631342004, 0.0065954136086116555, -0.0003317212908033872, 0.008042454924370359, -0.0007811110909475953, -0.01591928160747143, -0.03488768611552353, -0.008259914195534946, 0.004359021749609553, 0.004535652043230239, -0.0038406601658534587, 0.020132131832089183, 0.009185518432470395, -0.01696535989250994, -0.000641765048369837, -0.001792455608682673, -0.04067485223210661, 0.006687322898988176, 0.013403804349701334, -0.00594051970046532, -0.001985816592771813, -0.009892150727386466, 0.01776362568292193, -0.01109041611346622, -0.000995955420385508, 0.015266293442353713, 0.002342532130937561, 0.004325877581159506, -0.0008753892931653605, -0.00876373238412599, 0.03266946434576777, 0.002128580696011397, -0.004848932102601891, -0.0141702404073251, 0.0043089025927946015, -0.03711256868501034, -0.019829290001805867, 0.0049579945867505, -0.005073870863421224, -0.022908810633673983, 0.009950855007678372, -0.004554932137609504, 0.01618680664764867, -0.018039130379882903, 0.02410656558420789, -0.011164305052556164, -0.01997413589493373, 0.014279647992197471, 0.00031846253943835525}
@(private = "file")
EVT_FIT_REF := [?][9]f64{
	{0.95, -0.023999124964963193, 0.1891506757246072, 0.012657260994847453, 100.0, -0.023999124964963193, -0.03960900539023024, -0.04781107762180811, -0.0689756854181432},
	{0.9, -0.016013480323752775, 0.2074688339971388, 0.010724270407537737, 200.0, -0.02400803995043633, -0.03963252628333312, -0.047668286401003304, -0.06948655280685496},
	{0.975, -0.032944576101702615, 0.11886139888076606, 0.016002446262674143, 50.0, -0.02408705195658987, -0.03950636765980841, -0.04843574354955177, -0.06868652824239836},
}

@(private = "file")
_evt_rel :: proc(x, ref: f64) -> f64 {
	return math.abs(x - ref) / max(math.abs(ref), 1e-300)
}

evt_reference_test :: proc(allocator: mem.Allocator) {
	seed_test(#procedure)
	fmt.println("\n=== EVT: GPD, gpd_fit, evt_fit, GARCH-EVT (scipy reference) ===")
	context.allocator = allocator
	passed, total := 0, 0
	expect :: proc(passed, total: ^int, ok: bool, name: string) {
		total^ += 1
		if ok {passed^ += 1}
		fmt.printf("%s %s\n", "OK  " if ok else "FAIL", name)
	}

	// 1. GPD pdf / cdf / quantile vs scipy genpareto (incl. |xi| = 1e-9 and bounded support)
	{
		worst, at := 0.0, ""
		for row in EVT_FUN {
			got: f64
			switch row.kind {
			case "pdf":
				got = fin.gpd_pdf(row.x, row.xi, 0.01)
			case "cdf":
				got = fin.gpd_cdf(row.x, row.xi, 0.01)
			case "ppf":
				got = fin.gpd_quantile(row.x, row.xi, 0.01)
			}
			if e := _evt_rel(got, row.ref); e > worst {worst, at = e, fmt.tprintf("%s xi=%g x=%g", row.kind, row.xi, row.x)}
		}
		expect(&passed, &total, worst < 1e-12, fmt.tprintf("GPD pdf/cdf/quantile, %d values: max rel err %.1e (%s)", len(EVT_FUN), worst, at))
	}

	// 2. gpd_fit is the exact MLE (the NLL is flat to ~1e-15 within ~1e-8 of the optimum,
	// so parameters are compared to 1e-6 and the NLL to 1e-12)
	{
		ys := [?][]f64{EVT_Y0[:], EVT_Y1[:], EVT_Y2[:], EVT_Y3[:], EVT_Y4[:]}
		worst_p, worst_l := 0.0, 0.0
		all_conv := true
		start := time.tick_now()
		for y, k in ys {
			ref := EVT_GPD_REF[k]
			xi, beta, conv := fin.gpd_fit(y)
			all_conv = all_conv && conv
			worst_p = max(worst_p, math.abs(xi - ref[0]), _evt_rel(beta, ref[1]))
			worst_l = max(worst_l, fin._gpd_neg_log_likelihood([]f64{xi, beta}, y) - ref[2])
		}
		ms := time.duration_milliseconds(time.tick_since(start)) / f64(len(ys))
		expect(&passed, &total, worst_p < 1e-6 && worst_l < 1e-12 && all_conv, fmt.tprintf("gpd_fit on 5 samples (xi -0.3..0.9, n 60..800): max param err %.1e, NLL above optimum %.1e, %.2f ms per fit", worst_p, worst_l, ms))
	}

	// 3. evt_fit: threshold, GPD, VaR / ES at 95% and 99% (empirical where the level is inside the body)
	{
		worst, at := 0.0, ""
		ok := true
		for ref in EVT_FIT_REF {
			r := fin.evt_fit(EVT_R[:], ref[0])
			ok = ok && r.n_exceedances == int(ref[4]) && r.converged
			vals := [?]f64{r.threshold, r.xi, r.beta, r.var_95, r.cvar_95, r.var_99, r.cvar_99}
			refs := [?]f64{ref[1], ref[2], ref[3], ref[5], ref[6], ref[7], ref[8]}
			for v, j in vals {
				if e := _evt_rel(v, refs[j]); e > worst {worst, at = e, fmt.tprintf("threshold %.3f field %d", ref[0], j)}
			}
		}
		expect(&passed, &total, ok && worst < 1e-6, fmt.tprintf("evt_fit at thresholds 0.95 / 0.90 / 0.975 vs scipy genpareto ppf + quad: max rel err %.1e (%s)", worst, at))
	}

	// 4. evt_var_es at other levels, and infinite ES for xi >= 1
	{
		r := fin.evt_fit(EVT_R[:], 0.90)
		v99, e99 := fin.evt_var_es(&r, 0.99)
		v995, e995 := fin.evt_var_es(&r, 0.995)
		ok := v99 == r.var_99 && e99 == r.cvar_99 && v995 < v99 && e995 < v995

		heavy := make([]f64, 4000)
		defer delete(heavy)
		for i in 0 ..< len(heavy) {
			u := rand.float64()
			heavy[i] = -0.01 - 0.01 / 1.5 * (math.pow(1.0 - u, -1.5) - 1.0) if i % 10 == 0 else -0.01 + 0.03 * u
		}
		h := fin.evt_fit(heavy, 0.95)
		ok = ok && h.xi > 1.0 && math.is_inf(h.cvar_99, -1) && !math.is_inf(h.var_99, 0)
		expect(&passed, &total, ok, fmt.tprintf("evt_var_es: VaR/ES at 99.5%% beyond 99%%; xi = %.2f >= 1 gives ES = -inf (was 1.2 x VaR)", h.xi))
	}

	// 5. portfolio_cvar_evt uses the requested confidence
	{
		c95 := fin.portfolio_cvar_evt(EVT_R[:], 0.95, allocator)
		c99 := fin.portfolio_cvar_evt(EVT_R[:], 0.99, allocator)
		r := fin.evt_fit(EVT_R[:], 0.99)
		_, e := fin.evt_var_es(&r, 0.99)
		expect(&passed, &total, c99 == -e && c99 > c95, fmt.tprintf("portfolio_cvar_evt: 95%% %.5f, 99%% %.5f (99%% returned the 95%% ES before)", c95, c99))
	}

	// 6. garch_evt_fit on simulated GARCH(1,1)-t(5) returns with mean 0.0005
	{
		n := 4000
		ret := make([]f64, n)
		defer delete(ret)
		omega, alpha, beta, mu := 2e-6, 0.08, 0.9, 0.0005
		s2 := omega / (1 - alpha - beta)
		for i in 0 ..< n {
			chi := 0.0
			for _ in 0 ..< 5 {z := rand.float64_normal(0, 1); chi += z * z}
			z := rand.float64_normal(0, 1) / math.sqrt(chi / 5) * math.sqrt_f64(3.0 / 5.0)
			e := math.sqrt(s2) * z
			ret[i] = mu + e
			s2 = omega + alpha * e * e + beta * s2
		}
		h := fin.garch_evt_fit(ret, 0.90)
		defer {delete(h.var_95_series); delete(h.var_99_series)}

		resid := a.extract_residuals(ret)
		defer delete(resid)
		g := a.garch_fit(resid, .StudentT, 1, 1, 2000, 1e-4)
		defer {delete(g.params.alpha); delete(g.params.beta); delete(g.conditional_var); delete(g.standardized_resid)}
		mean := 0.0
		for v in ret {mean += v}
		mean /= f64(n)
		worst := 0.0
		for i in 0 ..< n {
			sig := math.sqrt(g.conditional_var[i])
			worst = max(worst, math.abs(h.var_95_series[i] - (sig * h.q_95 - mean)), math.abs(h.var_99_series[i] - (sig * h.q_99 - mean)))
		}
		ok :=
			worst < 1e-15 &&
			h.n_exceedances == n / 10 &&
			h.es_q_99 > h.q_99 &&
			h.q_99 > h.q_95 &&
			h.backtest_95.passes_test &&
			h.backtest_99.passes_test
		expect(&passed, &total, ok, fmt.tprintf("garch_evt_fit: VaR_t = sigma_t q - mu (max err %.1e), %d exceedances, q95 %.3f q99 %.3f ES99 %.3f, breaches %.2f%% / %.2f%%", worst, h.n_exceedances, h.q_95, h.q_99, h.es_q_99, 100 * h.backtest_95.breach_rate, 100 * h.backtest_99.breach_rate))
	}

	fmt.printf("EVT summary: %d/%d passed\n", passed, total)
	record_failures(total - passed)
}
