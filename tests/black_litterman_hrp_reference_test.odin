	10.0,
}
@(private = "file")
BL_DELTA :: 2.5
@(private = "file")
BL_TAU :: 0.05

@(private = "file")
_bl_mat :: proc(data: []f64, rows, cols: int) -> l.Matrix(f64) {
	m := l.matrix_new(f64, rows, cols)
	copy(m.data, data)
	return m
}

black_litterman_hrp_reference_test :: proc(allocator: mem.Allocator) {
	seed_test(#procedure)
	fmt.println("\n=== Black-Litterman and Hierarchical Risk Parity (numpy / scipy reference) ===")
	context.allocator = allocator
	passed, total := 0, 0
	expect :: proc(passed, total: ^int, ok: bool, name: string) {
		total^ += 1
		if ok {passed^ += 1}
		fmt.printf("%s %s\n", "OK  " if ok else "FAIL", name)
	}
	n, k := 7, 3
	cov := _bl_mat(BL_COV[:], n, n)
	P := _bl_mat(BL_P[:], k, n)

	// 1. Equilibrium returns
	pi := fin.bl_implied_returns(&cov, BL_WM[:], BL_DELTA)
	worst_pi := 0.0
	for x, i in pi {worst_pi = max(worst_pi, abs(x - BL_PI[i]))}
	mret, mvar := 0.0, 0.0
	for i in 0 ..< n {
		mret += BL_WM[i] * pi[i]
		for j in 0 ..< n {mvar += BL_WM[i] * BL_WM[j] * BL_COV[i * n + j]}
	}
	delta := fin.bl_market_risk_aversion(mret, mvar)
	expect(
		&passed,
		&total,
		worst_pi < 1e-15 && abs(delta - BL_DELTA) < 1e-12,
		fmt.tprintf(
			"implied returns Π = δΣw (7 assets, δ = 2.5) max diff %.1e; market risk aversion recovered from Π: %.12f",
			worst_pi,
			delta,
		),
	)

	// 2. Posteriors for the three Ω choices
	{
		omex := _bl_mat(BL_OMEX[:], k, k)
		names := [3]string {
			"He-Litterman Ω = diag(PτΣPᵀ)",
			"Idzorek confidences 90/50/25%",
			"explicit correlated Ω",
		}
		stride := n + n * n + n
		ok := true
		msg := ""
		for c in 0 ..< 3 {
			r: fin.BlackLittermanResult
			switch c {
			case 0:
				r = fin.black_litterman(&cov, pi, &P, BL_Q[:], BL_TAU)
			case 1:
				r = fin.black_litterman(&cov, pi, &P, BL_Q[:], BL_TAU, confidences = BL_CONF[:])
			case 2:
				r = fin.black_litterman(&cov, pi, &P, BL_Q[:], BL_TAU, omega = &omex)
			}
			defer fin.black_litterman_result_free(&r)
			ref := BL_BL[c * stride:(c + 1) * stride]
			wm, ws, ww := 0.0, 0.0, 0.0
			for x, i in r.posterior_returns {wm = max(wm, abs(x - ref[i]))}
			for x, i in r.posterior_cov.data {ws = max(ws, abs(x - ref[n + i]))}
			wts := fin.bl_optimal_weights(&r.posterior_cov, r.posterior_returns, BL_DELTA)
			for x, i in wts {ww = max(ww, abs(x - ref[n + n * n + i]))}
			ok &&= wm < 1e-14 && ws < 1e-15 && ww < 1e-11
			msg = fmt.tprintf(
				"%s%s%s: μ %.1e, Σ_BL %.1e, weights %.1e",
				msg,
				"; " if c > 0 else "",
				names[c],
				wm,
				ws,
				ww,
			)
		}
		expect(
			&passed,
			&total,
			ok,
			fmt.tprintf(
				"posterior vs numpy precision form [(τΣ)⁻¹ + PᵀΩ⁻¹P]⁻¹ (absolute, relative and basket views): %s",
				msg,
			),
		)
	}

	// 3. Properties: a 100%-confidence view holds exactly, a 0% view is ignored,
	// and the optimal weights are (w_mkt + Pᵀλ)/(1 + τ)
	{
		conf := [3]f64{1.0, 0.5, 0.0}
		r := fin.black_litterman(&cov, pi, &P, BL_Q[:], BL_TAU, confidences = conf[:])
		defer fin.black_litterman_result_free(&r)
		pmu := 0.0
		for j in 0 ..< n {pmu += BL_P[j] * r.posterior_returns[j]}
		// view 3 ignored: same posterior as with views 1-2 only
		P2 := _bl_mat(BL_P[:2 * n], 2, n)
		conf2 := [2]f64{1.0, 0.5}
		r2 := fin.black_litterman(&cov, pi, &P2, BL_Q[:2], BL_TAU, confidences = conf2[:])
		defer fin.black_litterman_result_free(&r2)
		diff3 := 0.0
		for x, i in r.posterior_returns {diff3 = max(diff3, abs(x - r2.posterior_returns[i]))}
		// He-Litterman: (1 + τ) w* − w_mkt lies in the span of the view portfolios
		h := fin.black_litterman(&cov, pi, &P, BL_Q[:], BL_TAU)
		defer fin.black_litterman_result_free(&h)
		wts := fin.bl_optimal_weights(&h.posterior_cov, h.posterior_returns, BL_DELTA)
		e := make([]f64, n)
		for i in 0 ..< n {e[i] = (1 + BL_TAU) * wts[i] - BL_WM[i]}
		// least squares fit of e on the rows of P; the residual must vanish
		G := l.matrix_new(f64, k, k)
		bvec := make([]f64, k)
		for a in 0 ..< k {
			for b in 0 ..< k {for j in 0 ..< n {G.data[a * k + b] += BL_P[a * n + j] * BL_P[b * n + j]}}
			for j in 0 ..< n {bvec[a] += BL_P[a * n + j] * e[j]}
		}
		lam := l.solve_spd_cholesky(&G, bvec)
		resid := 0.0
		for j in 0 ..< n {
			s := e[j]
			for a in 0 ..< k {s -= lam[a] * BL_P[a * n + j]}
			resid = max(resid, abs(s))
		}
		ok := abs(pmu - BL_Q[0]) < 1e-12 && diff3 < 1e-9 && resid < 1e-12
		expect(
			&passed,
			&total,
			ok,
			fmt.tprintf(
				"100%% confidence: Pμ = %.12f (view 6%%); 0%% confidence matches dropping the view to %.1e; (1 + τ)w* − w_mkt in the span of the views: residual %.1e (He & Litterman)",
				pmu,
				diff3,
				resid,
			),
		)
	}

	// 4–5. HRP vs López de Prado's code, from returns and from the covariance
	{
		T, N := 500, 12
		X := _bl_mat(BL_X[:], T, N)
		names := [2]string{"paper's d̃ linkage", "PyPortfolioOpt's d linkage"}
		for li in 0 ..< 2 {
			linkage := ml_fin.HRPLinkageInput(li)
			res := ml_fin.hrp_allocate(&X, allocator, linkage = linkage)
			defer ml_fin.hrp_result_free(&res)
			ref := BL_HRP[li * 2 * N:(li + 1) * 2 * N]
			worst := 0.0
			for x, i in res.weights {worst = max(worst, abs(x - ref[i]))}
			order_ok := true
			for o, i in res.cluster_order {order_ok &&= f64(o) == ref[N + i]}
			sum := 0.0
			for x in res.weights {sum += x}
			expect(
				&passed,
				&total,
				worst < 1e-14 && order_ok && abs(sum - 1) < 1e-14,
				fmt.tprintf(
					"HRP, 12 assets in 3 correlated blocks, %s: weights vs López de Prado's code (scipy linkage) max diff %.1e, leaf order %v, Σw = %.15f",
					names[li],
					worst,
					order_ok,
					sum,
				),
			)
		}
	}

	fmt.printf("Black-Litterman / HRP summary: %d/%d passed\n", passed, total)
	record_failures(total - passed)
}
