	0.07228728410099008,
	0.030412957917293794,
	0.12200526463268087,
	0.030912709964895285,
	0.1874930733610125,
	0.046639696413571255,
	11.0,
	2.0,
	5.0,
	8.0,
	0.0,
	6.0,
	3.0,
	9.0,
	7.0,
	1.0,
	4.0,
	10.0,
	0.01602920634865918,
	0.030209660311968263,
