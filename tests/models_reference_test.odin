// Σ out ⊙ R as a graph scalar
@(private = "file")
_mt_weighted :: proc(out: ^t.Tensor, R: []f64) -> ^t.Tensor {
	r := t.tensor_new(l.matrix_new(f64, out.data.rows, out.data.cols), false)
	copy(r.data.data, R)
	r.shape = out.shape
	return t.tensor_sum(t.tensor_mul(out, r))
}

// Max deviation of the parameter gradients from ref
@(private = "file")
_mt_grads :: proc(params: []^t.Tensor, ref: []f64) -> f64 {
	worst, k := 0.0, 0
	for p in params {
		for g in p.grad.data {
			worst = max(worst, abs(g - ref[k]))
			k += 1
		}
	}
	assert(k == len(ref), "gradient count differs from torch")
	return worst
}

models_reference_test :: proc(allocator: mem.Allocator) {
	seed_test(#procedure)
	fmt.println("\n=== nn models (torch reference) ===")
	context.allocator = allocator
	passed, total := 0, 0
	expect :: proc(passed, total: ^int, ok: bool, name: string) {
		total^ += 1
		if ok {passed^ += 1}
		fmt.printf("%s %s\n", "OK  " if ok else "FAIL", name)
	}
	TOL :: 1e-12

	// 1-3. GPT: dense (standard and flash attention) and with a top-2-of-4 MoE
	for c in 0 ..< 3 {
		moe := c == 2
		P := MT_GPTMOE_P[:] if moe else MT_GPT_P[:]
		DP := MT_GPTMOE_DP[:] if moe else MT_GPT_DP[:]
		R := MT_GPTMOE_R[:] if moe else MT_GPT_R[:]
		OUT := MT_GPTMOE_OUT[:] if moe else MT_GPT_OUT[:]
		model := nn.gpt_model_new(
			11,
			8,
			2,
			16,
			1 if moe else 2,
			8,
			use_flash = c == 1,
			use_moe = moe,
			num_experts = 4,
			top_k = 2,
		)
		ps := nn.gpt_model_parameters(&model)
		_lt_load(ps[:], P)
		ids := _lt_tensor(MT_GPT_IDS[:], {2, 5, 1, 1}, false)
		mask := nn.create_causal_mask(5, allocator)
		logits := nn.gpt_model_forward(&model, ids, mask, false, aux_loss = moe)
		loss := _mt_weighted(logits, R)
		if moe {loss = t.tensor_add(loss, t.tensor_scale(model.aux_loss, 0.01))}
		t.tensor_backward(loss)
		d_out := _lt_diff(logits.data.data, OUT)
		d_p := _mt_grads(ps[:], DP)
		switch c {
		case 0, 1:
			expect(
				&passed,
				&total,
				max(d_out, d_p) < TOL,
				fmt.tprintf(
					"GPT, 2 pre-LN blocks%s, learned positions: logits %.1e, all %d parameter grads (incl. positional embeddings) %.1e",
					" with FlashAttention" if c == 1 else "",
					d_out,
					len(ps),
					d_p,
				),
			)
		case 2:
			d_aux := abs(model.aux_loss.data.data[0] - MT_GPTMOE_AUX[0])
			expect(
				&passed,
				&total,
				max(d_out, d_p, d_aux) < TOL,
				fmt.tprintf(
					"GPT with top-2-of-4 MoE, loss + 0.01·load balancing: logits %.1e, aux loss %.6f (diff %.1e), all %d parameter grads (incl. router) %.1e",
					d_out,
					model.aux_loss.data.data[0],
					d_aux,
					len(ps),
					d_p,
				),
			)
		}
	}

	// 4. BERT: MLM and NSP heads, padding (token 0), [CLS] pooler
	{
		model := nn.bert_model_new(11, 8, 2, 16, 2, 8)
		ps := nn.bert_model_parameters(&model)
		_lt_load(ps[:], MT_BERT_P[:])
		ids := _lt_tensor(MT_BERT_IDS[:], {2, 6, 1, 1}, false)
		segs := _lt_tensor(MT_BERT_SEGS[:], {2, 6, 1, 1}, false)
		mlm, nsp := nn.bert_model_forward(&model, ids, segs, false)
		t.tensor_backward(
			t.tensor_add(_mt_weighted(mlm, MT_BERT_R1[:]), _mt_weighted(nsp, MT_BERT_R2[:])),
		)
		d_mlm := _lt_diff(mlm.data.data, MT_BERT_MLM[:])
		d_nsp := _lt_diff(nsp.data.data, MT_BERT_NSP[:])
		d_p := _mt_grads(ps[:], MT_BERT_DP[:])
		expect(
			&passed,
			&total,
			max(d_mlm, d_nsp, d_p) < TOL,
			fmt.tprintf(
				"BERT, 2 post-LN blocks, padded batch: MLM logits %.1e, NSP logits %.1e, all %d parameter grads %.1e",
				d_mlm,
				d_nsp,
				len(ps),
				d_p,
			),
		)
	}

	// 5. GAT layer: projection, attention over the weighted graph edges
	{
		c := _LtCase {
			MT_GAT_X[:],
			MT_GAT_R[:],
			MT_GAT_OUT[:],
			MT_GAT_DX[:],
			MT_GAT_P[:],
			MT_GAT_DP[:],
		}
		adj := t.tensor_new(l.matrix_new(f64, 5, 5), false)
		copy(adj.data.data, MT_GAT_A[:])
		layer := nn.gat_layer_new(3, 8, 2, adj)
		ps := _lt_params(layer)
		_lt_load(ps, c.p)
		x := _lt_tensor(c.x, {2, 5, 3, 1}, true)
		do_, dx, dp := _lt_check(c, nn.gat_layer_forward(&layer, x, layer.adjacency), x, ps)
		expect(
			&passed,
			&total,
			max(do_, dx, dp) < TOL,
			fmt.tprintf(
				"GAT layer (5 assets, 3 → 8 features, 2 heads, attention over weighted graph edges): output %.1e, input grad %.1e, parameter grads (incl. the input projection) %.1e",
				do_,
				dx,
				dp,
			),
		)
	}

	// 6. Mamba layer: projections, softplus Δ, A = −exp(θ), selective scan
	{
		c := _LtCase {
			MT_MAMBA_X[:],
			MT_MAMBA_R[:],
			MT_MAMBA_OUT[:],
			MT_MAMBA_DX[:],
			MT_MAMBA_P[:],
			MT_MAMBA_DP[:],
		}
		// θ_A trainable, then frozen (A is then a constant of the scan, whose
		// backward still reads it; θ_A keeps a zero gradient)
		worst: [2]f64
		for frozen, run in ([]bool{false, true}) {
			layer := nn.mamba_layer_new(4, 3)
			ps := _lt_params(layer)
			_lt_load(ps, c.p)
			cr := c
			if frozen {
				nn.tensor_set_requires_grad(layer.A, false)
				cr.dp = slice.clone(c.dp)
				k := 0
				for p in ps {
					if p == layer.A {slice.zero(cr.dp[k:k + len(p.data.data)])}
					k += len(p.data.data)
				}
			}
			x := _lt_tensor(c.x, {2, 6, 4, 1}, true)
			h0 := _lt_tensor(make([]f64, 2 * 4 * 3), {2, 4, 3, 1}, false)
			do_, dx, dp := _lt_check(cr, nn.mamba_layer_forward(&layer, x, h0), x, ps)
			worst[run] = max(do_, dx, dp)
		}
		expect(
			&passed,
			&total,
			max(worst[0], worst[1]) < TOL,
			fmt.tprintf(
				"Mamba layer (d 4, state 3, 6 steps): output, input grad and parameter grads (incl. θ_A, D) %.1e, with θ_A frozen %.1e",
				worst[0],
				worst[1],
			),
		)
	}

	// 7. VAE: clamped encoder, reparameterization (ε from torch), decoder
	{
		enc := nn.vae_encoder_new(4, 6, 3)
		dec := nn.vae_decoder_new(3, 6, 4)
		psd := make([dynamic]^t.Tensor)
		for lin in ([]^nn.LinearLayer{&enc.fc1, &enc.fc_mu, &enc.fc_logvar, &dec.fc1, &dec.fc2, &dec.fc3}) {_lt_linear(&psd, lin)}
		ps := psd[:]
		_lt_load(ps, MT_VAE_P[:])
		xm := l.matrix_new(f64, 5, 4)
		copy(xm.data, MT_VAE_X[:])
		x := t.tensor_new(xm, true)
		mu, log_var := nn.vae_encoder_forward(&enc, x)
		z := nn.reparameterize(mu, log_var, allocator)
		for i in 0 ..< len(z.data.data) {
			z.data.data[i] = mu.data.data[i] + math.exp(0.5 * log_var.data.data[i]) * MT_VAE_EPS[i]
		}
		rec := nn.vae_decoder_forward(&dec, z)
		loss := t.tensor_add(
			_mt_weighted(rec, MT_VAE_R[:]),
			t.tensor_add(_mt_weighted(mu, MT_VAE_RM[:]), _mt_weighted(log_var, MT_VAE_RV[:])),
		)
		t.tensor_backward(loss)
		d_out := _lt_diff(rec.data.data, MT_VAE_OUT[:])
		d_x := _lt_diff(x.grad.data, MT_VAE_DX[:])
		d_p := _mt_grads(ps, MT_VAE_DP[:])
		expect(
			&passed,
			&total,
			max(d_out, d_x, d_p) < TOL,
			fmt.tprintf(
				"VAE (%d of 30 encoder outputs clamped): reconstruction %.1e, input grad %.1e, all parameter grads %.1e",
				int(MT_VAE_CLAMPED[0]),
				d_out,
				d_x,
				d_p,
			),
		)
	}

	// 8. GAN: generator -> discriminator on fake data, critic (no sigmoid) on real data
	{
		gen := nn.generator_new(3, 6, 4)
		disc := nn.discriminator_new(4, 6)
		psd := make([dynamic]^t.Tensor)
		for lin in ([]^nn.LinearLayer{&gen.fc1, &gen.fc2, &gen.fc3, &disc.fc1, &disc.fc2, &disc.fc3}) {_lt_linear(&psd, lin)}
		ps := psd[:]
		_lt_load(ps, MT_GAN_P[:])
		zm := l.matrix_new(f64, 5, 3)
		copy(zm.data, MT_GAN_Z[:])
		z := t.tensor_new(zm, true)
		xm := l.matrix_new(f64, 5, 4)
		copy(xm.data, MT_GAN_X[:])
		x := t.tensor_new(xm, true)
		fake := nn.generator_forward(&gen, z)
		prob := nn.discriminator_forward(&disc, fake)
		score := nn.discriminator_forward_no_sigmoid(&disc, x)
		loss := t.tensor_add(
			_mt_weighted(fake, MT_GAN_RF[:]),
			t.tensor_add(_mt_weighted(prob, MT_GAN_RP[:]), _mt_weighted(score, MT_GAN_RS[:])),
		)
		t.tensor_backward(loss)
		d_out := max(
			_lt_diff(fake.data.data, MT_GAN_FAKE[:]),
			_lt_diff(prob.data.data, MT_GAN_PROB[:]),
			_lt_diff(score.data.data, MT_GAN_SCORE[:]),
		)
		d_in := max(_lt_diff(z.grad.data, MT_GAN_DZ[:]), _lt_diff(x.grad.data, MT_GAN_DX[:]))
		d_p := _mt_grads(ps, MT_GAN_DP[:])
		expect(
			&passed,
			&total,
			max(d_out, d_in, d_p) < TOL,
			fmt.tprintf(
				"GAN: fake data, probabilities, critic scores %.1e, noise and data grads %.1e, all parameter grads %.1e",
				d_out,
				d_in,
				d_p,
			),
		)
	}

	// 9. GPT with RMSNorm and the output projection tied to the token embedding
	{
		model := nn.gpt_model_new(11, 8, 2, 16, 2, 8, rms_norm = true, tie_embeddings = true)
		ps := nn.gpt_model_parameters(&model)
		_lt_load(ps[:], MT_GPTRT_P[:])
		ids := _lt_tensor(MT_GPT_IDS[:], {2, 5, 1, 1}, false)
		mask := nn.create_causal_mask(5, allocator)
		logits := nn.gpt_model_forward(&model, ids, mask, false)
		t.tensor_backward(_mt_weighted(logits, MT_GPTRT_R[:]))
		d_out := _lt_diff(logits.data.data, MT_GPTRT_OUT[:])
		d_p := _mt_grads(ps[:], MT_GPTRT_DP[:])
		expect(
			&passed,
			&total,
			max(d_out, d_p) < TOL && model.output_proj.weights == nil,
			fmt.tprintf(
				"GPT with RMSNorm and tied embeddings (logits = x·Eᵀ + b): logits %.1e, all %d parameter grads (the token embedding's from both uses) %.1e",
				d_out,
				len(ps),
				d_p,
			),
		)
	}

	// 10. RMSNorm (eps 1e-6) and LayerNorm with a non-default eps (1e-3)
	{
		worst: [2]f64
		for rms, k in ([]bool{true, false}) {
			norm := nn.rms_norm_layer_new(8, 1e-6) if rms else nn.layer_norm_layer_new(8, 1e-3)
			ps := []^t.Tensor{norm.gamma} if rms else []^t.Tensor{norm.gamma, norm.beta}
			_lt_load(ps, MT_NORM_RMS_P[:] if rms else MT_NORM_LN3_P[:])
			x := _lt_tensor(MT_NORM_X[:], {2, 5, 8, 1}, true)
			y := nn.layer_norm_layer_forward(&norm, x)
			t.tensor_backward(_mt_weighted(y, MT_NORM_RMS_R[:] if rms else MT_NORM_LN3_R[:]))
			worst[k] = max(
				_lt_diff(y.data.data, MT_NORM_RMS_OUT[:] if rms else MT_NORM_LN3_OUT[:]),
				_lt_diff(x.grad.data, MT_NORM_RMS_DX[:] if rms else MT_NORM_LN3_DX[:]),
				_mt_grads(ps, MT_NORM_RMS_DP[:] if rms else MT_NORM_LN3_DP[:]),
			)
		}
		expect(
			&passed,
			&total,
			max(worst[0], worst[1]) < TOL,
			fmt.tprintf(
				"RMSNorm (eps 1e-6) output, input and gamma grads %.1e; LayerNorm with eps 1e-3 %.1e (its backward used 1e-5 before)",
				worst[0],
				worst[1],
			),
		)
	}

	fmt.printf("Models summary: %d/%d passed\n", passed, total)
	record_failures(total - passed)
}
