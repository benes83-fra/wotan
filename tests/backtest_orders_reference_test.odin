@(private = "file")
_bo_ids: [400]int // order id -> index in the BT_ORD_* arrays (by id - 1)
@(private = "file")
_bo_bad: int // orders not left resting at submission

@(private = "file")
_bo_order :: proc(k: int) -> fin.Order {
	kind := BT_ORD_KIND[k]
	types := [3]fin.OrderType{.Limit, .Stop, .StopLimit}
	return fin.Order {
		symbol = "A",
		side = .Buy if kind < 3 else .Sell,
		quantity = 1,
		order_type = types[kind % 3],
		limit_price = BT_ORD_LIMIT[k],
		stop_price = BT_ORD_STOP[k],
	}
}

@(private = "file")
_bo_strategy :: proc(ctx: ^fin.StrategyContext) {
	for b, k in BT_ORD_BAR {
		if b != ctx.current_bar {continue}
		id, status := fin.context_submit_order(ctx, _bo_order(k))
		if status != .Pending {_bo_bad += 1; continue}
		_bo_ids[id - 1] = k
	}
}

// Close-only stop-limit script: closes 100, 103, 106, 104, 101, 99, 96, 98.
// Bar 0: buy stop 102 limit 105 (A); buy stop 105 limit 104 (B); sell stop 98 limit 97 (C).
// A triggers and fills at 103 on bar 1 (close >= 102 and <= 105). B triggers on bar 2
// (close 106 >= 105) above its limit 104, rests as a limit and fills at 104 on bar 3.
// C triggers on bar 6 (96 <= 98) below its limit 97, rests as a limit and fills at 98
// on bar 7 (a sell at >= 97).
@(private = "file")
_bo_close_strategy :: proc(ctx: ^fin.StrategyContext) {
	if ctx.current_bar != 0 {return}
	fin.context_submit_order(
		ctx,
		{
			symbol = "A",
			side = .Buy,
			quantity = 1,
			order_type = .StopLimit,
			stop_price = 102,
			limit_price = 105,
		},
	)
	fin.context_submit_order(
		ctx,
		{
			symbol = "A",
			side = .Buy,
			quantity = 1,
			order_type = .StopLimit,
			stop_price = 105,
			limit_price = 104,
		},
	)
	fin.context_submit_order(
		ctx,
		{
			symbol = "A",
			side = .Sell,
			quantity = 1,
			order_type = .StopLimit,
			stop_price = 98,
			limit_price = 97,
		},
	)
}

backtest_orders_reference_test :: proc(allocator: mem.Allocator) {
	seed_test(#procedure)
	fmt.println(
		"\n=== Backtest order engine: intrabar fills (backtrader rules), stop-limit orders ===",
	)
	context.allocator = allocator
	passed, total := 0, 0
	expect :: proc(passed, total: ^int, ok: bool, name: string) {
		total^ += 1
		if ok {passed^ += 1}
		fmt.printf("%s %s\n", "OK  " if ok else "FAIL", name)
	}

	{
		df := w.dataframe_new()
		defer w.destroy_dataframe(&df)
		cols := [4]string{"A", "A_Open", "A_High", "A_Low"}
		src := [4][]f64{BT_CLOSE[:], BT_OPEN[:], BT_HIGH[:], BT_LOW[:]}
		for name, j in cols {
			col := w.column_new(name, .Float, len(BT_CLOSE))
			for v in src[j] {w.append_float(&col, v)}
			w.add_column(&df, col)
		}
		cfg := fin.BacktestConfig {
			initial_capital = 1e9,
			intrabar        = true,
		}
		_bo_bad = 0
		r := fin.backtest_run(&df, []string{"A"}, _bo_strategy, cfg)
		defer {delete(r.equity_curve); delete(r.trades)}
		got_bar := make([]int, len(BT_ORD_BAR))
		got_px := make([]f64, len(BT_ORD_BAR))
		defer {delete(got_bar); delete(got_px)}
		for &b in got_bar {b = -1}
		for f in r.trades {
			k := _bo_ids[f.order_id - 1]
			got_bar[k], got_px[k] = f.fill_time, f.fill_price
		}
		mismatch, filled := 0, 0
		first := -1
		for k in 0 ..< len(BT_ORD_BAR) {
			if BT_FILL_BAR[k] >= 0 {filled += 1}
			if got_bar[k] != BT_FILL_BAR[k] || (got_bar[k] >= 0 && got_px[k] != BT_FILL_PX[k]) {
				mismatch += 1
				if first < 0 {first = k}
			}
		}
		detail := ""
		if first >= 0 {
			detail = fmt.tprintf(
				"; first: order %d kind %d bar %d -> got bar %d @ %v, ref bar %d @ %v",
				first,
				BT_ORD_KIND[first],
				BT_ORD_BAR[first],
				got_bar[first],
				got_px[first],
				BT_FILL_BAR[first],
				BT_FILL_PX[first],
			)
		}
		expect(
			&passed,
			&total,
			mismatch == 0 && _bo_bad == 0 && r.open_orders == len(BT_ORD_BAR) - filled,
			fmt.tprintf(
				"intrabar fills of 400 limit / stop / stop-limit orders = backtrader rules: %d mismatches, %d filled, %d still open (ref %d), %d not resting at submission%s",
				mismatch,
				filled,
				r.open_orders,
				len(BT_ORD_BAR) - filled,
				_bo_bad,
				detail,
			),
		)
	}
	{
		df := w.dataframe_new()
		defer w.destroy_dataframe(&df)
		col := w.column_new("A", .Float, 8)
		for v in ([]f64{100, 103, 106, 104, 101, 99, 96, 98}) {w.append_float(&col, v)}
		w.add_column(&df, col)
		r := fin.backtest_run(
			&df,
			[]string{"A"},
			_bo_close_strategy,
			fin.BacktestConfig{initial_capital = 1e6},
		)
		defer {delete(r.equity_curve); delete(r.trades)}
		want := [3][3]f64{{1, 1, 103}, {2, 3, 104}, {3, 7, 98}} // id, bar, price
		ok := len(r.trades) == 3 && r.open_orders == 0
		if ok {
			for f, i in r.trades {
				ok &&=
					f64(f.order_id) == want[i][0] &&
					f64(f.fill_time) == want[i][1] &&
					f.fill_price == want[i][2]
			}
		}
		desc := ""
		for f in r.trades {desc = fmt.tprintf("%s id %d bar %d @ %.0f;", desc, f.order_id, f.fill_time, f.fill_price)}
		expect(
			&passed,
			&total,
			ok,
			fmt.tprintf(
				"close-only stop-limit orders (trigger, rest as limit, fill) by hand:%s",
				desc,
			),
		)

		// rejected: a stop-limit without a limit price
		pf := fin.portfolio_init(1e6, context.allocator)
		defer fin.portfolio_destroy(&pf)
		ctx := fin.StrategyContext {
			portfolio = &pf,
			data      = &df,
			symbols   = []string{"A"},
		}
		id, st := fin.context_submit_order(
			&ctx,
			{symbol = "A", side = .Buy, quantity = 1, order_type = .StopLimit, stop_price = 102},
		)
		expect(
			&passed,
			&total,
			id == 0 && st == .Rejected,
			fmt.tprintf("stop-limit without a limit price: id %d, %v", id, st),
		)
	}

	fmt.printf("Backtest order engine summary: %d/%d passed\n", passed, total)
	record_failures(total - passed)
}
