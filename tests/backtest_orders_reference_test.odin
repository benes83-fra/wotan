package tests

// Order engine of the backtester (wotan/finance/backtest.odin):
// 1. Intrabar fills (BacktestConfig.intrabar): 400 random limit, stop and stop-limit
//    orders on a random 300-bar OHLC path, each submitted at a close where it does not
//    fill at once, against a Python transcription of backtrader 1.9.78.123's BackBroker
//    rules (bbroker.py _try_exec_limit / _try_exec_stop / _try_exec_stoplimit, no
//    commission or slippage; bt_ref.py). Fill bar and price of every order must match
//    exactly. Branches hit by the reference (side, type, fill price; "later bar": a
//    stop-limit that triggered and filled as a limit order on a later bar):
//   Buy Limit at limit 60
//   Buy Limit at open 9
//   Buy Stop at open 9
//   Buy Stop at stop 51
//   Buy StopLimit at limit 1
//   Buy StopLimit at limit (later bar) 33
//   Buy StopLimit at open 1
//   Buy StopLimit at open (later bar) 9
//   Buy StopLimit at stop 10
//   Buy StopLimit at stop (later bar) 11
//   Limit unfilled 12
//   Sell Limit at limit 46
//   Sell Limit at open 7
//   Sell Stop at open 7
//   Sell Stop at stop 46
//   Sell StopLimit at limit 1
//   Sell StopLimit at limit (later bar) 23
//   Sell StopLimit at open 3
//   Sell StopLimit at open (later bar) 8
//   Sell StopLimit at stop 13
//   Sell StopLimit at stop (later bar) 20
//   Stop unfilled 6
//   StopLimit unfilled 14
// 2. Close-only stop-limit orders (intrabar off) on a scripted path, by hand.

import w "../wotan/core"
import fin "../wotan/finance"
