// The time indexing ops on channels-last sequences against torch: index_select
// along time (repeated and reordered steps), narrow (tensor_slice_time), F.pad
// with zeros, reflection and replication (tensor_pad_time), a length regulator
// (tensor_length_regulate, including zero durations) against per-sequence
// repeat_interleave padded to the longest sequence, padded further and cut to a
// max_len, and torch.cat along time (tensor_concat, dim 1): outputs and input
// gradients under a random upstream gradient.
time_index_reference_test :: proc(allocator: mem.Allocator) {
	seed_test(#procedure)
	fmt.println(
		"\n=== time indexing (index_select, narrow, pad, length regulator, cat) vs torch ===",
	)
	context.allocator = allocator
	passed, total := 0, 0
	expect :: proc(passed, total: ^int, ok: bool, name: string) {
		total^ += 1
		if ok {passed^ += 1}
		fmt.printf("%s %s\n", "OK  " if ok else "FAIL", name)
	}
	leaf :: proc(v: []f64, shape: [4]int) -> ^t.Tensor {
		m := l.matrix_new(f64, 1, len(v))
		copy(m.data, v)
		x := t.tensor_new(m, true)
		x.shape = shape
		return x
	}
	diff :: proc(a, b: []f64) -> f64 {
		if len(a) != len(b) {return math.INF_F64}
		d := 0.0
		for v, i in a {d = max(d, abs(v - b[i]) / max(1, abs(b[i])))}
		return d
	}
	Case :: struct {
		name:         string,
		x_shape:      [4]int,
		T_out:        int,
		x, up, y, dx: []f64,
		run:          proc(x: ^t.Tensor) -> ^t.Tensor,
	}
	cases := [?]Case {
		{
			name = "index_select along time, indices 5 0 0 3 2 2 2",
			x_shape = {2, 6, 3, 1},
			T_out = 7,
			x = TI1_X[:],
			up = TI1_UP[:],
			y = TI1_Y[:],
			dx = TI1_DX[:],
			run = proc(x: ^t.Tensor) -> ^t.Tensor {
				return t.tensor_index_select_time(x, []int{5, 0, 0, 3, 2, 2, 2})
			},
		},
		{
			name = "tensor_slice_time = narrow(1, 2, 5)",
			x_shape = {2, 9, 4, 1},
			T_out = 5,
			x = TI2_X[:],
			up = TI2_UP[:],
			y = TI2_Y[:],
			dx = TI2_DX[:],
			run = proc(x: ^t.Tensor) -> ^t.Tensor {return t.tensor_slice_time(x, 2, 5)},
		},
		{
			name = "tensor_pad_time zeros, 1 / 3 steps",
			x_shape = {2, 7, 3, 1},
			T_out = 11,
			x = TI3_X[:],
			up = TI3_UP[:],
			y = TI3_Y[:],
			dx = TI3_DX[:],
			run = proc(x: ^t.Tensor) -> ^t.Tensor {return t.tensor_pad_time(x, 1, 3)},
		},
		{
			name = "tensor_pad_time reflect, 3 / 2 steps",
			x_shape = {2, 7, 3, 1},
			T_out = 12,
			x = TI4_X[:],
			up = TI4_UP[:],
			y = TI4_Y[:],
			dx = TI4_DX[:],
			run = proc(x: ^t.Tensor) -> ^t.Tensor {return t.tensor_pad_time(x, 3, 2, .Reflect)},
		},
		{
			name = "tensor_pad_time replicate, 2 / 4 steps",
			x_shape = {2, 7, 3, 1},
			T_out = 13,
			x = TI5_X[:],
			up = TI5_UP[:],
			y = TI5_Y[:],
			dx = TI5_DX[:],
			run = proc(x: ^t.Tensor) -> ^t.Tensor {return t.tensor_pad_time(x, 2, 4, .Replicate)},
		},
	}

	// 1-5. index_select, narrow, pad
	for c in cases {
		x := leaf(c.x, c.x_shape)
		y := c.run(x)
		t.tensor_backward_with_grad(y, c.up)
		d := max(diff(y.data.data, c.y), diff(x.grad.data, c.dx))
		want := [4]int{c.x_shape[0], c.T_out, c.x_shape[2], 1}
		expect(
			&passed,
			&total,
			y.shape == want && d < 1e-15,
			fmt.tprintf("%s: output %v, output and gradient vs torch %.1e", c.name, y.shape, d),
		)
	}

	// 6-8. length regulator: durations 2 0 3 1 1 / 1 1 1 1 1 / 0 4 2 0 3
	//      (lengths 7, 5, 9)
	Lr_Case :: struct {
		max_len:      int,
		T_out:        int,
		lengths:      [3]int,
		x, up, y, dx: []f64,
		name:         string,
	}
	lr_cases := [?]Lr_Case {
		{-1, 9, {7, 5, 9}, TL1_X[:], TL1_UP[:], TL1_Y[:], TL1_DX[:], "padded to the longest"},
		{14, 14, {7, 5, 9}, TL2_X[:], TL2_UP[:], TL2_Y[:], TL2_DX[:], "max_len 14"},
		{6, 6, {6, 5, 6}, TL3_X[:], TL3_UP[:], TL3_Y[:], TL3_DX[:], "cut to max_len 6"},
	}
	for c in lr_cases {
		x := leaf(c.x, {3, 5, 4, 1})
		y, lengths := t.tensor_length_regulate(x, TL_DUR[:], c.max_len)
		t.tensor_backward_with_grad(y, c.up)
		d := max(diff(y.data.data, c.y), diff(x.grad.data, c.dx))
		lengths_ok := len(lengths) == 3
		for n, b in lengths {lengths_ok &&= n == c.lengths[b]}
		expect(
			&passed,
			&total,
			y.shape == [4]int{3, c.T_out, 4, 1} && lengths_ok && d < 1e-15,
			fmt.tprintf(
				"length regulator (%s): output %v, lengths %v, output and gradient vs torch repeat_interleave %.1e",
				c.name,
				y.shape,
				lengths,
				d,
			),
		)
	}

	// 9. concatenation along time is tensor_concat with dim 1
	{
		a := leaf(TC_A[:], {2, 3, 4, 1})
		b := leaf(TC_B[:], {2, 5, 4, 1})
		y := t.tensor_concat([]^t.Tensor{a, b}, 1)
		t.tensor_backward_with_grad(y, TC_UP[:])
		d := max(
			diff(y.data.data, TC_Y[:]),
			diff(a.grad.data, TC_DA[:]),
			diff(b.grad.data, TC_DB[:]),
		)
		expect(
			&passed,
			&total,
			y.shape == [4]int{2, 8, 4, 1} && d < 1e-15,
			fmt.tprintf(
				"tensor_concat along time (3 + 5 steps): output %v, output and gradients vs torch.cat %.1e",
				y.shape,
				d,
			),
		)
	}

	fmt.printf("time indexing: %d/%d passed\n", passed, total)
	record_failures(total - passed)
}
