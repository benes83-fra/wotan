ml_tree_classifier_test :: proc(allocator: mem.Allocator) {
	seed_test(#procedure)
	fmt.println("\n=== ML Tree Classifiers (DT / RF / GB vs sklearn) ===")
	context.allocator = allocator
	passed, total := 0, 0
	expect :: proc(passed, total: ^int, ok: bool, name: string) {
		total^ += 1
		if ok {passed^ += 1}
		fmt.printf("%s %s\n", "OK  " if ok else "FAIL", name)
	}
	close :: proc(got, want: []f64, atol: f64) -> bool {
		if len(got) != len(want) do return false
		for g, i in got {if !(math.abs(g - want[i]) <= atol) do return false}
		return true
	}

	X := l.Matrix(f64) {
		data = CLS_X[:],
		rows = 40,
		cols = 3,
	}
	y3 := CLS_Y3[:]
	yb := CLS_YB[:]

	// --- decision trees ---
	dg := ml.dt_fit(&X, y3, {max_depth = 3, min_samples = 2, criterion = .Gini})
	pg := ml.dt_predict_proba(&dg, &X)
	expect(
		&passed,
		&total,
		close(pg.data, REF_GINI3[:], 1e-15),
		"DT gini depth 3: predict_proba = sklearn",
	)
	expect(
		&passed,
		&total,
		close(dg.classes, {-1.5, 0.5, 2.0}, 0),
		"DT classes sorted, labels kept (-1.5, 0.5, 2.0)",
	)
	de := ml.dt_fit(&X, y3, {max_depth = 100, min_samples = 2, criterion = .Entropy})
	pe := ml.dt_predict_proba(&de, &X)
	expect(
		&passed,
		&total,
		close(pe.data, REF_ENT[:], 1e-15),
		"DT entropy (full depth): predict_proba = sklearn",
	)
	expect(
		&passed,
		&total,
		close(ml.dt_predict(&de, &X), REF_ENT_PRED[:], 0),
		"DT entropy: predict = sklearn",
	)

	// --- random forest ---
	rf0 := ml.rf_fit(
		&X,
		y3,
		{n_trees = 4, max_features = 3, max_depth = 3, min_samples = 2, criterion = .Gini},
	)
	p0 := ml.rf_predict_proba(&rf0, &X)
	expect(
		&passed,
		&total,
		close(p0.data, REF_GINI3[:], 1e-15),
		"RF without bootstrap / feature sampling = the single tree",
	)
	ml.rf_free(&rf0)
	rf := ml.rf_fit(
		&X,
		y3,
		{
			n_trees = 60,
			max_depth = 5,
			min_samples = 2,
			bootstrap = true,
			oob_score = true,
			criterion = .Gini,
		},
	)
	pr := ml.rf_predict_proba(&rf, &X)
	yr := ml.rf_predict(&rf, &X)
	soft_ok := true
	for i in 0 ..< X.rows {
		row := pr.data[i * 3:(i + 1) * 3]
		if math.abs(row[0] + row[1] + row[2] - 1) > 1e-12 do soft_ok = false
		best := 0
		for k in 1 ..< 3 {if row[k] > row[best] do best = k}
		if yr[i] != rf.classes[best] do soft_ok = false
	}
	expect(
		&passed,
		&total,
		soft_ok,
		"RF: probabilities sum to 1, predict = argmax of mean probability",
	)
	expect(
		&passed,
		&total,
		rf.oob_score >= 0.35 && rf.oob_score <= 0.7,
		fmt.tprintf(
			"RF oob accuracy %.3f within sklearn's range over 30 seeds (0.40-0.625)",
			rf.oob_score,
		),
	)
	ml.rf_free(&rf)

	// --- gradient boosting ---
	g2 := ml.gb_fit(
		&X,
		yb,
		{
			n_estimators = 20,
			learning_rate = 0.1,
			max_depth = 2,
			min_samples = 2,
			subsample = 1,
			loss = .Log_Loss,
		},
	)
	p2 := ml.gb_predict_proba(&g2, &X)
	expect(
		&passed,
		&total,
		close(p2.data, REF_GB2[:], 1e-12),
		"GB log loss, binary: predict_proba = sklearn",
	)
	ml.gb_free(&g2)
	g3 := ml.gb_fit(
		&X,
		y3,
		{
			n_estimators = 15,
			learning_rate = 0.2,
			max_depth = 2,
			min_samples = 2,
			subsample = 1,
			loss = .Log_Loss,
		},
	)
	p3 := ml.gb_predict_proba(&g3, &X)
	expect(
		&passed,
		&total,
		close(p3.data, REF_GB3[:], 1e-12),
		"GB log loss, 3 classes (softmax): predict_proba = sklearn",
	)
	expect(
		&passed,
		&total,
		close(ml.gb_predict(&g3, &X), REF_GB3_PRED[:], 0),
		"GB 3 classes: predict = sklearn",
	)
	ml.gb_free(&g3)

	// --- serialization ---
	path := "ml_tree_classifier_test_model.wotan"
	defer os.remove(path)
	roundtrip :: proc(pipe: ^ml.Pipeline, X: ^l.Matrix(f64), y: []f64, path: string) -> bool {
		ml.pipeline_fit(pipe, X, y)
		before := ml.pipeline_predict(pipe, X)
		if !ml.pipeline_save(pipe, path) do return false
		loaded, ok := ml.pipeline_load(path)
		defer ml.pipeline_free(&loaded)
		if !ok do return false
		after := ml.pipeline_predict(&loaded, X)
		for v, i in before {if transmute(u64)v != transmute(u64)after[i] do return false}
		return true
	}
	pd := ml.pipeline_new()
	ml.pipeline_set_decision_tree(&pd, {max_depth = 4, min_samples = 2, criterion = .Entropy})
	expect(
		&passed,
		&total,
		roundtrip(&pd, &X, y3, path),
		"Classification tree save/load is bit-exact",
	)
	ml.pipeline_free(&pd)
	pf := ml.pipeline_new()
	ml.pipeline_set_random_forest(
		&pf,
		{n_trees = 8, max_depth = 4, min_samples = 2, bootstrap = true, criterion = .Gini},
	)
	expect(
		&passed,
		&total,
		roundtrip(&pf, &X, y3, path),
		"Classification forest save/load is bit-exact",
	)
	ml.pipeline_free(&pf)
	pb := ml.pipeline_new()
	ml.pipeline_set_gradient_boosting(
		&pb,
		{
			n_estimators = 8,
			learning_rate = 0.2,
			max_depth = 2,
			min_samples = 2,
			subsample = 0.8,
			loss = .Log_Loss,
		},
	)
	expect(
		&passed,
		&total,
		roundtrip(&pb, &X, y3, path),
		"Log-loss boosting save/load is bit-exact",
	)
	ml.pipeline_free(&pb)

	ml.dt_free(&dg)
	ml.dt_free(&de)
	fmt.printf("ML tree classifier summary: %d/%d passed\n", passed, total)
	record_failures(total - passed)
}
