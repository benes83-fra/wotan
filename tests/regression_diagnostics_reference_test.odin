DG_X := [?]f64{1.0, -0.39186984192721785, 0.0, 1.0, 0.04992040152334534, 0.0, 1.0, -0.16519016568439276, 1.0, 1.0, -0.16796939015046086, 1.0, 1.0, 0.06261587751175876, 0.0, 1.0, -0.2257110813270981, 0.0, 1.0, 0.2969227725915538, 0.0, 1.0, -0.0488928601357681, 1.0, 1.0, 0.5680696849093915, 0.0, 1.0, -0.6570321512472709, 0.0, 1.0, -0.36065998913515956, 0.0, 1.0, -0.8560830468147574, 1.0, 1.0, -1.6699613153859187, 0.0, 1.0, -2.2324993797182415, 0.0, 1.0, 0.06011966573083541, 0.0, 1.0, -0.8305089208950167, 0.0, 1.0, -0.7551370241324996, 0.0, 1.0, -0.5807141142442936, 0.0, 1.0, 0.41772361621879156, 1.0, 1.0, 0.5678085702934009, 1.0, 1.0, 0.6860170259645172, 1.0, 1.0, 0.9247965351503759, 1.0, 1.0, 2.9825211297644363, 0.0, 1.0, 0.2947190698353022, 0.0, 1.0, 0.1543671895776007, 0.0, 1.0, -2.182201585413012, 1.0, 1.0, -1.6840606356409922, 0.0, 1.0, 2.192950883395955, 0.0, 1.0, 2.7457863435768988, 1.0, 1.0, 0.44634547717970313, 1.0, 1.0, -0.08028189799892683, 1.0, 1.0, 0.557088849689639, 0.0, 1.0, -2.035279763150223, 1.0, 1.0, -0.5306071528504179, 0.0, 1.0, -0.4054187209770992, 1.0, 1.0, 1.7354992811557899, 0.0, 1.0, -0.9912403474545024, 0.0, 1.0, 0.3630207876346192, 0.0, 1.0, 0.7241023328626138, 1.0, 1.0, 1.0803153500640994, 1.0, 1.0, -0.42902964007139516, 0.0, 1.0, -0.6870694369346098, 1.0, 1.0, -2.176754060698025, 0.0, 1.0, 1.1475875882530329, 1.0, 1.0, 1.1822000085319717, 1.0, 1.0, -0.48993174625983293, 1.0, 1.0, 0.2311326140733636, 1.0, 1.0, -1.3960603618444776, 0.0, 1.0, -0.20926738944329235, 1.0, 1.0, 0.727569904568733, 0.0, 1.0, -0.4834008076774047, 0.0, 1.0, 0.063086917778475, 0.0, 1.0, 1.0999758084019655, 0.0, 1.0, 0.6004352300822452, 0.0, 1.0, -0.6128311949099872, 0.0, 1.0, 1.6147384501822435, 1.0, 1.0, 1.7746049045987535, 0.0, 1.0, 1.0034774109319793, 0.0, 1.0, 0.600669083829522, 1.0, 1.0, 0.715768362012354, 0.0, 1.0, 0.881849698871554, 0.0, 1.0, -1.2626722080098831, 0.0, 1.0, 1.079539146589146, 0.0, 1.0, -0.8404778884413265, 1.0, 1.0, 0.20007064978275851, 0.0, 1.0, -0.09887990363746195, 0.0, 1.0, 0.4747207458982391, 0.0, 1.0, 1.7586005225833379, 0.0, 1.0, 0.5328708987333687, 1.0, 1.0, -0.11857030102266883, 0.0, 1.0, 0.6695577234931344, 0.0, 1.0, 0.11588640746924374, 1.0, 1.0, -1.6537599883688663, 0.0, 1.0, -1.8111469829351374, 0.0, 1.0, -0.5333590032294453, 0.0, 1.0, 1.9909196988576745, 1.0, 1.0, -0.2809960162428199, 0.0, 1.0, 0.6554372397249413, 0.0, 1.0, 1.2773596802356935, 0.0, 1.0, -1.330326691881603, 1.0, 1.0, 1.347824851639273, 1.0, 1.0, 0.8509844414473512, 1.0, 1.0, 0.534644509390344, 0.0, 1.0, 0.9587398146236379, 0.0, 1.0, -2.0711917249528926, 0.0, 1.0, 0.16008423462141808, 0.0, 1.0, -1.5632547813990356, 0.0, 1.0, 0.32948806583472684, 1.0, 1.0, -0.19052748435405345, 0.0, 1.0, -0.4476879275817809, 1.0, 1.0, 0.5675824183810106, 1.0, 1.0, -1.7889043997707288, 1.0, 1.0, 0.06666839128944355, 1.0, 1.0, 2.1733472242606235, 1.0, 1.0, 1.0277254501831743, 0.0, 1.0, -0.9673380921852591, 0.0, 1.0, 0.41486812146366947, 0.0, 1.0, -0.18018908446864718, 1.0, 1.0, 0.49346116109075816, 1.0, 1.0, -1.1917397367420486, 0.0, 1.0, 0.471111153616468, 1.0, 1.0, 0.0006437947992057308, 0.0, 1.0, -1.170460481432893, 0.0, 1.0, 0.6986120607901634, 1.0, 1.0, 1.3711069930309434, 1.0, 1.0, 1.1537029901339637, 0.0, 1.0, -2.640597739525694, 1.0, 1.0, 0.3481339798862803, 0.0, 1.0, 0.3652758862698117, 1.0, 1.0, -0.1941492203877895, 0.0, 1.0, -0.17512483422525996, 1.0, 1.0, 0.42703368559418636, 1.0, 1.0, 0.6741764149976799, 0.0, 1.0, -0.7262088928595155, 1.0, 1.0, 0.21876308757354118, 1.0, 1.0, -0.2365856281025197, 1.0, 1.0, -0.750881143263351, 0.0, 1.0, 0.3725793440072543, 1.0, 1.0, -0.5755046711661017, 1.0, 1.0, -1.7655454461073903, 0.0}
@(private = "file")
DG_Y := [?]f64{0.02975618968733862, 0.6405390035640481, 0.21131410188157806, -0.8414155194410866, 1.6394360684682718, 0.9752721040928503, 0.27329726626378603, -1.7756701554623895, 1.1269398020417667, 0.22843052089894367, 0.021311647939301598, -1.3997313369813913, -1.991680935127528, -1.319667830202282, 1.1818735145945698, -1.8262725365870167, -0.1098553107084147, -0.011929585977452084, 0.6877995578273672, -0.017794193288560356, 1.2217311871500716, 2.7571034393970058, -5.993495095715339, 6.436722247429419, 2.8308616247447684, -2.1843429130345813, -1.6338674071902581, 2.662220876582055, 3.403790995476826, 0.22019802400492774, -1.5393188349437712, 1.7435348049375878, -2.1241693001654514, 0.6530799713339285, -2.2014955602655437, 3.4919955959942883, -1.3531416318249574, 1.4109271268767047, 1.1395984131258485, 2.9053190541352434, 3.039044881781785, 4.3382888463768285, -24.935366707000785, 36.79238567988915, 52.858694140101406, 17.910427065397936, 29.452220803942502, 23.371136744416578, 19.18451675937108, 22.18060207268941, -2.470587458326137, 0.24796057546789108, 0.34582250615475196, 2.1954285671890954, 0.0952042519666505, 2.4666807469061394, 1.4034214384422106, -0.12346909709446141, 0.5128349828874624, 2.402627058290334, -0.3413646212297412, -6.570451296587299, -5.486361115673505, 6.996625223559157, 5.105488091806672, 6.972019074238178, 2.1859967809794547, 0.9943128880859997, -0.6396304579908885, 0.38429250244265883, 0.5974684566643311, -0.16610455827305284, -1.4388813338988224, -1.8157090516348375, 0.1814672249140048, 0.4641053875744934, -1.9703664346660934, 1.7880224208360846, 2.475378056075163, -0.990590446209296, 3.030794221796322, 5.88832353872062, 7.932594449251699, 17.42405083029256, 4.204187023088371, 8.10554781402006, 6.330027428298721, -0.7922251546920335, -0.2798808008343439, -1.2239589819749348, -0.2339631711140986, -3.55517527504318, 1.5538915027291889, -0.4256750993219143, -0.002969342712819234, -7.289823448284838, -6.65446341243932, -2.1244753406023116, 1.679047003632828, -3.255136748626909, -0.40574878059071073, -0.25352802150517406, -1.0704936573757466, -0.022341014914580848, 1.1552760995586409, 2.059061310264323, -3.3482598004574546, 1.8789061830643505, 1.3046685851964805, 1.374981118371012, -2.08458398243547, 1.809475009254051, 3.0657824396623927, 3.032212429613849, -0.1661719137651554, -0.30546020679577807, 1.5010209726551376, 1.5324261501706102, 0.014235360928202101, -0.13009370605211146}

regression_diagnostics_reference_test :: proc(allocator: mem.Allocator) {
	seed_test(#procedure)
	fmt.println("\n=== Regression residual diagnostics vs statsmodels ===")
	context.allocator = allocator
	passed, total := 0, 0
	expect :: proc(passed, total: ^int, ok: bool, name: string) {
		total^ += 1
		if ok {passed^ += 1}
		fmt.printf("%s %s\n", "OK  " if ok else "FAIL", name)
	}
	near :: proc(got, want: f64) -> bool {return math.abs(got - want) <= 1e-9 * max(1, math.abs(want))}

	X := l.Matrix(f64){data = DG_X[:], rows = 120, cols = 3}
	fit := ml.ols_fit(&X, DG_Y[:])
	e := fit.residuals
	expect(&passed, &total, near(ts.durbin_watson(e), 0.9571850264769671), fmt.tprintf("Durbin-Watson %.4f = statsmodels", ts.durbin_watson(e)))
	{
		r := ts.arch_lm_test(e, 4)
		expect(&passed, &total, near(r.lm, 35.5095874167824) && near(r.lm_pvalue, 3.6500881819995013e-07) && near(r.f_stat, 12.242340661341915) && near(r.f_pvalue, 2.7951249889334712e-08), "ARCH-LM (4 lags) = statsmodels")
	}
	{
		r := ts.arch_lm_test(e)
		expect(&passed, &total, near(r.lm, 34.79701262114099) && near(r.lm_pvalue, 0.0001352245214274285) && near(r.f_stat, 4.5808077173027115) && near(r.f_pvalue, 2.4317121404261106e-05), "ARCH-LM (default lags min(10, n/5)) = statsmodels")
	}
	{
		r := ts.arch_lm_test(e, 3, 2)
		expect(&passed, &total, near(r.lm, 34.98924854174813) && near(r.lm_pvalue, 1.2246381033419103e-07) && near(r.f_stat, 16.471890811159923) && near(r.f_pvalue, 6.022977675800883e-09), "ARCH-LM (3 lags, ddof 2) = statsmodels")
	}
	{
		r := ts.breusch_pagan_test(e, &X)
		expect(&passed, &total, near(r.lm, 2.643520580441696) && near(r.lm_pvalue, 0.26666547993903295) && near(r.f_stat, 1.3177453406979625) && near(r.f_pvalue, 0.2716819929325545), "Breusch-Pagan (Koenker, robust) = statsmodels")
	}
	{
		r := ts.breusch_pagan_test(e, &X, false)
		expect(&passed, &total, near(r.lm, 20.282965151900726) && near(r.lm_pvalue, 3.941033068309115e-05) && near(r.f_stat, 1.317745340697947) && near(r.f_pvalue, 0.2716819929325585), "Breusch-Pagan (original, robust = false) = statsmodels")
	}
	{
		r := ts.white_test(e, &X)
		expect(&passed, &total, near(r.lm, 5.775092668616657) && near(r.lm_pvalue, 0.21658587951231537) && near(r.f_stat, 1.4535701372121923) && near(r.f_pvalue, 0.22097723504741995), "White (dummy regressor: collinear products, df from the rank) = statsmodels")
	}
	{
		r := ts.breusch_godfrey_test(e, &X, 3)
		expect(&passed, &total, near(r.lm, 39.89494330910809) && near(r.lm_pvalue, 1.1215676758974443e-08) && near(r.f_stat, 18.925245276288276) && near(r.f_pvalue, 4.974159150394564e-10), "Breusch-Godfrey (3 lags, with regressors) = statsmodels")
	}
	{
		r := ts.breusch_godfrey_test(e, &X)
		expect(&passed, &total, near(r.lm, 45.201138456529264) && near(r.lm_pvalue, 2.0003378039882746e-06) && near(r.f_stat, 6.466036668269067) && near(r.f_pvalue, 9.715637772240283e-08), "Breusch-Godfrey (default lags) = statsmodels")
	}

	fmt.printf("Regression diagnostics summary: %d/%d passed\n", passed, total)
	record_failures(total - passed)
}
