// American options against QuantLib 1.44: converged finite-difference prices and
// Greeks (FdBlackScholesVanillaEngine, 2000 x 2000) for the trees and the FD
// solver, Black-Scholes for Crank-Nicolson, the Bermudan FD price for
// Longstaff-Schwartz; numpy for the Householder least squares.
american_options_reference_test :: proc(allocator: mem.Allocator) {
	seed_test(#procedure)
	fmt.println("\n=== American options: trees, finite differences, LSM (QuantLib reference) ===")
	context.allocator = allocator
	passed, total := 0, 0
	expect :: proc(passed, total: ^int, ok: bool, name: string) {
		total^ += 1
		if ok {passed^ += 1}
		fmt.printf("%s %s\n", "OK  " if ok else "FAIL", name)
	}
	r := 0.05

