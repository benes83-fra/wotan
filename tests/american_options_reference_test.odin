		{100.0, 2.0, 0.4, 1.0, 17.991873798533497, -0.3589771450540269, 0.007580668615015972, -3.3719239724723686, 16.773981635344228, -0.32289471306013273, 0.006345454319642659, -2.6231908086462528},
		{120.0, 0.25, 0.2, 0.0, 0.19976520458256317, 0.04965420435922816, 0.010256628363337447, -2.274162739139194, 0.19976435000036247, 0.04965422165668527, 0.010256630490630591, -2.289608988909528},
		{120.0, 0.25, 0.2, 1.0, 19.999999999999964, -1.0000000000011346, -2.2802922217124434e-11, 0.0, 18.709100409266146, -0.9503457783433149, 0.010256630490630591, 3.6358578140537765},
		{120.0, 0.25, 0.4, 0.0, 2.390991281487985, 0.22689636468362687, 0.015066980409634905, -13.071284728097432, 2.3909896775936192, 0.2268961219006347, 0.015066944469201326, -13.068486700984561},
		{120.0, 0.25, 0.4, 1.0, 21.34425360128845, -0.8008568298478014, 0.01664075974631185, -8.243607120514946, 20.900325736859397, -0.7731038780993652, 0.015066944469201326, -7.143019898021258},
		{120.0, 1.0, 0.2, 0.0, 3.2474819668512347, 0.28719195049351565, 0.017036958496564204, -4.680503684026087, 3.247477416560818, 0.287191637905127, 0.017036921138505082, -4.6809685463986135},
		{120.0, 1.0, 0.2, 1.0, 20.135474731590193, -0.9084638152107999, 0.03023083254938158, -0.49572917864072935, 17.39500835664649, -0.7128083620948729, 0.017036921138505082, 1.0264080006056782},
		{120.0, 1.0, 0.4, 0.0, 10.805990035765877, 0.44796617235167896, 0.009888629116179357, -9.614849467329119, 10.805973916005637, 0.44796522204682254, 0.009888598853894308, -9.610406497549281},
		{120.0, 1.0, 0.4, 1.0, 26.228785462036242, -0.5983933619192127, 0.011676542943701393, -5.041754817764718, 24.9535048560913, -0.5520347779531776, 0.009888598853894308, -3.9030299505449886},
		{120.0, 2.0, 0.2, 0.0, 7.9282262337180995, 0.440529235445942, 0.013947761475962864, -4.596118439075501, 7.9282128864703845, 0.4405285455758376, 0.013947725081644942, -4.59577709988466},
		{120.0, 2.0, 0.2, 1.0, 20.680934537560645, -0.7982290580147106, 0.027744676612698943, -0.523882343076425, 16.50870305078552, -0.5594714544241624, 0.013947725081644942, 0.8332474083311006},
		{120.0, 2.0, 0.4, 0.0, 19.174356681100896, 0.5546116014439565, 0.006986220993364253, -7.40538784372568, 19.174316369367162, 0.5546100352632287, 0.006986192277673337, -7.403288179986459},
		{120.0, 2.0, 0.4, 1.0, 30.199353842102717, -0.5110199357828149, 0.009049897214132878, -3.176484883173781, 27.754806533682306, -0.4453899647367714, 0.006986192277673337, -1.974263671770697},
	}
	{
		worst_a, worst_e: [4]f64
		for row in FD {
			o := fin.OptionType.Call if row[3] == 0 else .Put
			a := fin.finite_difference_american(100, row[0], row[1], r, row[2], o, 200, 200)
			e := fin.crank_nicolson_european(100, row[0], row[1], r, row[2], o, 200, 200)
			for v, k in ([4]f64{a.price, a.delta, a.gamma, a.theta}) {worst_a[k] = max(worst_a[k], abs(v - row[4 + k]))}
			for v, k in ([4]f64{e.price, e.delta, e.gamma, e.theta}) {worst_e[k] = max(worst_e[k], abs(v - row[8 + k]))}
		}
		tol_a := [4]f64{2e-2, 1e-3, 1e-4, 4e-2}
		tol_e := [4]f64{1.5e-2, 1e-3, 1e-4, 6e-2}
		ok_a, ok_e := true, true
		for k in 0 ..< 4 {
			ok_a &&= worst_a[k] < tol_a[k]
			ok_e &&= worst_e[k] < tol_e[k]
		}
		expect(&passed, &total, ok_a, fmt.tprintf("American FD (200 x 200), 36 options: price %.1e (QuantLib FD at 200 x 200: 1.2e-2) delta %.1e gamma %.1e theta %.1e (were 4.4e-2, 4.0e-2, 1.0e-2, 8.0)", worst_a[0], worst_a[1], worst_a[2], worst_a[3]))
		expect(&passed, &total, ok_e, fmt.tprintf("Crank-Nicolson European (200 x 200) vs Black-Scholes: price %.1e delta %.1e gamma %.1e theta %.1e (were 1.4e-2, 9.9e-3, 1.0e-2, 7.4)", worst_e[0], worst_e[1], worst_e[2], worst_e[3]))
	}

	// --- Longstaff-Schwartz: Bermudan put with 10 exercise dates (QuantLib FD) ---
	{
		BERM := [?][6]f64{{90.0, 2.4457112455612053, -0.20585208894020293, 0.015286402076123758, 28.03776147194794, -1.9073858511379542}, {100.0, 6.033636284152507, -0.40806728426813654, 0.02289913511857604, 37.432908647010784, -2.2401375949532243}, {110.0, 11.877789930102752, -0.6515183267175056, 0.027513462835439678, 33.70100057288674, -1.6576389819230721}}
		SD := [?][5]f64{{0.0163, 0.0041, 0.00073, 1.22, 0.113}, {0.023, 0.0094, 0.0014, 1.6, 0.153}, {0.0361, 0.0129, 0.0025, 1.89, 0.242}}
		ok := true
		desc := ""
		for row, i in BERM {
			rand.reset(u64(31 + i))
			v := fin.lsm_american_vanilla_reduced(100, row[0], 1, r, 0.2, .Put, 20000, 50, 10)
			got := [5]f64{v.price, v.delta, v.gamma, v.vega, v.theta}
			for g, k in got {ok &&= abs(g - row[1 + k]) < 4 * SD[i][k]}
			desc = fmt.tprintf("%s | K=%.0f gamma %.4f (ref %.4f) theta %.3f (ref %.3f)", desc, row[0], v.gamma, row[3], v.theta, row[5])
		}
		expect(&passed, &total, ok, fmt.tprintf("variance-reduced LSM price, delta, gamma, vega, theta within 4 sd of the Bermudan%s (gamma was 3/16 of it, theta had the wrong sign)", desc))

		rand.reset(41)
		p := fin.lsm_american_put(100, 100, 1, r, 0.2, 20000, 50, 10)
		ok_p := abs(p.price - BERM[1][1]) < 4 * 1.4 * SD[1][0] && abs(p.delta - BERM[1][2]) < 4 * 1.4 * SD[1][1] && abs(p.gamma - BERM[1][3]) < 4 * 1.4 * SD[1][2] && p.theta < 0
		expect(&passed, &total, ok_p, fmt.tprintf("plain LSM put: price %.4f delta %.4f gamma %.4f theta %.3f (Bermudan %.4f %.4f %.4f %.3f)", p.price, p.delta, p.gamma, p.theta, BERM[1][1], BERM[1][2], BERM[1][3], BERM[1][5]))

		// One exercise date: the control variate is the payoff itself, so the
		// estimate is the Black-Scholes price exactly
		eu := fin.lsm_american_vanilla_reduced(100, 100, 1, r, 0.2, .Put, 1000, 50, 1)
		expect(&passed, &total, abs(eu.price - 5.573526022256967) < 1e-10, fmt.tprintf("LSM with one exercise date + control variate = Black-Scholes (%.10f)", eu.price))

		// Deep in the money: exercise at t = 0 is worth more than waiting
		deep := fin.lsm_american_put(100, 160, 1, r, 0.2, 2000, 20, 5)
		expect(&passed, &total, deep.price >= 60, fmt.tprintf("LSM includes exercise at t = 0 (deep ITM put %.4f >= intrinsic 60)", deep.price))

		// 50 steps / 15 dates (not a multiple) and an odd path count used to write
		// past the path buffers
		odd := fin.lsm_american_vanilla_reduced(100, 100, 1, r, 0.2, .Put, 2001, 50, 15)
		as := fin.lsm_american_asian_call(100, 100, 1, r, 0.2, 2001, 50, 15)
		expect(&passed, &total, odd.price > 5 && odd.price < 7 && as.price > 0, fmt.tprintf("n_steps not a multiple of the exercise dates and odd n_paths work (%.4f, Asian %.4f)", odd.price, as.price))
	}

	// --- linalg.lstsq (QR) on a tall problem: Householder without forming Q ---
	{
		rand.reset(5)
		X := l.matrix_new(f64, 20000, 4)
		defer l.matrix_free(&X)
		y := make([]f64, 20000)
		defer delete(y)
		B := [4]f64{0.5, -1.2, 2.0, 0.3}
		for i in 0 ..< 20000 {
			X.data[i * 4] = 1
			for j in 1 ..< 4 {X.data[i * 4 + j] = rand.float64_normal(0, 1)}
			y[i] = X.data[i * 4] * B[0] + X.data[i * 4 + 1] * B[1] + X.data[i * 4 + 2] * B[2] + X.data[i * 4 + 3] * B[3] + rand.float64_normal(0, 0.1)
		}
		q := l.lstsq(&X, y, .QR)
		c := l.lstsq(&X, y, .Cholesky)
		defer {l.lstsq_result_free(&q, context.allocator); l.lstsq_result_free(&c, context.allocator)}
		gap := 0.0
		for v, j in q.beta {gap = max(gap, abs(v - c.beta[j]))}
		expect(&passed, &total, gap < 1e-12 && q.rank == 4, fmt.tprintf("lstsq QR on 20000 x 4 equals the normal equations to %.1e (used to build a 20000 x 20000 Q)", gap))
	}

	fmt.printf("American options summary: %d/%d passed\n", passed, total)
	record_failures(total - passed)
}
