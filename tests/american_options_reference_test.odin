	{
		worst_b, worst_t: [4]f64
		for row in TREE {
			o := fin.OptionType.Call if row[4] == 0 else .Put
			b := fin.american_option_binomial(100, row[0], row[1], r, row[2], row[3], o, 1000)
			t := fin.american_option_trinomial(100, row[0], row[1], r, row[2], row[3], o, 1000)
			for v, k in ([4]f64{b.price, b.delta, b.gamma, b.theta}) {worst_b[k] = max(worst_b[k], abs(v - row[5 + k]))}
			for v, k in ([4]f64{t.price, t.delta, t.gamma, t.theta}) {worst_t[k] = max(worst_t[k], abs(v - row[5 + k]))}
		}
		tol := [4]f64{1e-2, 3e-4, 2e-4, 6e-2}
		ok_b, ok_t := true, true
		for k in 0 ..< 4 {ok_b &&= worst_b[k] < tol[k]; ok_t &&= worst_t[k] < tol[k]}
		expect(&passed, &total, ok_b, fmt.tprintf("CRR binomial (1000 steps), 72 calls/puts with and without dividends: max error price %.1e delta %.1e gamma %.1e theta %.1e", worst_b[0], worst_b[1], worst_b[2], worst_b[3]))
		expect(&passed, &total, ok_t, fmt.tprintf("trinomial (1000 steps): price %.1e delta %.1e gamma %.1e theta %.1e (the doubled variance gave errors up to 21)", worst_t[0], worst_t[1], worst_t[2], worst_t[3]))
		c := fin.american_call_binomial(100, 100, 1, r, 0.2)
		ct := fin.american_call_trinomial(100, 100, 1, r, 0.2)
		expect(&passed, &total, abs(c.early_exercise_premium) < 1e-12 && abs(ct.early_exercise_premium) < 1e-12, "no early-exercise premium for calls without dividends")
	}

