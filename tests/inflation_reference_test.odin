@(private = "file")
IN_EVAL :: 45730

@(private = "file")
_in_date :: proc(serial: f64) -> w.Date {
	return w.civil_from_days(i64(serial) - 25569)
}

inflation_reference_test :: proc(allocator: mem.Allocator) {
	seed_test(#procedure)
	fmt.println(
		"\n=== Inflation: zero-inflation curve, CPI forecasts, zero-coupon swaps, inflation-linked bond (QuantLib reference) ===",
	)
	context.allocator = allocator
	passed, total := 0, 0
	expect :: proc(passed, total: ^int, ok: bool, name: string) {
		total^ += 1
		if ok {passed^ += 1}
		fmt.printf("%s %s\n", "OK  " if ok else "FAIL", name)
	}

	eval := _in_date(IN_EVAL)
	months := make([]w.Date, len(IN_FIX))
	for &m, i in months {m = w.add_month_date({2023, 1, 1}, i32(i))}
	quotes := make([]fin.ZCISQuote, len(IN_QUOTES) / 2)
	for &q, i in quotes {q = {{int(IN_QUOTES[2 * i]), .Years}, IN_QUOTES[2 * i + 1]}}
	nominal := fin.YieldCurve {
		tenors         = {1.0},
		zero_rates     = {0.025},
		reference_date = eval,
	}
	names := [2]string{"Flat", "Linear"}

	for interp in fin.CPIInterpolation {
		ii := int(interp)
		index := fin.CPIIndex{months, IN_FIX[:], nil}
		curve := fin.bootstrap_zero_inflation_curve(
			&index,
			eval,
			{2025, 1, 1},
			quotes,
			3,
			interp,
			{.TARGET},
		)
		defer fin.free_zero_inflation_curve(&curve)
		index.curve = &curve
		cv := IN_CURVES[12 * ii:12 * ii + 12]

		// 1. curve and forecasts
		pillars_ok := true
		worst_z, worst_f := 0.0, 0.0
		for m, i in curve.months {pillars_ok &&= m == _in_date(cv[i])}
		for z, i in curve.rates {worst_z = max(worst_z, abs(z - cv[6 + i]))}
		for d, i in IN_FDATES {
			worst_f = max(
				worst_f,
				abs(fin.cpi_fixing(&index, _in_date(d)) - IN_FCST[len(IN_FDATES) * ii + i]),
			)
		}
		expect(
			&passed,
			&total,
			pillars_ok && worst_z < 1e-11 && worst_f < 1e-9,
			fmt.tprintf(
				"%s observation, 3M lag: zero-inflation curve from 6 swap quotes 1Y-20Y vs QuantLib PiecewiseZeroInflation: pillar months %v, max zero-rate diff %.1e; %d HICP forecasts 2025-2046 max diff %.1e",
				names[ii],
				pillars_ok,
				worst_z,
				len(IN_FDATES),
				worst_f,
			),
		)

		// 2. zero-coupon swaps (new 5Y / 7Y, seasoned 2Y)
		worst := 0.0
		for k in 0 ..< 3 {
			s := IN_SWAPS[21 * ii + 7 * k:]
			sw := fin.ZeroCouponInflationSwap {
				notional      = 1e6,
				fixed_rate    = s[2],
				start         = _in_date(s[0]),
				maturity      = _in_date(s[1]),
				lag_months    = 3,
				interpolation = interp,
				calendar      = {.TARGET},
				convention    = .ModifiedFollowing,
				day_count     = .ACT_365,
			}
			inf, fix, _ := fin.zcis_cashflows(sw, &index)
			npv := fin.zcis_npv(sw, &index, &nominal)
			fair := fin.zcis_fair_rate(sw, &index)
			worst = max(
				worst,
				abs(fix - s[3]) / 1e6,
				abs(inf - s[4]) / 1e6,
				abs(npv - s[5]) / 1e6,
				abs(fair - s[6]),
			)
		}
		expect(
			&passed,
			&total,
			worst < 1e-11,
			fmt.tprintf(
				"%s observation: 5Y and 7Y zero-coupon inflation swaps and a seasoned 2Y (from 15 Jun 2024, fixings in the past) vs QuantLib ZeroCouponInflationSwap: fixed / inflation legs, NPV per notional, fair rate max diff %.1e",
				names[ii],
				worst,
			),
		)

		// 3. inflation-linked bond on the Linear curve
		if interp == .Linear {
			sch := fin.make_schedule(
				{2024, 4, 15},
				{2034, 4, 15},
				{6, .Months},
				{.TARGET},
				.Unadjusted,
				.Unadjusted,
			)
			defer fin.free_schedule(&sch)
			b := fin.InflationLinkedBond {
				100,
				0.0125,
				IN_BOND[0],
				sch,
				.ACT_ACT_ICMA,
				.ModifiedFollowing,
				3,
				.Linear,
			}
			flows := fin.inflation_linked_bond_cashflows(b, &index)
			cf := IN_BOND[3:]
			ok := len(flows) == len(cf) / 2
			worst_cf := 0.0
			if ok {
				for f, i in flows {
					ok &&= f.payment_date == _in_date(cf[2 * i])
					worst_cf = max(worst_cf, abs(f.amount - cf[2 * i + 1]))
				}
			}
			settle := fin.calendar_advance({.TARGET}, eval, 2, .Days)
			dirty := fin.inflation_linked_bond_dirty_price(b, &index, &nominal, settle)
			ok &&=
				settle == _in_date(IN_BOND[1]) &&
				worst_cf < 1e-10 &&
				abs(dirty - IN_BOND[2]) < 1e-9
			expect(
				&passed,
				&total,
				ok,
				fmt.tprintf(
					"1.25%% 10Y inflation-linked bond (semiannual ACT/ACT ICMA, base CPI %.2f, linear 3M-lagged index) vs QuantLib CPIBond: %d indexed cash flows max diff %.1e, dirty price %.8f (%.8f)",
					IN_BOND[0],
					len(flows),
					worst_cf,
					dirty,
					IN_BOND[2],
				),
			)
		}
	}

	fmt.printf("Inflation summary: %d/%d passed\n", passed, total)
	record_failures(total - passed)
}
