	0.000542537214553505,
	0.00041728963634303257,
	0.000661553231889254,
	0.00040492752135642946,
	0.0005549378534109375,
	0.0008673256456954168,
	0.0005117008842505179,
	0.0009195197028047767,
	0.0006469870476896731,
	0.0005856166486339695,
	0.0008176881674953444,
	0.00036104483212948303,
	0.0006331545638848672,
	0.0009703979176885004,
	0.0008271707807204258,
	0.0008456540202338813,
	0.0007146312328552522,
	0.00043829724368132917,
	0.0005010475897726401,
	0.0009348437406408314,
	0.0007377499254294923,
	0.0008538967704052249,
	0.000735462502739792,
	0.0004299707706816407,
	0.0009714158191348138,
	0.0007905749674294313,
	0.00048528452712104527,
	0.0007758845980014755,
	0.0006294408345808432,
	0.0004608755030994076,
	0.0007034431976085729,
	0.0007807621549327114,
	0.00036879561273944295,
	0.00034325509594448385,
	0.0006619101931083537,
	0.0005333590674399766,
	0.0008750494014244384,
	0.0004914346721553421,
	0.000544629161443568,
	0.0003432035650108379,
	0.0007955296942030021,
	0.0009088167990652006,
	0.0009393991527224224,
	0.0006567134975001703,
	0.00039541048914390925,
	0.0008080910426073673,
	0.0006158482207614744,
	0.0004618107585240795,
	0.0006453252495754444,
	0.0003743801038228773,
	0.0009474681602450482,
	0.0008837546474872593,
	0.0008779155783257472,
	0.000448921475479239,
	0.0005271439615229896,
	0.0006984849064574455,
	0.0009218239003392671,
	0.0004939722304789571,
	0.0007730997075739484,
	0.0007790771585968662,
}
@(private = "file")
PD_LIN := [?]f64{6.835176556297795, -5.830622483353054}
@(private = "file")
PD_QUA := [?]f64{47.123193749062395, -86.12264886447348}
@(private = "file")
PD_PRICE := [?]f64 {
	0.08619623432846067,
	0.09514256741432488,
	-0.007820939940218388,
	-0.5904599388245756,
	0.087228010193331,
}
@(private = "file")
PD_DYB7 := [?]f64{2.888571428571429, 3.1492857142857145}
@(private = "file")
PD_X7 := [?]f64{3.0, -1.0, 4.0, 1.5, 9.0, 2.6, 5.3}
@(private = "file")
PD_M7 := [?]f64{0.9, 1.2, 0.7, 1.05, 0.95, 1.3, 0.8}
@(private = "file")
PD_DYB := [?]f64{0.08458123330489667, 0.08458123330489666}
@(private = "file")
PD_MET := [?]f64 {
	0.0008153559875145722,
	0.00010558793192288962,
	0.5519715743521949,
	6.809606947913117,
	-0.015475558950656729,
	-0.029110052575396783,
	-0.02214588704656829,
}
@(private = "file")
PD_APD := [?]f64{0.09514256741432488, 0.18721450321316968, 8.208608905910452, 87.14865745111848}
@(private = "file")
PD_SPD := [?]f64 {
	0.10312207289522993,
	0.11265120946298912,
	-0.008200043700624132,
	0.10435326410610865,
	0.9882016990898643,
	0.9882022196884962,
	0.08458123330489666,
}
@(private = "file")
PD_SCAL := [?]f64{0.0002, 40.0, 3.0, 0.99, 100.0, 101.0, 0.004, 120.0}

pdpm_reference_test :: proc(allocator: mem.Allocator) {
	seed_test(#procedure)
	fmt.println(
		"\n=== PDPM core: SDF moment conditions, pricing, Dybvig distributional price, metrics, state-price density (numpy / scipy reference) ===",
	)
	context.allocator = allocator
	passed, total := 0, 0
	expect :: proc(passed, total: ^int, ok: bool, name: string) {
		total^ += 1
		if ok {passed^ += 1}
		fmt.printf("%s %s\n", "OK  " if ok else "FAIL", name)
	}
	rel :: proc(x, y: f64) -> f64 {return abs(x - y) / max(abs(y), 1e-300)}
	R := PD_R[:]
	n := len(R)
	rf, cq, gam, beta, S0, K :=
		PD_SCAL[0], PD_SCAL[1], PD_SCAL[2], PD_SCAL[3], PD_SCAL[4], PD_SCAL[5]
	moments :: proc(sdf: ^fin.StochasticDiscountFactor, R: []f64) -> (em, emr: f64) {
		for r, i in R {
			em += sdf.values[i]
			emr += sdf.values[i] * (1.0 + r)
		}
		return em / f64(len(R)), emr / f64(len(R))
	}

	// 1. Linear and quadratic SDFs price the bond and the market
	{
		lin := fin.sdf_linear_factor(R, rf)
		qua := fin.sdf_quadratic(R, rf, allocator, cq)
		el, elr := moments(&lin, R)
		eq, eqr := moments(&qua, R)
		d := 1.0 / (1.0 + rf)
		ok :=
			rel(lin.parameters[0], PD_LIN[0]) < 1e-9 &&
			rel(lin.parameters[1], PD_LIN[1]) < 1e-9 &&
			rel(qua.parameters[0], PD_QUA[0]) < 1e-9 &&
			rel(qua.parameters[1], PD_QUA[1]) < 1e-9
		ok &&=
			abs(el - d) < 1e-12 &&
			abs(elr - 1.0) < 1e-12 &&
			abs(eq - d) < 1e-12 &&
			abs(eqr - 1.0) < 1e-12
		expect(
			&passed,
			&total,
			ok,
			fmt.tprintf(
				"linear SDF a, b = %.6f, %.6f and quadratic (c = %.0f) a, b = %.4f, %.4f vs numpy solve; E[M] − 1/(1+rf) = %.1e / %.1e, E[M R] − 1 = %.1e / %.1e (old quadratic: fixed b = −mean/2, c = 0.1, priced neither)",
				lin.parameters[0],
				lin.parameters[1],
				cq,
				qua.parameters[0],
				qua.parameters[1],
				el - d,
				eq - d,
				elr - 1,
				eqr - 1,
			),
		)
	}

	// 2. Probability-weighted pricing of a call under a power-utility SDF
	gross := make([]f64, n)
	X := make([]f64, n)
	for r, i in R {
		gross[i] = 1.0 + r
		X[i] = max(S0 * (1.0 + r) - K, 0.0)
	}
	pw := fin.sdf_power_utility(gross, gam, beta)
	{
		res := fin.price_payoff(X, &pw, PD_W[:])
		got := [5]f64 {
			res.price,
			res.expected_payoff,
			res.risk_premium,
			res.correlation_with_sdf,
			res.certainty_equivalent,
		}
		worst := 0.0
		for k in 0 ..< 5 {worst = max(worst, rel(got[k], PD_PRICE[k]))}
		expect(
			&passed,
			&total,
			worst < 1e-11,
			fmt.tprintf(
				"price_payoff with probability weights: price %.8f, E[X] %.8f, risk premium Cov(M, X) %.8f, corr %.6f, CE %.8f vs numpy, max rel err %.1e (old: E[M] and the correlation used the unweighted SDF mean)",
				res.price,
				res.expected_payoff,
				res.risk_premium,
				res.correlation_with_sdf,
				res.certainty_equivalent,
				worst,
			),
		)
	}

	// 3. Dybvig distributional price
	{
		m7 := fin.StochasticDiscountFactor {
			values = PD_M7[:],
		}
		r7 := fin.dybvig_distributional_price(PD_X7[:], &m7, 7)
		act := fin.price_payoff(PD_X7[:], &m7)
		rf_ := fin.dybvig_distributional_price(X, &pw, 100)
		ok :=
			rel(r7.price, PD_DYB7[0]) < 1e-14 &&
			rel(act.price, PD_DYB7[1]) < 1e-14 &&
			rel(rf_.price, PD_DYB[0]) < 1e-12
		expect(
			&passed,
			&total,
			ok,
			fmt.tprintf(
				"Dybvig distributional price: 7 states %.10f vs brute-force minimum over all 7! permutations %.10f (actual payoff costs %.6f, efficiency loss %.6f); call under the decreasing power SDF %.8f = its price %.8f (already efficient; old: bucketed E[MX] — 7 states gave the actual cost 3.149286 with 7 buckets and 1.956786 with 3, dropping a state)",
				r7.price,
				PD_DYB7[0],
				act.price,
				act.price - r7.price,
				rf_.price,
				PD_DYB[1],
			),
		)
	}

	// 4. Distribution metrics and weighted payoff moments
	{
		m := fin.compute_distribution_metrics(R)
		got := [7]f64 {
			m.mean,
			m.variance,
			m.skewness,
			m.kurtosis,
			m.value_at_risk_95,
			m.value_at_risk_99,
			m.expected_shortfall_95,
		}
		worst := 0.0
		for k in 0 ..< 7 {worst = max(worst, rel(got[k], PD_MET[k]))}
		a := fin.analyze_payoff_distribution(X, PD_W[:])
		ga := [4]f64{a.mean, a.variance, a.skewness, a.kurtosis}
		wa := 0.0
		for k in 0 ..< 4 {wa = max(wa, rel(ga[k], PD_APD[k]))}
		expect(
			&passed,
			&total,
			worst < 1e-11 && wa < 1e-11,
			fmt.tprintf(
				"distribution metrics vs scipy (skew %.6f, excess kurtosis %.6f, VaR95 %.6f, VaR99 %.6f, ES95 %.6f; inverted-CDF quantiles) max rel err %.1e; weighted payoff moments max rel err %.1e (old skew / kurtosis mixed the n − 1 std into /n moments)",
				m.skewness,
				m.kurtosis,
				m.value_at_risk_95,
				m.value_at_risk_99,
				m.expected_shortfall_95,
				worst,
				wa,
			),
		)
	}

	// 5. State-price density and continuous pricing
	{
		spd := fin.estimate_state_price_density(&pw, R, PD_SCAL[6], int(PD_SCAL[7]))
		defer fin.free_state_price_density(&spd)
		call :: proc(s: f64) -> f64 {return max(100.0 * (1.0 + s) - 101.0, 0.0)}
		res := fin.price_payoff_continuous(call, &spd)
		got := [4]f64{res.price, res.expected_payoff, res.risk_premium, res.certainty_equivalent}
		worst := 0.0
		for k in 0 ..< 4 {worst = max(worst, rel(got[k], PD_SPD[k]))}
		bond := 0.0
		for v in res.state_prices {bond += v}
		ok := worst < 1e-11 && rel(bond, PD_SPD[4]) < 1e-12 && rel(bond, PD_SPD[5]) < 1e-5
		expect(
			&passed,
			&total,
			ok,
			fmt.tprintf(
				"kernel SPD (h = %.3f, %d points) + trapezoidal pricing vs numpy: price %.8f, E[X] under the physical density %.8f (old: ∫X ds, not an expectation), max rel err %.1e; Σ state prices %.8f = E[M] %.8f (discrete call price %.6f)",
				PD_SCAL[6],
				int(PD_SCAL[7]),
				res.price,
				res.expected_payoff,
				worst,
				bond,
				PD_SPD[5],
				PD_SPD[6],
			),
		)
	}

	fmt.printf("PDPM summary: %d/%d passed\n", passed, total)
	record_failures(total - passed)
}
