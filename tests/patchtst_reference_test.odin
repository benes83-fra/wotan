_PT_LOSS :: 3.2012741554993998
_PT_LAST :: 0.62923378103218686

@(private = "file")
_pt_u :: proc(x: ^u64) -> f64 {
	x^ = 6364136223846793005 * x^ + 1442695040888963407
	return f64(x^ >> 11) * 1.1102230246251565e-16
}

@(private = "file")
_pt_err :: proc(got, want: []f64) -> f64 {
	e := 0.0
	for v, i in want {e = max(e, abs(got[i] - v) / max(abs(v), 1e-3))}
	return e
}

patchtst_reference_test :: proc(allocator: mem.Allocator) {
	seed_test(#procedure)
	fmt.println("\n=== PatchTST Reference Checks ===")
	context.allocator = allocator
	passed, total := 0, 0
	expect :: proc(passed, total: ^int, ok: bool, name: string) {
		total^ += 1
		if ok {passed^ += 1}
		fmt.printf("%s %s\n", "OK  " if ok else "FAIL", name)
	}
	L, H, C, B :: 12, 3, 2, 3
	x: u64 = 717
	for _ in 0 ..< B * (L + H) * C {_ = _pt_u(&x)} 	// the series (taken from the reference)
	Xm := l.matrix_new(f64, B * C, L)
	Ym := l.matrix_new(f64, B * C, H)
	channels := make([]int, B * C)
	defer delete(channels)
	for b in 0 ..< B {
		for c in 0 ..< C {
			r := b * C + c
			channels[r] = c
			for j in 0 ..< L {Xm.data[r * L + j] = _PT_SERIES[(b * (L + H) + j) * C + c]}
			for j in 0 ..< H {Ym.data[r * H + j] = _PT_SERIES[(b * (L + H) + L + j) * C + c]}
		}
	}
	X := t.tensor_new(Xm)
	defer t.tensor_free(X)
	Y := t.tensor_new(Ym)
	defer t.tensor_free(Y)
	m := ml_fin.patchtst_new(
		{
			input_size = L,
			horizon = H,
			patch_len = 4,
			stride = 2,
			d_model = 8,
			n_heads = 2,
			d_ff = 10,
			n_layers = 2,
			channels = C,
			revin = true,
		},
	)
	defer ml_fin.patchtst_free(m)
	params := ml_fin.patchtst_parameters(m)
	defer delete(params)
	// kinds in order: embedding W, b, pos; per layer 6 x (W, b), 2 x (gamma, beta); head W, b; RevIN w, b
	for q, k in params {
		n_layer_params := 16
		kind: string
		switch {
		case k == 0:
			kind = "lin"
		case k == 1:
			kind = "vec"
		case k == 2:
			kind = "pos"
		case k < 3 + 2 * n_layer_params:
			j := (k - 3) % n_layer_params
			kind = "lin" if j < 12 && j % 2 == 0 else ("gamma" if j == 12 || j == 14 else "vec")
		case k == 3 + 2 * n_layer_params:
			kind = "lin"
		case k == 4 + 2 * n_layer_params:
			kind = "vec"
		case k == 5 + 2 * n_layer_params:
			kind = "gamma"
		case:
			kind = "vec"
		}
		for &v in q.data.data {
			switch kind {
			case "lin":
				v = 0.8 * (_pt_u(&x) - 0.5)
			case "pos", "vec":
				v = 0.1 * (_pt_u(&x) - 0.5)
			case "gamma":
				v = 1 + 0.2 * (_pt_u(&x) - 0.5)
			}
		}
	}
	f := ml_fin.patchtst_predict(m, X, channels)
	defer delete(f)
	e1 := _pt_err(f, _PT_FORECAST)
	opt := nn.adam_new(0.005)
	defer nn.adam_free(&opt)
	for q in params {nn.adam_add_param(&opt, q)}
	{
		t.graph_begin(&m.scope)
		loss := ml_fin.patchtst_loss(m, X, Y, channels, t.graph_allocator(&m.scope))
		nn.adam_zero_grad(&opt)
		t.tensor_backward(loss)
		e1 = max(e1, abs(loss.data.data[0] - _PT_LOSS) / _PT_LOSS)
		t.graph_end(&m.scope)
		for q, k in params {e1 = max(e1, _pt_err(q.grad.data, _PT_GRADS[k]))}
	}
	expect(
		&passed,
		&total,
		len(params) == 39 && e1 < 1e-9,
		fmt.tprintf(
			"forecasts (RevIN, patching, embedding, 2 encoder layers, head, denormalisation), MSE and all %d parameter gradients = torch (error %.1e)",
			len(params),
			e1,
		),
	)
	last := 0.0
	for _ in 0 ..< 8 {last = ml_fin.patchtst_train_step(m, X, Y, channels, &opt)}
	g := ml_fin.patchtst_predict(m, X, channels)
	defer delete(g)
	e2 := max(abs(last - _PT_LAST) / _PT_LAST, _pt_err(g, _PT_AFTER))
	expect(
		&passed,
		&total,
		e2 < 1e-9,
		fmt.tprintf("after 8 Adam steps: last loss and forecasts = torch (error %.1e)", e2),
	)
	fmt.printf("PatchTST reference checks: %d/%d passed\n", passed, total)
	record_failures(total - passed)
}
