@(private = "file")
_cop_data :: proc(name: string) -> (u1, u2: []f64) {
	switch name {
	case "gauss":
		return COP_GAUSS_U1[:], COP_GAUSS_U2[:]
	case "student":
		return COP_STUDENT_U1[:], COP_STUDENT_U2[:]
	case "clayton":
		return COP_CLAYTON_U1[:], COP_CLAYTON_U2[:]
	case "gumbel":
		return COP_GUMBEL_U1[:], COP_GUMBEL_U2[:]
	case "frank":
		return COP_FRANK_U1[:], COP_FRANK_U2[:]
	}
	return COP_TIES_U1[:], COP_TIES_U2[:]
}

@(private = "file")
_cop_rel :: proc(a, b: f64) -> f64 {
	return math.abs(a - b) / max(math.abs(b), 1.0)
}

copula_reference_test :: proc(allocator: mem.Allocator) {
	seed_test(#procedure)
	fmt.println(
		"\n=== Copulas: densities, MLE fits, rank dependence, t quantile (scipy/statsmodels reference) ===",
	)
	context.allocator = allocator
	passed, total := 0, 0
	expect :: proc(passed, total: ^int, ok: bool, name: string) {
		total^ += 1
		if ok {passed^ += 1}
		fmt.printf("%s %s\n", "OK  " if ok else "FAIL", name)
	}

	// 1. Student-t quantile (used by the t copula) against scipy.stats.t.ppf
	{
		worst := 0.0
		for row in COP_TQ {
			q := fin.t_quantile(row[0], row[1])
			worst = max(worst, math.abs(q - row[2]) / max(math.abs(row[2]), 1e-300))
		}
		expect(
			&passed,
			&total,
			worst < 1e-12,
			fmt.tprintf(
				"t_quantile on %d (p, nu) pairs, p down to 1e-12, nu 1..150: max rel err %.1e (was Cornish-Fisher, -9.33 vs -10.21 at p=0.001, nu=3)",
				len(COP_TQ),
				worst,
			),
		)
	}

	// 2. Log-likelihoods of all families at fixed parameters
	{
		worst, worst_name := 0.0, ""
		for row in COP_FIXED {
			u1, u2 := _cop_data(row.data)
			ll: f64
			switch row.family {
			case "gauss":
				ll = fin.gaussian_copula_loglik(u1, u2, row.a)
			case "student":
				ll = fin.student_t_copula_loglik(u1, u2, row.a, row.b)
			case "clayton":
				ll = fin.clayton_copula_loglik(u1, u2, row.a)
			case "gumbel":
				ll = fin.gumbel_copula_loglik(u1, u2, row.a)
			case "frank":
				ll = fin.frank_copula_loglik(u1, u2, row.a)
			}
			if e := _cop_rel(ll, row.ll);
			   !(e <=
				   worst) {worst, worst_name = e, fmt.tprintf("%s/%s(%.1f)", row.data, row.family, row.a)}
		}
		expect(
			&passed,
			&total,
			worst < 1e-12,
			fmt.tprintf(
				"log-likelihoods, %d (data, family, parameter) cases incl. Frank theta<0: max rel err %.1e at %s",
				len(COP_FIXED),
				worst,
				worst_name,
			),
		)
	}

	// 3. Single-point densities agree with the summed versions
	{
		a, b := []f64{0.05}, []f64{0.2}
		g := math.ln(fin.gaussian_copula_pdf(0.05, 0.2, 0.5))
		t := fin.student_t_copula_log_pdf(0.05, 0.2, 0.5, 1.5)
		ok :=
			math.abs(g - fin.gaussian_copula_loglik(a, b, 0.5)) < 1e-12 &&
			math.abs(t - fin.student_t_copula_loglik(a, b, 0.5, 1.5)) < 1e-12 &&
			fin.frank_copula_loglik(a, b, 0) == 0 &&
			math.abs(fin.frank_copula_loglik(a, b, 1e-9)) < 1e-8 &&
			math.abs(fin.gumbel_copula_loglik(a, b, 1)) < 1e-12 &&
			math.abs(fin.clayton_copula_loglik(a, b, 1e-9)) < 1e-8
		expect(
			&passed,
			&total,
			ok,
			"pointwise densities match the sums; Frank/Gumbel/Clayton reduce to independence at the boundary (t copula with nu = 1.5 < 2 allowed)",
		)
	}

	// 4. MLE fits
	fits: [5]fin.CopulaResult
	elapsed: [5]time.Duration
	for row, k in COP_MLE {
		u1, u2 := _cop_data(row.name)
		start := time.tick_now()
		switch row.name {
		case "gauss":
			fits[k] = fin.fit_gaussian_copula(u1, u2)
		case "student":
			fits[k] = fin.fit_student_t_copula(u1, u2)
		case "clayton":
			fits[k] = fin.fit_clayton(u1, u2)
		case "gumbel":
			fits[k] = fin.fit_gumbel(u1, u2)
		case "frank":
			fits[k] = fin.fit_frank(u1, u2)
		}
		elapsed[k] = time.tick_since(start)
		f := fits[k]
		ok :=
			f.converged &&
			math.abs(f.log_likelihood - row.ll) < 1e-7 &&
			_cop_rel(f.parameters[0], row.a) < 1e-5
		if row.name == "student" {ok = ok && _cop_rel(f.parameters[1], row.b) < 1e-4}
		ok = ok && math.abs(f.aic - (2 * f64(len(f.parameters)) - 2 * row.ll)) < 1e-6
		expect(
			&passed,
			&total,
			ok,
			fmt.tprintf(
				"fit %-8s param %.6f (ref %.6f)%s, loglik %.6f (ref %.6f), %.2f ms",
				row.name,
				f.parameters[0],
				row.a,
				fmt.tprintf(", nu %.4f (ref %.4f)", f.parameters[1], row.b) if row.name == "student" else "",
				f.log_likelihood,
				row.ll,
				time.duration_milliseconds(elapsed[k]),
			),
		)
	}
	for &f in fits {delete(f.parameters)}

	// 5. Clayton / Gumbel refuse negative dependence; Frank fits it
	{
		u1, u2 := _cop_data("student") // rho = -0.45
		c, g := fin.fit_clayton(u1, u2), fin.fit_gumbel(u1, u2)
		fr := fin.fit_frank(u1, u2)
		defer delete(fr.parameters)
		expect(
			&passed,
			&total,
			!c.converged &&
			!g.converged &&
			c.parameters == nil &&
			fr.converged &&
			fr.parameters[0] < 0,
			fmt.tprintf(
				"negative dependence: Clayton/Gumbel not converged, Frank theta = %.4f",
				fr.parameters[0],
			),
		)
	}

	// 6. Kendall tau-b and Spearman rho, incl. heavily tied data
	{
		worst := 0.0
		for row in COP_DEP {
			u1, u2 := _cop_data(row.data)
			worst = max(
				worst,
				math.abs(fin.kendall_tau(u1, u2) - row.tau),
				math.abs(fin.spearman_rho(u1, u2, context.temp_allocator) - row.rho),
			)
		}
		expect(
			&passed,
			&total,
			worst < 1e-13,
			fmt.tprintf(
				"kendall_tau (tau-b) and spearman_rho vs scipy on %d data sets incl. ties: max abs err %.1e",
				len(COP_DEP),
				worst,
			),
		)
	}

	// 7. Pseudo-observations with average ranks for ties
	{
		u := fin.pit_empirical(COP_TIES_U1[:])
		defer delete(u)
		worst := 0.0
		for v, i in u {worst = max(worst, math.abs(v - COP_PIT_REF[i]))}
		expect(
			&passed,
			&total,
			worst < 1e-15,
			fmt.tprintf(
				"pit_empirical = rankdata(average)/(n+1) on tied data: max abs err %.1e",
				worst,
			),
		)
	}

	// 8. Large n: O(n log n) ranks and tau
	{
		n := 200_000
		x := make([]f64, n)
		y := make([]f64, n)
		defer {delete(x); delete(y)}
		for i in 0 ..< n {
			x[i] = f64((i * 7919) % n)
			y[i] = x[i] // perfect concordance
		}
		start := time.tick_now()
		tau := fin.kendall_tau(x, y)
		u := fin.pit_empirical(x)
		defer delete(u)
		ms := time.duration_milliseconds(time.tick_since(start))
		expect(
			&passed,
			&total,
			math.abs(tau - 1) < 1e-15 && ms < 2000,
			fmt.tprintf("kendall_tau + pit_empirical on n = %d in %.0f ms (were O(n^2))", n, ms),
		)
	}

	fmt.printf("Copula summary: %d/%d passed\n", passed, total)
	record_failures(total - passed)
}
