@(private = "file")
Met_Ref :: struct {
	name: string,
	ref:  f64,
}
@(private = "file")
MET_SCALAR := [?]Met_Ref {
	{"hist_vol", 0.2100251039784006},
	{"ewma_vol", 0.22285763801851113},
	{"max_dd", -0.23618545713631045},
	{"avg_dd", -0.08643676627265487},
	{"sharpe", 0.20153007495361094},
	{"sortino", 0.2901879097642639},
	{"sortino_old", 0.205193838812661},
	{"calmar", 0.21848659150539435},
	{"beta", 0.5918499899754751},
	{"corr", 0.6099650736107378},
	{"te", 0.011869631522247813},
	{"win_rate", 0.5026666666666667},
	{"profit_factor", 1.0583296415733388},
	{"avg_win", 0.010359712975315117},
	{"avg_loss", -0.009893712395172742},
}
@(private = "file")
MET_DF := [?]Met_Ref {
	{"beta", 0.5841909132871571},
	{"corr", 0.6109929185151233},
	{"te", 0.011888902994881581},
	{"vol", 0.2089520471271003},
	{"sharpe", 0.2846464619298206},
}

@(private = "file")
_met_rel :: proc(x, ref: f64) -> f64 {
	return math.abs(x - ref) / max(math.abs(ref), 1e-300)
}

@(private = "file")
_met_col :: proc(name: string, x: []f64, nulls: []bool) -> w.Column {
	c := w.column_new(name, .Float, len(x))
	for v, i in x {
		if nulls != nil && nulls[i] {w.append_null(&c)} else {w.append_float(&c, v)}
	}
	return c
}

// Max relative error of a column against a reference with NaN = null
@(private = "file")
_met_col_err :: proc(c: ^w.Column, ref: []f64) -> (worst: f64, nulls_ok: bool) {
	nulls_ok = c.len == len(ref)
	for i in 0 ..< min(c.len, len(ref)) {
		v, is_null := w.column_at_float(c, i)
		if is_null != math.is_nan(ref[i]) {
			nulls_ok = false
			continue
		}
		if !is_null {worst = max(worst, _met_rel(v, ref[i]))}
	}
	return
}

risk_metrics_reference_test :: proc(allocator: mem.Allocator) {
	seed_test(#procedure)
	fmt.println(
		"\n=== Risk metrics: volatility, drawdown, ratios, beta (numpy / pandas reference) ===",
	)
	context.allocator = allocator
	passed, total := 0, 0
	expect :: proc(passed, total: ^int, ok: bool, name: string) {
		total^ += 1
		if ok {passed^ += 1}
		fmt.printf("%s %s\n", "OK  " if ok else "FAIL", name)
	}
	R, B := MET_R[:], MET_B[:]

	// 1. Scalar metrics
	{
		worst, at := 0.0, ""
		old_sortino := 0.0
		for row in MET_SCALAR {
			got: f64
			switch row.name {
			case "hist_vol":
				got = fin.historical_volatility(R)
			case "ewma_vol":
				got = fin.ewma_volatility(R)
			case "max_dd":
				got = fin.max_drawdown(R)
			case "avg_dd":
				got = fin.avg_drawdown(R)
			case "sharpe":
				got = fin.sharpe_ratio_from_returns(R, 0.03)
			case "sortino":
				got = fin.sortino_ratio_from_returns(R, 0.03)
			case "sortino_old":
				old_sortino = row.ref
				continue
			case "calmar":
				got = fin.calmar_ratio(R)
			case "beta":
				got = fin.beta(R, B)
			case "corr":
				got = fin.correlation(R, B)
			case "te":
				got = fin.tracking_error(R, B)
			case "win_rate":
				got = fin.win_rate(R)
			case "profit_factor":
				got = fin.profit_factor(R)
			case "avg_win":
				got = fin.avg_win(R)
			case "avg_loss":
				got = fin.avg_loss(R)
			}
			if e := _met_rel(got, row.ref); e > worst {worst, at = e, row.name}
		}
		expect(
			&passed,
			&total,
			worst < 1e-12,
			fmt.tprintf(
				"%d scalar metrics vs numpy (empyrical conventions): max rel err %.1e (%s); Sortino %.4f (was %.4f, downside deviation over the losing periods only)",
				len(MET_SCALAR) - 1,
				worst,
				at,
				fin.sortino_ratio_from_returns(R, 0.03),
				old_sortino,
			),
		)
	}

	// 2. Drawdown series, incl. a loss on the first day
	{
		dd := fin.drawdown_series(R, context.allocator)
		defer delete(dd)
		worst := 0.0
		for v, i in dd {worst = max(worst, math.abs(v - MET_DD[i]))}
		first := fin.max_drawdown([]f64{-0.1, 0.05})
		expect(
			&passed,
			&total,
			worst < 1e-14 && math.abs(first + 0.1) < 1e-15,
			fmt.tprintf(
				"drawdown_series vs numpy: max err %.1e; first-day loss counts (max drawdown %.3f)",
				worst,
				first,
			),
		)
	}

	// 3. risk_metrics_from_df drops rows where either column is null
	{
		df := w.dataframe_new()
		defer w.destroy_dataframe(&df)
		w.add_column(&df, _met_col("r", R, MET_NULL_R[:]))
		w.add_column(&df, _met_col("b", B, MET_NULL_B[:]))
		df.rows = len(R)
		m := fin.risk_metrics_from_df(&df, "r", "b", 0.02)
		got := [?]f64{m.beta, m.correlation, m.tracking_error, m.volatility, m.sharpe_ratio}
		worst := 0.0
		for row, k in MET_DF {worst = max(worst, _met_rel(got[k], row.ref))}
		expect(
			&passed,
			&total,
			worst < 1e-12,
			fmt.tprintf(
				"risk_metrics_from_df with nulls at different rows: beta %.4f corr %.4f TE %.5f, max rel err %.1e (nulls used to be dropped per column, so the pairs went out of step)",
				m.beta,
				m.correlation,
				m.tracking_error,
				worst,
			),
		)
	}

	// 4. DataFrame rolling wrappers vs pandas
	{
		df := w.dataframe_new()
		defer w.destroy_dataframe(&df)
		w.add_column(&df, _met_col("r", R, nil))
		w.add_column(&df, _met_col("b", B, nil))
		df.rows = len(R)
		vol := fin.historical_volatility_rolling(&df, "r", 252, 20)
		ewm := fin.ewma_volatility_df(&df, "r", 0.06, 20)
		bet := fin.rolling_beta_df(&df, "r", "b", 252, 20)
		cor := fin.rolling_correlation_df(&df, "r", "b", 252, 20)
		defer {
			w.destroy_column(&vol)
			w.destroy_column(&ewm)
			w.destroy_column(&bet)
			w.destroy_column(&cor)
		}
		e1, n1 := _met_col_err(&vol, MET_ROLL_VOL[:])
		e2, n2 := _met_col_err(&ewm, MET_EWM_VOL[:])
		e3, n3 := _met_col_err(&bet, MET_ROLL_BETA[:])
		e4, n4 := _met_col_err(&cor, MET_ROLL_CORR[:])
		expect(
			&passed,
			&total,
			n1 && n2 && n3 && n4 && max(e1, e2, e3, e4) < 1e-9,
			fmt.tprintf(
				"rolling volatility / EWM volatility (adjust=False) / beta / correlation vs pandas (window 252, min 20): max rel err %.1e %.1e %.1e %.1e, nulls match %v %v %v %v",
				e1,
				e2,
				e3,
				e4,
				n1,
				n2,
				n3,
				n4,
			),
		)
	}

	fmt.printf("Risk metrics summary: %d/%d passed\n", passed, total)
	record_failures(total - passed)
}
