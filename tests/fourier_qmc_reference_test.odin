// Prices of one (model, parameter set, expiry) group with every strike / type
@(private = "file")
_fq_group_prices :: proc(model, pset: int, days: i32, strikes: []f64, puts: []bool, out: []f64) {
	S, r := 100.0, 0.03
	T := f64(days) / 365.0
	tmp := make([]f64, len(strikes), context.temp_allocator)
	for opt in fin.OptionType {
		switch model {
		case 0:
			h := FQ_HESTON[5 * pset:]
			p := fin.Heston_Params{v0 = h[0], kappa = h[1], theta = h[2], sigma = h[3], rho = h[4]}
			fin.heston_prices_cos(S, strikes, T, r, p, opt, tmp)
		case 1:
			m := FQ_MERTON[4 * pset:]
			fin.merton_prices_cos(S, strikes, T, r, {sigma = m[0], lambda = m[1], mu_j = m[2], sigma_j = m[3]}, opt, tmp)
		case 2:
			b := FQ_BATES[8 * pset:]
			p := fin.Bates_Params {
				heston  = {v0 = b[0], kappa = b[1], theta = b[2], sigma = b[3], rho = b[4]},
				lambda  = b[5],
				mu_j    = b[6],
				sigma_j = b[7],
			}
			fin.bates_prices_cos(S, strikes, T, r, p, opt, tmp)
		}
		for i in 0 ..< len(strikes) {
			if puts[i] == (opt == .Put) {out[i] = tmp[i]}
		}
	}
}

fourier_qmc_reference_test :: proc(allocator: mem.Allocator) {
	seed_test(#procedure)
	fmt.println("\n=== COS Fourier pricing, Sobol' sequences, Brownian bridge, QMC (QuantLib / scipy reference) ===")
	context.allocator = allocator
	passed, total := 0, 0
	expect :: proc(passed, total: ^int, ok: bool, name: string) {
		total^ += 1
		if ok {passed^ += 1}
		fmt.printf("%s %s\n", "OK  " if ok else "FAIL", name)
	}

	// 1–3. COS vs the reference engines, grouped by (model, set, expiry)
	n_cases := len(FQ_CF) / 2
	names := [3]string{"Heston (3 parameter sets incl. σ = 1, ρ = −0.9) vs QuantLib AnalyticHestonEngine", "Merton jump diffusion (incl. λ = 0 = Black-Scholes) vs Merton's series", "Bates vs QuantLib BatesEngine"}
	t_cos: time.Duration
	n_groups := 0
	for model in 0 ..< 3 {
		worst := 0.0
		worst_at := ""
		count := 0
		i := 0
		for i < n_cases {
			if int(FQ_CI[4 * i]) != model {i += 1; continue}
			j := i
			for j < n_cases && FQ_CI[4 * j] == FQ_CI[4 * i] && FQ_CI[4 * j + 1] == FQ_CI[4 * i + 1] && FQ_CI[4 * j + 2] == FQ_CI[4 * i + 2] {j += 1}
			m := j - i
			strikes := make([]f64, m)
			puts := make([]bool, m)
			got := make([]f64, m)
			for k in 0 ..< m {
				strikes[k] = FQ_CF[2 * (i + k)]
				puts[k] = FQ_CI[4 * (i + k) + 3] != 0
			}
			t0 := time.now()
			_fq_group_prices(model, int(FQ_CI[4 * i + 1]), FQ_CI[4 * i + 2], strikes, puts, got)
			if model == 0 {t_cos += time.since(t0); n_groups += 1}
			for k in 0 ..< m {
				e := abs(got[k] - FQ_CF[2 * (i + k) + 1])
				if e > worst {worst, worst_at = e, fmt.tprintf("set %d, %d days, K %.2f %s: %.10f vs %.10f", FQ_CI[4 * i + 1], FQ_CI[4 * i + 2], strikes[k], "put" if puts[k] else "call", got[k], FQ_CF[2 * (i + k) + 1])}
			}
			count += m
			i = j
		}
		extra := fmt.tprintf("; %.2f ms per expiry for 24 options (heston_prices_same_expiry now uses COS: its former Gil-Pelaez midpoint rule, du = 0.2, was off by 4.5e-3 on the σ = 1, 10Y, K = 270 put)", time.duration_milliseconds(t_cos) / f64(n_groups)) if model == 0 else ""
		expect(&passed, &total, worst < 1e-9, fmt.tprintf("COS %s: %d calls / puts, 1W-10Y, strikes 40%%-250%% of the forward (S = 100): max abs diff %.1e (%s)%s", names[model], count, worst, worst_at, extra))
	}

	// Heston in the Black-Scholes limit: vol of vol 0, and 1e-4 (ρ = 0, so the
	// true difference is second order), where the former characteristic
	// function lost ~8 digits to the cancellation in b − d
	{
		worst0, worst4 := 0.0, 0.0
		strikes := [7]f64{50, 64, 80, 100, 125, 160, 250}
		out := make([]f64, 7)
		for T in ([]f64{0.02, 0.2, 1, 10}) {
			for opt in fin.OptionType {
				for sv in ([]f64{0, 1e-4}) {
					p := fin.Heston_Params{v0 = 0.04, kappa = 1, theta = 0.04, sigma = sv, rho = 0 if sv > 0 else -0.5}
					fin.heston_prices_same_expiry(100, strikes[:], T, 0.05, p, opt, out)
					for K, k in strikes {
						bs := fin.black_scholes_call(100, K, T, 0.05, 0.2)
						if opt == .Put {bs += K * math.exp(-0.05 * T) - 100}
						if sv == 0 {worst0 = max(worst0, abs(out[k] - bs))} else {worst4 = max(worst4, abs(out[k] - bs))}
					}
				}
			}
		}
		K64 := [1]f64{64}
		p64: [1]f64
		fin.heston_prices_same_expiry(100, K64[:], 0.2, 0.05, {v0 = 0.04, kappa = 1, theta = 0.04, sigma = 1e-4, rho = 0}, .Put, p64[:])
		bs64 := fin.black_scholes_call(100, 64, 0.2, 0.05, 0.2) + 64 * math.exp_f64(-0.05 * 0.2) - 100
		rel64 := abs(p64[0] - bs64) / bs64
		expect(&passed, &total, worst0 < 1e-11 && worst4 < 2e-7 && rel64 < 1e-4, fmt.tprintf("Heston with vol of vol 0 equals Black-Scholes (σ = 20%%, 1W-10Y, K 50-250, ρ = −0.5): max abs diff %.1e; vol of vol 1e-4: max abs diff %.1e (the true O(σ²) correction: it quadruples when σ doubles), the 0.2Y 64-put (2.2e-7) within %.1e relative (the former b − d form was 4%% off there)", worst0, worst4, rel64))
	}

	// 4. Sobol' sequence vs scipy
	{
		s := fin.make_sobol(64)
		defer fin.free_sobol(&s)
		pt := make([]f64, 64)
		exact := true
		for i in 0 ..< 256 {
			fin.sobol_next(&s, pt)
			for d in 0 ..< 64 {exact &&= pt[d] * 4294967296.0 == f64(FQ_SOBOL[64 * i + d])}
		}
		all := fin.make_sobol(2048)
		defer fin.free_sobol(&all)
		big := make([]f64, 2048)
		chk := make([]u64, 2048)
		for i in 0 ..< 4096 {
			fin.sobol_next(&all, big)
			for d in 0 ..< 2048 {chk[d] += u64(big[d] * 4294967296.0) * u64(2 * i + 1)}
		}
		chk_ok := true
		for d in 0 ..< 2048 {chk_ok &&= chk[d] == FQ_CHK[d]}
		// skip_to jumps straight to a point; a digital shift keeps every
		// coordinate of 2^k consecutive-from-0 points stratified
		fin.sobol_skip_to(&s, 200)
		fin.sobol_next(&s, pt)
		skip_ok := true
		for d in 0 ..< 64 {skip_ok &&= pt[d] * 4294967296.0 == f64(FQ_SOBOL[64 * 200 + d])}
		sh := fin.make_sobol(16, 0, 12345)
		defer fin.free_sobol(&sh)
		hits := make([]int, 16 * 1024)
		for _ in 0 ..< 1024 {
			fin.sobol_next(&sh, pt[:16])
			for d in 0 ..< 16 {hits[d * 1024 + int(pt[d] * 1024)] += 1}
		}
		strat := true
		for h in hits {strat &&= h == 1}
		expect(&passed, &total, exact && chk_ok && skip_ok && strat, fmt.tprintf("Sobol' (Joe-Kuo 6.21201, 32 bits, Gray code) vs scipy.stats.qmc.Sobol: 256 points × 64 dims bit-exact %v, checksums of 4096 points in all 2048 dims %v; skip_to %v; digital shift keeps 1024 points one per 1/1024 cell in 16 dims %v", exact, chk_ok, skip_ok, strat))
	}

	// 5. Brownian bridge vs QuantLib
	{
		worst := 0.0
		off := 0
		for n in FQ_BB_N {
			b := fin.make_brownian_bridge(n)
			out := make([]f64, n)
			fin.brownian_bridge_transform(&b, FQ_BB_IN[off:off + n], out)
			for k in 0 ..< n {worst = max(worst, abs(out[k] - FQ_BB_OUT[off + k]))}
			fin.free_brownian_bridge(&b)
			off += n
		}
		bt := fin.make_brownian_bridge_times(FQ_BB_T[:])
		defer fin.free_brownian_bridge(&bt)
		out := make([]f64, len(FQ_BB_T))
		fin.brownian_bridge_transform(&bt, FQ_BB_T_IN[:], out)
		for k in 0 ..< len(out) {worst = max(worst, abs(out[k] - FQ_BB_T_OUT[k]))}
		expect(&passed, &total, worst < 1e-14, fmt.tprintf("Brownian bridge (1-100 equal steps, and 7 uneven times) vs QuantLib BrownianBridge.transform: max diff %.1e", worst))
	}

	// 6. QMC through the existing GBM path generator
	{
		S0, K, r, sg, T := 100.0, 100.0, 0.03, 0.25, 1.0
		n_paths, n_steps := 1 << 14, 64
		price :: proc(z: []f64, n_paths, n_steps: int, S0, K, r, sg, T: f64) -> (euro, geo: f64) {
			S := fin.mc_generate_gbm_paths(S0, r, sg, T, n_paths, n_steps, z, context.temp_allocator)
			for p in 0 ..< n_paths {
				row := S[p * (n_steps + 1):(p + 1) * (n_steps + 1)]
				euro += max(row[n_steps] - K, 0)
				lg := 0.0
				for k in 1 ..= n_steps {lg += math.ln(row[k])}
				geo += max(math.exp(lg / f64(n_steps)) - K, 0)
			}
			df := math.exp(-r * T) / f64(n_paths)
			return euro * df, geo * df
		}
		zb := fin.mc_generate_sobol_normals(n_paths, n_steps)
		zn := fin.mc_generate_sobol_normals(n_paths, n_steps, brownian_bridge = false)
		zr := fin.mc_generate_normals(n_paths * n_steps, context.temp_allocator)
		eb, gb := price(zb, n_paths, n_steps, S0, K, r, sg, T)
		en, gn := price(zn, n_paths, n_steps, S0, K, r, sg, T)
		er, gr := price(zr, n_paths, n_steps, S0, K, r, sg, T)
		// randomized QMC: 8 independent digital shifts of 2^11 paths
		shifts: [8]f64
		for k in 0 ..< 8 {
			z := fin.mc_generate_sobol_normals(1 << 11, n_steps, shift_seed = u64(k + 1))
			_, shifts[k] = price(z, 1 << 11, n_steps, S0, K, r, sg, T)
		}
		m, v := 0.0, 0.0
		for x in shifts {m += x / 8}
		for x in shifts {v += (x - m) * (x - m) / 7}
		se := math.sqrt(v / 8)
		ok := abs(eb - FQ_BSC) < 1e-2 && abs(gb - FQ_GEO) < 1e-2 && abs(m - FQ_GEO) < 4 * se && se < 0.01
		expect(&passed, &total, ok, fmt.tprintf("2^14 paths × 64 steps through mc_generate_gbm_paths, errors vs closed form (European %.4f, geometric Asian %.4f): Sobol' + bridge %.1e / %.1e, Sobol' without bridge %.1e / %.1e, pseudo-random %.1e / %.1e (as scipy's points give); 8 digital shifts × 2^11 paths: Asian %.4f ± %.4f", FQ_BSC, FQ_GEO, abs(eb - FQ_BSC), abs(gb - FQ_GEO), abs(en - FQ_BSC), abs(gn - FQ_GEO), abs(er - FQ_BSC), abs(gr - FQ_GEO), m, se))
	}

	fmt.printf("Fourier / QMC summary: %d/%d passed\n", passed, total)
	record_failures(total - passed)
}
