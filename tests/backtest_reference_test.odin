BT_M2 :: [8]f64{-0.07295061249649315, -0.04660074347260501, -0.32849464029898723, -0.18942911032796372, 0.2727272727272727, 0.7117451615893227, 22.0, 11.0}
@(private = "file")
BT_M3A :: [8]f64{0.09656654156958622, 0.0597954339395268, 0.360632135680075, -0.07776046111708435, 1.0, math.INF_F64, 9.0, 4.0}
@(private = "file")
BT_M3B :: [8]f64{-0.022357084068618027, -0.014143822003404138, -0.09445349789967587, -0.20934022000206765, 0.3333333333333333, 0.8561263104279703, 12.0, 6.0}
@(private = "file")
BT_M4 :: [8]f64{0.12843846940719428, 0.07909844425726464, 0.9725812201649604, -0.045788940485894214, 0.625, 1.908508588049462, 64.0, 32.0}
@(private = "file")
BT_MV_LAST := [3]f64{0.46174163099215326, 0.4186952496925233, 0.11956311931532346}

@(private = "file")
_bt_frame :: proc() -> w.DataFrame {
	df := w.dataframe_new()
	names := [3]string{"A", "B", "C"}
	data := [3][]f64{BT_A[:], BT_B[:], BT_C[:]}
	for k in 0 ..< 3 {
		col := w.column_new(names[k], .Float, BT_N)
		for v in data[k] {w.append_float(&col, v)}
		w.add_column(&df, col)
	}
	df.rows = BT_N
	return df
}

// bar → (side, quantity): add, partial sell, oversell into a short, add to the
// short, over-cover into a long, close
@(private = "file")
_bt_script :: proc(ctx: ^fin.StrategyContext) {
	side: fin.OrderSide
	qty := 0.0
	switch ctx.current_bar {
	case 5: side, qty = .Buy, 100
	case 10: side, qty = .Buy, 50
	case 20: side, qty = .Sell, 60
	case 30: side, qty = .Sell, 150
	case 40: side, qty = .Sell, 40
	case 50: side, qty = .Buy, 130
	case 60: side, qty = .Sell, 30
	case: return
	}
	fin.context_submit_order(ctx, fin.Order{symbol = "A", side = side, quantity = qty, order_type = .Market})
}
@(private = "file")
_bt_sma :: proc(ctx: ^fin.StrategyContext) {fin.sma_crossover_strategy(ctx, "A", 10, 30, 0.95)}
@(private = "file")
_bt_boll :: proc(ctx: ^fin.StrategyContext) {fin.mean_reversion_strategy(ctx, "A", 20, 2.0, 0.95)}
@(private = "file")
_bt_mom :: proc(ctx: ^fin.StrategyContext) {fin.momentum_strategy(ctx, "A", 20, 0.95)}
@(private = "file")
_bt_pairs :: proc(ctx: ^fin.StrategyContext) {fin.pairs_trading_full(ctx, "A", "B", 40, 1.5, 0.3, 0.9)}
@(private = "file")
_bt_minvar :: proc(ctx: ^fin.StrategyContext, allocator: mem.Allocator) -> map[string]f64 {
	return fin.portfolio_min_variance(ctx, allocator, 120)
}
@(private = "file")
_bt_eqw :: proc(ctx: ^fin.StrategyContext, allocator: mem.Allocator) -> map[string]f64 {
	return fin.portfolio_equal_weight(ctx, allocator)
}

@(private = "file")
_bt_eq_err :: proc(got, ref: []f64) -> f64 {
	if len(got) != len(ref) {return math.INF_F64}
	worst := 0.0
	for i in 0 ..< len(ref) {worst = max(worst, abs(got[i] - ref[i]) / abs(ref[i]))}
	return worst
}

// Max relative error of total/annual return, Sharpe, drawdown, win rate, profit
// factor; fills and closed trips must match exactly
@(private = "file")
_bt_metric_err :: proc(r: ^fin.BacktestResult, m: [8]f64) -> f64 {
	got := [6]f64{r.total_return, r.annual_return, r.sharpe_ratio, r.max_drawdown, r.win_rate, r.profit_factor}
	worst := 0.0
	for k in 0 ..< 6 {
		if math.is_inf(m[k]) {
			if !math.is_inf(got[k]) {return math.INF_F64}
			continue
		}
		worst = max(worst, abs(got[k] - m[k]) / max(abs(m[k]), 1e-12))
	}
	if r.total_trades != int(m[6]) || r.round_trips != int(m[7]) {return math.INF_F64}
	return worst
}

backtest_reference_test :: proc(allocator: mem.Allocator) {
	seed_test(#procedure)
	fmt.println("\n=== Backtest: fills and ledger, strategies, metrics, rebalancing (independent pandas backtester) ===")
	context.allocator = allocator
	passed, total := 0, 0
	expect :: proc(passed, total: ^int, ok: bool, name: string) {
		total^ += 1
		if ok {passed^ += 1}
		fmt.printf("%s %s\n", "OK  " if ok else "FAIL", name)
	}
	df := _bt_frame()
	defer w.destroy_dataframe(&df)
	cfg := BT_CFG
	one := []string{"A"}
	// 1. Ledger: scripted orders through every position transition
	{
		r := fin.backtest_run(&df, one, _bt_script, cfg)
		e := _bt_eq_err(r.equity_curve, BT_EQ1[:])
		wins := 0
		for t in BT_TRIPS1 {if t > 0 {wins += 1}}
		wr := f64(wins) / f64(len(BT_TRIPS1))
		ok := e < 1e-12 && abs(r.win_rate - wr) < 1e-15 && r.total_trades == 7 && r.round_trips == len(BT_TRIPS1)
		expect(&passed, &total, ok, fmt.tprintf("scripted fills (add, partial sell, sell through zero into a short, add to the short, cover through zero into a long, close) at 20 bp commission / 10 bp slippage: equity curve max rel err %.1e, final %.2f (%.2f), %d round trips, win rate %.3f (old: hard-coded 10/5 bp costs, the short add overwrote the position and the over-cover paid for shares it never booked: final 96206.84)", e, r.equity_curve[BT_N - 1], BT_EQ1[BT_N - 1], len(BT_TRIPS1), r.win_rate))
	}

	// 2. SMA crossover: equity curve and every metric
	{
		r := fin.backtest_run(&df, one, _bt_sma, cfg)
		e := _bt_eq_err(r.equity_curve, BT_EQ2[:])
		m := _bt_metric_err(&r, BT_M2)
		expect(&passed, &total, e < 1e-12 && m < 1e-9, fmt.tprintf("SMA 10/30 crossover: equity max rel err %.1e; return %.4f%%, annual %.4f%%, Sharpe %.6f (%.6f), max DD %.4f%%, win rate %.3f, profit factor %.4f (%.4f), %d fills; metrics max rel err %.1e", e, 100 * r.total_return, 100 * r.annual_return, r.sharpe_ratio, BT_M2[2], 100 * r.max_drawdown, r.win_rate, r.profit_factor, BT_M2[5], r.total_trades, m))
	}

	// 3. Bollinger mean reversion and breakout momentum
	{
		ra := fin.backtest_run(&df, one, _bt_boll, cfg)
		rb := fin.backtest_run(&df, one, _bt_mom, cfg)
		ma, mb := _bt_metric_err(&ra, BT_M3A), _bt_metric_err(&rb, BT_M3B)
		expect(&passed, &total, ma < 1e-9 && mb < 1e-9, fmt.tprintf("Bollinger 20/2σ: return %.4f%% (%.4f%%), %d fills, win rate %.3f; 20-bar breakout: return %.4f%% (%.4f%%), %d fills, profit factor %.4f (%.4f); metrics max rel err %.1e / %.1e", 100 * ra.total_return, 100 * BT_M3A[0], ra.total_trades, ra.win_rate, 100 * rb.total_return, 100 * BT_M3B[0], rb.total_trades, rb.profit_factor, BT_M3B[5], ma, mb))
	}

	// 4. Long/short pairs trading
	{
		r := fin.backtest_run(&df, []string{"A", "B"}, _bt_pairs, cfg)
		e := _bt_eq_err(r.equity_curve, BT_EQ4[:])
		m := _bt_metric_err(&r, BT_M4)
		expect(&passed, &total, e < 1e-12 && m < 1e-9, fmt.tprintf("pairs_trading_full (A/B, 40 bars, entry 1.5σ, exit 0.3σ, short leg booked as a short): equity max rel err %.1e, return %.4f%% (%.4f%%), %d fills, win rate %.3f (%.3f)", e, 100 * r.total_return, 100 * BT_M4[0], r.total_trades, r.win_rate, BT_M4[4]))
	}

	// 5. Rebalancing: rolling minimum variance and equal weight
	{
		syms := []string{"A", "B", "C"}
		r5 := fin.backtest_portfolio_run(&df, syms, _bt_minvar, 21, cfg)
		r6 := fin.backtest_portfolio_run(&df, syms, _bt_eqw, 21, cfg)
		e5, e6 := _bt_eq_err(r5.equity_curve, BT_EQ5[:]), _bt_eq_err(r6.equity_curve, BT_EQ6[:])
		pf := fin.portfolio_init(cfg.initial_capital, allocator)
		ctx := fin.StrategyContext{portfolio = &pf, data = &df, current_bar = BT_N - 1, symbols = syms}
		wts := fin.portfolio_min_variance(&ctx, allocator, 120)
		dw := 0.0
		for s, i in syms {dw = max(dw, abs(wts[s] / 0.95 - BT_MV_LAST[i]))}
		expect(&passed, &total, e5 < 1e-6 && e6 < 1e-12 && dw < 1e-6, fmt.tprintf("rebalancing every 21 bars (sells before buys): min-variance equity max rel err %.1e, equal weight %.1e; min-variance weights at bar %d vs SLSQP on the asset covariance: %.4f/%.4f/%.4f, max diff %.1e (old: covariance taken across dates instead of assets, 0.3363/0.6637/0)", e5, e6, BT_N - 1, wts["A"] / 0.95, wts["B"] / 0.95, wts["C"] / 0.95, dw))
	}

	fmt.printf("Backtest summary: %d/%d passed\n", passed, total)
	record_failures(total - passed)
}
