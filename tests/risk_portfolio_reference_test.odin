risk_portfolio_reference_test :: proc(allocator: mem.Allocator) {
	seed_test(#procedure)
	fmt.println(
		"\n=== Risk portfolio: EWMA covariance, CVaR, min-CVaR, risk parity (scipy / numpy reference) ===",
	)
	context.allocator = allocator
	passed, total := 0, 0
	expect :: proc(passed, total: ^int, ok: bool, name: string) {
		total^ += 1
		if ok {passed^ += 1}
		fmt.printf("%s %s\n", "OK  " if ok else "FAIL", name)
	}
	sc := RP_SCAL

	X := l.matrix_new(f64, RP_T, RP_N)
	defer l.matrix_free(&X)
	copy(X.data, RP_X[:])
	cov := l.matrix_new(f64, RP_N, RP_N)
	defer l.matrix_free(&cov)
	copy(cov.data, RP_COV[:])

	// 1. EWMA covariance
	{
		E := fin.garch_adjusted_covariance(&X, 0.94)
		defer l.matrix_free(&E)
		worst := 0.0
		for v, i in E.data {worst = max(worst, abs(v - RP_EWMA[i]) / abs(RP_EWMA[i]))}
		expect(
			&passed,
			&total,
			worst < 1e-12,
			fmt.tprintf(
				"garch_adjusted_covariance (RiskMetrics EWMA, λ 0.94) vs numpy: max rel err %.1e",
				worst,
			),
		)
	}

	// 2. Historical CVaR (Acerbi-Tasche) and its gradient / Euler allocation
	{
		port := fin.portfolio_returns(RP_W0[:], &X, allocator)
		defer delete(port)
		cv := fin.portfolio_cvar_historical(port, RP_CONF)
		g := fin.cvar_gradient(RP_W0[:], &X, RP_CONF, allocator)
		defer delete(g)
		worst, euler := 0.0, 0.0
		for i in 0 ..< RP_N {
			worst = max(worst, abs(g[i] - RP_GR[i]) / abs(RP_GR[i]))
			euler += RP_W0[i] * g[i]
		}
		expect(
			&passed,
			&total,
			abs(cv - sc[0]) / sc[0] < 1e-13 && worst < 1e-12 && abs(euler - cv) < 1e-15,
			fmt.tprintf(
				"portfolio_cvar_historical at 97.5%% (αT = 18.75) vs numpy Acerbi-Tasche: %.6f (rel err %.1e); cvar_gradient max rel err %.1e, Σ w_i·∂_i = CVaR to %.1e",
				cv,
				abs(cv - sc[0]) / sc[0],
				worst,
				abs(euler - cv),
			),
		)
	}

	// 3. Minimum CVaR, long-only with a 50% cap, vs the LP optimum
	{
		c := fin.PortfolioConstraints {
			no_short_selling = true,
			max_weight       = 0.5,
		}
		w := fin.min_cvar_portfolio(&X, c, 0.95, allocator)
		defer delete(w)
		port := fin.portfolio_returns(w, &X, allocator)
		defer delete(port)
		cv := fin.portfolio_cvar_historical(port, 0.95)
		dw, sum, feas := 0.0, 0.0, true
		for i in 0 ..< RP_N {
			dw = max(dw, abs(w[i] - RP_LP_A_W[i]))
			sum += w[i]
			if w[i] < -1e-15 || w[i] > 0.5 + 1e-15 {feas = false}
		}
		expect(
			&passed,
			&total,
			(cv - sc[1]) / sc[1] < 1e-7 && feas && abs(sum - 1) < 1e-14,
			fmt.tprintf(
				"min_cvar_portfolio (95%%, long-only, cap 50%%): CVaR %.7f vs LP optimum %.7f (rel gap %.1e), max weight diff %.1e, feasible %v (old: stopped after one step at ≈ equal weights, CVaR %.5f)",
				cv,
				sc[1],
				(cv - sc[1]) / sc[1],
				dw,
				feas,
				sc[3],
			),
		)
	}

	// 4. Minimum CVaR with a group limit (assets 0-2 at most 40%)
	{
		grp := fin.GroupLimit {
			asset_indices = []int{0, 1, 2},
			max_weight    = 0.4,
		}
		c := fin.PortfolioConstraints {
			no_short_selling = true,
			group_limits     = []fin.GroupLimit{grp},
		}
		w := fin.min_cvar_portfolio(&X, c, RP_CONF, allocator)
		defer delete(w)
		port := fin.portfolio_returns(w, &X, allocator)
		defer delete(port)
		cv := fin.portfolio_cvar_historical(port, RP_CONF)
		dw := 0.0
		for i in 0 ..< RP_N {dw = max(dw, abs(w[i] - RP_LP_B_W[i]))}
		g := w[0] + w[1] + w[2]
		expect(
			&passed,
			&total,
			(cv - sc[2]) / sc[2] < 1e-7 && g <= 0.4 + 1e-12,
			fmt.tprintf(
				"min_cvar_portfolio (97.5%%, group 0-2 ≤ 40%%): CVaR %.7f vs LP %.7f (rel gap %.1e), max weight diff %.1e, group weight %.6f",
				cv,
				sc[2],
				(cv - sc[2]) / sc[2],
				dw,
				g,
			),
		)
	}

	// 5. Risk parity: equal contributions, risk budgets, a binding cap
	{
		none := fin.PortfolioConstraints{}
		w := fin.risk_parity_portfolio(&cov, none, allocator)
		wb := fin.risk_parity_portfolio(&cov, none, allocator, budgets = RP_BUD[:])
		capped := fin.risk_parity_portfolio(
			&cov,
			fin.PortfolioConstraints{no_short_selling = true, max_weight = RP_CAP},
			allocator,
		)
		rc := fin.risk_contributions(w, &cov, allocator)
		rb := fin.risk_contributions(wb, &cov, allocator)
		defer {delete(w); delete(wb); delete(capped); delete(rc); delete(rb)}
		vol, volb := 0.0, 0.0
		for i in 0 ..< RP_N {vol += rc[i]; volb += rb[i]}
		spread, bud, proj := 0.0, 0.0, 0.0
		for i in 0 ..< RP_N {
			spread = max(spread, abs(rc[i] / vol - 1.0 / RP_N))
			bud = max(bud, abs(rb[i] / volb - RP_BUD[i]))
			proj = max(proj, abs(capped[i] - RP_PROJ[i]))
		}
		expect(
			&passed,
			&total,
			spread < 1e-12 && bud < 1e-12 && proj < 1e-8,
			fmt.tprintf(
				"risk_parity_portfolio: contribution shares equal to %.1e, budgets 30/20/20/10/10/10%% met to %.1e, cap %.0f%% = SLSQP projection to %.1e (the old iteration also reached equal shares, spread %.0e, but its stopping test compared vol-unit contributions with 1/n and never fired, so it always ran all 1000 iterations)",
				spread,
				bud,
				100 * RP_CAP,
				proj,
				sc[4],
			),
		)
	}

	fmt.printf("Risk portfolio summary: %d/%d passed\n", passed, total)
	record_failures(total - passed)
}
