@(private = "file")
_di_date :: proc(serial: i32) -> w.Date {
	return w.civil_from_days(i64(serial) - 25569)
}

@(private = "file")
_DI_CALS := [5]fin.Calendar{{}, {.Weekends}, {.TARGET}, {.US_Settlement}, {.US_Government_Bond}}

dated_instruments_reference_test :: proc(allocator: mem.Allocator) {
	seed_test(#procedure)
	fmt.println(
		"\n=== Dated curve bootstrap, swaps, fixed-rate bonds, OIS / multi-curve (QuantLib reference) ===",
	)
	context.allocator = allocator
	passed, total := 0, 0
	expect :: proc(passed, total: ^int, ok: bool, name: string) {
		total^ += 1
		if ok {passed^ += 1}
		fmt.printf("%s %s\n", "OK  " if ok else "FAIL", name)
	}
	rel :: proc(x, y: f64) -> f64 {return abs(x - y) / max(abs(y), 1e-300)}

	eval := _di_date(DI_EVAL)
	conv := fin.SwapConventions {
		calendar         = {.TARGET},
		settlement_days  = 2,
		fixed_tenor      = {1, .Years},
		fixed_convention = .ModifiedFollowing,
		fixed_day_count  = .THIRTY_360,
		float_tenor      = {6, .Months},
		float_convention = .ModifiedFollowing,
		float_day_count  = .ACT_360,
	}
	quotes := [12]fin.CurveQuote {
		{.Deposit, {1, .Months}, DI_DEP[0]},
		{.Deposit, {3, .Months}, DI_DEP[1]},
		{.Deposit, {6, .Months}, DI_DEP[2]},
		{.Swap, {1, .Years}, DI_SWP[0]},
		{.Swap, {2, .Years}, DI_SWP[1]},
		{.Swap, {3, .Years}, DI_SWP[2]},
		{.Swap, {5, .Years}, DI_SWP[3]},
		{.Swap, {7, .Years}, DI_SWP[4]},
		{.Swap, {10, .Years}, DI_SWP[5]},
		{.Swap, {15, .Years}, DI_SWP[6]},
		{.Swap, {20, .Years}, DI_SWP[7]},
		{.Swap, {30, .Years}, DI_SWP[8]},
	}
	curve := fin.bootstrap_yield_curve_dated(eval, quotes[:], conv)
	defer fin.free_yield_curve(&curve, allocator)

	// 1. Bootstrap vs PiecewiseLinearZero
	{
		pillars_ok := true
		for t, i in curve.tenors {pillars_ok &&= abs(t - fin.date_to_time(eval, _di_date(DI_PILLAR[i]))) < 1e-15}
		worst_z, worst_df := 0.0, 0.0
		for z, i in curve.zero_rates {worst_z = max(worst_z, abs(z - DI_ZERO[i]))}
		for d, i in DI_DFD {worst_df = max(worst_df, rel(fin.yield_curve_discount_factor_date(&curve, _di_date(d)), DI_DF[i]))}
		// every instrument reprices on the curve
		spot := fin.swap_spot_date(conv, eval)
		worst_q := 0.0
		for q in quotes {
			implied: f64
			if q.kind == .Deposit {
				end := fin.calendar_advance_period(
					conv.calendar,
					spot,
					q.tenor,
					conv.float_convention,
				)
				implied =
					(fin.yield_curve_discount_factor_date(&curve, spot) /
							fin.yield_curve_discount_factor_date(&curve, end) -
						1.0) /
					fin.year_fraction(.ACT_360, spot, end)
			} else {
				sw := fin.make_dated_swap(conv, spot, q.tenor, q.rate)
				implied = fin.price_dated_swap(sw, &curve).par_swap_rate
				fin.free_dated_swap(&sw)
			}
			worst_q = max(worst_q, abs(implied - q.rate))
		}
		ok := pillars_ok && worst_z < 1e-11 && worst_df < 1e-10 && worst_q < 1e-14
		expect(
			&passed,
			&total,
			ok,
			fmt.tprintf(
				"EUR curve from 3 deposits + 9 swaps (TARGET T+2, fixed 1Y 30/360 vs 6M ACT/360) vs QuantLib PiecewiseLinearZero: pillar dates %v, max zero-rate diff %.1e, max DF rel diff %.1e over %d dates to 30Y; all 12 quotes reprice to %.1e",
				pillars_ok,
				worst_z,
				worst_df,
				len(DI_DFD),
				worst_q,
			),
		)
	}

	// 2. Swaps vs VanillaSwap
	{
		spot := fin.swap_spot_date(conv, eval)
		starts := [2]w.Date {
			fin.calendar_advance(conv.calendar, spot, 6, .Months, .ModifiedFollowing),
			_di_date(DI_SWI[2]),
		}
		tenors := [2]fin.Period{{7, .Years}, {5, .Years}}
		worst := 0.0
		starts_ok := true
		for k in 0 ..< 2 {
			f := DI_SWF[8 * k:8 * k + 8]
			c := conv
			c.end_of_month = DI_SWI[2 * k + 1] != 0
			starts_ok &&= starts[k] == _di_date(DI_SWI[2 * k])
			sw := fin.make_dated_swap(c, starts[k], tenors[k], f[0], f[2], .Payer, f[1])
			defer fin.free_dated_swap(&sw)
			r := fin.price_dated_swap(sw, &curve)
			got := [5]f64{r.pv_fixed_leg, r.pv_floating_leg, r.npv, r.par_swap_rate, r.pv01}
			want := [5]f64{abs(f[3]), f[4], f[5], f[6], f[7]}
			for j in 0 ..< 5 {worst = max(worst, abs(got[j] - want[j]) / max(abs(want[j]), 1e-300) if j != 2 else abs(got[j] - want[j]) / f[2])}
		}
		expect(
			&passed,
			&total,
			starts_ok && worst < 1e-9,
			fmt.tprintf(
				"6M-forward 7Y payer (+15bp spread) and 5Y end-of-month payer from 30 Jun vs QuantLib VanillaSwap: fixed / floating leg PV, NPV (per notional), fair rate, BPS max rel diff %.1e",
				worst,
			),
		)
	}

	// 3–4. Fixed-rate bonds vs FixedRateBond / BondFunctions
	names := [3]string {
		"UST-style 4.375% ACT/ACT ICMA semiannual, short first stub",
		"5.25% 30/360 US semiannual, long first coupon",
		"3.1% ACT/360 quarterly forward-generated, short last stub",
	}
	for b in 0 ..< 3 {
		a := DI_BI[14 * b:14 * b + 14]
		f := DI_BF[10 * b:10 * b + 10]
		first := _di_date(a[2]) if a[2] != 0 else w.Date{}
		sch := fin.make_schedule(
			_di_date(a[0]),
			_di_date(a[1]),
			{int(a[3]), .Months},
			_DI_CALS[a[4]],
			fin.BusinessDayConvention(a[5]),
			fin.BusinessDayConvention(a[5]),
			fin.DateGenerationRule(a[8]),
			first_date = first,
		)
		defer fin.free_schedule(&sch)
		bond := fin.DatedBond {
			100.0,
			f[0],
			sch,
			fin.DayCountConvention(a[6]),
			fin.BusinessDayConvention(a[5]),
			int(a[7]),
		}
		settle := fin.dated_bond_settlement_date(bond, eval)

		flows := fin.dated_bond_cashflows(bond)
		defer delete(flows)
		cf_ok := len(flows) == int(a[11]) && settle == _di_date(a[9])
		cf_err := 0.0
		if cf_ok {
			for fl, j in flows {
				cf_ok &&= fl.payment_date == _di_date(DI_BCFD[a[10] + i32(j)])
				cf_err = max(cf_err, abs(fl.amount - DI_BCFA[a[10] + i32(j)]))
			}
		}
		acc_err := 0.0
		for j in 0 ..< a[13] {
			d := _di_date(DI_BACCD[a[12] + j])
			acc_err = max(
				acc_err,
				abs(fin.dated_bond_accrued_interest(bond, d) - DI_BACCA[a[12] + j]),
			)
		}
		res := fin.price_dated_bond(bond, &curve, settle)
		clean2 := fin.dated_bond_clean_price(bond, f[5], settle)
		y_of := fin.dated_bond_yield(bond, 97.25, settle)
		dur, cvx := fin.dated_bond_duration_convexity(bond, f[5], settle)
		curve_err := max(
			abs(res.dirty_price - f[1]),
			abs(res.clean_price - f[2]),
			abs(res.accrued_interest - f[3]),
		)
		yield_err := max(abs(res.yield_to_maturity - f[4]), abs(y_of - f[7]))
		ok1 := cf_ok && cf_err < 1e-12 && acc_err < 1e-12
		ok2 :=
			curve_err < 1e-9 &&
			yield_err < 1e-10 &&
			abs(clean2 - f[6]) < 1e-10 &&
			rel(dur, f[8]) < 1e-10 &&
			rel(cvx, f[9]) < 1e-10
		expect(
			&passed,
			&total,
			ok1 && ok2,
			fmt.tprintf(
				"%s: %d cash flows (dates exact, amounts %.1e), accrued on %d dates %.1e; on the curve dirty %.6f (%.6f), yield %.8f%% (%.8f%%); clean at y + 123bp %.8f (%.8f), yield of 97.25 %.8f%% (%.8f%%), mod. duration %.8f (%.8f), convexity %.6f (%.6f)",
				names[b],
				len(flows),
				cf_err,
				a[13],
				acc_err,
				res.dirty_price,
				f[1],
				100 * res.yield_to_maturity,
				100 * f[4],
				clean2,
				f[6],
				100 * y_of,
				100 * f[7],
				dur,
				f[8],
				cvx,
				f[9],
			),
		)
	}

	// 6–7. Multi-curve: €STR OIS discounting curve, 6M Euribor projection curve
	// (indexed coupons, 2-day fixing lag) bootstrapped with OIS discounting
	ois_conv := fin.SwapConventions {
		calendar         = {.TARGET},
		settlement_days  = 2,
		fixed_tenor      = {1, .Years},
		fixed_convention = .ModifiedFollowing,
		fixed_day_count  = .ACT_360,
		float_tenor      = {1, .Years},
		float_convention = .ModifiedFollowing,
		float_day_count  = .ACT_360,
		payment_lag      = 1,
	}
	ois_tenors := [15]fin.Period {
		{1, .Weeks},
		{1, .Months},
		{3, .Months},
		{6, .Months},
		{9, .Months},
		{1, .Years},
		{18, .Months},
		{2, .Years},
		{3, .Years},
		{5, .Years},
		{7, .Years},
		{10, .Years},
		{15, .Years},
		{20, .Years},
		{30, .Years},
	}
	ois_quotes: [15]fin.CurveQuote
	for t, i in ois_tenors {ois_quotes[i] = {.Swap, t, DI_OISR[i]}}
	ois := fin.bootstrap_yield_curve_dated(eval, ois_quotes[:], ois_conv)
	defer fin.free_yield_curve(&ois, allocator)
	{
		pillars_ok := true
		for t, i in ois.tenors {pillars_ok &&= abs(t - fin.date_to_time(eval, _di_date(DI_OISP[i]))) < 1e-15}
		worst_z, worst_q := 0.0, 0.0
		for z, i in ois.zero_rates {worst_z = max(worst_z, abs(z - DI_OISZ[i]))}
		spot := fin.swap_spot_date(ois_conv, eval)
		for q in ois_quotes {
			sw := fin.make_dated_swap(ois_conv, spot, q.tenor, q.rate)
			worst_q = max(worst_q, abs(fin.price_dated_swap(sw, &ois).par_swap_rate - q.rate))
			fin.free_dated_swap(&sw)
		}
		expect(
			&passed,
			&total,
			pillars_ok && worst_z < 1e-11 && worst_q < 1e-14,
			fmt.tprintf(
				"€STR OIS curve, 15 swaps 1W-30Y (annual ACT/360, 1-day payment lag; pillars on the last payment) vs QuantLib OISRateHelper / PiecewiseLinearZero: pillar dates %v, max zero-rate diff %.1e, quotes reprice to %.1e",
				pillars_ok,
				worst_z,
				worst_q,
			),
		)
	}
	{
		e6_conv := conv
		e6_conv.fixing_days = 2
		e6_conv.indexed_coupons = true
		e6_quotes: [10]fin.CurveQuote
		e6_quotes[0] = {.Deposit, {6, .Months}, DI_E6R[0]}
		for i in 1 ..< 10 {e6_quotes[i] = {.Swap, quotes[i + 2].tenor, DI_E6R[i]}}
		e6 := fin.bootstrap_yield_curve_dated(eval, e6_quotes[:], e6_conv, &ois)
		defer fin.free_yield_curve(&e6, allocator)
		pillars_ok := true
		for t, i in e6.tenors {pillars_ok &&= abs(t - fin.date_to_time(eval, _di_date(DI_E6P[i]))) < 1e-15}
		worst_z, worst_q := 0.0, 0.0
		for z, i in e6.zero_rates {worst_z = max(worst_z, abs(z - DI_E6Z[i]))}
		spot := fin.swap_spot_date(e6_conv, eval)
		for q in e6_quotes[1:] {
			sw := fin.make_dated_swap(e6_conv, spot, q.tenor, q.rate)
			worst_q = max(worst_q, abs(fin.price_dated_swap(sw, &ois, &e6).par_swap_rate - q.rate))
			fin.free_dated_swap(&sw)
		}
		start := fin.calendar_advance(e6_conv.calendar, spot, 6, .Months, .ModifiedFollowing)
		sw := fin.make_dated_swap(e6_conv, start, {7, .Years}, 0.0265, 1e7, .Payer, 0.0015)
		defer fin.free_dated_swap(&sw)
		r := fin.price_dated_swap(sw, &ois, &e6)
		got := [5]f64{r.pv_fixed_leg, r.pv_floating_leg, r.npv, r.par_swap_rate, r.pv01}
		worst_s := 0.0
		for j in 0 ..< 5 {worst_s = max(worst_s, abs(got[j] - DI_MSW[j]) / (1e7 if j == 2 else abs(DI_MSW[j])))}
		single := fin.price_dated_swap(sw, &curve)
		ok := pillars_ok && worst_z < 1e-11 && worst_q < 1e-14 && worst_s < 1e-9
		expect(
			&passed,
			&total,
			ok,
			fmt.tprintf(
				"6M Euribor projection curve with OIS discounting and indexed coupons (fixing 2 days before accrual start, index period from the value date): pillar dates %v, max zero-rate diff %.1e, quotes reprice to %.1e; 6M-forward 7Y payer on both curves NPV %.2f (QuantLib %.2f), fair rate %.8f%% (%.8f%%), max rel diff %.1e (single-curve %.8f%%)",
				pillars_ok,
				worst_z,
				worst_q,
				r.npv,
				DI_MSW[2],
				100 * r.par_swap_rate,
				100 * DI_MSW[3],
				worst_s,
				100 * single.par_swap_rate,
			),
		)
	}

	fmt.printf("Dated instruments summary: %d/%d passed\n", passed, total)
	record_failures(total - passed)
}
