coint_var_reference_test :: proc(allocator: mem.Allocator) {
	seed_test(#procedure)
	fmt.println("\n=== VAR / Granger / Engle-Granger / Johansen vs statsmodels ===")
	context.allocator = allocator
	passed, total := 0, 0
	expect :: proc(passed, total: ^int, ok: bool, name: string) {
		total^ += 1
		if ok {passed^ += 1}
		fmt.printf("%s %s\n", "OK  " if ok else "FAIL", name)
	}
	close :: proc(got, want: []f64, rtol: f64) -> bool {
		if len(got) != len(want) do return false
		for g, i in got {if !(math.abs(g - want[i]) <= rtol * max(1, math.abs(want[i]))) do return false}
		return true
	}
	near :: proc(got, want, rtol: f64) -> bool {return(
			math.abs(got - want) <=
			rtol * max(1, math.abs(want)) \
		)}

	// --- general eigenvalues ---
	{
		G := l.Matrix(f64) {
			data = CV_G[:],
			rows = 7,
			cols = 7,
		}
		re, im, ok := l.eigvals_general(&G)
		used: [7]bool
		match := ok
		for i in 0 ..< 7 {
			best, bd := -1, math.INF_F64
			for j in 0 ..< 7 {
				if used[j] do continue
				d := math.hypot(re[j] - CV_EV_RE[i], im[j] - CV_EV_IM[i])
				if d < bd {bd = d; best = j}
			}
			if best < 0 || bd > 1e-10 {match = false; break}
			used[best] = true
		}
		expect(&passed, &total, match, "eigvals_general (7 × 7, complex pairs) = numpy eigvals")
	}

	// --- VAR ---
	Y := l.Matrix(f64) {
		data = CV_Y[:],
		rows = 150,
		cols = 3,
	}
	vr := ts.var_fit(&Y, 2)
	expect(
		&passed,
		&total,
		close(vr.params.data, CV_PARAMS[:], 1e-10) && close(vr.stderr.data, CV_STDERR[:], 1e-10),
		"VAR(2): params and stderr = statsmodels",
	)
	expect(
		&passed,
		&total,
		close(vr.sigma_u.data, CV_SIGMA[:], 1e-10),
		"VAR(2): sigma_u = statsmodels",
	)
	expect(
		&passed,
		&total,
		near(vr.llf, -609.6036715593041, 1e-10) &&
		near(vr.aic, 0.008040038059856536, 1e-10) &&
		near(vr.bic, 0.4333201579858458, 1e-10) &&
		near(vr.hqic, 0.18083036840737393, 1e-10) &&
		near(vr.fpe, 1.008286074951134, 1e-10),
		"VAR(2): llf, AIC, BIC, HQIC, FPE = statsmodels",
	)
	sel := ts.var_select_order(&Y, 5)
	expect(
		&passed,
		&total,
		sel.aic_lag == 1 &&
		sel.bic_lag == 1 &&
		sel.hqic_lag == 1 &&
		sel.fpe_lag == 1 &&
		close(sel.aic, CV_ICS_AIC[:], 1e-10) &&
		close(sel.bic, CV_ICS_BIC[:], 1e-10),
		"VAR select_order (common sample, lags 0 … 5) = statsmodels",
	)
	ts.var_lag_selection_free(&sel)
	pt, lo, hi := ts.var_forecast_interval(&vr, 5, 0.05)
	expect(
		&passed,
		&total,
		close(pt.data, CV_FC[:], 1e-10) &&
		close(lo.data, CV_LO[:], 1e-10) &&
		close(hi.data, CV_HI[:], 1e-10),
		"VAR forecast and 95 % interval = statsmodels",
	)
	{
		irf := ts.var_irf(&vr, 6)
		oirf := ts.var_irf(&vr, 6, true)
		flat := make([dynamic]f64)
		oflat := make([dynamic]f64)
		for h in 0 ..= 6 {
			append(&flat, ..irf[h].data)
			append(&oflat, ..oirf[h].data)
		}
		expect(
			&passed,
			&total,
			close(flat[:], CV_IRF[:], 1e-10) && close(oflat[:], CV_OIRF[:], 1e-10),
			"VAR impulse responses (plain and orthogonalised) = statsmodels",
		)
		ts.var_irf_free(irf)
		ts.var_irf_free(oirf)
	}
	stable, mm := ts.var_is_stable(&vr)
	expect(
		&passed,
		&total,
		stable == true && near(mm, 0.5470259154007028, 1e-10),
		fmt.tprintf("VAR stability: max |eigenvalue| of the companion matrix %.6f = numpy", mm),
	)
	tf := ts.var_test_causality(&vr, {0}, {1, 2}, .F)
	expect(
		&passed,
		&total,
		near(tf.statistic, 1.00735725437758, 1e-10) &&
		near(tf.p_value, 0.40333011320844636, 1e-9) &&
		tf.df_num == 4 &&
		tf.df_den == 423,
		"VAR test_causality (F) = statsmodels",
	)
	tw := ts.var_test_causality(&vr, {0, 2}, {1}, .Wald)
	expect(
		&passed,
		&total,
		near(tw.statistic, 10.002124381396477, 1e-10) &&
		near(tw.p_value, 0.04039191227150282, 1e-9),
		"VAR test_causality (Wald, two caused variables) = statsmodels",
	)
	ts.var_free(&vr)

	// --- bivariate Granger causality ---
	{
		y0 := make([]f64, 150)
		y1 := make([]f64, 150)
		for t in 0 ..< 150 {y0[t], y1[t] = CV_Y[t * 3], CV_Y[t * 3 + 1]}
		g := ts.granger_causality_test(y0, y1, 3)
		ok := len(g) == 3
		for r, i in g {
			want := CV_GC[i * 6:(i + 1) * 6]
			got := []f64{r.f_stat, r.f_pvalue, r.chi2_stat, r.chi2_pvalue, r.lr_stat, r.lr_pvalue}
			if !close(got, want, 1e-9) do ok = false
		}
		expect(
			&passed,
			&total,
			ok,
			"grangercausalitytests (ssr F, ssr χ², LR; lags 1 … 3) = statsmodels",
		)
	}

	// --- MacKinnon ---
	expect(
		&passed,
		&total,
		near(ts.mackinnon_pvalue(-3.1, .Constant, 2), 0.08830280765664933, 1e-12) &&
		near(ts.mackinnon_pvalue(-1.2, .ConstantTrend, 3), 0.9857903680537751, 1e-12) &&
		near(ts.mackinnon_pvalue(-5.5, .None, 1), 1.0486731415976314e-07, 1e-12) &&
		near(ts.mackinnon_pvalue(-2.0, .ConstantTrendSq, 4), 0.9812586861048996, 1e-12),
		"mackinnon_pvalue = statsmodels mackinnonp",
	)
	mc := ts.mackinnon_critical_values(3, .ConstantTrend, 150)
	expect(
		&passed,
		&total,
		close(mc[:], {-4.790357468444444, -4.19900424237037, -3.8959594657777776}, 1e-12),
		"mackinnon_critical_values = statsmodels mackinnoncrit",
	)

	// --- Engle-Granger ---
	{
		x1, x2, x3 := make([]f64, 200), make([]f64, 200), make([]f64, 200)
		for t in 0 ..< 200 {x1[t], x2[t], x3[t] = CV_L[t * 3], CV_L[t * 3 + 1], CV_L[t * 3 + 2]}
		a := ts.engle_granger(x2, {x1}, .Constant)
		expect(
			&passed,
			&total,
			near(a.statistic, -8.116692546435962, 1e-9) &&
			near(a.p_value, 1.5369072799439636e-11, 1e-9) &&
			close(a.crit[:], {-3.952321293401682, -3.3670063137294513, -3.065831247948284}, 1e-12),
			fmt.tprintf(
				"Engle-Granger (trend c, cointegrated: p = %.2e) = statsmodels coint",
				a.p_value,
			),
		)
		b := ts.engle_granger(x2, {x1, x3}, .ConstantTrend)
		expect(
			&passed,
			&total,
			near(b.statistic, -8.116857286083054, 1e-9) &&
			near(b.p_value, 2.08368372876408e-10, 1e-9) &&
			close(b.crit[:], {-4.758609717199162, -4.179130554707834, -3.8809096968631445}, 1e-12),
			"Engle-Granger (trend ct, two regressors) = statsmodels coint",
		)
		c := ts.engle_granger(x3, {x1}, .Constant)
		expect(
			&passed,
			&total,
			near(c.statistic, -2.4923514596528227, 1e-9) &&
			near(c.p_value, 0.2824526458503622, 1e-9),
			fmt.tprintf(
				"Engle-Granger (independent random walks: p = %.3f) = statsmodels coint",
				c.p_value,
			),
		)
		ts.engle_granger_free(&a)
		ts.engle_granger_free(&b)
		ts.engle_granger_free(&c)
	}

	// --- Johansen ---
	Lm := l.Matrix(f64) {
		data = CV_L[:],
		rows = 200,
		cols = 3,
	}
	check_jo :: proc(j: ^ts.JohansenResult, eig, lr1, lr2, cvt, cvm, evec: []f64) -> bool {
		if !close(j.eig, eig, 1e-9) || !close(j.trace_stat, lr1, 1e-9) || !close(j.max_eig_stat, lr2, 1e-9) do return false
		for i in 0 ..< 3 {
			if !close(j.trace_crit[i][:], cvt[i * 3:(i + 1) * 3], 1e-12) || !close(j.max_eig_crit[i][:], cvm[i * 3:(i + 1) * 3], 1e-12) do return false
		}
		// eigenvectors: equal up to the sign of each column
		for col in 0 ..< 3 {
			s := 1.0 if j.evec.data[col] * evec[col] >= 0 else -1.0
			for r in 0 ..< 3 {
				if !(math.abs(s * j.evec.data[r * 3 + col] - evec[r * 3 + col]) <= 1e-7 * max(1, math.abs(evec[r * 3 + col]))) do return false
			}
		}
		return true
	}
	jm := ts.johansen_test(&Lm, -1, 2)
	jp0 := ts.johansen_test(&Lm, 0, 2)
	jp1 := ts.johansen_test(&Lm, 1, 2)
	expect(
		&passed,
		&total,
		check_jo(
			&jm,
			CV_JO_EIG_M1[:],
			CV_JO_LR1_M1[:],
			CV_JO_LR2_M1[:],
			CV_JO_CVT_M1[:],
			CV_JO_CVM_M1[:],
			CV_JO_EVEC_M1[:],
		),
		"Johansen det_order -1 = statsmodels coint_johansen",
	)
	expect(
		&passed,
		&total,
		check_jo(
			&jp0,
			CV_JO_EIG_P0[:],
			CV_JO_LR1_P0[:],
			CV_JO_LR2_P0[:],
			CV_JO_CVT_P0[:],
			CV_JO_CVM_P0[:],
			CV_JO_EVEC_P0[:],
		),
		"Johansen det_order 0 = statsmodels coint_johansen",
	)
	expect(
		&passed,
		&total,
		check_jo(
			&jp1,
			CV_JO_EIG_P1[:],
			CV_JO_LR1_P1[:],
			CV_JO_LR2_P1[:],
			CV_JO_CVT_P1[:],
			CV_JO_CVM_P1[:],
			CV_JO_EVEC_P1[:],
		),
		"Johansen det_order 1 = statsmodels coint_johansen",
	)
	expect(
		&passed,
		&total,
		jp0.rank_trace == 1 && jp0.rank_max_eig == 1,
		fmt.tprintf(
			"Johansen finds cointegration rank 1 (trace %d, max-eig %d)",
			jp0.rank_trace,
			jp0.rank_max_eig,
		),
	)
	ts.johansen_free(&jm)
	ts.johansen_free(&jp0)
	ts.johansen_free(&jp1)

	fmt.printf("Cointegration / VAR summary: %d/%d passed\n", passed, total)
	record_failures(total - passed)
}
