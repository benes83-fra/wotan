ml_step6_reference_test :: proc(allocator: mem.Allocator) {
	seed_test(#procedure)
	fmt.println("\n=== ML predict_proba / RobustScaler / ElasticNet / early stopping ===")
	context.allocator = allocator
	passed, total := 0, 0
	expect :: proc(passed, total: ^int, ok: bool, name: string) {
		total^ += 1
		if ok {passed^ += 1}
		fmt.printf("%s %s\n", "OK  " if ok else "FAIL", name)
	}
	close :: proc(got, want: []f64, atol: f64) -> bool {
		if len(got) != len(want) do return false
		for g, i in got {
			if math.is_nan(want[i]) {if !math.is_nan(g) do return false; continue}
			if !(math.abs(g - want[i]) <= atol) do return false
		}
		return true
	}

	// --- predict_proba ---
	Xc := l.Matrix(f64){data = S6_XC[:], rows = 30, cols = 2}
	Xq := l.Matrix(f64){data = S6_XQ[:], rows = 6, cols = 2}
	ku := ml.knn_fit(&Xc, S6_YC[:], {k = 5})
	pu := ml.knn_predict_proba(&ku, &Xq)
	expect(&passed, &total, close(pu.data, S6_KNN_U[:], 1e-15), "KNN predict_proba (uniform, k = 5) = sklearn")
	kd := ml.knn_fit(&Xc, S6_YC[:], {k = 4, weights = .Distance})
	pd := ml.knn_predict_proba(&kd, &Xq)
	expect(&passed, &total, close(pd.data, S6_KNN_D[:], 1e-14), "KNN predict_proba (1/distance, zero-distance query) = sklearn")
	agree := true
	pr := ml.knn_predict(&kd, &Xq)
	for i in 0 ..< Xq.rows {
		best := 0
		for k in 1 ..< 3 {if pd.data[i * 3 + k] > pd.data[i * 3 + best] do best = k}
		if pr[i] != kd.classes[best] do agree = false
	}
	expect(&passed, &total, agree, "KNN predict = argmax of predict_proba")
	ml.knn_free(&ku)
	ml.knn_free(&kd)
	g := ml.gnb_fit(&Xc, S6_YC[:])
	pg := ml.gnb_predict_proba(&g, &Xq)
	expect(&passed, &total, close(pg.data, S6_GNB[:], 1e-12), "GaussianNB predict_proba = sklearn")
	ml.gnb_free(&g)

	// --- robust scaler ---
	Xr := l.Matrix(f64){data = S6_XR[:], rows = 12, cols = 3}
	rs := ml.robust_scaler_fit(&Xr)
	rt := ml.robust_scaler_transform(&rs, &Xr)
	expect(&passed, &total, close(rs.center, S6_RS_CENTER[:], 1e-15) && close(rs.scale, S6_RS_SCALE[:], 1e-14) && close(rt.data, S6_RS_T[:], 1e-14), "RobustScaler (outlier, NaN, constant column) = sklearn")
	back := ml.robust_scaler_inverse_transform(&rs, &rt)
	expect(&passed, &total, close(back.data, S6_XR[:], 1e-13), "RobustScaler inverse_transform restores X")
	ml.robust_scaler_free(&rs)

	// --- elastic net ---
	Xe := l.Matrix(f64){data = S6_XE[:], rows = 50, cols = 5}
	en := ml.elastic_net_fit(&Xe, S6_YE[:], 6.0, 0.4, 100000, 1e-12)
	expect(&passed, &total, close(en.beta, S6_BETA_EN[:], 1e-8), "ElasticNet coefficients = sklearn ElasticNet(alpha = λ/n, l1_ratio)")
	ssr := 0.0
	for r in en.residuals {ssr += r * r}
	df := f64(50) - ssr / en.sigma2 // σ² = SSR / (n - df)
	expect(&passed, &total, math.abs(df - 3.6280726394799903) <= 1e-6, fmt.tprintf("ElasticNet df = tr[(X_AᵀX_A + λ(1-ρ)M)⁻¹ X_AᵀX_A] (%.6f)", df))
	en0 := ml.elastic_net_fit(&Xe, S6_YE[:], 2.5, 0, 100000, 1e-13)
	rd := ml.ridge_fit(&Xe, S6_YE[:], 2.5)
	expect(&passed, &total, close(en0.beta, rd.beta, 1e-9), "ElasticNet with l1_ratio = 0 = ridge")

	path := "ml_step6_test_model.wotan"
	defer os.remove(path)
	{
		Xraw := l.Matrix(f64){data = S6_XE_RAW[:], rows = 50, cols = 4}
		pipe := ml.pipeline_new()
		ml.pipeline_add_robust_scaler(&pipe)
		ml.pipeline_set_elastic_net(&pipe, {lambda = 6.0, l1_ratio = 0.4, max_iter = 100000, tol = 1e-12})
		ml.pipeline_fit(&pipe, &Xraw, S6_YE[:])
		before := ml.pipeline_predict(&pipe, &Xraw)
		expect(&passed, &total, close(before, S6_PIPE[:], 1e-8), "Pipeline(RobustScaler, ElasticNet) = sklearn")
		ok := ml.pipeline_save(&pipe, path)
		loaded, lok := ml.pipeline_load(path)
		after := ml.pipeline_predict(&loaded, &Xraw)
		same := ok && lok
		for v, i in before {if transmute(u64)v != transmute(u64)after[i] do same = false}
		expect(&passed, &total, same, "Pipeline(RobustScaler, ElasticNet) save/load is bit-exact")
		ml.pipeline_free(&loaded)
		ml.pipeline_free(&pipe)
	}

	// --- gradient boosting early stopping ---
	Xg := l.Matrix(f64){data = S6_XG[:], rows = 120, cols = 3}
	{
		_, va := ml.holdout_split(120, S6_YG[:], 0.2, false, 11)
		_, vb := ml.holdout_split(120, S6_YGB[:], 0.2, true, 11)
		same_r, same_c := len(va) == len(S6_VAL_R), len(vb) == len(S6_VAL_C)
		for v, i in va {if same_r && v != S6_VAL_R[i] do same_r = false}
		for v, i in vb {if same_c && v != S6_VAL_C[i] do same_c = false}
		expect(&passed, &total, same_r && same_c, "holdout_split (plain and stratified) = its Python replica")
	}
	gp := ml.GBParams{n_estimators = 200, learning_rate = 0.3, max_depth = 3, min_samples = 10, subsample = 1, n_iter_no_change = 5, validation_fraction = 0.2, tol = 0.0001, random_state = 11}
	gr := ml.gb_fit(&Xg, S6_YG[:], gp)
	expect(&passed, &total, gr.n_estimators == 12 && close(ml.gb_predict(&gr, &Xg), S6_GB_R[:], 1e-12), fmt.tprintf("GB regressor stops after %d of 200 stages, as sklearn's rule (expected 12)", gr.n_estimators))
	ml.gb_free(&gr)
	gpc := gp
	gpc.loss = .Log_Loss
	gc := ml.gb_fit(&Xg, S6_YGB[:], gpc)
	pgc := ml.gb_predict_proba(&gc, &Xg)
	expect(&passed, &total, gc.n_estimators == 8 && close(pgc.data, S6_GB_C[:], 1e-12), fmt.tprintf("GB classifier (stratified split) stops after %d stages, as sklearn's rule (expected 8)", gc.n_estimators))
	ml.gb_free(&gc)

	// --- MLP early stopping ---
	{
		mp := ml.MLPParams{hidden_layers = {16}, activation = .Tanh, output_activation = .Linear, task = .Regression, learning_rate = 0.05, max_iter = 2000, optimizer_type = .Adam, early_stopping = true, n_iter_no_change = 10, validation_fraction = 0.2, random_state = 3}
		m := ml.mlp_fit(&Xg, S6_YG[:], mp)
		// the returned weights are the best epoch's: their validation R² is best_validation_score
		_, va := ml.holdout_split(120, S6_YG[:], 0.2, false, 3)
		Xv := ml.subset_matrix(&Xg, va)
		yv := ml.subset_slice(S6_YG[:], va)
		r2 := ml.metrics_r2(yv, ml.mlp_predict(&m, &Xv))
		expect(&passed, &total, m.n_iter < 2000 && math.abs(r2 - m.best_validation_score) <= 1e-12, fmt.tprintf("MLP early stopping: stopped after %d epochs, returned weights score the best validation R² (%.4f)", m.n_iter, m.best_validation_score))
		ml.mlp_free(&m)
		mp.early_stopping = false
		mp.max_iter = 50
		m2 := ml.mlp_fit(&Xg, S6_YG[:], mp)
		expect(&passed, &total, m2.n_iter == 50 && math.is_nan(m2.best_validation_score), "MLP without early stopping runs all epochs")
		ml.mlp_free(&m2)
	}

	fmt.printf("ML step-6 summary: %d/%d passed\n", passed, total)
	record_failures(total - passed)
}
