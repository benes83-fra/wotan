package tests

// Generated by gen_yc_test.py: independent brentq bootstrap (linear zero interpolation,
// backward coupon schedules) and explicit cash-flow swap valuation.

import fin "../wotan/finance"
import "core:fmt"
import "core:math"
import "core:mem"

@(private = "file")
YC_TEN := [?]f64{0.16666666666666666, 0.5, 1.0, 2.0, 3.0, 5.0, 7.0, 10.0, 30.0}
@(private = "file")
YC_PAR := [?]f64{0.045, 0.046, 0.0455, 0.044, 0.043, 0.0425, 0.043, 0.044, 0.045}
@(private = "file")
YC_Z := [?]f64 {
	0.045452404359716134,
	0.046373088446290595,
	0.04586338883296825,
	0.04432254979904494,
	0.04328689234008998,
	0.04277877927555703,
	0.043364406610188456,
	0.044552022667277924,
	0.04587688382244041,
}
@(private = "file")
YC_SWAP := [?]f64 {
	2064307.6647960916,
	2278061.336103389,
	213753.67130729742,
	0.046348990389372645,
	4915.018249514504,
	3.7676750464723674,
	16.987036419601452,
	3.7676750478985745,
	16.987035334988136,
}
@(private = "file")
YC_SPOT := [?]f64{0.04299999999999997, 608.8549910492266, 6.070913177192036, 0.041762553146491195}

swaps_yield_curve_reference_test :: proc(allocator: mem.Allocator) {
	seed_test(#procedure)
	fmt.println(
		"\n=== Swaps & yield curve: bootstrap, repricing, leg valuation, duration (independent scipy reference) ===",
	)
	context.allocator = allocator
	passed, total := 0, 0
	expect :: proc(passed, total: ^int, ok: bool, name: string) {
		total^ += 1
		if ok {passed^ += 1}
		fmt.printf("%s %s\n", "OK  " if ok else "FAIL", name)
	}
	rel :: proc(x, y: f64) -> f64 {return abs(x - y) / max(abs(y), 1e-300)}
	curve := fin.bootstrap_yield_curve_from_swaps(YC_TEN[:], YC_PAR[:], 0.25, .ACT_360)
	defer fin.free_yield_curve(&curve, allocator)

	// 1. Bootstrapped zero rates
	{
		worst := 0.0
		for z, i in curve.zero_rates {worst = max(worst, abs(z - YC_Z[i]))}
		expect(
			&passed,
			&total,
			worst < 1e-13,
			fmt.tprintf(
				"bootstrap (2M deposit … 30Y, quarterly ACT/360) vs scipy brentq: max zero-rate diff %.1e; 2M %.6f%% (old 0%%: no coupon date inside one period), 30Y %.6f%%",
				worst,
				100 * curve.zero_rates[0],
				100 * curve.zero_rates[8],
			),
		)
	}

	// 2. Every input swap reprices to par on the curve
	{
		worst_rate, worst_npv := 0.0, 0.0
		for T, i in YC_TEN {
			worst_rate = max(
				worst_rate,
				abs(fin.compute_par_swap_rate(T, &curve, 0.25, .ACT_360) - YC_PAR[i]),
			)
			r := fin.price_swap(fin.create_payer_swap(1e7, YC_PAR[i], T, 0.25, .ACT_360), &curve)
			worst_npv = max(worst_npv, abs(r.npv))
		}
		expect(
			&passed,
			&total,
			worst_rate < 1e-14 && worst_npv < 1e-6,
			fmt.tprintf(
				"all 9 input swaps reprice: max par-rate error %.1e (old 450bp at 2M, 6.1bp at 6M, 4bp at 30Y: coupons past the last solved pillar were extrapolated flat), max NPV on $10M %.1e",
				worst_rate,
				worst_npv,
			),
		)
	}

	// 3. Forward-start swap with a stub and mixed leg conventions
	swap := fin.InterestRateSwap {
		notional = 1e7,
		effective_date = 0.5,
		maturity = 6.3,
		payer_leg = fin.SwapLeg {
			leg_type = .Fixed,
			fixed_rate = 0.042,
			payment_frequency = 1.0,
			day_count = .ACT_365,
		},
		receiver_leg = fin.SwapLeg {
			leg_type = .Floating,
			floating_spread = 0.0025,
			payment_frequency = 0.25,
			day_count = .ACT_360,
		},
		direction = .Payer,
	}
	{
		r := fin.price_swap(swap, &curve)
		got := [5]f64{r.pv_fixed_leg, r.pv_floating_leg, r.npv, r.par_swap_rate, r.pv01}
		worst := 0.0
		for k in 0 ..< 5 {worst = max(worst, rel(got[k], YC_SWAP[k]))}
		expect(
			&passed,
			&total,
			worst < 1e-12,
			fmt.tprintf(
				"6M×6.3Y payer (annual ACT/365 fixed 4.2%%, 3M ACT/360 + 25bp): fixed leg %.4f, floating leg %.4f, NPV %.4f, par %.8f%%, PV01 %.4f vs cash-flow reference, max rel err %.1e (old: par rate and PV01 on the floating leg's schedule, the 0.8Y stub dropped, leg PVs reported as 0)",
				r.pv_fixed_leg,
				r.pv_floating_leg,
				r.npv,
				100 * r.par_swap_rate,
				r.pv01,
				worst,
			),
		)
	}

	// 4. Duration and convexity
	{
		r := fin.price_swap(swap, &curve)
		d7 := fin.compute_swap_duration(7.0, &curve, 0.25, .ACT_360)
		ok :=
			rel(r.modified_duration, YC_SWAP[5]) < 1e-12 &&
			rel(r.modified_duration, YC_SWAP[7]) < 1e-8 &&
			rel(r.convexity, YC_SWAP[6]) < 1e-12 &&
			rel(r.convexity, YC_SWAP[8]) < 1e-6 &&
			rel(d7, YC_SPOT[2]) < 1e-12
		expect(
			&passed,
			&total,
			ok,
			fmt.tprintf(
				"fixed-leg duration %.8f / convexity %.6f vs ±0.1bp parallel-zero-shift differences %.8f / %.6f (old divided a continuous-compounding duration by 1 + S·f; convexity 0); 7Y par-bond duration %.6f (%.6f; old (1 − DF)/(S·A) ≡ 1)",
				r.modified_duration,
				r.convexity,
				YC_SWAP[7],
				YC_SWAP[8],
				d7,
				YC_SPOT[2],
			),
		)
	}

	// 5. Spot metrics and forward rate
	{
		s7 := fin.compute_par_swap_rate(7.0, &curve, 0.25, .ACT_360)
		pv01 := fin.compute_swap_pv01(7.0, 1e6, &curve, 0.25, .ACT_360)
		fwd := fin.yield_curve_forward_rate(&curve, 4.0, 5.0)
		ok :=
			rel(s7, YC_SPOT[0]) < 1e-12 &&
			rel(pv01, YC_SPOT[1]) < 1e-12 &&
			rel(fwd, YC_SPOT[3]) < 1e-12
		expect(
			&passed,
			&total,
			ok,
			fmt.tprintf(
				"7Y par rate %.8f%% (input 4.3%%), PV01 per $1M $%.6f ($%.6f), 4Y→5Y forward %.8f%% = ln(DF4/DF5) %.8f%%",
				100 * s7,
				pv01,
				YC_SPOT[1],
				100 * fwd,
				100 * YC_SPOT[3],
			),
		)
	}

	fmt.printf("Swaps / yield curve summary: %d/%d passed\n", passed, total)
	record_failures(total - passed)
}
