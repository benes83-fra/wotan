package tests

// Generated by gen_prob_test.py: torch / scipy (float64) probabilistic losses and scores.

import l "../wotan/linalg"
import ml_fin "../wotan/ml_finance"
import nn "../wotan/nn"
import optim "../wotan/optimize"
import t "../wotan/tensor"
import "core:fmt"
import "core:math"
import "core:math/rand"
import "core:mem"
import "core:slice"

@(private = "file")
PF_NLL_MU := [?]f64 {
	-0.8019314252534474,
	-1.324358995628145,
	-0.24836162209524854,
	0.4204452380655215,
	1.1360465324896427,
	0.10970639932180819,
}
@(private = "file")
