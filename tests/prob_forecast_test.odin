@(private = "file")
PF_CLOSED := [?]f64 {
	0.001,
	0.02,
	0.05,
	-0.03,
	-0.03189707253902946,
	0.03189707253902946,
	0.04025425615014851,
	0.02076118136079664,
	-1.791834472223473,
	-0.5,
	1.3,
	0.01,
