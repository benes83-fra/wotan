@(private = "file")
PF_PIN_LOSS := [?]f64{0.5647146507371669}
@(private = "file")
PF_PIN_DP := [?]f64 {
	0.049999999999999996,
	0.027777777777777776,
	0.005555555555555554,
	0.049999999999999996,
	0.027777777777777776,
	0.005555555555555554,
	0.049999999999999996,
	0.027777777777777776,
	-0.049999999999999996,
	0.049999999999999996,
	0.027777777777777776,
	0.005555555555555554,
	-0.005555555555555556,
	-0.027777777777777776,
