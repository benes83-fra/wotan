ml_weights_reference_test :: proc(allocator: mem.Allocator) {
	seed_test(#procedure)
	fmt.println("\n=== ML Sample / Class Weights vs sklearn ===")
	context.allocator = allocator
	passed, total := 0, 0
	expect :: proc(passed, total: ^int, ok: bool, name: string) {
		total^ += 1
		if ok {passed^ += 1}
		fmt.printf("%s %s\n", "OK  " if ok else "FAIL", name)
	}
	close :: proc(got, want: []f64, atol: f64) -> bool {
		if len(got) != len(want) do return false
		for g, i in got {if !(math.abs(g - want[i]) <= atol) do return false}
		return true
	}
	maxdiff :: proc(got, want: []f64) -> f64 {
		m := 0.0
		for g, i in got {m = max(m, math.abs(g - want[i]))}
		return m
	}

	X := l.Matrix(f64) {
		data = W_X[:],
		rows = 36,
		cols = 3,
	}
	yb, ypm, y3, yr, w, wt := W_YB[:], W_YPM[:], W_Y3[:], W_YR[:], W_W[:], W_WT[:]

	// --- logistic regression ---
	lp := ml.LogisticParams {
		C              = 0.7,
		max_iter       = 2000,
		tol            = 1e-10,
		learning_rate  = 1,
		fit_intercept  = true,
		optimizer_type = .LBFGS,
	}
	lw := ml.logistic_fit(&X, yb, lp, sample_weight = w)
	expect(
		&passed,
		&total,
		close(lw.weights, W_LOG_W[:3], 1e-6) && math.abs(lw.bias - W_LOG_W[3]) <= 1e-6,
		fmt.tprintf(
			"logistic, sample_weight = exact optimum (max |Δ| %.1e)",
			max(maxdiff(lw.weights, W_LOG_W[:3]), math.abs(lw.bias - W_LOG_W[3])),
		),
	)
	lpb := lp
	lpb.class_weight = .Balanced
	lb := ml.logistic_fit(&X, yb, lpb, sample_weight = w)
	expect(
		&passed,
		&total,
		close(lb.weights, W_LOG_BAL[:3], 1e-6) && math.abs(lb.bias - W_LOG_BAL[3]) <= 1e-6,
		"logistic, sample_weight × balanced class weights = exact optimum",
	)
	ml.logistic_free(&lw)
	ml.logistic_free(&lb)

	// --- trees ---
	dw := ml.dt_fit(
		&X,
		y3,
		{max_depth = 3, min_samples = 2, criterion = .Gini},
		sample_weight = wt,
	)
	pw := ml.dt_predict_proba(&dw, &X)
	expect(
		&passed,
		&total,
		close(pw.data, W_DT_CLS_W[:], 1e-14),
		"decision tree classifier, sample_weight: predict_proba = sklearn",
	)
	db := ml.dt_fit(
		&X,
		y3,
		{max_depth = 3, min_samples = 2, criterion = .Gini, class_weight = .Balanced},
	)
	pb := ml.dt_predict_proba(&db, &X)
	expect(
		&passed,
		&total,
		close(pb.data, W_DT_CLS_BAL[:], 1e-14),
		"decision tree classifier, class_weight balanced = sklearn",
	)
	dr := ml.dt_fit(&X, yr, {max_depth = 3, min_samples = 2}, sample_weight = wt)
	expect(
		&passed,
		&total,
		close(ml.dt_predict(&dr, &X), W_DT_REG_W[:], 1e-13),
		"decision tree regressor, sample_weight = sklearn",
	)

	// integer weights = duplicated rows (no zeros: a zero-weight row still adds a
	// candidate threshold, so split midpoints could differ)
	{
		wi := make([]f64, X.rows)
		rows := make([dynamic]int)
		for i in 0 ..< X.rows {
			wi[i] = f64(1 + i % 3)
			for _ in 0 ..< 1 + i % 3 do append(&rows, i)
		}
		Xd := ml.subset_matrix(&X, rows[:])
		yd := ml.subset_slice(y3, rows[:])
		a := ml.dt_fit(
			&X,
			y3,
			{max_depth = 4, min_samples = 2, criterion = .Entropy},
			sample_weight = wi,
		)
		b := ml.dt_fit(&Xd, yd, {max_depth = 4, min_samples = 2, criterion = .Entropy})
		pa := ml.dt_predict_proba(&a, &X)
		pbb := ml.dt_predict_proba(&b, &X)
		expect(
			&passed,
			&total,
			close(pa.data, pbb.data, 1e-15),
			"integer weights 1/2/3 = rows repeated 1/2/3 times",
		)
		ml.dt_free(&a)
		ml.dt_free(&b)
	}

	// a forest without bootstrap / feature sampling is the weighted tree
	rf := ml.rf_fit(
		&X,
		y3,
		{n_trees = 3, max_features = 3, max_depth = 3, min_samples = 2, criterion = .Gini},
		sample_weight = wt,
	)
	prf := ml.rf_predict_proba(&rf, &X)
	expect(
		&passed,
		&total,
		close(prf.data, W_DT_CLS_W[:], 1e-14),
		"random forest (no randomness), sample_weight = weighted tree",
	)
	ml.rf_free(&rf)
	ml.dt_free(&dw)
	ml.dt_free(&db)
	ml.dt_free(&dr)

	// --- gradient boosting ---
	gr := ml.gb_fit(
		&X,
		yr,
		{n_estimators = 15, learning_rate = 0.2, max_depth = 2, min_samples = 2, subsample = 1},
		sample_weight = wt,
	)
	expect(
		&passed,
		&total,
		close(ml.gb_predict(&gr, &X), W_GB_REG_W[:], 1e-12),
		"gradient boosting regressor, sample_weight = sklearn",
	)
	ml.gb_free(&gr)
	gc := ml.gb_fit(
		&X,
		yb,
		{
			n_estimators = 15,
			learning_rate = 0.2,
			max_depth = 2,
			min_samples = 2,
			subsample = 1,
			loss = .Log_Loss,
		},
		sample_weight = wt,
	)
	pgc := ml.gb_predict_proba(&gc, &X)
	expect(
		&passed,
		&total,
		close(pgc.data, W_GB_CLS_W[:], 1e-12),
		"gradient boosting classifier (binary), sample_weight = sklearn",
	)
	ml.gb_free(&gc)
	g3 := ml.gb_fit(
		&X,
		y3,
		{
			n_estimators = 10,
			learning_rate = 0.2,
			max_depth = 2,
			min_samples = 2,
			subsample = 1,
			loss = .Log_Loss,
		},
		sample_weight = wt,
	)
	pg3 := ml.gb_predict_proba(&g3, &X)
	expect(
		&passed,
		&total,
		close(pg3.data, W_GB3_W[:], 1e-12),
		"gradient boosting classifier (3 classes), sample_weight = sklearn",
	)
	ml.gb_free(&g3)

	// --- SVMs ---
	kp := ml.KernelSVMParams {
		C           = 2,
		kernel_type = .RBF,
		gamma       = 0.4,
		tol         = 1e-8,
	}
	ks := ml.kernel_svm_fit(&X, ypm, kp, sample_weight = w)
	dks := ml.kernel_svm_predict(&ks, &X)
	sv_ok := true
	for sv in ks.support_vectors {if w[sv] == 0 do sv_ok = false}
	expect(
		&passed,
		&total,
		close(dks, W_SVC_RBF_W[:], 1e-6) && sv_ok,
		fmt.tprintf(
			"SVC (RBF), sample_weight: decision = sklearn (max |Δ| %.1e), zero-weight rows dropped",
			maxdiff(dks, W_SVC_RBF_W[:]),
		),
	)
	ml.kernel_svm_free(&ks)
	kpb := kp
	kpb.class_weight = .Balanced
	kb := ml.kernel_svm_fit(&X, ypm, kpb)
	expect(
		&passed,
		&total,
		close(ml.kernel_svm_predict(&kb, &X), W_SVC_RBF_BAL[:], 1e-6),
		"SVC (RBF), class_weight balanced = sklearn",
	)
	ml.kernel_svm_free(&kb)
	ls := ml.svm_fit_linear(
		&X,
		ypm,
		{C = 0.5, tol = 1e-8, fit_intercept = true},
		sample_weight = w,
	)
	expect(
		&passed,
		&total,
		close(ml.svm_predict_linear(&ls, &X), W_SVC_LIN_W[:], 1e-6),
		"linear SVM, sample_weight = sklearn SVC(kernel=linear)",
	)
	ml.svm_free(&ls)
	sr := ml.svr_fit(
		&X,
		yr,
		{C = 3, epsilon = 0.2, kernel_type = .RBF, gamma = 0.3, tol = 1e-8},
		sample_weight = w,
	)
	expect(
		&passed,
		&total,
		close(ml.svr_predict(&sr, &X), W_SVR_W[:], 1e-6),
		"SVR, sample_weight = sklearn",
	)
	ml.svr_free(&sr)

	// pipeline routes the weights to the model (= fitting the model directly)
	{
		pipe := ml.pipeline_new()
		ml.pipeline_set_decision_tree(&pipe, {max_depth = 3, min_samples = 2, criterion = .Gini})
		ml.pipeline_fit(&pipe, &X, y3, wt)
		t := ml.dt_fit(
			&X,
			y3,
			{max_depth = 3, min_samples = 2, criterion = .Gini},
			sample_weight = wt,
		)
		expect(
			&passed,
			&total,
			close(ml.pipeline_predict(&pipe, &X), ml.dt_predict(&t, &X), 0),
			"pipeline_fit passes sample_weight to the model",
		)
		ml.dt_free(&t)
		ml.pipeline_free(&pipe)
	}

	fmt.printf("ML weights summary: %d/%d passed\n", passed, total)
	record_failures(total - passed)
}
