@(private = "file")
OP_SIZES :: [3]int{6, 3, 4}

@(private = "file")
_op_params :: proc(allocator: mem.Allocator) -> [3]^t.Tensor {
	ps: [3]^t.Tensor
	k := 0
	for n, i in OP_SIZES {
		m := l.matrix_new(f64, 1, n, allocator)
		copy(m.data, OP_P0[k:k + n])
		ps[i] = t.tensor_new(m, true, allocator)
		k += n
	}
	return ps
}

@(private = "file")
_op_set_grads :: proc(ps: [3]^t.Tensor, step: int) {
	k := step * 13
	for p in ps {
		n := len(p.grad.data)
		copy(p.grad.data, OP_G[k:k + n])
		k += n
	}
}

// Max deviation of the parameters from ref, then frees them
@(private = "file")
_op_diff_free :: proc(ps: [3]^t.Tensor, ref: []f64) -> f64 {
	worst, k := 0.0, 0
	for p in ps {
		for x in p.data.data {
			worst = max(worst, abs(x - ref[k]))
			k += 1
		}
		t.tensor_free(p)
	}
	return worst
}

@(private = "file")
_op_train :: proc(seq: ^nn.Sequential, opt: ^nn.Adam, x, y: ^t.Tensor, losses: []f64) {
	for &loss_out in losses {
		loss := t.tensor_mse_loss(nn.sequential_forward(seq, x), y)
		loss_out = loss.data.data[0]
		t.tensor_backward(loss)
		nn.clip_grad_norm(opt, 0.5)
		nn.adam_step(opt)
		t.tensor_free_graph(loss)
		nn.adam_zero_grad(opt)
	}
}

optimizers_reference_test :: proc(allocator: mem.Allocator) {
	seed_test(#procedure)
	fmt.println("\n=== Optimizers (torch.optim reference) ===")
	context.allocator = allocator
	passed, total := 0, 0
	expect :: proc(passed, total: ^int, ok: bool, name: string) {
		total^ += 1
		if ok {passed^ += 1}
		fmt.printf("%s %s\n", "OK  " if ok else "FAIL", name)
	}
	T :: 25

	// 1. Adam, one parameter with its own learning rate (registered last)
	{
		ps := _op_params(allocator)
		opt := nn.adam_new(0.01, allocator = allocator)
		defer nn.adam_free(&opt)
		nn.adam_add_param(&opt, ps[0])
		nn.adam_add_param(&opt, ps[1])
		nn.adam_add_param_with_lr(&opt, ps[2], 0.05)
		for s in 0 ..< T {
			_op_set_grads(ps, s)
			nn.adam_step(&opt)
		}
		d := _op_diff_free(ps, OP_OPT[0:13])
		old := 0.0
		for x, i in OP_OLD {old = max(old, abs(x - OP_OPT[i]))}
		expect(&passed, &total, d < 1e-14, fmt.tprintf("Adam (lr 0.01, one parameter at 0.05), 25 steps with gradient norms up to 84: max diff %.1e (the former built-in per-parameter clipping: %.2f)", d, old))
	}

	// 2. AdamW
	{
		ps := _op_params(allocator)
		opt := nn.adam_new(0.01, 0.8, 0.99, 1e-6, allocator, weight_decay = 0.1)
		defer nn.adam_free(&opt)
		for p in ps {nn.adam_add_param(&opt, p)}
		for s in 0 ..< T {
			_op_set_grads(ps, s)
			nn.adam_step(&opt)
		}
		d := _op_diff_free(ps, OP_OPT[13:26])
		expect(&passed, &total, d < 1e-14, fmt.tprintf("AdamW (β = 0.8/0.99, ε = 1e-6, λ = 0.1): max diff %.1e", d))
	}

	// 3. SGD: plain, momentum + weight decay, Nesterov
	{
		cfg := [3][3]f64{{0, 0, 0}, {0.9, 0.01, 0}, {0.9, 0.01, 1}}
		msg := ""
		ok := true
		for c, ci in cfg {
			ps := _op_params(allocator)
			opt := nn.sgd_new(0.05, allocator, momentum = c[0], weight_decay = c[1], nesterov = c[2] > 0)
			for p in ps {nn.sgd_add_param(&opt, p)}
			for s in 0 ..< T {
				_op_set_grads(ps, s)
				nn.sgd_step(&opt)
			}
			nn.sgd_free(&opt)
			d := _op_diff_free(ps, OP_OPT[(2 + ci) * 13:(3 + ci) * 13])
			ok &&= d < 1e-12
			msg = fmt.tprintf("%s%s %.1e", msg, "," if ci > 0 else "", d)
		}
		expect(&passed, &total, ok, fmt.tprintf("SGD plain / momentum 0.9 + λ 0.01 / Nesterov: max diff%s", msg))
	}

	// 4. Global gradient clipping before Adam
	{
		ps := _op_params(allocator)
		opt := nn.adam_new(0.01, allocator = allocator)
		defer nn.adam_free(&opt)
		for p in ps {nn.adam_add_param(&opt, p)}
		worst_norm := 0.0
		for s in 0 ..< T {
			_op_set_grads(ps, s)
			norm := nn.clip_grad_norm(&opt, 1.0)
			worst_norm = max(worst_norm, abs(norm - OP_NORMS[s]) / OP_NORMS[s])
			nn.adam_step(&opt)
		}
		d := _op_diff_free(ps, OP_OPT[5 * 13:6 * 13])
		expect(&passed, &total, d < 1e-14 && worst_norm < 1e-14, fmt.tprintf("clip_grad_norm(1.0) + Adam vs clip_grad_norm_: returned norms rel. diff %.1e, parameters %.1e", worst_norm, d))
	}

	// 5. The optimize package's slice / matrix optimizers on the same sequence
	{
		W := l.matrix_new(f64, 1, 13, allocator)
		Gm := l.matrix_new(f64, 1, 13, allocator)
		defer l.matrix_free(&W)
		defer l.matrix_free(&Gm)
		diffs: [3]f64
		ref := [3][]f64{OP_OPT[3 * 13:4 * 13], OP_OPT[13:26], OP_OPT[6 * 13:7 * 13]}
		for k in 0 ..< 3 {
			copy(W.data, OP_P0[:])
			sgd := optim.optimizer_sgd_init_mat(1, 13, 0.05, 0.9, 0.01, allocator)
			adam := optim.optimizer_adam_init_mat(1, 13, 0.01, 0.8, 0.99, 1e-6, 0.1, allocator)
			rms := optim.optimizer_rmsprop_init(13, 0.01, 0.99, 1e-8, 0.0, allocator)
			for s in 0 ..< T {
				copy(Gm.data, OP_G[s * 13:(s + 1) * 13])
				switch k {
				case 0:
					optim.optimizer_sgd_step_mat(&sgd, &W, &Gm)
				case 1:
					optim.optimizer_adam_step_mat(&adam, &W, &Gm)
				case 2:
					optim.optimizer_rmsprop_step(&rms, W.data, Gm.data)
				}
			}
			optim.optimizer_sgd_free(&sgd)
			optim.optimizer_adam_free(&adam)
			optim.optimizer_rmsprop_free(&rms)
			for x, i in W.data {diffs[k] = max(diffs[k], abs(x - ref[k][i]))}
		}
		expect(&passed, &total, diffs[0] < 1e-12 && diffs[1] < 1e-14 && diffs[2] < 1e-14, fmt.tprintf("optimize package: SGD momentum + λ (matrix API) %.1e, AdamW (matrix API) %.1e, RMSprop %.1e", diffs[0], diffs[1], diffs[2]))
	}

	// 6. Training Linear(3,5)-ReLU-Linear(5,2) on MSE with AdamW + clipping;
	// checkpoint after 10 steps and resume from the loaded model and optimizer
	{
		seq := nn.sequential_new(allocator)
		lin1 := nn.linear_layer_new(3, 5, allocator)
		lin2 := nn.linear_layer_new(5, 2, allocator)
		copy(lin1.weights.data.data, OP_W1[:])
		copy(lin1.bias.data.data, OP_B1[:])
		copy(lin2.weights.data.data, OP_W2[:])
		copy(lin2.bias.data.data, OP_B2[:])
		nn.sequential_add(seq, lin1, nn.Activation.ReLU, lin2)
		opt := nn.adam_new(0.05, allocator = allocator, weight_decay = 0.01)
		nn.sequential_add_to_adam(seq, &opt)

		xm := l.matrix_new(f64, 8, 3, allocator)
		ym := l.matrix_new(f64, 8, 2, allocator)
		copy(xm.data, OP_X[:])
		copy(ym.data, OP_Y[:])
		x := t.tensor_new(xm, false, allocator)
		y := t.tensor_new(ym, false, allocator)
		defer t.tensor_free(x)
		defer t.tensor_free(y)

		losses: [15]f64
		_op_train(seq, &opt, x, y, losses[:10])
		path := "model_checkpoints/optimizers_reference_test.bin"
		saved := nn.save_checkpoint(seq, &opt, path, 10, allocator)
		nn.adam_free(&opt)
		nn.sequential_free(seq)
		seq2, opt2, epoch, loaded := nn.load_checkpoint(path, allocator)
		os.remove(path)
		ok :=
			saved &&
			loaded &&
			epoch == 10 &&
			opt2.timestep == 10 &&
			opt2.learning_rate == 0.05 &&
			opt2.weight_decay == 0.01 &&
			len(opt2.parameters) == 4
		worst_p, worst_l := math.INF_F64, math.INF_F64
		if ok {
			_op_train(seq2, opt2, x, y, losses[10:])
			params := nn.sequential_parameters(seq2, allocator)
			worst_p, worst_l = 0, 0
			k := 0
			for p in params {
				for v in p.data.data {
					worst_p = max(worst_p, abs(v - OP_TRAIN[k]))
					k += 1
				}
			}
			delete(params)
			for v, i in losses {worst_l = max(worst_l, abs(v - OP_LOSS[i]))}
			nn.sequential_free(seq2)
			nn.adam_free(opt2)
			free(opt2, allocator)
		}
		expect(&passed, &total, ok && worst_p < 1e-12 && worst_l < 1e-12, fmt.tprintf("MLP on MSE, AdamW + clip_grad_norm(0.5), 15 steps with save/load after 10 vs torch: losses %.1e (%.4f → %.4f), parameters %.1e; optimizer state restored %v", worst_l, OP_LOSS[0], OP_LOSS[14], worst_p, ok))
	}

	fmt.printf("Optimizers summary: %d/%d passed\n", passed, total)
	record_failures(total - passed)
}
