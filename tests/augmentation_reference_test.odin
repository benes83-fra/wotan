augmentation_reference_test :: proc(allocator: mem.Allocator) {
	seed_test(#procedure)
	fmt.println("\n=== nn augmentation (torch affine_grid / grid_sample reference) ===")
	context.allocator = allocator
	passed, total := 0, 0
	expect :: proc(passed, total: ^int, ok: bool, name: string) {
		total^ += 1
		if ok {passed^ += 1}
		fmt.printf("%s %s\n", "OK  " if ok else "FAIL", name)
	}
	TOL :: 1e-12

	// 1. affine_transform_image against torch: identity, shift, rotation,
	// rotation + scale + shift, shrinking (zero padding), a square image
	{
		off := 0
		for k in 0 ..< len(AT_CASES) / 6 {
			c := AT_CASES[k * 6:][:6]
			H, W := int(c[0]), int(c[1])
			img := AT_IMG[off:][:H * W]
			ref := AT_OUT[off:][:H * W]
			off += H * W
			got := make([]f64, H * W)
			nn.affine_transform_image(img, got, W, H, c[2], int(c[3]), int(c[4]), c[5])
			d := _lt_diff(got, ref)
			expect(
				&passed,
				&total,
				d < TOL,
				fmt.tprintf(
					"%dx%d image, angle %v°, shift (%d, %d), scale %v: max diff %.1e",
					H,
					W,
					c[2],
					int(c[3]),
					int(c[4]),
					c[5],
					d,
				),
			)
		}
	}

	// 2. augment_batch: zero ranges leave every image unchanged; all channels of
	// an image get the same transformation; shifts cover ±translation_range;
	// apply = false returns the batch itself
	{
		N, C, H, W :: 3, 3, 5, 6
		batch := t.tensor_new_4d(N, C, H, W, false)
		for n in 0 ..< N {
			for p in 0 ..< H * W {
				v := rand.float64()
				for c in 0 ..< C {batch.data.data[(n * C + c) * H * W + p] = v}
			}
		}
		same := nn.augment_batch(batch, {apply = true}, allocator)
		d_id := _lt_diff(same.data.data, batch.data.data)

		aug := nn.augment_batch(
			batch,
			{rotation_range = 30, translation_range = 1, scale_range = 0.2, apply = true},
			allocator,
		)
		d_ch, changed := 0.0, 0.0
		for n in 0 ..< N {
			first := aug.data.data[n * C * H * W:][:H * W]
			changed = max(changed, _lt_diff(first, batch.data.data[n * C * H * W:][:H * W]))
			for c in 1 ..< C {d_ch = max(d_ch, _lt_diff(aug.data.data[(n * C + c) * H * W:][:H * W], first))}
		}

		// One bright pixel in the middle of a 7x7 image: its new position is the shift
		R :: 2
		M :: 400
		dots := t.tensor_new_4d(M, 1, 7, 7, false)
		for m in 0 ..< M {dots.data.data[m * 49 + 3 * 7 + 3] = 1}
		moved := nn.augment_batch(dots, {translation_range = R, apply = true}, allocator)
		seen: [2 * R + 1][2 * R + 1]int
		for m in 0 ..< M {
			for p in 0 ..< 49 {
				if moved.data.data[m * 49 + p] == 1 {seen[p / 7 - 3 + R][p % 7 - 3 + R] += 1}
			}
		}
		all_seen := true
		for row in seen {for s in row {all_seen &&= s > 0}}

		off := nn.augment_batch(batch, {rotation_range = 30, apply = false}, allocator)
		expect(
			&passed,
			&total,
			d_id == 0 && d_ch == 0 && changed > 0.1 && all_seen && off == batch,
			fmt.tprintf(
				"augment_batch: zero ranges max diff %.1e, channels of an image max diff %.1e (image changed by %.2f), all %d shifts in ±%d seen: %v, apply = false returns the batch: %v",
				d_id,
				d_ch,
				changed,
				(2 * R + 1) * (2 * R + 1),
				R,
				all_seen,
				off == batch,
			),
		)
	}

	fmt.printf("Augmentation summary: %d/%d passed\n", passed, total)
	record_failures(total - passed)
}
