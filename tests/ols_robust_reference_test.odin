package tests

import ml "../wotan/analytics/ML"
import l "../wotan/linalg"
import "core:fmt"
import "core:math"
import "core:mem"

// Robust OLS standard errors vs statsmodels 0.13.5 OLS(...).fit(cov_type=…):
// HC0–HC3, HAC (Newey-West; explicit lags, default lag rule, small-sample
// correction), cluster (unsorted labels, with / without correction, G - 1 df),
// normal vs t inference (use_t), Wald F of the slopes; plus the classical F p-value.

@(private = "file")
RB_X := [?]f64{1.0, 1.101262453505847, 0.6685177904467157, 1.0, 0.3384312766461778, 0.6969923942941988, 1.0, -0.5399715152535035, 0.3006702713955927, 1.0, -1.2602418568524327, 0.49463836378098097, 1.0, -1.8946212698392553, 0.7083588877649208, 1.0, 0.018638290983285614, 0.36411397626814435, 1.0, -0.8105670995116028, 0.5247978888606862, 1.0, -0.8721559599345132, 0.5454846252393184, 1.0, -0.22196950708389104, 0.7915853233197492, 1.0, -0.05184602813201771, 1.0052439648581213, 1.0, -2.2767828157758307, 1.0027112428844533, 1.0, 0.9251465905764266, 0.880226382476232, 1.0, -2.026845605910026, 1.1533381874202124, 1.0, 1.8596241085543468, 1.2472979486280134, 1.0, 0.5905681115998624, 0.8005147366881669, 1.0, -0.47184451813331413, 0.6370539845607075, 1.0, 1.342996537380774, 0.49206026497817035, 1.0, 0.020786461917443023, 0.4134139132034061, 1.0, 0.6909209676232841, 1.0987015325665082, 1.0, 0.10722707944720507, 0.9855153411416678, 1.0, 1.096531380130275, 1.1287163407694887, 1.0, 1.0614224543758295, 1.6253163467944782, 1.0, -0.9073341413930657, 1.7764124068402987, 1.0, -0.6124917784436158, 1.9059756785616289, 1.0, 0.3432270521124315, 2.2953632909407333, 1.0, -0.21001015163517062, 2.3545564978772124, 1.0, -2.284914216554451, 2.410351212143204, 1.0, 2.0261175349217764, 2.616972775290843, 1.0, -2.174977373868806, 2.7405958411147493, 1.0, -2.081542853744764, 2.5364885834244606, 1.0, -1.2761124197329383, 2.1867213328060076, 1.0, 0.5648512404463458, 2.152709584092707, 1.0, 1.7960125066302708, 2.5721131941083586, 1.0, -0.2354150525900867, 2.5041884673087003, 1.0, -0.3910773505445041, 2.8487173148831544, 1.0, 0.17390146428778722, 2.9724969276192597, 1.0, -0.3668597432540227, 2.8798278186077773, 1.0, 0.08236522460221347, 2.0898093449570787, 1.0, -1.1399714593630075, 2.1564494417448667, 1.0, 0.438257432619766, 2.0733658993957045, 1.0, 0.39257939815601534, 1.593210122358524, 1.0, -2.4354174163439515, 1.7475615618623792, 1.0, -0.11022594532382894, 1.7399348065659022, 1.0, 0.16291581767584848, 1.8524507278123972, 1.0, 0.5612247602630475, 1.6711259590481573, 1.0, -0.816089756439701, 1.731732727389322, 1.0, -1.3280342642624956, 1.5897631465785675, 1.0, -0.9507340805091575, 1.9092471485065197, 1.0, 0.5480409641909273, 1.9465448484495977, 1.0, -0.8518355089919037, 1.5257875639264409, 1.0, -0.7641438115235788, 1.5900823780915647, 1.0, 1.1437655777004572, 1.610374712678626, 1.0, -0.7861575894791125, 1.5493413929563282, 1.0, -0.8986326207536771, 1.144442718971849, 1.0, -0.09123756351337108, 1.462304053010099, 1.0, 0.19861051640677327, 1.2428249770231212, 1.0, 1.0376296586712488, 1.7176156096073696, 1.0, -0.8793276811910162, 1.519632414953047, 1.0, -1.5681545944352957, 1.5293754727593014, 1.0, -0.12249665156557239, 1.5159315966266544, 1.0, 0.6436368157294202, 1.5612839249065695, 1.0, -1.481526543249413, 2.3543084279191633, 1.0, -0.48726301578469694, 2.2048220865779826, 1.0, 0.30619578810330356, 2.8256592927618516, 1.0, 0.2310243000221297, 3.012696760014323, 1.0, 0.08335899091739198, 2.804194497699675, 1.0, -0.2568895173775524, 3.180862635965194, 1.0, -0.7993464580715008, 3.4331099578663604, 1.0, -0.9281380009611975, 3.7194410134649156, 1.0, 1.1562622342720783, 3.3192456928875154, 1.0, -1.1172097148854832, 3.470089174418239, 1.0, 1.2280000985175472, 3.349334405477658, 1.0, -1.3150584358653277, 3.306684725699544, 1.0, 2.903581786972847, 3.2672472406561477, 1.0, -1.7381109288833918, 3.2794477448672845, 1.0, 1.6042742994540782, 3.756580806470343, 1.0, -0.8970721577902043, 3.8701128639645255, 1.0, -0.11561548050669124, 3.3166845527285638, 1.0, -0.06555257091474957, 3.6907448668481866, 1.0, -0.6522226650767547, 3.717037798721577}
@(private = "file")
RB_Y := [?]f64{1.015816994395551, 0.7218983941411856, -1.3440303742079025, -0.42227412782430424, -1.946696572408111, 0.35402977012740744, 0.5543969096965682, 1.4910055229300092, 0.804497677640307, -0.5103865975401988, 1.3414054532665232, 2.7266319789095212, -0.5905746534371932, -0.17517770900133112, -0.9752380654891045, -2.436543181676486, -2.5063188825473626, -1.6273527717452738, 0.9990347673940635, 0.8598967175493775, 3.564189567214925, 0.4050357348105724, 0.99852055090327, -0.16998061084753546, 0.968398850705747, 0.8633683418997773, -0.8610445307877932, 0.9850518972234037, 1.6159879077990285, -1.7866901928180856, -5.05904290434214, -1.7727992591060822, 4.043772020256468, 0.006533578617123892, -0.6111497102567754, -1.5696846513197558, -1.905881553364332, -1.4641978030959621, -0.360419403243989, -0.3902514306284923, -0.22082268142451553, -4.882601749087479, -1.9599370144662829, -1.6462317382632907, -1.2052662172646693, -1.5823118659730837, -4.063028252882371, -2.909322122558162, -3.1164825853655547, -2.641347778744375, -2.128818634711217, -1.259330349136827, -1.815312288423397, -2.017798934067147, -0.9052366078011604, -0.3112064759601212, -0.8300245951186611, -1.5563962190220268, -2.9484598307090897, -1.517894138785699, -1.0319285092424775, -5.857026393095767, -1.9206198261306557, -2.0140504336247336, -2.3294554727512056, -1.6473026684024692, -3.5218415960583367, -3.7723156366592345, -2.977828153892501, -1.8386386334903848, -2.6883189711493247, -2.0457259017010827, -3.560016795865033, -1.0553796092210357, -2.6894421901623162, -3.625988870324761, -3.6087584144183436, -2.1666050913647146, -2.608643010134948, -3.333963443878721}
@(private = "file")
RB_G := [?]int{59, 24, 66, 38, 31, 24, 45, 45, 38, 10, 59, 45, 52, 31, 66, 17, 3, 10, 10, 38, 59, 17, 3, 52, 52, 52, 17, 52, 10, 17, 17, 31, 52, 52, 24, 3, 3, 3, 31, 31, 59, 17, 66, 45, 66, 59, 38, 45, 52, 45, 24, 17, 38, 24, 24, 3, 59, 66, 3, 10, 66, 66, 24, 10, 38, 3, 45, 31, 10, 31, 17, 59, 45, 59, 24, 10, 66, 38, 31, 38}

ols_robust_reference_test :: proc(allocator: mem.Allocator) {
	seed_test(#procedure)
	fmt.println("\n=== OLS robust standard errors vs statsmodels ===")
	context.allocator = allocator
	passed, total := 0, 0
	expect :: proc(passed, total: ^int, ok: bool, name: string) {
		total^ += 1
		if ok {passed^ += 1}
		fmt.printf("%s %s\n", "OK  " if ok else "FAIL", name)
	}
	close :: proc(got, want: []f64, rtol: f64) -> bool {
		if len(got) != len(want) do return false
		for g, i in got {if !(math.abs(g - want[i]) <= rtol * max(1, math.abs(want[i]))) do return false}
		return true
	}
	near :: proc(got, want, rtol: f64) -> bool {return math.abs(got - want) <= rtol * max(1, math.abs(want))}

	X := l.Matrix(f64){data = RB_X[:], rows = 80, cols = 3}
	groups := RB_G[:]
	{
		r := ml.ols_fit(&X, RB_Y[:])
		expect(&passed, &total, near(r.fstat, 14.621100644836382, 1e-10) && near(r.f_pvalue, 4.1443467978514245e-06, 1e-9) && r.cov_type == .NonRobust, "classical OLS: F and its p-value = statsmodels")
	}
	{
		r := ml.ols_fit_robust(&X, RB_Y[:], ml.RobustCovSpec{type = .HC0})
		ok := close(r.vcov.data, {0.1351495061787821, 0.013215128840376955, -0.05018642213238868, 0.013215128840376953, 0.04612605621864131, -0.003745938185666994, -0.05018642213238868, -0.0037459381856669925, 0.024125924842279302}, 1e-10) && close(r.stderr, {0.36762685725988803, 0.21476977491872853, 0.15532522281419492}, 1e-10) && close(r.pvalues, {0.27194736114578844, 0.008243456147623689, 6.511666475355074e-07}, 1e-9)
		// 1e-9: scipy's t.ppf (behind statsmodels' t intervals) is only ~1e-10 accurate
		ok = ok && close(r.ci_low, {-0.3166645643926286, 0.14646615523475714, -1.077235282357805}, 1e-9) && close(r.ci_high, {1.1244062355654272, 0.9883482028517206, -0.4683715971448426}, 1e-9)
		ok = ok && near(r.fstat, 14.57490449391593, 1e-9) && near(r.f_pvalue, 4.285515442032713e-06, 1e-9)
		expect(&passed, &total, ok, "HC0: cov, stderr, p-values, CI, Wald F = statsmodels")
	}
	{
		r := ml.ols_fit_robust(&X, RB_Y[:], ml.RobustCovSpec{type = .HC1})
		ok := close(r.vcov.data, {0.14041507135457879, 0.01373000399000203, -0.05214173728040382, 0.01373000399000203, 0.04792317529209486, -0.0038918838292644102, -0.05214173728040382, -0.0038918838292644085, 0.02506589594003044}, 1e-10) && close(r.stderr, {0.37471999059908556, 0.21891362518604196, 0.1583221271333557}, 1e-10) && close(r.pvalues, {0.2811258430379895, 0.009544123321926468, 1.0543726171605188e-06}, 1e-9)
		// 1e-9: scipy's t.ppf (behind statsmodels' t intervals) is only ~1e-10 accurate
		ok = ok && close(r.ci_low, {-0.3305668502749961, 0.13834435795349614, -1.0831091068884726}, 1e-9) && close(r.ci_high, {1.1383085214477946, 0.9964700001329816, -0.46249777261417496}, 1e-9)
		ok = ok && near(r.fstat, 14.028345575394084, 1e-9) && near(r.f_pvalue, 6.383807285008145e-06, 1e-9)
		expect(&passed, &total, ok, "HC1: cov, stderr, p-values, CI, Wald F = statsmodels")
	}
	{
		r := ml.ols_fit_robust(&X, RB_Y[:], ml.RobustCovSpec{type = .HC2})
		ok := close(r.vcov.data, {0.14223315109018186, 0.013870304130422546, -0.052980060350079336, 0.013870304130422543, 0.048951519340948296, -0.0038385215177535645, -0.052980060350079336, -0.003838521517753565, 0.02552330405158145}, 1e-10) && close(r.stderr, {0.3771381061231838, 0.22124990246539838, 0.15976014537919478}, 1e-10) && close(r.pvalues, {0.2842219820882208, 0.010330869537721681, 1.3163257092502095e-06}, 1e-9)
		// 1e-9: scipy's t.ppf (behind statsmodels' t intervals) is only ~1e-10 accurate
		ok = ok && close(r.ci_low, {-0.33530626961268584, 0.13376533862805834, -1.0859275708594287}, 1e-9) && close(r.ci_high, {1.1430479407854843, 1.0010490194584194, -0.45967930864321893}, 1e-9)
		ok = ok && near(r.fstat, 13.803681707017574, 1e-9) && near(r.f_pvalue, 7.529151958221681e-06, 1e-9)
		expect(&passed, &total, ok, "HC2: cov, stderr, p-values, CI, Wald F = statsmodels")
	}
	{
		r := ml.ols_fit_robust(&X, RB_Y[:], ml.RobustCovSpec{type = .HC3})
		ok := close(r.vcov.data, {0.14973280286252724, 0.014553200802062367, -0.05594674317192139, 0.014553200802062367, 0.05196605405125819, -0.0039259374416652, -0.0559467431719214, -0.0039259374416652, 0.027012058484790512}, 1e-10) && close(r.stderr, {0.3869532308464774, 0.22796064145211162, 0.16435345595633366}, 1e-10) && close(r.pvalues, {0.296614942470793, 0.01280821940260837, 2.5752193390758474e-06}, 1e-9)
		// 1e-9: scipy's t.ppf (behind statsmodels' t intervals) is only ~1e-10 accurate
		ok = ok && close(r.ci_low, {-0.35454356057410996, 0.12061253190445159, -1.0949302941604278}, 1e-9) && close(r.ci_high, {1.1622852317469086, 1.0142018261820263, -0.4506765853422198}, 1e-9)
		ok = ok && near(r.fstat, 13.069605046524936, 1e-9) && near(r.f_pvalue, 1.2974080301493648e-05, 1e-9)
		expect(&passed, &total, ok, "HC3: cov, stderr, p-values, CI, Wald F = statsmodels")
	}
	{
		r := ml.ols_fit_robust(&X, RB_Y[:], ml.RobustCovSpec{type = .HAC, maxlags = 4})
		ok := close(r.vcov.data, {0.27738634734989664, 0.0007475619612428647, -0.09967712298043611, 0.0007475619612428638, 0.03671227566703274, -0.00013989646174195416, -0.09967712298043596, -0.00013989646174195492, 0.04746915776566943}, 1e-10) && close(r.stderr, {0.526674802273563, 0.1916044771581101, 0.2178741787492713}, 1e-10) && close(r.pvalues, {0.4431816972955833, 0.003062974879574202, 0.0003896192872232141}, 1e-9)
		// 1e-9: scipy's t.ppf (behind statsmodels' t intervals) is only ~1e-10 accurate
		ok = ok && close(r.ci_low, {-0.6283928084345384, 0.19186930453671563, -1.1998289832611375}, 1e-9) && close(r.ci_high, {1.436134479607337, 0.9429450535497621, -0.34577789624151006}, 1e-9)
		ok = ok && near(r.fstat, 10.640369751646505, 1e-9) && near(r.f_pvalue, 8.314936130081496e-05, 1e-9)
		expect(&passed, &total, ok, "HAC lags 4: cov, stderr, p-values, CI, Wald F = statsmodels")
	}
	{
		r := ml.ols_fit_robust(&X, RB_Y[:], ml.RobustCovSpec{type = .HAC, maxlags = -1, hac_correction = true})
		ok := close(r.vcov.data, {0.2856714742814654, 0.009086332668851808, -0.10260807831716598, 0.009086332668851815, 0.042166303958642355, -0.002960687427193753, -0.10260807831716595, -0.0029606874271937474, 0.0472573175916234}, 1e-10) && close(r.stderr, {0.5344824358961344, 0.20534435458186415, 0.21738748260105364}, 1e-10) && close(r.pvalues, {0.4498712069086551, 0.005723797396630497, 0.000378039012861706}, 1e-9)
		// 1e-9: scipy's t.ppf (behind statsmodels' t intervals) is only ~1e-10 accurate
		ok = ok && close(r.ci_low, {-0.6436954891392624, 0.16493963963416275, -1.1988750763392166}, 1e-9) && close(r.ci_high, {1.4514371603120608, 0.9698747184523151, -0.34673180316343105}, 1e-9)
		ok = ok && near(r.fstat, 9.526894208029422, 1e-9) && near(r.f_pvalue, 0.00020094848320050015, 1e-9)
		expect(&passed, &total, ok, "HAC default lags (3) + correction: cov, stderr, p-values, CI, Wald F = statsmodels")
	}
	{
		r := ml.ols_fit_robust(&X, RB_Y[:], ml.RobustCovSpec{type = .Cluster, groups = groups})
		ok := close(r.vcov.data, {0.24130727145193645, 0.013452885389364174, -0.09169750831308969, 0.01345288538936418, 0.04216874809879338, 0.0013257659958379679, -0.09169750831308968, 0.0013257659958379707, 0.045607257651289}, 1e-10) && close(r.stderr, {0.4912303649530803, 0.20535030581616717, 0.21355855789756822}, 1e-10) && close(r.pvalues, {0.410984822939635, 0.005725201939910503, 0.00029609152539585243}, 1e-9)
		// 1e-9: scipy's t.ppf (behind statsmodels' t intervals) is only ~1e-10 accurate
		ok = ok && close(r.ci_low, {-0.558922987834105, 0.16492797542926524, -1.1913705218208694}, 1e-9) && close(r.ci_high, {1.3666646590069034, 0.9698863826572126, -0.3542363576817782}, 1e-9)
		ok = ok && near(r.fstat, 10.676926170465885, 1e-9) && near(r.f_pvalue, 0.004208517286492415, 1e-9)
		expect(&passed, &total, ok, "Cluster: cov, stderr, p-values, CI, Wald F = statsmodels")
	}
	{
		r := ml.ols_fit_robust(&X, RB_Y[:], ml.RobustCovSpec{type = .Cluster, groups = groups, cluster_no_correction = true, use_t = true})
		ok := close(r.vcov.data, {0.21167840394454676, 0.01180107541117642, -0.08043844716578627, 0.011801075411176424, 0.036991066370207354, 0.0011629820697667236, -0.08043844716578626, 0.0011629820697667262, 0.04000737918018136}, 1e-10) && close(r.stderr, {0.46008521378604067, 0.19233061734993562, 0.20001844709971467}, 1e-10) && close(r.pvalues, {0.40286784469997905, 0.016216564686039284, 0.0038256157771584683}, 1e-9)
		// 1e-9: scipy's t.ppf (behind statsmodels' t intervals) is only ~1e-10 accurate
		ok = ok && close(r.ci_low, {-0.636914226250913, 0.1323250953906852, -1.2252766025382735}, 1e-9) && close(r.ci_high, {1.4446558974237114, 1.0024892626957926, -0.32033027696437416}, 1e-9)
		ok = ok && near(r.fstat, 12.171387697933696, 1e-9) && near(r.f_pvalue, 0.002757931221141549, 1e-9)
		expect(&passed, &total, ok, "Cluster, no correction, use_t: cov, stderr, p-values, CI, Wald F = statsmodels")
	}
	{
		r := ml.ols_fit_robust(&X, RB_Y[:], ml.RobustCovSpec{type = .HC1, use_t = true})
		ok := close(r.vcov.data, {0.14041507135457879, 0.01373000399000203, -0.05214173728040382, 0.01373000399000203, 0.04792317529209486, -0.0038918838292644102, -0.05214173728040382, -0.0038918838292644085, 0.02506589594003044}, 1e-10) && close(r.stderr, {0.37471999059908556, 0.21891362518604196, 0.1583221271333557}, 1e-10) && close(r.pvalues, {0.28449083013810206, 0.01141459178366851, 5.579421502037203e-06}, 1e-9)
		// 1e-9: scipy's t.ppf (behind statsmodels' t intervals) is only ~1e-10 accurate
		ok = ok && close(r.ci_low, {-0.3422919926313329, 0.1314944607410618, -1.0880630712495114}, 1e-9) && close(r.ci_high, {1.1500336638041313, 1.003319897345416, -0.45754380825313623}, 1e-9)
		ok = ok && near(r.fstat, 14.028345575394084, 1e-9) && near(r.f_pvalue, 6.383807285008145e-06, 1e-9)
		expect(&passed, &total, ok, "HC1, use_t: cov, stderr, p-values, CI, Wald F = statsmodels")
	}

	fmt.printf("OLS robust summary: %d/%d passed\n", passed, total)
	record_failures(total - passed)
}
