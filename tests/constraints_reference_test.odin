constraints_reference_test :: proc(allocator: mem.Allocator) {
	seed_test(#procedure)
	fmt.println(
		"\n=== Constrained portfolios: projection, min variance, max Sharpe, target return (KKT / scipy reference) ===",
	)
	context.allocator = allocator
	passed, total := 0, 0
	expect :: proc(passed, total: ^int, ok: bool, name: string) {
		total^ += 1
		if ok {passed^ += 1}
		fmt.printf("%s %s\n", "OK  " if ok else "FAIL", name)
	}
	cov := l.matrix_new(f64, CS_N, CS_N)
	defer l.matrix_free(&cov)
	copy(cov.data, CS_COV[:])
	grp := fin.GroupLimit {
		asset_indices = []int{0, 1, 2},
		max_weight    = CS_GMAX,
	}
	capped := fin.PortfolioConstraints {
		no_short_selling = true,
		max_weight       = CS_CAP,
	}
	grouped := fin.PortfolioConstraints {
		no_short_selling = true,
		group_limits     = []fin.GroupLimit{grp},
	}
	both := fin.PortfolioConstraints {
		no_short_selling = true,
		max_weight       = CS_CAP,
		group_limits     = []fin.GroupLimit{grp},
	}

	// 1. Projection: nearest feasible point, input untouched
	{
		v := CS_V
		p := fin.project_constraints(v[:], both, allocator)
		defer delete(p)
		untouched := _cs_maxdiff(v[:], CS_V[:]) == 0
		expect(
			&passed,
			&total,
			_cs_maxdiff(p, CS_PROJ[:]) < 1e-8 && untouched,
			fmt.tprintf(
				"project_constraints (long-only, cap %.0f%%, group ≤ %.0f%%) vs SLSQP projection: max diff %.1e; input unchanged %v (it used to be modified and returned as the result when shorting was allowed)",
				100 * CS_CAP,
				100 * CS_GMAX,
				_cs_maxdiff(p, CS_PROJ[:]),
				untouched,
			),
		)
	}

	// 2. Negative Sharpe gradient
	{
		g := fin.negative_sharpe_gradient(CS_W0[:], CS_MU[:], &cov, CS_RF, allocator)
		defer delete(g)
		worst := 0.0
		for i in 0 ..< CS_N {worst = max(worst, abs(g[i] - CS_G0[i]) / abs(CS_G0[i]))}
		expect(
			&passed,
			&total,
			worst < 1e-12,
			fmt.tprintf(
				"negative_sharpe_gradient vs the analytic gradient: max rel err %.1e (the σ term was doubled before)",
				worst,
			),
		)
	}

	// 3. Minimum variance, long-only with a cap: exact KKT solution
	{
		w := fin.constrained_min_variance_portfolio(&cov, capped, allocator)
		defer delete(w)
		v, v_ref, v_old :=
			fin.portfolio_variance(w, &cov),
			fin.portfolio_variance(CS_W_MV[:], &cov),
			fin.portfolio_variance(CS_OLD_MV[:], &cov)
		expect(
			&passed,
			&total,
			_cs_maxdiff(w, CS_W_MV[:]) < 1e-9,
			fmt.tprintf(
				"constrained_min_variance_portfolio (cap %.0f%%) vs exact KKT enumeration: max weight diff %.1e, vol %.5f%% vs %.5f%% (old: stopped after %d steps near equal weights, vol %.5f%%)",
				100 * CS_CAP,
				_cs_maxdiff(w, CS_W_MV[:]),
				100 * math.sqrt(v),
				100 * math.sqrt(v_ref),
				CS_OLD_ITERS,
				100 * math.sqrt(v_old),
			),
		)
	}

	// 4. Minimum variance with a group limit, and with an exact target return
	{
		wg := fin.constrained_min_variance_portfolio(&cov, grouped, allocator)
		wt := fin.constrained_mean_variance_portfolio(CS_MU[:], &cov, CS_TARGET, capped, allocator)
		defer {delete(wg); delete(wt)}
		vg, vg_ref := fin.portfolio_variance(wg, &cov), fin.portfolio_variance(CS_W_GRP[:], &cov)
		vt, vt_ref := fin.portfolio_variance(wt, &cov), fin.portfolio_variance(CS_W_TGT[:], &cov)
		miss := abs(fin.portfolio_return(wt, CS_MU[:]) - CS_TARGET)
		gsum := wg[0] + wg[1] + wg[2]
		expect(
			&passed,
			&total,
			(vg - vg_ref) / vg_ref < 1e-9 &&
			(vt - vt_ref) / vt_ref < 1e-9 &&
			miss < 1e-13 &&
			gsum <= CS_GMAX + 1e-12 &&
			_cs_maxdiff(wg, CS_W_GRP[:]) < 1e-5 &&
			_cs_maxdiff(wt, CS_W_TGT[:]) < 1e-5,
			fmt.tprintf(
				"group limit: variance vs SLSQP rel %+.1e, group weight %.6f; target return (cap %.0f%%): variance vs SLSQP rel %+.1e, return misses the target by %.1e (the old penalty method only approached it)",
				(vg - vg_ref) / vg_ref,
				gsum,
				100 * CS_CAP,
				(vt - vt_ref) / vt_ref,
				miss,
			),
		)
	}

	// 5. Maximum Sharpe with a cap and a group limit
	{
		w := fin.constrained_max_sharpe_portfolio(CS_MU[:], &cov, CS_RF, both, allocator)
		defer delete(w)
		s, s_ref :=
			-fin.negative_sharpe(w, CS_MU[:], &cov, CS_RF),
			-fin.negative_sharpe(CS_W_SR[:], CS_MU[:], &cov, CS_RF)
		expect(
			&passed,
			&total,
			s >= s_ref - 1e-12 && _cs_maxdiff(w, CS_W_SR[:]) < 1e-5,
			fmt.tprintf(
				"constrained_max_sharpe_portfolio (cap %.0f%%, group ≤ %.0f%%): Sharpe %.8f vs best of 20 SLSQP starts %.8f, max weight diff %.1e",
				100 * CS_CAP,
				100 * CS_GMAX,
				s,
				s_ref,
				_cs_maxdiff(w, CS_W_SR[:]),
			),
		)
	}

	// Group lower limits and min_weight_if_held (semi-continuous weights, by
	// branch and bound) vs SciPy SLSQP and an exhaustive search over all 255
	// supports (cons_ref.py): n = 8, cap 40%, group {0,1,2} ≤ 50%,
	// group {3,4,6} ≥ 35%, min 8% if held
	{
		cov := l.matrix_new(f64, 8, 8, allocator)
		copy(cov.data, CS_SC_COV[:])
		mu := CS_SC_MU[:]
		groups := []fin.GroupLimit {
			{asset_indices = {0, 1, 2}, max_weight = 0.5}, // no lower limit
			{asset_indices = {3, 4, 6}, min_weight = 0.35}, // no upper limit
		}
		c := fin.PortfolioConstraints {
			no_short_selling = true,
			max_weight       = 0.4,
			group_limits     = groups,
		}
		sc := c
		sc.min_weight, sc.min_weight_if_held = 0.08, true
		sc1 := sc
		sc1.group_limits = groups[:1]
		sp := fin.PortfolioConstraints {
			no_short_selling   = true,
			max_weight         = 0.4,
			min_weight         = 0.08,
			min_weight_if_held = true,
		}
		got := [5][]f64 {
			fin.constrained_min_variance_portfolio(&cov, c, allocator),
			fin.constrained_mean_variance_portfolio(mu, &cov, 0.09, c, allocator),
			fin.constrained_min_variance_portfolio(&cov, sc, allocator),
			fin.constrained_risk_aversion_portfolio(mu, &cov, 3, sc1, allocator),
			fin.project_constraints(CS_SC_V[:], sp, allocator),
		}
		refs := [5][]f64 {
			CS_SC_GMIN_VAR[:],
			CS_SC_GMIN_MV[:],
			CS_SC_SC_VAR[:],
			CS_SC_SC_UTIL[:],
			CS_SC_SC_PROJ[:],
		}
		objective :: proc(k: int, w: []f64, cov: ^l.Matrix(f64), mu: []f64) -> f64 {
			switch k {
			case 3:
				return 1.5 * fin.portfolio_variance(w, cov) - l.dot_simd(mu, w)
			case 4:
				s := 0.0
				for x, i in w {s += (x - CS_SC_V[i]) * (x - CS_SC_V[i])}
				return s
			}
			return fin.portfolio_variance(w, cov)
		}
		worst_w, worst_f := 0.0, 0.0
		for k in 0 ..< 5 {
			for x, i in got[k] {worst_w = max(worst_w, abs(x - refs[k][i]))}
			// not worse than the reference (both are optimal up to SLSQP's precision)
			worst_f = max(
				worst_f,
				objective(k, got[k], &cov, mu) - objective(k, refs[k], &cov, mu),
			)
		}
		// the semi-continuous results: every weight 0 or in [8%, 40%]
		sc_ok := true
		for k in 2 ..< 5 {
			for x in got[k] {sc_ok &&= x == 0 || (x >= 0.08 - 1e-12 && x <= 0.4 + 1e-12)}
		}
		g2 := got[0][3] + got[0][4] + got[0][6]
		expect(
			&passed,
			&total,
			worst_w < 1e-7 && worst_f < 1e-12 && sc_ok && abs(g2 - 0.35) < 1e-12,
			fmt.tprintf(
				"group lower limit (binding: %.12f) and min 8%% if held (min variance, utility, projection; exhaustive search over supports) vs SciPy: max weight diff %.1e, objective excess %.1e; weights 0 or in [8%%, 40%%] %v",
				g2,
				worst_w,
				worst_f,
				sc_ok,
			),
		)
		for w in got {delete(w, allocator)}
	}

	// Long projected-gradient steps with group limits (upper and lower): a nearly
	// linear objective ε wᵀΣw − μᵀw (ε = 1e-4, Barzilai–Borwein steps ~1/ε) and
	// projections of points 1e2 and 1e4 away, vs SciPy SLSQP (cons_long.py). The
	// Dykstra projection must not stop while its increments still move.
	{
		cov := l.matrix_new(f64, 8, 8, allocator)
		copy(cov.data, CS_SC_COV[:])
		c := fin.PortfolioConstraints {
			no_short_selling = true,
			max_weight       = 0.4,
			group_limits     = []fin.GroupLimit {
				{asset_indices = {0, 1, 2}, max_weight = 0.5},
				{asset_indices = {3, 4, 6}, min_weight = 0.35},
			},
		}
		Ctx :: struct {
			cov: ^l.Matrix(f64),
			mu:  []f64,
		}
		ctx := Ctx{&cov, CS_SC_MU[:]}
		f :: proc(w: []f64, user: rawptr) -> f64 {
			x := (^Ctx)(user)
			return 1e-4 * fin.portfolio_variance(w, x.cov) - l.dot_simd(x.mu, w)
		}
		g :: proc(w, gr: []f64, user: rawptr) {
			x := (^Ctx)(user)
			gv := fin.portfolio_variance_gradient(w, x.cov, context.temp_allocator)
			for i in 0 ..< len(w) {gr[i] = 1e-4 * gv[i] - x.mu[i]}
		}
		lin := fin.constrained_minimize(8, f, g, &ctx, c, allocator)
		p0 := fin.project_constraints(CS_LONG_FAR_V0[:], c, allocator)
		p1 := fin.project_constraints(CS_LONG_FAR_V1[:], c, allocator)
		worst := 0.0
		for i in 0 ..< 8 {
			worst = max(
				worst,
				abs(lin[i] - CS_LONG_LONG_LIN[i]),
				abs(p0[i] - CS_LONG_FAR_P0[i]),
				abs(p1[i] - CS_LONG_FAR_P1[i]),
			)
		}
		expect(
			&passed,
			&total,
			worst < 1e-9,
			fmt.tprintf(
				"long SPG steps with upper and lower group limits (nearly linear objective; projections of points 1e2 and 1e4 away) vs SciPy: max weight diff %.1e; %.4f",
				worst,
				lin,
			),
		)
		delete(lin, allocator)
		delete(p0, allocator)
		delete(p1, allocator)
	}

	fmt.printf("Constraints summary: %d/%d passed\n", passed, total)
	record_failures(total - passed)
}
