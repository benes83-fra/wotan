@(private = "file")
TS_SAMPLE_CRPS := [?]f64{0.45351255060847817, 3.461322673856219, 4.567806235519}

// Time-series tokens and forecasting with a language model over them
// (nn/tokenizers/time_series.odin, ml_finance/token_forecast.odin):
// 1. the tokenizer equals Chronos' MeanScaleUniformBins (contexts with missing
//    values, all zeros, outliers beyond the outer bins, truncation; labels
//    with ±inf; EOS; decoding; a left-padded batch); sample quantiles and the
//    ensemble CRPS equal numpy's
// 2. a GPT trained on tokenized AR(1) windows (x_t = 0.9·x_{t-1} + ε) forecasts
//    8 steps by sampling paths: per step and for the 8-step sum (which needs
//    the paths' dependence right) its CRPS must stay within 20% of the true
//    conditional distribution's (the unconditional one: ~2× at h = 1), its
//    80% intervals cover 80% ± 10 points on average and ± 15 at worst.
//    Over 5 data seeds (this run: seed 0) the CRPS ratio was 1.03-1.13, the
//    mean coverage per seed 72-82% (worst single one 68%: with 100 contexts a
//    coverage has a standard error of ~4 points; the paths are slightly too
//    narrow after 600 steps). Takes ~25 s.
token_forecast_test :: proc(allocator: mem.Allocator) {
	seed_test(#procedure)
	fmt.println("\n=== Time-series tokens and token forecasting ===")
	context.allocator = allocator
	passed, total := 0, 0
	expect :: proc(passed, total: ^int, ok: bool, name: string) {
		total^ += 1
		if ok {passed^ += 1}
		fmt.printf("%s %s\n", "OK  " if ok else "FAIL", name)
	}

	// 1. Tokenizer and sample scores
	{
		tok := tk.ts_tokenizer_new(64, -15, 15, context_length = 16)
		defer tk.ts_tokenizer_free(&tok)
		tok_eos := tk.ts_tokenizer_new(64, -15, 15, context_length = 16, use_eos = true)
		defer tk.ts_tokenizer_free(&tok_eos)
		values := TS_CTX_VALUES
		for i in TS_CTX_MISSING {values[i] = math.nan_f64()}
		contexts: [len(TS_CTX_FULL_LENGTHS)][]f64
		off := 0
		for n, k in TS_CTX_FULL_LENGTHS {
			contexts[k] = values[off:off + n]
			off += n
		}
		ids_ok, eos_ok, label_ok := true, true, true
		d_scale, d_dec := 0.0, 0.0
		pos, pos_label := 0, 0
		for c, k in contexts {
			n := TS_CTX_LENGTHS[k]
			ids, mask, scale := tk.ts_encode_context(&tok, c)
			ids_e, mask_e, _ := tk.ts_encode_context(&tok_eos, c)
			dec := tk.ts_decode(&tok, ids, scale)
			ids_ok &&= len(ids) == n
			for i in 0 ..< n {
				ids_ok &&= ids[i] == TS_CTX_IDS[pos + i] && mask[i] == TS_CTX_MASK[pos + i]
				eos_ok &&= ids_e[i] == TS_CTX_IDS_EOS[pos + k + i]
				d_dec = max(d_dec, abs(dec[i] - TS_DECODED[pos + i]) / scale)
			}
			eos_ok &&= len(ids_e) == n + 1 && ids_e[n] == tok_eos.eos_id && mask_e[n] == 1
			d_scale = max(d_scale, abs(scale - TS_CTX_SCALE[k]) / TS_CTX_SCALE[k])
			label := []f64{c[0], math.INF_F64 if k % 2 == 0 else math.NEG_INF_F64, math.nan_f64()}
			lab_ids, lab_mask := tk.ts_encode(&tok_eos, label, scale)
			for v, i in lab_ids {label_ok &&= v == TS_LABEL_IDS[pos_label + i]}
			label_ok &&= lab_mask[2] == 0 && lab_mask[3] == 1
			pos += n
			pos_label += len(lab_ids)
			for x in ([][]int{ids, mask, ids_e, mask_e, lab_ids, lab_mask}) {delete(x)}
			delete(dec)
		}
		b_ids, b_mask, b_scales := tk.ts_encode_batch_to_tensors(&tok, contexts[:])
		batch_ok :=
			b_ids.shape == {TS_BATCH_SHAPE[0], TS_BATCH_SHAPE[1], 1, 1} &&
			b_mask.shape == b_ids.shape
		for v, i in TS_BATCH_IDS {
			batch_ok &&=
				b_ids.data.data[i] == f64(v) && b_mask.data.data[i] == f64(TS_BATCH_MASK[i])
		}
		for s, i in b_scales {batch_ok &&= abs(s - TS_BATCH_SCALE[i]) <= 1e-15 * s}
		t.tensor_free(b_ids)
		t.tensor_free(b_mask)
		delete(b_scales)

		q: [len(TS_SAMPLE_Q)]f64
		ml_fin.prob_forecast_sample_quantiles(
			TS_SAMPLES[:],
			{0.0, 0.05, 0.1, 0.5, 0.9, 0.95, 1.0},
			q[:],
		)
		d_q, d_crps := 0.0, 0.0
		for v, j in q {d_q = max(d_q, abs(v - TS_SAMPLE_Q[j]))}
		for y, j in ([]f64{0.1, -4.0, 6.0}) {
			d_crps = max(
				d_crps,
				abs(ml_fin.prob_forecast_sample_crps(TS_SAMPLES[:], y) - TS_SAMPLE_CRPS[j]),
			)
		}
		expect(
			&passed,
			&total,
			ids_ok &&
			eos_ok &&
			label_ok &&
			batch_ok &&
			d_scale < 1e-15 &&
			d_dec < 1e-15 &&
			d_q < 1e-14 &&
			d_crps < 1e-14,
			fmt.tprintf(
				"tokenizer vs Chronos' MeanScaleUniformBins (7 contexts: missing values, zeros, outliers, truncated to 16): tokens / mask %v, scale %.1e, with EOS %v, labels with ±inf %v, decoded %.1e, left-padded batch %v; sample quantiles %.1e, ensemble CRPS %.1e vs numpy",
				ids_ok,
				d_scale,
				eos_ok,
				label_ok,
				d_dec,
				batch_ok,
				d_q,
				d_crps,
			),
		)
	}

	// 2. A GPT over the tokens of AR(1) windows: sampled 8-step forecasts
	{
		rand.reset(2000)
		PHI :: 0.9
		C, H :: 32, 8
		N, TRAIN_END :: 20000, 15000
		x := make([]f64, N)
		defer delete(x)
		for i in 1 ..< N {x[i] = PHI * x[i - 1] + rand.norm_float64()}

		model := ml_fin.token_forecaster_new(
			{
				context_length = C,
				prediction_length = H,
				d_model = 32,
				num_heads = 2,
				d_ff = 64,
				num_layers = 2,
			},
		)
		defer ml_fin.token_forecaster_free(model)
		STEPS, B :: 600, 32
		opt := nn.adam_new(3e-3)
		defer nn.adam_free(&opt)
		ml_fin.token_forecaster_add_to_adam(model, &opt)
		schedule := optim.lr_cosine(3e-3, STEPS, warmup_steps = STEPS / 20)
		scope: t.Graph_Scope
		defer t.graph_scope_destroy(&scope)
		windows := make([]f64, B * (C + H))
		defer delete(windows)
		first_loss, last_loss := 0.0, 0.0
		for s in 0 ..< STEPS {
			for b in 0 ..< B {
				i := rand.int_max(TRAIN_END - C - H)
				copy(windows[b * (C + H):][:C + H], x[i:i + C + H])
			}
			t.graph_begin(&scope)
			loss := ml_fin.token_forecaster_loss(model, windows, B)
			nn.adam_zero_grad(&opt)
			t.tensor_backward(loss)
			opt.learning_rate = optim.lr_schedule_at(schedule, s)
			nn.adam_step(&opt)
			if s < 20 {first_loss += loss.data.data[0] / 20}
			if s >= STEPS - 20 {last_loss += loss.data.data[0] / 20}
			t.graph_end(&scope)
		}

		// held-out contexts: 100 sample paths each; the truth given x_T:
		// x_{T+h} ~ N(φ^h x_T, (1 - φ^2h) / (1 - φ²)), the h-step sum
		// ~ N(x_T Σ φ^h, Σ_k (Σ_{h ≥ k} φ^(h-k))²)
		NS :: 100
		crps, crps_true, inside: [H + 1]f64 // [H]: the 8-step sum
		crps_uncond := 0.0 // h = 1, N(0, 1 / (1 - φ²))
		n_eval := 0
		col := make([]f64, NS)
		defer delete(col)
		sum_var := 0.0
		for k in 0 ..< H {
			a := 0.0
			for h in k ..< H {a += math.pow(PHI, f64(h - k))}
			sum_var += a * a
		}
		for i := TRAIN_END; i + C + H <= N; i += 50 {
			ctx := x[i:i + C]
			paths := ml_fin.token_forecaster_sample(model, ctx, NS)
			for h in 0 ..= H {
				y, mu, sd: f64
				if h < H {
					for s in 0 ..< NS {col[s] = paths[s * H + h]}
					y = x[i + C + h]
					mu = math.pow(PHI, f64(h + 1)) * ctx[C - 1]
					sd = math.sqrt((1 - math.pow(PHI, 2 * f64(h + 1))) / (1 - PHI * PHI))
				} else {
					for s in 0 ..< NS {col[s] = math.sum(paths[s * H:(s + 1) * H])}
					y = math.sum(x[i + C:i + C + H])
					for h2 in 1 ..= H {mu += math.pow(PHI, f64(h2)) * ctx[C - 1]}
					sd = math.sqrt(sum_var)
				}
				crps[h] += ml_fin.prob_forecast_sample_crps(col, y)
				crps_true[h] += ml_fin.prob_forecast_gaussian_crps(mu, sd, y)
				if h ==
				   0 {crps_uncond += ml_fin.prob_forecast_gaussian_crps(0, 1 / math.sqrt(f64(1 - PHI * PHI)), y)}
				q: [2]f64
				ml_fin.prob_forecast_sample_quantiles(col, {0.1, 0.9}, q[:])
				if y >= q[0] && y <= q[1] {inside[h] += 1}
			}
			delete(paths)
			n_eval += 1
		}
		worst_ratio, worst_cov, mean_cov := 0.0, 0.0, 0.0
		for h in 0 ..= H {
			crps[h] /= f64(n_eval)
			crps_true[h] /= f64(n_eval)
			inside[h] /= f64(n_eval)
			worst_ratio = max(worst_ratio, crps[h] / crps_true[h])
			worst_cov = max(worst_cov, abs(inside[h] - 0.8))
			mean_cov += inside[h] / (H + 1)
		}
		crps_uncond /= f64(n_eval)
		expect(
			&passed,
			&total,
			worst_ratio < 1.2 && abs(mean_cov - 0.8) < 0.1 && worst_cov < 0.15,
			fmt.tprintf(
				"GPT on AR(1) tokens (loss %.2f → %.2f), %d held-out contexts × %d paths: CRPS / the true distribution's %.3f at h = 1 (unconditional %.2f), %.3f at h = 8, %.3f for the 8-step sum (worst %.3f); 80%% intervals cover %.0f%% / %.0f%% / %.0f%% (mean over the 9 %.1f%%)",
				first_loss,
				last_loss,
				n_eval,
				NS,
				crps[0] / crps_true[0],
				crps_uncond / crps_true[0],
				crps[H - 1] / crps_true[H - 1],
				crps[H] / crps_true[H],
				worst_ratio,
				100 * inside[0],
				100 * inside[H - 1],
				100 * inside[H],
				100 * mean_cov,
			),
		)
	}

	fmt.printf("Token forecasting: %d/%d passed\n", passed, total)
	record_failures(total - passed)
}
