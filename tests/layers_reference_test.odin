// Shared with models_reference_test.odin.
// One torch case: input, loss weights R, output, input gradient, parameters
// and their gradients (in nn.layer_parameters' order)
@(private)
_LtCase :: struct {
	x, r, out, dx, p, dp: []f64,
}

// Tensor [1, n] with a logical 3D / 4D shape
@(private)
_lt_tensor :: proc(data: []f64, shape: [4]int, grad: bool) -> ^t.Tensor {
	m := l.matrix_new(f64, 1, len(data))
	copy(m.data, data)
	x := t.tensor_new(m, grad)
	x.shape = shape
	return x
}

@(private)
_lt_load :: proc(params: []^t.Tensor, src: []f64) {
	k := 0
	for p in params {
		n := len(p.data.data)
		copy(p.data.data, src[k:k + n])
		k += n
	}
	assert(k == len(src), "parameter count differs from torch")
}

@(private)
_lt_diff :: proc(a, b: []f64) -> f64 {
	assert(len(a) == len(b), "length differs from torch")
	worst := 0.0
	for x, i in a {worst = max(worst, abs(x - b[i]))}
	return worst
}

// Back-propagates Σ out ⊙ R and returns the max deviations of the output, the
// input gradient (x may be nil) and the parameter gradients
@(private)
_lt_check :: proc(c: _LtCase, out, x: ^t.Tensor, params: []^t.Tensor) -> (d_out, d_x, d_p: f64) {
	r := t.tensor_new(l.matrix_new(f64, out.data.rows, out.data.cols), false)
	copy(r.data.data, c.r)
	r.shape = out.shape
	loss := t.tensor_sum(t.tensor_mul(out, r))
	t.tensor_backward(loss)
	d_out = _lt_diff(out.data.data, c.out)
	if x != nil {d_x = _lt_diff(x.grad.data, c.dx)}
	k := 0
	for p in params {
		for g in p.grad.data {
			d_p = max(d_p, abs(g - c.dp[k]))
			k += 1
		}
	}
	assert(k == len(c.dp), "gradient count differs from torch")
	return
}

@(private)
_lt_params :: proc(layer: nn.Layer) -> []^t.Tensor {
	lay := layer
	ps := make([dynamic]^t.Tensor)
	nn.layer_parameters(&lay, &ps)
	return ps[:]
}

@(private)
_lt_linear :: proc(ps: ^[dynamic]^t.Tensor, lin: ^nn.LinearLayer) {
	append(ps, lin.weights, lin.bias)
}

@(private)
_lt_mha_params :: proc(ps: ^[dynamic]^t.Tensor, q, k, v, o: ^nn.LinearLayer) {
	_lt_linear(ps, q)
	_lt_linear(ps, k)
	_lt_linear(ps, v)
	_lt_linear(ps, o)
}

layers_reference_test :: proc(allocator: mem.Allocator) {
	seed_test(#procedure)
	fmt.println("\n=== nn layers (torch.nn reference) ===")
	context.allocator = allocator
	passed, total := 0, 0
	expect :: proc(passed, total: ^int, ok: bool, name: string) {
		total^ += 1
		if ok {passed^ += 1}
		fmt.printf("%s %s\n", "OK  " if ok else "FAIL", name)
	}
	TOL :: 1e-12

	// 1. Linear + activations
	{
		acts := [8]nn.Activation {
			.None,
			.ReLU,
			.Sigmoid,
			.Tanh,
			.LeakyReLU,
			.Gelu,
			.Softmax,
			.Softplus,
		}
		cases := [8]_LtCase {
			{
				LT_ACT0_X[:],
				LT_ACT0_R[:],
				LT_ACT0_OUT[:],
				LT_ACT0_DX[:],
				LT_ACT0_P[:],
				LT_ACT0_DP[:],
			},
			{
				LT_ACT1_X[:],
				LT_ACT1_R[:],
				LT_ACT1_OUT[:],
				LT_ACT1_DX[:],
				LT_ACT1_P[:],
				LT_ACT1_DP[:],
			},
			{
				LT_ACT2_X[:],
				LT_ACT2_R[:],
				LT_ACT2_OUT[:],
				LT_ACT2_DX[:],
				LT_ACT2_P[:],
				LT_ACT2_DP[:],
			},
			{
				LT_ACT3_X[:],
				LT_ACT3_R[:],
				LT_ACT3_OUT[:],
				LT_ACT3_DX[:],
				LT_ACT3_P[:],
				LT_ACT3_DP[:],
			},
			{
				LT_ACT4_X[:],
				LT_ACT4_R[:],
				LT_ACT4_OUT[:],
				LT_ACT4_DX[:],
				LT_ACT4_P[:],
				LT_ACT4_DP[:],
			},
			{
				LT_ACT5_X[:],
				LT_ACT5_R[:],
				LT_ACT5_OUT[:],
				LT_ACT5_DX[:],
				LT_ACT5_P[:],
				LT_ACT5_DP[:],
			},
			{
				LT_ACT6_X[:],
				LT_ACT6_R[:],
				LT_ACT6_OUT[:],
				LT_ACT6_DX[:],
				LT_ACT6_P[:],
				LT_ACT6_DP[:],
			},
			{
				LT_ACT7_X[:],
				LT_ACT7_R[:],
				LT_ACT7_OUT[:],
				LT_ACT7_DX[:],
				LT_ACT7_P[:],
				LT_ACT7_DP[:],
			},
		}
		worst := 0.0
		for c, a in cases {
			lin := nn.linear_layer_new(5, 4)
			ps := []^t.Tensor{lin.weights, lin.bias}
			_lt_load(ps, c.p)
			xm := l.matrix_new(f64, 6, 5)
			copy(xm.data, c.x)
			x := t.tensor_new(xm, true)
			do_, dx, dp := _lt_check(
				c,
				nn.apply_activation(nn.linear_forward(&lin, x), acts[a]),
				x,
				ps,
			)
			worst = max(worst, do_, dx, dp)
		}
		expect(
			&passed,
			&total,
			worst < TOL,
			fmt.tprintf(
				"Linear(5, 4) + None/ReLU/Sigmoid/Tanh/LeakyReLU/GELU/Softmax/Softplus: output, input and parameter gradients max diff %.1e",
				worst,
			),
		)
	}

	// 2. Conv2d -> BatchNorm2d (training) -> MaxPool2d; running statistics, eval mode, AvgPool2d
	{
		c := _LtCase {
			LT_CNN_X[:],
			LT_CNN_R[:],
			LT_CNN_OUT[:],
			LT_CNN_DX[:],
			LT_CNN_P[:],
			LT_CNN_DP[:],
		}
		conv := nn.conv2d_layer_new(3, 4, 3, stride = 2, padding = 1)
		bn := nn.batch_norm_2d_layer_new(4)
		mp := nn.maxpool2d_layer_new(2)
		ps := []^t.Tensor{conv.weight, conv.bias, bn.weight, bn.bias}
		_lt_load(ps, c.p)
		x := _lt_tensor(c.x, {2, 3, 7, 7}, true)
		bn_fwd :: proc(bn: ^nn.BatchNorm2dLayer, x: ^t.Tensor, training: bool) -> ^t.Tensor {
			return t.tensor_batch_norm_2d(
				x,
				bn.weight,
				bn.bias,
				bn.running_mean,
				bn.running_var,
				training,
				bn.momentum,
				bn.eps,
			)
		}
		out := nn.maxpool2d_layer_forward(
			&mp,
			bn_fwd(&bn, nn.conv2d_layer_forward(&conv, x), true),
		)
		do_, dx, dp := _lt_check(c, out, x, ps)
		run := 0.0
		for i in 0 ..< 4 {
			run = max(
				run,
				abs(bn.running_mean.data.data[i] - LT_CNN_RUN[i]),
				abs(bn.running_var.data.data[i] - LT_CNN_RUN[4 + i]),
			)
		}
		for p in ps {t.tensor_zero_grad(p)}
		ce := _LtCase {
			LT_CNNE_X[:],
			LT_CNNE_R[:],
			LT_CNNE_OUT[:],
			LT_CNNE_DX[:],
			LT_CNNE_P[:],
			LT_CNNE_DP[:],
		}
		x2 := _lt_tensor(ce.x, {2, 3, 7, 7}, true)
		ev := nn.maxpool2d_layer_forward(
			&mp,
			bn_fwd(&bn, nn.conv2d_layer_forward(&conv, x2), false),
		)
		eo, ex, ep := _lt_check(ce, ev, x2, ps)
		d_eval := max(eo, ex, ep)
		avg := t.tensor_avg_pool2d(nn.conv2d_layer_forward(&conv, x), 2, 2, 2)
		d_avg := _lt_diff(avg.data.data, LT_CNN_AVG[:])
		ok := max(do_, dx, dp, run, d_eval, d_avg) < TOL
		expect(
			&passed,
			&total,
			ok,
			fmt.tprintf(
				"Conv2d(3, 4, k3, s2, p1) → BatchNorm2d → MaxPool2d: output %.1e, input grad %.1e, parameter grads %.1e; running mean/var %.1e; eval mode (output and all grads) %.1e; AvgPool2d %.1e",
				do_,
				dx,
				dp,
				run,
				d_eval,
				d_avg,
			),
		)
	}

	// 3. Recurrent layers, zero initial state, full output sequence
	{
		cases := [3]_LtCase {
			{LT_RNN_X[:], LT_RNN_R[:], LT_RNN_OUT[:], LT_RNN_DX[:], LT_RNN_P[:], LT_RNN_DP[:]},
			{LT_GRU_X[:], LT_GRU_R[:], LT_GRU_OUT[:], LT_GRU_DX[:], LT_GRU_P[:], LT_GRU_DP[:]},
			{
				LT_LSTM_X[:],
				LT_LSTM_R[:],
				LT_LSTM_OUT[:],
				LT_LSTM_DX[:],
				LT_LSTM_P[:],
				LT_LSTM_DP[:],
			},
		}
		msg := ""
		ok := true
		for c, k in cases {
			x := _lt_tensor(c.x, {2, 5, 3, 1}, true)
			h0 := t.tensor_new(l.matrix_new(f64, 1, 2 * 4), false)
			c0 := t.tensor_new(l.matrix_new(f64, 1, 2 * 4), false)
			out: ^t.Tensor
			ps: [3]^t.Tensor
			switch k {
			case 0:
				rnn := nn.rnn_layer_new(3, 4)
				ps = {rnn.w_ih, rnn.w_hh, rnn.bias}
				_lt_load(ps[:], c.p)
				out = nn.rnn_layer_forward(&rnn, x, h0)
			case 1:
				gru := nn.gru_layer_new(3, 4)
				ps = {gru.w_ih, gru.w_hh, gru.bias}
				_lt_load(ps[:], c.p)
				out = nn.gru_layer_forward(&gru, x, h0)
			case 2:
				lstm := nn.lstm_layer_new(3, 4)
				ps = {lstm.w_ih, lstm.w_hh, lstm.bias}
				_lt_load(ps[:], c.p)
				out = nn.lstm_layer_forward(&lstm, x, h0, c0)
			}
			do_, dx, dp := _lt_check(c, out, x, ps[:])
			ok &&= max(do_, dx, dp) < TOL
			names := [3]string{"RNN", "GRU", "LSTM"}
			msg = fmt.tprintf(
				"%s%s%s %.1e/%.1e/%.1e",
				msg,
				"; " if k > 0 else "",
				names[k],
				do_,
				dx,
				dp,
			)
		}
		expect(
			&passed,
			&total,
			ok,
			fmt.tprintf(
				"RNN / GRU / LSTM (input 3, hidden 4, 5 steps) output/input grad/parameter grads: %s",
				msg,
			),
		)
	}

	// 4. Embedding -> positional encoding -> LayerNorm (gradients reach the embedding)
	{
		c := _LtCase{nil, LT_EMB_R[:], LT_EMB_OUT[:], nil, LT_EMB_P[:], LT_EMB_DP[:]}
		emb := nn.embedding_layer_new(10, 6)
		norm := nn.layer_norm_layer_new(6)
		pe := nn.positional_encoding_new(16, 6)
		ps := []^t.Tensor{emb.weight, norm.gamma, norm.beta}
		_lt_load(ps, c.p)
		ids := _lt_tensor(LT_EMB_IDS[:], {2, 4, 1, 1}, false)
		out := nn.layer_norm_layer_forward(
			&norm,
			nn.positional_encoding_forward(&pe, nn.embedding_layer_forward(&emb, ids)),
		)
		do_, _, dp := _lt_check(c, out, nil, ps)
		expect(
			&passed,
			&total,
			max(do_, dp) < TOL,
			fmt.tprintf(
				"Embedding(10, 6) → sinusoidal encoding → LayerNorm: output %.1e, embedding and LayerNorm grads %.1e",
				do_,
				dp,
			),
		)
	}

	// 5. Multi-head self-attention: plain, key padding, causal, causal + padding;
	// FlashAttention for the plain and causal cases; the masked forward without
	// a mask (causal only by is_causal), with and without FlashAttention
	{
		cases := [4]_LtCase {
			{
				LT_MHA0_X[:],
				LT_MHA0_R[:],
				LT_MHA0_OUT[:],
				LT_MHA0_DX[:],
				LT_MHA0_P[:],
				LT_MHA0_DP[:],
			},
			{
				LT_MHA1_X[:],
				LT_MHA1_R[:],
				LT_MHA1_OUT[:],
				LT_MHA1_DX[:],
				LT_MHA1_P[:],
				LT_MHA1_DP[:],
			},
			{
				LT_MHA2_X[:],
				LT_MHA2_R[:],
				LT_MHA2_OUT[:],
				LT_MHA2_DX[:],
				LT_MHA2_P[:],
				LT_MHA2_DP[:],
			},
			{
				LT_MHA3_X[:],
				LT_MHA3_R[:],
				LT_MHA3_OUT[:],
				LT_MHA3_DX[:],
				LT_MHA3_P[:],
				LT_MHA3_DP[:],
			},
		}
		pad := _lt_tensor(LT_MHA_PAD[:], {3, 5, 1, 1}, false)
		// runs: name, reference case, use_flash, masked forward (no explicit
		// mask: is_causal alone decides)
		Run :: struct {
			name:   string,
			k:      int,
			flash:  bool,
			masked: bool,
		}
		runs := [?]Run {
			{"plain", 0, false, false},
			{"key padding", 1, false, false},
			{"causal", 2, false, false},
			{"causal + padding", 3, false, false},
			{"flash", 0, true, false},
			{"flash causal", 2, true, false},
			{"masked fwd", 0, false, true},
			{"masked fwd causal", 2, false, true},
			{"masked fwd flash", 0, true, true},
			{"masked fwd flash causal", 2, true, true},
		}
		msg := ""
		ok := true
		for r, run in runs {
			k := r.k
			c := cases[k]
			layer := nn.multi_head_attention_layer_new(
				8,
				2,
				use_flash = r.flash,
				is_causal = k >= 2,
			)
			ps := _lt_params(layer)
			_lt_load(ps, c.p)
			x := _lt_tensor(c.x, {3, 5, 8, 1}, true)
			mask := pad if k == 1 || k == 3 else nil
			out :=
				nn.masked_multi_head_attention_layer_forward(&layer, x, nil) if r.masked else nn.multi_head_attention_layer_forward(&layer, x, mask)
			do_, dx, dp := _lt_check(c, out, x, ps)
			ok &&= max(do_, dx, dp) < TOL
			msg = fmt.tprintf(
				"%s%s%s %.1e",
				msg,
				", " if run > 0 else "",
				r.name,
				max(do_, dx, dp),
			)
		}
		expect(
			&passed,
			&total,
			ok,
			fmt.tprintf(
				"MultiheadAttention (d 8, 2 heads, batch 3 × 5; padding differs per sequence), max diff of output and all grads: %s",
				msg,
			),
		)
	}

	// 6. Transformer encoder block (post-norm, GELU)
	{
		c := _LtCase {
			LT_ENC_X[:],
			LT_ENC_R[:],
			LT_ENC_OUT[:],
			LT_ENC_DX[:],
			LT_ENC_P[:],
			LT_ENC_DP[:],
		}
		block := nn.transformer_encoder_block_new(8, 2, 16)
		ps := _lt_params(block)
		_lt_load(ps, c.p)
		x := _lt_tensor(c.x, {3, 5, 8, 1}, true)
		do_, dx, dp := _lt_check(c, nn.transformer_encoder_block_forward(&block, x), x, ps)
		expect(
			&passed,
			&total,
			max(do_, dx, dp) < TOL,
			fmt.tprintf(
				"TransformerEncoderLayer (d 8, 2 heads, d_ff 16, GELU, no dropout): output %.1e, input grad %.1e, all 16 parameter grads %.1e",
				do_,
				dx,
				dp,
			),
		)
	}

	// 7. Transformer decoder block (causal self-attention, cross-attention)
	{
		c := _LtCase {
			LT_DEC_X[:],
			LT_DEC_R[:],
			LT_DEC_OUT[:],
			LT_DEC_DX[:],
			LT_DEC_P[:],
			LT_DEC_DP[:],
		}
		// with the causal mask, without it (the self-attention is causal by
		// is_causal), and with FlashAttention
		names := [3]string{"causal mask", "no mask", "flash"}
		worst: [3]f64
		for run in 0 ..< 3 {
			block := nn.transformer_decoder_block_new(8, 2, 16, use_flash = run == 2)
			psd := make([dynamic]^t.Tensor)
			m := &block.masked_mha
			_lt_mha_params(&psd, &m.q_proj, &m.k_proj, &m.v_proj, &m.out_proj)
			cr := &block.cross_attn
			_lt_mha_params(&psd, &cr.q_proj, &cr.k_proj, &cr.v_proj, &cr.out_proj)
			_lt_linear(&psd, &block.ffn.fc1)
			_lt_linear(&psd, &block.ffn.fc2)
			for norm in ([]^nn.LayerNormLayer{&block.ln1, &block.ln2, &block.ln3}) {append(&psd, norm.gamma, norm.beta)}
			ps := psd[:]
			_lt_load(ps, c.p)
			x := _lt_tensor(c.x, {3, 5, 8, 1}, true)
			enc := _lt_tensor(LT_DEC_E0[:], {3, 6, 8, 1}, true)
			mask := nil if run == 1 else nn.create_causal_mask(5, allocator)
			do_, dx, dp := _lt_check(
				c,
				nn.transformer_decoder_block_forward(&block, x, enc, mask),
				x,
				ps,
			)
			worst[run] = max(do_, dx, dp, _lt_diff(enc.grad.data, LT_DEC_DE0[:]))
		}
		expect(
			&passed,
			&total,
			max(worst[0], worst[1], worst[2]) < TOL,
			fmt.tprintf(
				"TransformerDecoderLayer (causal self-attention, cross-attention to 6 encoder steps), max diff of output, input, encoder-output and all 26 parameter grads: %s %.1e, %s %.1e, %s %.1e",
				names[0],
				worst[0],
				names[1],
				worst[1],
				names[2],
				worst[2],
			),
		)
	}

	fmt.printf("Layers summary: %d/%d passed\n", passed, total)
	record_failures(total - passed)
}
