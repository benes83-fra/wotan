Cr_Case :: struct {
	x_shape:                       [4]int,
	C_out, kH, kW, sh, sw, ph, pw: int,
	x, w, b, up, y, dx, dw, db:    []f64,
	name:                          string,
}

// tensor_conv2d with rectangular kernels and separate strides and paddings per
// axis against torch.nn.functional.conv2d, on the layer shapes of the Vocos
// discriminators (multi-period: (5, 1) kernels with (3, 1) strides; multi-
// resolution: (7, 5) and (5, 3) kernels, stride (2, 1)) and one with a larger
// width stride and no bias: output shape, output and the gradients of input,
// weight and bias under a random upstream gradient; Conv2dLayer with the
// width values gives the same output.
conv2d_rect_reference_test :: proc(allocator: mem.Allocator) {
	seed_test(#procedure)
	fmt.println("\n=== conv2d rectangular kernels, strides and padding vs torch ===")
	context.allocator = allocator
	passed, total := 0, 0
	expect :: proc(passed, total: ^int, ok: bool, name: string) {
		total^ += 1
		if ok {passed^ += 1}
		fmt.printf("%s %s\n", "OK  " if ok else "FAIL", name)
	}
	leaf :: proc(v: []f64, shape: [4]int, grad := true) -> ^t.Tensor {
		m := l.matrix_new(f64, 1, len(v))
		copy(m.data, v)
		x := t.tensor_new(m, grad)
		x.shape = shape
		return x
	}
	diff :: proc(a, b: []f64) -> f64 {
		if len(a) != len(b) {return math.INF_F64}
		d := 0.0
		for v, i in a {d = max(d, abs(v - b[i]) / max(1, abs(b[i])))}
		return d
	}
	cases := [?]Cr_Case {
		{
			x_shape = {2, 1, 20, 3},
			C_out = 4,
			kH = 5,
			kW = 1,
			sh = 3,
			sw = 1,
			ph = 2,
			pw = 0,
			x = CR1_X[:],
			w = CR1_W[:],
			b = CR1_B[:],
			up = CR1_UP[:],
			y = CR1_Y[:],
			dx = CR1_DX[:],
			dw = CR1_DW[:],
			db = CR1_DB[:],
			name = "multi-period first layer: kernel (5, 1), stride (3, 1), padding (2, 0)",
		},
		{
			x_shape = {2, 4, 7, 3},
			C_out = 1,
			kH = 3,
			kW = 1,
			sh = 1,
			sw = 1,
			ph = 1,
			pw = 0,
			x = CR2_X[:],
			w = CR2_W[:],
			b = CR2_B[:],
			up = CR2_UP[:],
			y = CR2_Y[:],
			dx = CR2_DX[:],
			dw = CR2_DW[:],
			db = CR2_DB[:],
			name = "multi-period output layer: kernel (3, 1), padding (1, 0)",
		},
		{
			x_shape = {2, 1, 12, 9},
			C_out = 4,
			kH = 7,
			kW = 5,
			sh = 2,
			sw = 2,
			ph = 3,
			pw = 2,
			x = CR3_X[:],
			w = CR3_W[:],
			b = CR3_B[:],
			up = CR3_UP[:],
			y = CR3_Y[:],
			dx = CR3_DX[:],
			dw = CR3_DW[:],
			db = CR3_DB[:],
			name = "multi-resolution first layer: kernel (7, 5), stride 2, padding (3, 2)",
		},
		{
			x_shape = {2, 3, 9, 7},
			C_out = 4,
			kH = 5,
			kW = 3,
			sh = 2,
			sw = 1,
			ph = 2,
			pw = 1,
			x = CR4_X[:],
			w = CR4_W[:],
			b = CR4_B[:],
			up = CR4_UP[:],
			y = CR4_Y[:],
			dx = CR4_DX[:],
			dw = CR4_DW[:],
			db = CR4_DB[:],
			name = "multi-resolution: kernel (5, 3), stride (2, 1), padding (2, 1)",
		},
		{
			x_shape = {2, 2, 6, 11},
			C_out = 3,
			kH = 3,
			kW = 4,
			sh = 1,
			sw = 3,
			ph = 0,
			pw = 2,
			x = CR5_X[:],
			w = CR5_W[:],
			up = CR5_UP[:],
			y = CR5_Y[:],
			dx = CR5_DX[:],
			dw = CR5_DW[:],
			name = "kernel (3, 4), stride (1, 3), padding (0, 2), no bias",
		},
	}

	// 1-5. the configurations against torch
	for c in cases {
		x := leaf(c.x, c.x_shape)
		w := leaf(c.w, {c.C_out, c.x_shape[1], c.kH, c.kW})
		b := leaf(c.b, {1, c.C_out, 1, 1}) if c.b != nil else nil
		y := t.tensor_conv2d(x, w, b, c.sh, c.ph, stride_w = c.sw, pad_w = c.pw)
		oh := (c.x_shape[2] + 2 * c.ph - c.kH) / c.sh + 1
		ow := (c.x_shape[3] + 2 * c.pw - c.kW) / c.sw + 1
		shape_ok := y.shape == [4]int{c.x_shape[0], c.C_out, oh, ow}
		t.tensor_backward_with_grad(y, c.up)
		d := max(diff(y.data.data, c.y), diff(x.grad.data, c.dx), diff(w.grad.data, c.dw))
		if b != nil {d = max(d, diff(b.grad.data, c.db))}
		expect(
			&passed,
			&total,
			shape_ok && d < 1e-13,
			fmt.tprintf(
				"%s: output %v, output and input / weight / bias gradients vs torch %.1e",
				c.name,
				y.shape,
				d,
			),
		)
	}

	// 6. Conv2dLayer with the width values (the multi-resolution (5, 3) layer)
	{
		c := cases[3]
		layer := nn.conv2d_layer_new(
			c.x_shape[1],
			c.C_out,
			c.kH,
			c.sh,
			c.ph,
			kernel_w = c.kW,
			stride_w = c.sw,
			padding_w = c.pw,
		)
		defer nn.conv2d_layer_free(&layer)
		copy(layer.weight.data.data, c.w)
		copy(layer.bias.data.data, c.b)
		y := nn.conv2d_layer_forward(&layer, leaf(c.x, c.x_shape, false))
		d := diff(y.data.data, c.y)
		want_shape := [4]int{c.C_out, c.x_shape[1], c.kH, c.kW}
		expect(
			&passed,
			&total,
			d < 1e-13 && layer.weight.shape == want_shape,
			fmt.tprintf(
				"Conv2dLayer kernel (5, 3), stride (2, 1): weight shape %v, output vs torch %.1e",
				layer.weight.shape,
				d,
			),
		)
	}

	fmt.printf("conv2d rectangular: %d/%d passed\n", passed, total)
	record_failures(total - passed)
}
