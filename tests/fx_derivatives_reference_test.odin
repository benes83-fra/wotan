package tests

// Generated by gen_fx_test.py: QuantLib Garman-Kohlhagen, cash-or-nothing, binary-barrier
// and double-barrier-binary engines; mpmath Greeks; Castagna–Mercurio vanna-volga weights.

import fin "../wotan/finance"
import "core:fmt"
import "core:math"
import "core:mem"

@(private = "file")
FX_GK := [?]f64 {
	0.032917664687813306,
	0.447600636025933,
	3.7999122715220013,
	0.4276041279143707,
	-0.033008529702483407,
	0.45944303494071415,
	-0.49236069962852747,
	0.04861296222620324,
	-0.5325980372808221,
	3.7999122715220013,
	0.4276041279143707,
	0.00012279139355909907,
	-0.6344708032351069,
	0.5858578410089036,
}
@(private = "file")
FX_DIG := [?]f64 {
	0.5129181165593995,
	-46.65984837388999,
	14.562612233114086,
	-0.8150979745629441,
	0.5129181165593992,
}
@(private = "file")
FX_DO1 := [?]f64 {
	0.4048431874904123,
	-33.545958013276795,
	32.84574252157691,
	-3.560739883034826,
	0.4048431874904121,
}
@(private = "file")
FX_DO2 := [?]f64 {
	0.4900461765369496,
	-41.80901445061865,
	108.69897034984572,
	-5.884316595136871,
	0.49004617653694965,
}
@(private = "file")
FX_DNT := [?]f64{0.710792350740213, 28.754537906413525, -39.706066546949586, -7.158449135577667}
@(private = "file")
FX_VV := [?]f64 {
	1.0686579333907353,
	1.1334999873488687,
	1.1999906943223055,
	0.016742966418465233,
	0.03655148803473285,
	0.012924890781820908,
	0.03556316063082475,
	0.9967011396025935,
	-0.03172192401580993,
	0.03836079518157373,
}

fx_derivatives_reference_test :: proc(allocator: mem.Allocator) {
	seed_test(#procedure)
	fmt.println(
		"\n=== FX derivatives: Garman-Kohlhagen, delta strikes, digitals, double-no-touch, vanna-volga (QuantLib reference) ===",
	)
	context.allocator = allocator
	passed, total := 0, 0
	expect :: proc(passed, total: ^int, ok: bool, name: string) {
		total^ += 1
		if ok {passed^ += 1}
		fmt.printf("%s %s\n", "OK  " if ok else "FAIL", name)
	}
	rel :: proc(x, y: f64) -> f64 {return abs(x - y) / max(abs(y), 1e-300)}
	S, rd, rf, T := 1.10, 0.05, 0.02, 1.0
	smile := fin.FXSmile {
		atm_vol           = 0.085,
		risk_reversal_25d = -0.015,
		butterfly_25d     = 0.004,
	}
	vols := fin.fx_smile_to_vols(smile)
	atm := vols.vol_atm

	// 1. Garman-Kohlhagen price and Greeks
	{
		worst := 0.0
		for opt, k in ([]fin.FXOptionType{.Call, .Put}) {
			g := fin.fx_gk_greeks(S, 1.15, T, rd, rf, 0.093, opt)
			got := [7]f64{g.price, g.delta, g.gamma, g.vega, g.theta, g.rho_d, g.rho_f}
			for i in 0 ..< 7 {worst = max(worst, rel(got[i], FX_GK[7 * k + i]))}
		}
		z := fin.fx_gk_price(S, 1.05, T, rd, rf, 0.0, .Call)
		zr := S * math.exp(-rf * T) - 1.05 * math.exp(-rd * T)
		expect(
			&passed,
			&total,
			worst < 1e-12 && rel(z, zr) < 1e-15,
			fmt.tprintf(
				"GK call / put (K = 1.15, σ = 9.3%%) vs QuantLib AnalyticEuropeanEngine: price, delta, gamma, vega, theta, ρ_d, ρ_f max rel err %.1e (ρ_d and ρ_f had the wrong sign); σ = 0 gives the discounted forward %.6f (was NaN)",
				worst,
				z,
			),
		)
	}

	// 2. Strikes from spot delta
	{
		kp := fin.fx_strike_from_delta(S, -0.25, T, rd, rf, vols.vol_25d_put, .Put)
		kc := fin.fx_strike_from_delta(S, 0.25, T, rd, rf, vols.vol_25d_call, .Call)
		dp := fin.fx_gk_greeks(S, kp, T, rd, rf, vols.vol_25d_put, .Put).delta
		dcall := fin.fx_gk_greeks(S, kc, T, rd, rf, vols.vol_25d_call, .Call).delta
		ok :=
			rel(kp, FX_VV[0]) < 1e-14 &&
			rel(kc, FX_VV[2]) < 1e-14 &&
			abs(dp + 0.25) < 1e-14 &&
			abs(dcall - 0.25) < 1e-14
		expect(
			&passed,
			&total,
			ok,
			fmt.tprintf(
				"25Δ strikes vs scipy ndtri: put %.10f (%.10f; old 1.0686901563 from a 4.5e-4 inverse-normal approximation), call %.10f (%.10f); deltas at those strikes %.15f / %.15f",
				kp,
				FX_VV[0],
				kc,
				FX_VV[2],
				dp,
				dcall,
			),
		)
	}

	// 3. Digital and down-and-out digitals (K > L and K < L), vanna / volga / vega
	{
		worst_p, worst_g := 0.0, 0.0
		p := fin.fx_digital_call_price(S, 1.12, T, rd, rf, atm)
		va, vo, ve := fin.fx_digital_call_sensitivities(S, 1.12, T, rd, rf, atm)
		worst_p = max(worst_p, rel(p, FX_DIG[4]))
		worst_g = max(worst_g, rel(va, FX_DIG[1]), rel(vo, FX_DIG[2]), rel(ve, FX_DIG[3]))
		refs := [2][5]f64 {
			{FX_DO1[0], FX_DO1[1], FX_DO1[2], FX_DO1[3], FX_DO1[4]},
			{FX_DO2[0], FX_DO2[1], FX_DO2[2], FX_DO2[3], FX_DO2[4]},
		}
		Ks := [2]f64{1.12, 1.02}
		for r, i in refs {
			q := fin.fx_down_and_out_digital_call_price(S, Ks[i], 1.05, T, rd, rf, atm)
			a, b, c := fin.fx_down_and_out_digital_call_sensitivities(
				S,
				Ks[i],
				1.05,
				T,
				rd,
				rf,
				atm,
			)
			worst_p = max(worst_p, rel(q, r[4]))
			worst_g = max(worst_g, rel(a, r[1]), rel(b, r[2]), rel(c, r[3]))
		}
		low := fin.fx_down_and_out_digital_call_price(S, 1.02, 1.05, T, rd, rf, atm)
		expect(
			&passed,
			&total,
			worst_p < 1e-13 && worst_g < 2e-4,
			fmt.tprintf(
				"digital and down-and-out digitals (L = 1.05, K = 1.12 and 1.02) vs QuantLib: prices max rel err %.1e (K < L: %.6f vs %.6f; old 0.474856, the formula assumed K > L); vanna / volga / vega (central differences) vs mpmath derivatives max rel err %.1e",
				worst_p,
				low,
				FX_DO2[4],
				worst_g,
			),
		)
	}

	// 4. Double-no-touch PDE
	{
		p := fin.fx_dnt_pde_price(S, 0.95, 1.25, T, rd, rf, atm)
		va, vo, ve := fin.fx_dnt_pde_sensitivities(S, 0.95, 1.25, T, rd, rf, atm)
		ok :=
			rel(p, FX_DNT[0]) < 3e-5 &&
			rel(va, FX_DNT[1]) < 2e-3 &&
			rel(vo, FX_DNT[2]) < 2e-3 &&
			rel(ve, FX_DNT[3]) < 2e-3
		expect(
			&passed,
			&total,
			ok,
			fmt.tprintf(
				"double-no-touch 0.95 / 1.25 (PDE, 200 × 1000) vs QuantLib AnalyticDoubleBarrierBinaryEngine: price %.7f (%.7f; old 0.785568, the discount term had the wrong sign), vanna %.3f (%.3f), volga %.3f (%.3f), vega %.4f (%.4f)",
				p,
				FX_DNT[0],
				va,
				FX_DNT[1],
				vo,
				FX_DNT[2],
				ve,
				FX_DNT[3],
			),
		)
	}

	// 5. Vanna-volga: a vanilla reproduces Castagna–Mercurio's closed-form weights,
	//    and a pillar reproduces its own market price
	{
		mp, ma, mc := FX_VV[3], FX_VV[4], FX_VV[5]
		g := fin._fx_vanna_volga_sensitivities(S, 1.13, T, rd, rf, atm)
		bs := fin.fx_gk_price(S, 1.13, T, rd, rf, atm, .Call)
		r := fin.fx_vanna_volga_adjust(
			S,
			T,
			rd,
			rf,
			smile,
			bs,
			g.vanna,
			g.volga,
			mp,
			ma,
			mc,
			allocator,
			g.vega,
		)
		gp := fin._fx_vanna_volga_sensitivities(S, FX_VV[0], T, rd, rf, atm)
		bp := fin.fx_gk_price(S, FX_VV[0], T, rd, rf, atm, .Put)
		rp := fin.fx_vanna_volga_adjust(
			S,
			T,
			rd,
			rf,
			smile,
			bp,
			gp.vanna,
			gp.volga,
			mp,
			ma,
			mc,
			allocator,
			gp.vega,
		)
		dw := max(
			abs(r.weight_25d_put - FX_VV[6]),
			abs(r.weight_atm - FX_VV[7]),
			abs(r.weight_25d_call - FX_VV[8]),
		)
		ok := dw < 1e-10 && rel(r.price_vv, FX_VV[9]) < 1e-12 && rel(rp.price_vv, mp) < 1e-12
		expect(
			&passed,
			&total,
			ok,
			fmt.tprintf(
				"vanna-volga 1.13 call: price %.8f vs Castagna–Mercurio %.8f (BS %.8f; old %.8f: pillar Greeks at their own vols, vanna missing 1/√T), weights %.5f / %.5f / %.5f (max diff %.1e); 25Δ put through VV %.10f vs its market price %.10f",
				r.price_vv,
				FX_VV[9],
				bs,
				0.03814613490402533,
				r.weight_25d_put,
				r.weight_atm,
				r.weight_25d_call,
				dw,
				rp.price_vv,
				mp,
			),
		)
	}

	fmt.printf("FX derivatives summary: %d/%d passed\n", passed, total)
	record_failures(total - passed)
}
