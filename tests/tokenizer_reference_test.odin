// Tokenizers (nn/tokenizers) vs Hugging Face on the real vocabularies (GPT-2,
// bert-base-uncased; downloaded to model_checkpoints by gpt_completion_test /
// event_study_test, skipped if absent): ids of 35 texts (punctuation,
// contractions, whitespace runs, accents, CJK / Hangul, emoji, control and
// format characters, special tokens in the text, a 120-character word) and
// their decoding; padding / special tokens / truncation of the fixed-length
// input; no leaks or bad frees on a heap allocator.
tokenizer_reference_test :: proc(allocator: mem.Allocator) {
	seed_test(#procedure)
	fmt.println("\n=== Tokenizers vs Hugging Face ===")
	GPT2_VOCAB, GPT2_MERGES, BERT_VOCAB ::
		"model_checkpoints/vocab.json",
		"model_checkpoints/merges.txt",
		"model_checkpoints/bert_vocab.txt"
	if !os.exists(GPT2_VOCAB) || !os.exists(GPT2_MERGES) || !os.exists(BERT_VOCAB) {
		fmt.println(
			"SKIP vocabularies not downloaded yet (gpt_completion_test / event_study_test fetch them)",
		)
		return
	}
	passed, total := 0, 0
	expect :: proc(passed, total: ^int, ok: bool, name: string) {
		total^ += 1
		if ok {passed^ += 1}
		fmt.printf("%s %s\n", "OK  " if ok else "FAIL", name)
	}
	// a heap allocator under tracking: arena allocators hide bad frees
	track: mem.Tracking_Allocator
	mem.tracking_allocator_init(&track, os.heap_allocator())
	defer mem.tracking_allocator_destroy(&track)
	heap := mem.tracking_allocator(&track)
	parse :: proc(s: string) -> [dynamic]int {
		ids: [dynamic]int
		rest := s
		for f in strings.fields_iterator(&rest) {
			v, _ := strconv.parse_int(f)
			append(&ids, v)
		}
		return ids
	}
	same :: proc(a: []int, b: [dynamic]int) -> bool {
		if len(a) != len(b) {return false}
		for v, i in a {if v != b[i] {return false}}
		return true
	}

	{
		context.allocator = heap
		bpe, ok_b := tok.bpe_tokenizer_new(GPT2_VOCAB, GPT2_MERGES, 32)
		wp, ok_w := tok.wordpiece_tokenizer_new(BERT_VOCAB, 32)
		ids_b, dec_b, ids_w, dec_w := 0, 0, 0, 0
		for c in TK_CASES {
			ref_b, ref_w := parse(c.bpe), parse(c.wp)
			ids := tok.bpe_encode(&bpe, c.text)
			text := tok.bpe_decode(&bpe, ids)
			if same(
				ids,
				ref_b,
			) {ids_b += 1} else {fmt.printf("   BPE ids differ for %q: %v\n", c.text, ids)}
			if text == c.text {dec_b += 1}
			delete(ids)
			delete(text)
			ids = tok.wordpiece_encode(&wp, c.text)
			text = tok.wordpiece_decode(&wp, ids)
			if same(
				ids,
				ref_w,
			) {ids_w += 1} else {fmt.printf("   WordPiece ids differ for %q: %v\n", c.text, ids)}
			if text == c.wp_decoded {dec_w += 1}
			delete(ids)
			delete(text)
			delete(ref_b)
			delete(ref_w)
		}
		N := len(TK_CASES)
		expect(
			&passed,
			&total,
			ok_b && ok_w && ids_b == N && dec_b == N && ids_w == N && dec_w == N,
			fmt.tprintf(
				"vs GPT2Tokenizer: ids of %d/%d texts equal, decode gives the text back %d/%d; vs BertTokenizer: ids %d/%d, decode %d/%d",
				ids_b,
				N,
				dec_b,
				N,
				ids_w,
				N,
				dec_w,
				N,
			),
		)

		// fixed-length input: BERT [CLS] … [SEP] truncated to max_len, GPT-2 padded
		long := TK_CASES[13].text // 2 words of 13 + 4 pieces
		ids, mask := tok.tokenize(&wp, long)
		raw := tok.wordpiece_encode(&wp, long)
		n_mask := 0
		for m in mask {n_mask += m}
		bert_ok :=
			ids[0] == wp.cls_id &&
			ids[n_mask - 1] == wp.sep_id &&
			n_mask == min(len(raw) + 2, 32) &&
			(n_mask == 32 || ids[n_mask] == wp.pad_id)
		for i in 1 ..< n_mask - 1 {bert_ok &&= ids[i] == raw[i - 1]}
		delete(ids)
		delete(mask)
		delete(raw)
		short := TK_CASES[1].text // ends in "!" = id 0, also GPT-2's padding id
		ids, mask = tok.bpe_tokenize(&bpe, short, add_special_tokens = false)
		raw = tok.bpe_encode(&bpe, short)
		n_mask = 0
		for m in mask {n_mask += m}
		gpt_ok := n_mask == len(raw)
		for v, i in raw {gpt_ok &&= ids[i] == v}
		delete(ids)
		delete(mask)
		delete(raw)
		tok.bpe_tokenizer_free(&bpe)
		tok.wordpiece_tokenizer_free(&wp)
		free_all(context.temp_allocator)
		expect(
			&passed,
			&total,
			bert_ok && gpt_ok && len(track.allocation_map) == 0 && len(track.bad_free_array) == 0,
			fmt.tprintf(
				"BERT input [CLS] tokens [SEP] truncated to 32 %v, GPT-2 input padded with the mask marking the real tokens (incl. id 0) %v; on a tracked heap allocator %d allocations leaked, %d bad frees",
				bert_ok,
				gpt_ok,
				len(track.allocation_map),
				len(track.bad_free_array),
			),
		)
	}

	fmt.printf("Tokenizers vs Hugging Face: %d/%d passed\n", passed, total)
	record_failures(total - passed)
}
