IPD_KB := [?]f64{30.0, 31.928497241649932, 32.20596107374686, 35.28213370172502, 42.005227601925064, 43.44245718924043, 44.28179429385632, 47.22581293442828, 49.2556944960345, 50.61529326285347, 57.77380086230623, 58.731726288080125, 60.82783194178245, 62.96929288503287, 63.1364452140102, 64.7427523225391, 66.05650725114859, 69.91258139750272, 71.58285059211664, 73.72122093690885, 78.19977663512961, 78.89105033618576, 79.72746999156368, 86.26294162797973, 88.73793215182812, 89.32271467229633, 96.3402605307871, 101.38732063314154, 105.44929581829703, 113.73124273530941, 121.2579153534383, 122.71988409482086, 123.61561051675042, 125.33543133191019, 126.16450101594614, 127.34465258321974, 134.379181078901, 135.04923219302145, 137.0834660061646, 137.9102175824301, 138.69948559056635, 144.02446648036863, 146.066130170775, 147.8062661136118, 149.6621351153534, 153.6950410367767, 157.26856076445478, 160.70086664859303, 161.21175994879792, 163.24988453994314, 164.00506181653833, 166.0466629354332, 177.34679896990784, 182.27658968979685, 183.53490875975425, 188.07529575407364, 192.5304000953712, 199.0649805651117, 200.11264071951635, 200.63906737478743, 201.6922097626008, 205.62189374164953, 206.7810271036515, 206.79871645416478, 210.9193918040714, 211.02462952375836, 218.09210828237, 219.6093122548303, 222.03394490719424, 222.6146794326606, 226.56008258681948, 227.9203014628051, 233.10904135915737, 236.81828850551983, 241.3401555030517, 245.1486822377295, 245.23536784594776, 246.15085751858408, 247.66461209383814, 250.0}
@(private = "file")
IPD_CB := [?]f64{71.95001770995587, 70.18957471221918, 69.93699834824375, 67.14910623235544, 61.13838493671723, 59.86849417444755, 59.129354084187014, 56.551176161109, 54.78654556717578, 53.610519496591614, 47.49664707189117, 46.68859637837451, 44.92907684591618, 43.14420901995803, 43.00545418064111, 41.67639044683112, 40.59548171951328, 37.457953068217606, 36.117179637596486, 34.41915644545245, 30.941736173871945, 30.415869315676815, 29.783908582828545, 25.03209276690331, 23.331811061386883, 22.93902740982163, 18.5193246290803, 15.7057696231151, 13.677411053382723, 10.195651872225236, 7.746892719747746, 7.342946230647447, 7.106145963296482, 6.6734754928817415, 6.474916243755208, 6.203127858116625, 4.824648300813623, 4.712933865951745, 4.392380998013428, 4.26976148254073, 4.156645530225202, 3.485558474326561, 3.266369476562188, 3.0942113266474607, 2.9243050473620515, 2.5986768467974217, 2.353391669817947, 2.1500132246187063, 2.1221333490071106, 2.016515009551136, 1.9795381944436286, 1.8849728640247585, 1.4759976081507593, 1.3428690664213867, 1.312174501074192, 1.2108001530262187, 1.1235502688030572, 1.0129918179954682, 0.9968862644983039, 0.9889444021932263, 0.9733487044461159, 0.9183609891075177, 0.9030345468549378, 0.9028036085043166, 0.8512809011516715, 0.8500214766593417, 0.7711118871653707, 0.755500640887818, 0.7314230955461373, 0.725808372132241, 0.6891230450258586, 0.6770351482429633, 0.6333336408572215, 0.604247612724374, 0.5709819687447575, 0.5446782360954672, 0.5440967462307708, 0.5380008805295606, 0.528099890871359, 0.5132479245871742}
@(private = "file")
IPD_EXACT_A :: [3]f64{72.3, 0.15499943633901508, 3.634865006910246}
@(private = "file")
IPD_EXACT_B :: [4]f64{95.0, 0.3575617894581665, 8.787061100213975, 0.2029537174833358}
@(private = "file")
IPD_EXACT_75 :: f64(0.16951959278955298)
@(private = "file")
IPD_OLD_A :: [3]f64{0.2863766427121963, 11.516032231189733, 0.12998467180364642}

implied_default_prob_reference_test :: proc(allocator: mem.Allocator) {
	seed_test(#procedure)
	fmt.println("\n=== Implied default probability / Breeden-Litzenberger (closed-form lognormal mixture) ===")
	context.allocator = allocator
	passed, total := 0, 0
	expect :: proc(passed, total: ^int, ok: bool, name: string) {
		total^ += 1
		if ok {passed^ += 1}
		fmt.printf("%s %s\n", "OK  " if ok else "FAIL", name)
	}
	S, r, T := IPD_SETUP[0], IPD_SETUP[1], IPD_SETUP[2]
	ea, eb := IPD_EXACT_A, IPD_EXACT_B
	old := IPD_OLD_A

	// 1. PD and expected loss on a uniform grid (K_default between strikes)
	{
		res := fin.implied_default_probability(IPD_KA[:], IPD_CA[:], r, T, ea[0], spot = S)
		defer {delete(res.rnd_strikes); delete(res.rnd_values)}
		e_pd, e_el := abs(res.pd_risk_neutral - ea[1]), abs(res.expected_loss - ea[2])
		expect(&passed, &total, e_pd < 5e-4 && e_el < 2e-4, fmt.tprintf("strikes 30..250 step 2.5, K_d %.1f: PD %.5f vs exact %.5f (err %.1e; old %.5f), expected loss %.5f vs put %.5f (err %.1e; old %.4f was ∫K f(K) dK, not a loss)", ea[0], res.pd_risk_neutral, ea[1], e_pd, old[0], res.expected_loss, ea[2], e_el, old[1]))
	}

	// 2. Second-order convergence: halving the step cuts the PD error by ~4
	{
		half_k := make([]f64, (len(IPD_KA) + 1) / 2)
		half_c := make([]f64, len(half_k))
		defer {delete(half_k); delete(half_c)}
		for i in 0 ..< len(half_k) {half_k[i], half_c[i] = IPD_KA[2 * i], IPD_CA[2 * i]}
		coarse := fin.implied_default_probability(half_k, half_c, r, T, 75.0)
		fine := fin.implied_default_probability(IPD_KA[:], IPD_CA[:], r, T, 75.0)
		defer {
			delete(coarse.rnd_strikes); delete(coarse.rnd_values)
			delete(fine.rnd_strikes); delete(fine.rnd_values)
		}
		e5, e25 := abs(coarse.pd_risk_neutral - IPD_EXACT_75), abs(fine.pd_risk_neutral - IPD_EXACT_75)
		expect(&passed, &total, e5 / e25 > 3.5 && e5 / e25 < 4.5, fmt.tprintf("PD error at K_d = 75, step 5 → 2.5: %.2e → %.2e (ratio %.1f, second order)", e5, e25, e5 / e25))
	}

	// 3. Density vs the exact pdf, including the end points
	{
		res := fin.implied_default_probability(IPD_KA[:], IPD_CA[:], r, T, ea[0])
		defer {delete(res.rnd_strikes); delete(res.rnd_values)}
		worst, peak := 0.0, 0.0
		for v, i in res.rnd_values {
			worst = max(worst, abs(v - IPD_PDF_A[i]))
			peak = max(peak, IPD_PDF_A[i])
		}
		expect(&passed, &total, worst < 1.5e-2 * peak, fmt.tprintf("density at all %d strikes vs exact pdf: max err %.1e (%.2f%% of the peak); at K = 30: %.5f vs %.5f (old edge formula gave %.5f, which grows like 1/step)", len(IPD_KA), worst, 100 * worst / peak, res.rnd_values[0], IPD_PDF_A[0], old[2]))
	}

	// 4. Non-uniform grid; expected loss without the spot (lower bound, put at K_min ≈ 0)
	{
		res := fin.implied_default_probability(IPD_KB[:], IPD_CB[:], r, T, eb[0], spot = S)
		nos := fin.implied_default_probability(IPD_KB[:], IPD_CB[:], r, T, eb[0])
		defer {
			delete(res.rnd_strikes); delete(res.rnd_values)
			delete(nos.rnd_strikes); delete(nos.rnd_values)
		}
		e_pd, e_el := abs(res.pd_risk_neutral - eb[1]), abs(res.expected_loss - eb[2])
		gap := eb[2] - nos.expected_loss
		low := abs(gap - eb[3]) < 3e-3
		expect(&passed, &total, e_pd < 3e-3 && e_el < 3e-3 && low, fmt.tprintf("80 random strikes, K_d %.0f: PD %.5f vs %.5f (err %.1e), expected loss %.5f vs %.5f; without spot %.5f, short by %.4f = the put at K_min %.4f", eb[0], res.pd_risk_neutral, eb[1], e_pd, res.expected_loss, eb[2], nos.expected_loss, gap, eb[3]))
	}

	// 5. Degenerate inputs
	{
		out := fin.implied_default_probability(IPD_KA[:], IPD_CA[:], r, T, 10.0)
		defer {delete(out.rnd_strikes); delete(out.rnd_values)}
		bad := fin.implied_default_probability(IPD_KA[:], IPD_CA[:5], r, T, ea[0])
		expect(&passed, &total, math.is_nan(out.pd_risk_neutral) && math.is_nan(out.expected_loss) && bad.rnd_values == nil, fmt.tprintf("K_d below the grid gives NaN (old: silently 0), mismatched lengths give an empty result"))
	}

	fmt.printf("Implied default probability summary: %d/%d passed\n", passed, total)
	record_failures(total - passed)
}
