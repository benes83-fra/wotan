@(private = "file")
PF_MU := [?]f64{-0.00035449968740996975, 0.0004323739560178967, 0.00027525559023997183, -0.0004226986121324655, 0.0002503393942601301, 0.00042873916698523665, -0.0006158414382605532, -0.0001592552516924311}
@(private = "file")
PF_COV := [?]f64{0.00017731229707668131, 0.00010089180988263934, 0.0001198115915873671, 0.00010264959661961768, 5.535269676612229e-05, 7.202310255747644e-05, 0.00010247528546653233, 8.762434110530444e-05, 0.00010089180988263934, 0.00019038959824696435, 0.0001452338235723968, 0.0001289177247136524, 6.928346278944215e-05, 8.920351430555446e-05, 0.00012383328439706705, 0.00011082276246475455, 0.0001198115915873671, 0.0001452338235723968, 0.00021291851393459292, 0.00016437873769107342, 8.235305779701848e-05, 0.00010806399840712141, 0.0001576659020279434, 0.00013007132863920333, 0.00010264959661961768, 0.0001289177247136524, 0.00016437873769107342, 0.0002035065971912125, 6.487500550502495e-05, 9.308495495045325e-05, 0.00016656176912360803, 9.701276940286801e-05, 5.535269676612229e-05, 6.928346278944215e-05, 8.235305779701848e-05, 6.487500550502495e-05, 0.0001564940249722493, 4.581316548894716e-05, 5.880732580987898e-05, 5.643297996502562e-05, 7.202310255747644e-05, 8.920351430555446e-05, 0.00010806399840712141, 9.308495495045325e-05, 4.581316548894716e-05, 7.971358925217925e-05, 8.622018565769107e-05, 8.205445805243683e-05, 0.00010247528546653233, 0.00012383328439706705, 0.0001576659020279434, 0.00016656176912360803, 5.880732580987898e-05, 8.622018565769107e-05, 0.0002469748669184152, 9.475299116162867e-05, 8.762434110530444e-05, 0.00011082276246475455, 0.00013007132863920333, 9.701276940286801e-05, 5.643297996502562e-05, 8.205445805243683e-05, 9.475299116162867e-05, 0.00012862143608274236}
@(private = "file")
PF_GMV := [?]f64{0.09464422187435033, -0.06372441767750008, -0.46400889223112207, 0.005098867854841654, 0.2468423210620135, 1.0163418742945756, 0.06789643554923872, 0.09690958927360208}
@(private = "file")
PF_TAN := [?]f64{-1.8437357367057927, 2.368028254246339, 3.4731281572939445, -4.076408975237907, 0.18300950375599456, 9.479620551212552, -1.733118625031174, -6.850523129533955}
@(private = "file")
PF_TARGETS := [?]f64{0.00024931267462797774, 0.0002798228881929642, 0.00031033310175795074, 0.0003408433153229372, 0.0003713535288879237, 0.00040186374245291016, 0.0004323739560178967}
@(private = "file")
PF_FW := [?]f64{0.0946442218743506, -0.06372441767749946, -0.46400889223112185, 0.005098867854841337, 0.24684232106201337, 1.0163418742945751, 0.06789643554923913, 0.09690958927360169, 0.08894430753275039, -0.05657371336456678, -0.45243152122390584, -0.006903033520180478, 0.24665461710375866, 1.0412286171098795, 0.06260045034891751, 0.07648027601334709, 0.0832443931911502, -0.049423009051632515, -0.44085415021669044, -0.018904934895202535, 0.24646691314550376, 1.0661153599251831, 0.05730446514859618, 0.05605096275309223, 0.07754447884955012, -0.0422723047386977, -0.42927677920947577, -0.030906836270224208, 0.24627920918724905, 1.0910021027404866, 0.05200847994827455, 0.03562164949283744, 0.0718445645079497, -0.035121600425765356, -0.41769940820225976, -0.04290873764524628, 0.2460915052289943, 1.1158888455557916, 0.046712494747953186, 0.015192336232582617, 0.06614465016634989, -0.02797089611283109, -0.4061220371950444, -0.054910639020268506, 0.24590380127073908, 1.1407755883710955, 0.041416509547631895, -0.005236977027672299, 0.06044473582474928, -0.020820191799897515, -0.39454466618782885, -0.06691254039528985, 0.24571609731248453, 1.1656623311863994, 0.036120524347310196, -0.025666290287927312}

@(private = "file")
_pf_rel :: proc(x, ref: f64) -> f64 {
	return abs(x - ref) / max(abs(ref), 1e-300)
}

portfolio_reference_test :: proc(allocator: mem.Allocator) {
	seed_test(#procedure)
	fmt.println("\n=== Portfolio: minimum variance, tangency, efficient frontier (numpy reference) ===")
	context.allocator = allocator
	passed, total := 0, 0
	expect :: proc(passed, total: ^int, ok: bool, name: string) {
		total^ += 1
		if ok {passed^ += 1}
		fmt.printf("%s %s\n", "OK  " if ok else "FAIL", name)
	}

	X := l.matrix_new(f64, PF_T, PF_N)
	defer l.matrix_free(&X)
	copy(X.data, PF_X[:])

	// 1. Expected returns and covariance from history
	cov := fin.covariance_matrix(&X)
	defer l.matrix_free(&cov)
	mu := fin.expected_returns_from_history(&X)
	defer delete(mu)
	{
		worst := 0.0
		for v, i in cov.data {worst = max(worst, _pf_rel(v, PF_COV[i]))}
		for v, i in mu {worst = max(worst, _pf_rel(v, PF_MU[i]))}
		expect(&passed, &total, worst < 1e-12, fmt.tprintf("expected_returns_from_history / covariance_matrix (%d x %d) vs numpy mean / cov: max rel err %.1e", PF_T, PF_N, worst))
	}

	// 2. Minimum variance and tangency portfolios
	{
		gmv := fin.min_variance_portfolio(&cov)
		tan := fin.max_sharpe_portfolio(mu, &cov, PF_RF)
		defer {delete(gmv); delete(tan)}
		worst := 0.0
		for i in 0 ..< PF_N {worst = max(worst, abs(gmv[i] - PF_GMV[i]), abs(tan[i] - PF_TAN[i]))}
		m := fin.portfolio_metrics(tan, mu, &cov, PF_RF)
		expect(&passed, &total, worst < 1e-10 && _pf_rel(m.sharpe_ratio, PF_MAX_SR) < 1e-12, fmt.tprintf("min_variance_portfolio / max_sharpe_portfolio vs numpy: max weight err %.1e; tangency Sharpe %.6f = analytic max sqrt((μ-rf)ᵀΣ⁻¹(μ-rf)) %.6f", worst, m.sharpe_ratio, PF_MAX_SR))
	}

	// 3. Risk-free rate above the minimum-variance return: no maximum exists
	{
		w_hi := fin.max_sharpe_portfolio(mu, &cov, PF_RF_HI)
		defer delete(w_hi)
		expect(&passed, &total, math.is_nan(w_hi[0]), fmt.tprintf("max_sharpe_portfolio with rf above the minimum-variance return gives NaN weights (the old formula returned the MINIMUM Sharpe portfolio, Sharpe %.4f)", PF_OLD_HI_SR))
	}

	// 4. Efficient frontier vs the bordered KKT system at each target return
	{
		fr := fin.efficient_frontier(mu, &cov, PF_RF, PF_NP)
		defer {
			for p in fr {delete(p.weights)}
			delete(fr)
		}
		worst, worst_ret := 0.0, 0.0
		increasing := true
		for p, k in fr {
			for i in 0 ..< PF_N {worst = max(worst, abs(p.weights[i] - PF_FW[k * PF_N + i]))}
			worst_ret = max(worst_ret, abs(p.expected_return - PF_TARGETS[k]))
			if k > 0 && p.volatility <= fr[k - 1].volatility {increasing = false}
		}
		expect(&passed, &total, worst < 1e-10 && worst_ret < 1e-15 && increasing, fmt.tprintf("efficient_frontier (%d points) vs numpy KKT solve: max weight err %.1e, return err %.1e; starts at the minimum-variance portfolio and volatility rises along it: %v (the old grid started at the lowest asset return, so %d of %d points were on the inefficient lower branch)", PF_NP, worst, worst_ret, increasing, PF_OLD_BELOW, PF_NP))
	}

	// 5. Degenerate inputs: equal expected returns, a single point
	{
		flat := make([]f64, PF_N)
		defer delete(flat)
		for &v in flat {v = 0.0004}
		fr := fin.efficient_frontier(flat, &cov, 0, 4)
		one := fin.efficient_frontier(mu, &cov, 0, 1)
		defer {
			for p in fr {delete(p.weights)}
			delete(fr)
			delete(one[0].weights)
			delete(one)
		}
		worst := 0.0
		for p in fr {
			for i in 0 ..< PF_N {worst = max(worst, abs(p.weights[i] - PF_GMV[i]))}
		}
		for i in 0 ..< PF_N {worst = max(worst, abs(one[0].weights[i] - PF_GMV[i]))}
		expect(&passed, &total, worst < 1e-10, fmt.tprintf("equal expected returns and n_points = 1 both give the minimum-variance portfolio: max err %.1e (old: equal weights 1/n, and NaN for one point)", worst))
	}

	fmt.printf("Portfolio summary: %d/%d passed\n", passed, total)
	record_failures(total - passed)
}
