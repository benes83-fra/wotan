			0.7492061340016524,
			-0.003905757763701654,
			-7.6134124804368595,
		},
	}
	{
		worst_rel, worst_tiny := 0.0, 0.0
		for row in BS_REF {
			g := fin.compute_greeks(100, row[0], row[1], r, row[2], .Call if row[3] == 0 else .Put)
			got := [6]f64{g.price, g.delta, g.gamma, g.vega, g.theta, g.rho}
			for k in 0 ..< 6 {
				ref := row[4 + k]
				err := abs(got[k] - ref) / abs(ref) if ref != 0 else abs(got[k])
				if abs(ref) >
				   1e-20 {worst_rel = max(worst_rel, err)} else {worst_tiny = max(worst_tiny, err)}
			}
		}
		expect(
			&passed,
			&total,
			worst_rel < 1e-11,
			fmt.tprintf(
				"price / delta / gamma / vega / theta / rho on 120 options: max relative error %.1e",
				worst_rel,
			),
		)
		expect(
			&passed,
			&total,
			worst_tiny < 1e-8,
			fmt.tprintf(
				"far out-of-the-money values down to 1e-292 keep relative accuracy (%.1e, no underflow to 0)",
				worst_tiny,
			),
		)
	}

	// --- degenerate inputs: expiry and zero volatility ---
	{
		c0 := fin.compute_greeks(110, 100, 0, r, 0.2, .Call)
		p0 := fin.compute_greeks(90, 100, 0, r, 0.2, .Put)
		cs := fin.compute_greeks(100, 100, 2, r, 0, .Call)
		ps := fin.compute_greeks(100, 100, 2, r, 0, .Put)
		KD := 100 * math.exp(-2 * r)
		expect(
			&passed,
			&total,
			c0.price == 10 && c0.delta == 1 && p0.price == 10 && p0.delta == -1 && c0.gamma == 0,
			"T = 0: intrinsic value and step delta (was NaN)",
		)
		expect(
			&passed,
			&total,
			abs(cs.price - (100 - KD)) < 1e-12 &&
			cs.delta == 1 &&
			abs(cs.rho - 2 * KD / 100) < 1e-12 &&
			ps == (fin.Greeks{}),
			"sigma = 0: discounted payoff of the forward (was NaN)",
		)
	}

	// --- implied volatility: round trip over moneyness, maturity and volatility ---
	{
		n_cases, n_ok, max_iter := 0, 0, 0
		worst := 0.0
		for K in ([]f64{50, 80, 100, 120, 200}) do for T in ([]f64{0.01, 0.25, 1, 5}) do for s in ([]f64{0.05, 0.2, 0.8, 2}) do for o in fin.OptionType {
			p := fin.compute_greeks(100, K, T, r, s, o).price
			KD := K * math.exp(-r * T)
			lower := max(100 - KD, 0) if o == .Call else max(KD - 100, 0)
			if p - lower <= 1e-10 * max(p, 1) {continue} 	// time value lost to rounding: no volatility information
			n_cases += 1
			iv, ok, it := fin.implied_volatility(p, 100, K, T, r, o)
			if ok && abs(iv - s) <= 1e-7 * s {n_ok += 1}
			worst = max(worst, abs(iv - s) / s)
			max_iter = max(max_iter, it)
		}
		expect(
			&passed,
			&total,
			n_ok == n_cases && max_iter <= 20,
			fmt.tprintf(
				"implied vol recovers sigma in %d/%d cases (deep ITM/OTM, T = 0.01..5, sigma = 5%%..200%%; worst %.1e, <= %d iterations)",
				n_ok,
				n_cases,
				worst,
				max_iter,
			),
		)
		_, ok1, it1 := fin.implied_volatility(9.9, 110, 100, 1, r, .Call) // below intrinsic
		_, ok2, _ := fin.implied_volatility(100, 100, 100, 1, r, .Call) // at the upper bound S
		_, ok3, _ := fin.implied_volatility(math.nan_f64(), 100, 100, 1, r, .Put)
		expect(
			&passed,
			&total,
			!ok1 && it1 == 0 && !ok2 && !ok3,
			"implied vol rejects prices outside the no-arbitrage bounds",
		)
	}

	// --- tensor_norm_cdf (was the Hastings approximation, ~1e-7) and autograd BS ---
	{
		X := [?]f64{-37.0, -20.0, -8.0, -3.0, -1.0, 0.0, 0.5, 2.5, 8.0}
		REF := [?]f64 {
			5.7255712225239266e-300,
			2.7536241186061556e-89,
			6.22096057427174e-16,
			0.0013498980316300933,
			0.15865525393145707,
			0.5,
			0.6914624612740131,
			0.9937903346742238,
			0.9999999999999993,
		}
		xm := l.matrix_new(f64, len(X), 1)
		copy(xm.data, X[:])
		xt := t.tensor_new(xm, false)
		ct := t.tensor_norm_cdf(xt)
		worst := 0.0
		for v, i in ct.data.data {worst = max(worst, abs(v - REF[i]) / REF[i])}
		t.tensor_free(ct)
		t.tensor_free(xt)
		expect(
			&passed,
			&total,
			worst < 1e-12,
			fmt.tprintf("tensor_norm_cdf at x = -37..8: max relative error %.1e", worst),
		)

		mk :: proc(v: f64, g: bool) -> ^t.Tensor {
			d := l.matrix_new(f64, 1, 1)
			d.data[0] = v
			return t.tensor_new(d, g)
		}
		worst = 0
		for K in ([]f64{50, 100, 200}) do for o in fin.OptionType {
			St, Kt, Tt, rt, st := mk(100, true), mk(K, false), mk(0.5, true), mk(r, true), mk(0.3, true)
			pr := fin.black_scholes_price(St, Kt, Tt, rt, st, o, allocator)
			t.tensor_backward(pr)
			g := fin.compute_greeks(100, K, 0.5, r, 0.3, o)
			for e in ([]f64{pr.data.data[0] - g.price, St.grad.data[0] - g.delta, st.grad.data[0] - 100 * g.vega, rt.grad.data[0] - 100 * g.rho, -Tt.grad.data[0] / 365 - g.theta}) {worst = max(worst, abs(e))}
			t.tensor_free_graph(pr)
			for x in ([]^t.Tensor{St, Kt, Tt, rt, st}) {t.tensor_free(x)}
		}
		expect(
			&passed,
			&total,
			worst < 1e-12,
			fmt.tprintf(
				"autograd black_scholes_price and its gradients match the closed form (%.1e)",
				worst,
			),
		)
	}

	// --- Monte Carlo against numpy (1M paths): mean and per-path std of each output ---
	N_MC :: 50000
	se_scale := math.sqrt_f64(1.0 / N_MC + 1.0 / 1e6)
	names := [5]string{"price", "delta", "vega", "", ""}
	{
		REF := [?]f64{2.5306509018632015, 0.367999011256321, 15.638022668301303}
		STD := [?]f64{5.157020615440084, 0.5221781878960584, 28.104777801609366}
		got: [3]f64
		got[0], got[1], got[2] = fin.monte_carlo_asian_option(100, 105, 0.5, 0.04, 0.25, N_MC, 50)
		nm := names
		ok := true
		desc := ""
		for v, i in got {
			z := (v - REF[i]) / (STD[i] * se_scale)
			ok &&= abs(z) < 4
			desc = fmt.tprintf("%s %s %.4f (ref %.4f, z %+.1f)", desc, nm[i], v, REF[i], z)
		}
		expect(&passed, &total, ok, fmt.tprintf("Asian call:%s", desc))
	}
	{
		REF := [?]f64{0.2133181355108099, 0.013472151500293877, -4.372792361267189}
		STD := [?]f64{0.8423641417504889, 0.8654386336385123, 71.32959161531087}
		got: [3]f64
		got[0], got[1], got[2] = fin.monte_carlo_barrier_asian_option(
			100,
			100,
			1,
			0.03,
			0.2,
			115,
			N_MC,
			50,
		)
		nm := names
		ok := true
		desc := ""
		for v, i in got {
			z := (v - REF[i]) / (STD[i] * se_scale)
			ok &&= abs(z) < 4
			desc = fmt.tprintf("%s %s %.4f (ref %.4f, z %+.1f)", desc, nm[i], v, REF[i], z)
		}
		expect(&passed, &total, ok, fmt.tprintf("Up-and-out Asian call (B=115):%s", desc))
	}
	{
		REF := [?]f64{1.7185016439249228, -0.009045562801467255, -12.761716065738483}
		STD := [?]f64{4.42680267022069, 2.7849279385121313, 258.2564281801145}
		got: [3]f64
		got[0], got[1], got[2] = fin.monte_carlo_barrier_call_bs(
			100,
			100,
			1,
			0.03,
			0.25,
			125,
			N_MC,
			50,
		)
		nm := names
		ok := true
		desc := ""
		for v, i in got {
			z := (v - REF[i]) / (STD[i] * se_scale)
			ok &&= abs(z) < 4
			desc = fmt.tprintf("%s %s %.4f (ref %.4f, z %+.1f)", desc, nm[i], v, REF[i], z)
		}
		expect(&passed, &total, ok, fmt.tprintf("Up-and-out call (B=125):%s", desc))
	}
	{
		REF := [?]f64{17.38070555148806, 1.0933985893557574, 76.90103270001353}
		STD := [?]f64{15.224975077877412, 0.21960021399141424, 84.10151898537626}
		got: [3]f64
		got[0], got[1], got[2] = fin.monte_carlo_lookback_call_option(
			100,
			100,
			1,
			0.05,
			0.2,
			N_MC,
			50,
		)
		nm := names
		ok := true
		desc := ""
		for v, i in got {
			z := (v - REF[i]) / (STD[i] * se_scale)
			ok &&= abs(z) < 4
			desc = fmt.tprintf("%s %s %.4f (ref %.4f, z %+.1f)", desc, nm[i], v, REF[i], z)
		}
		expect(&passed, &total, ok, fmt.tprintf("Fixed-strike lookback call (K=S_0):%s", desc))
	}
	{
		REF := [?]f64 {
			4.460363887658716,
			0.3732329605853992,
			0.2514775090564301,
			8.616531969979901,
			4.282678852573859,
		}
		STD := [?]f64 {
			5.700582645250547,
			0.30785974874155003,
			0.21189853783250487,
			28.31494206898652,
			18.47303375130256,
		}
		got: [5]f64
		got[0], got[1], got[2], got[3], got[4] = fin.monte_carlo_basket_option(
			100,
			90,
			95,
			1,
			0.03,
			0.2,
			0.3,
			-0.3,
			0.6,
			0.4,
			N_MC,
			50,
		)
		nm := [5]string{"price", "delta1", "delta2", "vega1", "vega2"}
		ok := true
		desc := ""
		for v, i in got {
			z := (v - REF[i]) / (STD[i] * se_scale)
			ok &&= abs(z) < 4
			desc = fmt.tprintf("%s %s %.4f (ref %.4f, z %+.1f)", desc, nm[i], v, REF[i], z)
		}
		expect(&passed, &total, ok, fmt.tprintf("Basket call (rho=-0.3):%s", desc))
	}

	// --- pathwise Greeks equal finite differences on the same random numbers ---
	{
		crn :: proc(
			f: proc(S, sig: f64) -> [3]f64,
			h_S, h_sig: f64,
		) -> (
			rel_delta, rel_vega: f64,
		) {
			rand.reset(99)
			base := f(100, 0.2)
			fd: [4]f64
			for bump, j in ([4][2]f64{{h_S, 0}, {-h_S, 0}, {0, h_sig}, {0, -h_sig}}) {
				rand.reset(99)
				fd[j] = f(100 + bump[0], 0.2 + bump[1])[0]
			}
			d := (fd[0] - fd[1]) / (2 * h_S)
			v := (fd[2] - fd[3]) / (2 * h_sig)
			return abs(base[1] - d) / abs(d), abs(base[2] - v) / abs(v)
		}
		asian :: proc(S, sig: f64) -> (o: [3]f64) {o[0], o[1], o[2] = fin.monte_carlo_asian_option(
				S,
				100,
				1,
				0.03,
				sig,
				4000,
				50,
			)
			return}
		lookback :: proc(S, sig: f64) -> (o: [3]f64) {o[0], o[1], o[2] =
				fin.monte_carlo_lookback_call_option(S, 100, 1, 0.03, sig, 4000, 50)
			return}
		basket :: proc(S, sig: f64) -> (o: [3]f64) {o[0], o[1], _, o[2], _ =
				fin.monte_carlo_basket_option(
					S,
					100,
					100,
					1,
					0.03,
					sig,
					0.3,
					0.5,
					0.5,
					0.5,
					4000,
					50,
				)
			return}
		ad, av := crn(asian, 1e-4, 1e-6)
		ld, lv := crn(lookback, 1e-4, 1e-6)
		bd, bv := crn(basket, 1e-4, 1e-6)
		worst := max(ad, av, ld, lv, bd, bv)
		expect(
			&passed,
			&total,
			worst < 1e-5,
			fmt.tprintf(
				"Asian / lookback / basket delta and vega equal common-random-number differences (max rel. gap %.1e)",
				worst,
			),
		)
	}

	// --- exact identities and regressions ---
	{
		// K < S_0: always in the money and homogeneous in S_0, so delta = (V + K·e^{-rT})/S_0.
		// The autograd version missed the paths whose maximum is S_0 (delta 1.09 for 1.18).
		rand.reset(11)
		v, d, _ := fin.monte_carlo_lookback_call_option(100, 95, 0.75, 0.04, 0.3, 2000, 50)
		ident := (v + 95 * math.exp_f64(-0.04 * 0.75)) / 100
		expect(
			&passed,
			&total,
			abs(d - ident) < 1e-12 * ident,
			fmt.tprintf(
				"lookback delta = (V + K·exp(-rT))/S_0 for K < S_0 (%.12f vs %.12f)",
				d,
				ident,
			),
		)

		// Same normals, same estimator as the previous autograd implementation
		rand.reset(11)
		p, de, ve := fin.monte_carlo_asian_option(100, 95, 0.75, 0.04, 0.3, 2000, 50)
		old := [3]f64{9.5480757569884513, 0.67537048614179529, 17.792737124309443}
		expect(
			&passed,
			&total,
			abs(p - old[0]) < 1e-12 * old[0] &&
			abs(de - old[1]) < 1e-12 * old[1] &&
			abs(ve - old[2]) < 1e-12 * old[2],
			"Asian pricer reproduces the autograd implementation (same seed) to 1e-12",
		)
	}

	// --- memory: pricers allocate nothing; smooth max frees its graph ---
	{
		track: mem.Tracking_Allocator
		mem.tracking_allocator_init(&track, runtime.heap_allocator()) // frees must reach a real heap
		defer mem.tracking_allocator_destroy(&track)
		tal := mem.tracking_allocator(&track)
		context.allocator = tal
		_, _, _ = fin.monte_carlo_asian_option(100, 100, 1, 0.03, 0.2, 2000, 252, tal)
		_, _, _ = fin.monte_carlo_barrier_asian_option(100, 100, 1, 0.03, 0.2, 120, 2000, 252, tal)
		_, _, _, _, _ = fin.monte_carlo_basket_option(
			100,
			100,
			100,
			1,
			0.03,
			0.2,
			0.25,
			0.5,
			0.5,
			0.5,
			2000,
			252,
			tal,
		)
		_, _, _ = fin.monte_carlo_lookback_call_option(100, 100, 1, 0.03, 0.2, 2000, 252, tal)
		_, _, _ = fin.monte_carlo_barrier_call_bs(100, 100, 1, 0.03, 0.2, 130, 2000, 252, tal)
		expect(
			&passed,
			&total,
			track.total_allocation_count == 0,
			fmt.tprintf(
				"Monte Carlo pricers allocate nothing (%d allocations; was up to 830 MB peak and 97 MB leaked per call)",
				track.total_allocation_count,
			),
		)

		for grad in ([]bool{true, false}) {
			a := t.tensor_new(l.matrix_new(f64, 3, 1), grad)
			b := t.tensor_new(l.matrix_new(f64, 3, 1), false)
			copy(a.data.data, []f64{1, 5, -2})
			copy(b.data.data, []f64{2, 1, -2})
			m := fin.tensor_smooth_max(a, b, tal)
			if grad {
				t.tensor_backward(m)
				t.tensor_free_graph(m)
			} else {t.tensor_free(m)}
			t.tensor_free(a)
			t.tensor_free(b)
		}
		context.allocator = allocator
		for _, e in track.allocation_map {fmt.println("  leaked:", e.location, e.size)}
		expect(
			&passed,
			&total,
			len(track.allocation_map) == 0,
			"tensor_smooth_max: no use-after-free of its epsilon tensor, nothing leaked with or without a graph",
		)
	}

	fmt.printf("European options summary: %d/%d passed\n", passed, total)
	record_failures(total - passed)
}
