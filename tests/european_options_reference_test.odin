package tests

import fin "../wotan/finance"
import l "../wotan/linalg"
import t "../wotan/tensor"
import "base:runtime"
import "core:fmt"
import "core:math"
import "core:math/rand"
import "core:mem"

// European options: closed-form Black-Scholes, implied volatility and the Monte
// Carlo pricers against references from
//   scipy 1.10 (norm.cdf / norm.pdf closed forms) and
//   numpy Monte Carlo with 1M paths on the same 50-step grid (pathwise
//   estimators; central differences on common random numbers for barriers).
// Monte Carlo results must agree within 4 standard errors of the difference.
european_options_reference_test :: proc(allocator: mem.Allocator) {
	seed_test(#procedure)
	fmt.println(
		"\n=== European options: Black-Scholes, implied vol, Monte Carlo (scipy / numpy reference) ===",
	)
	context.allocator = allocator
	passed, total := 0, 0
	expect :: proc(passed, total: ^int, ok: bool, name: string) {
		total^ += 1
		if ok {passed^ += 1}
		fmt.printf("%s %s\n", "OK  " if ok else "FAIL", name)
	}
	r := 0.03

	// --- closed form: K, T, sigma, type, price, delta, gamma, vega, theta, rho ---
