		worst, worst50 := 0.0, 0.0
		for row in HESTON {
			p := PSETS[int(row[0])]
			T := row[1] / 365
			c := fin.heston_price(100, row[2], T, r, p, .Call)
			put := fin.heston_price(100, row[2], T, r, p, .Put)
			c50 := fin.heston_price(100, row[2], T, r, p, .Call, 50)
			worst = max(worst, abs(c - row[3]), abs(put - row[4]))
			worst50 = max(worst50, abs(c50 - row[3]))
		}
