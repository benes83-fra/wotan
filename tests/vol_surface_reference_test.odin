		{1.0, 0.3, 0.4, 2.0, 200.0, 0.2, 0.27994506416979387},
		{1.0, 0.3, 1.0, 0.25, 50.0, 0.2, 0.31842754179377936},
		{1.0, 0.3, 1.0, 0.25, 80.0, 0.2, 0.21020915368154408},
		{1.0, 0.3, 1.0, 0.25, 95.0, 0.2, 0.1985980052031334},
		{1.0, 0.3, 1.0, 0.25, 100.0, 0.2, 0.20435416666666667},
