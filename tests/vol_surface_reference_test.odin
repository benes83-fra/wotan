package tests

import fin "../wotan/finance"
import opt "../wotan/optimize"
import "core:fmt"
import "core:math"
import "core:mem"

// Volatility surface models against QuantLib 1.44 and scipy:
//   Heston prices (AnalyticHestonEngine), Hagan SABR (sabrVolatility), Heston
//   and SABR calibration round trips on QuantLib quotes, and the
//   Levenberg-Marquardt solver (scipy.optimize.least_squares).
vol_surface_reference_test :: proc(allocator: mem.Allocator) {
	seed_test(#procedure)
	fmt.println("\n=== Volatility surface: Heston, SABR, calibration (QuantLib / scipy reference) ===")
	context.allocator = allocator
	passed, total := 0, 0
	expect :: proc(passed, total: ^int, ok: bool, name: string) {
		total^ += 1
		if ok {passed^ += 1}
		fmt.printf("%s %s\n", "OK  " if ok else "FAIL", name)
	}
	r := 0.03

	// --- Heston prices: pset, days, K, call, put ---
