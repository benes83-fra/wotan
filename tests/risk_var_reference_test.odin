@(private = "file")
_risk_rel :: proc(x, ref: f64) -> f64 {
	return math.abs(x - ref) / max(math.abs(ref), 1e-300)
}

risk_var_reference_test :: proc(allocator: mem.Allocator) {
	seed_test(#procedure)
	fmt.println("\n=== Risk: VaR, ES, backtests, GED (numpy / scipy reference) ===")
	context.allocator = allocator
	passed, total := 0, 0
	expect :: proc(passed, total: ^int, ok: bool, name: string) {
		total^ += 1
		if ok {passed^ += 1}
		fmt.printf("%s %s\n", "OK  " if ok else "FAIL", name)
	}

	// 1. Empirical VaR = inverse ECDF at the exact alpha (numpy's inverted_cdf takes the next
	// order statistic when alpha*n is an integer, since 1 - 0.95 rounds up), ES = exact
	// integral of the empirical quantile function
	{
		worst_v, worst_e := 0.0, 0.0
		for row in RISK_EMP {
			x := RISK_R[:int(row[0])]
			worst_v = max(worst_v, math.abs(fin.var_historical(x, row[1]) - row[2]))
			worst_e = max(worst_e, math.abs(fin.conditional_var(x, row[1]) - row[3]))
			worst_v = max(worst_v, math.abs(fin.value_at_risk(x, row[1], .Historical) - row[2]))
			worst_e = max(worst_e, math.abs(fin.expected_shortfall(x, row[1]) - row[3]))
		}
		expect(&passed, &total, worst_v == 0 && worst_e < 1e-15, fmt.tprintf("historical VaR (inverse ECDF, k = ceil(alpha n) with exact alpha) and ES (Acerbi-Tasche = integral of the empirical quantile) on %d (n, confidence) cases incl. fractional and alpha*n < 1: max err %.1e / %.1e", len(RISK_EMP), worst_v, worst_e))
	}

	// 2. Rolling historical VaR / ES use the preceding window
	{
		v99 := fin.historical_var_rolling(RISK_R[:], 0.99, 252)
		e99 := fin.historical_cvar_rolling(RISK_R[:], 0.99, 252)
		v95 := fin.historical_var_rolling(RISK_R[:], 0.95, 252)
		e95 := fin.historical_cvar_rolling(RISK_R[:], 0.95, 252)
		defer {delete(v99); delete(e99); delete(v95); delete(e95)}
		worst := 0.0
		for row in RISK_ROLL {
			i := int(row[0])
			worst = max(worst, math.abs(v99[i] - row[1]), math.abs(e99[i] - row[2]), math.abs(v95[i] - row[3]), math.abs(e95[i] - row[4]))
		}
		expect(&passed, &total, worst < 1e-15 && v99[251] == 0, fmt.tprintf("rolling historical VaR / ES (window 252): max err %.1e", worst))
	}

	// 3. Parametric VaR
	{
		worst := 0.0
		for row in RISK_PAR {worst = max(worst, _risk_rel(fin.var_parametric(RISK_R[:], row[0]), row[1]))}
		expect(&passed, &total, worst < 1e-13, fmt.tprintf("parametric VaR mean - z*s: max rel err %.1e", worst))
	}

	// 4. Kupiec POF
	{
		worst := 0.0
		ok := true
		for row in RISK_KUP {
			n, k := int(row[0]), int(row[1])
			ret := make([]f64, n)
			vs := make([]f64, n)
			defer {delete(ret); delete(vs)}
			for i in 0 ..< n {ret[i] = -2.0 if i < k else 0.0; vs[i] = 1.0}
			bt := fin.backtest_var(ret, vs, 1.0 - row[2])
			ok = ok && bt.n_breaches == k
			worst = max(worst, math.abs(bt.kupiec_stat - row[3]), math.abs(bt.kupiec_pvalue - row[4]))
		}
		bt0 := fin.backtest_var(make([]f64, 1000), make([]f64, 1000), 0.99) // 0 == -0: no breach
		ok = ok && !bt0.passes_test
		expect(&passed, &total, ok && worst < 1e-10, fmt.tprintf("Kupiec LR and p-value vs scipy chi2.sf on %d cases (0 breaches in 1000 at 99%%: LR %.2f, fails; was LR 0, passes): max err %.1e", len(RISK_KUP), bt0.kupiec_stat, worst))
	}

	// 5. GED pdf / cdf / quantile / ES vs scipy gennorm
	{
		worst, worst_kind := 0.0, ""
		for row in RISK_GED {
			got: f64
			switch row.kind {
			case "pdf":
				got = fin.ged_pdf(row.x, row.p)
			case "cdf":
				got = fin.ged_cdf(row.x, row.p)
			case "ppf":
				got = fin.ged_quantile(row.x, row.p)
			case "cvar":
				got = fin.ged_cvar(row.x, row.p)
			}
			if e := _risk_rel(got, row.ref); e > worst {worst, worst_kind = e, fmt.tprintf("%s p=%.1f x=%g", row.kind, row.p, row.x)}
		}
		expect(&passed, &total, worst < 1e-10, fmt.tprintf("GED pdf/cdf/quantile/ES vs scipy gennorm, %d values, shape 0.8..3.5: max rel err %.1e (%s)", len(RISK_GED), worst, worst_kind))
	}

	// 6. ES multipliers of the unit-variance error distributions (cvar_garch_series)
	{
		worst := 0.0
		one := []f64{1.0}
		for row in RISK_TES {
			s := fin.cvar_garch_series(one, row[1], .StudentT, row[0], 0)
			worst = max(worst, _risk_rel(s[0], row[2]))
			delete(s)
		}
		for row in RISK_NES {
			s := fin.cvar_garch_series(one, row[0])
			c := fin.cvar_garch(one, row[0])
			worst = max(worst, _risk_rel(s[0], row[1]), _risk_rel(-c[0], row[1]))
			delete(s); delete(c)
		}
		g := fin.cvar_garch_series(one, 0.99, .GED, 0, 1.3)
		defer delete(g)
		worst = max(worst, _risk_rel(g[0], -fin.ged_cvar(0.99, 1.3)))
		expect(&passed, &total, worst < 1e-10, fmt.tprintf("ES multipliers normal / unit-variance t / GED vs scipy quad: max rel err %.1e", worst))
	}

	// 7. ES backtest (exceedance residuals, Acerbi-Szekely Z2)
	{
		n := len(RISK_R)
		ret := make([]f64, n)
		vs := make([]f64, n)
		es := make([]f64, n)
		defer {delete(ret); delete(vs); delete(es)}
		for i in 0 ..< n {
			ret[i] = RISK_R[i] * RISK_SIG[i] / 0.01
			vs[i] = 1.6448536269514722 * RISK_SIG[i]
			es[i] = RISK_NES[0][1] * RISK_SIG[i]
		}
		bt := fin.backtest_es(ret, vs, es, 0.95)
		ok :=
			bt.n_violations == int(RISK_ESBT[0]) &&
			_risk_rel(bt.mean_excess_loss, RISK_ESBT[1]) < 1e-12 &&
			_risk_rel(bt.z_statistic, RISK_ESBT[2]) < 1e-12 &&
			_risk_rel(bt.p_value, RISK_ESBT[3]) < 1e-10 &&
			_risk_rel(bt.acerbi_szekely_z2, RISK_ESBT[4]) < 1e-12
		expect(&passed, &total, ok, fmt.tprintf("ES backtest on t(4) returns vs normal ES: %d violations, z = %.3f (p %.2e), Z2 = %.3f -- both reject (old z used n instead of the violation count)", bt.n_violations, bt.z_statistic, bt.p_value, bt.acerbi_szekely_z2))
	}

	// 8. garch_risk_metrics fills its fields consistently
	{
		r := fin.garch_risk_metrics(RISK_R[:], .StudentT)
		resid := a.extract_residuals(RISK_R[:])
		defer delete(resid)
		g := a.garch_fit(resid, .StudentT)
		defer {delete(g.params.alpha); delete(g.params.beta); delete(g.conditional_var); delete(g.standardized_resid)}
		fc := a.garch_forecast(&g, resid, 1)
		z99 := a.garch_std_quantile(&g.params, 0.99)
		ok :=
			r.garch_omega == g.params.omega &&
			r.garch_alpha == g.params.alpha[0] &&
			r.garch_beta == g.params.beta[0] &&
			r.garch_nu == g.params.nu &&
			math.abs(r.long_run_vol - math.sqrt(g.params.omega / (1 - g.persistence))) < 1e-15 &&
			r.current_vol == fc.std_forecast &&
			_risk_rel(r.current_var_99, z99 * fc.std_forecast) < 1e-12 &&
			r.current_cvar_99 > r.current_var_99 &&
			r.current_cvar_95 > r.current_var_95 &&
			r.backtest_99.n_obs == len(RISK_R) - 100
		expect(&passed, &total, ok, fmt.tprintf("garch_risk_metrics (t): omega/alpha/beta/long-run/current vol filled, VaR99 %.4f < ES99 %.4f (t ES was 0, current used the in-sample sigma_n)", r.current_var_99, r.current_cvar_99))
	}

	fmt.printf("Risk VaR/ES summary: %d/%d passed\n", passed, total)
	record_failures(total - passed)
}
