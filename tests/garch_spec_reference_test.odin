garch_spec_reference_test :: proc(allocator: mem.Allocator) {
	seed_test(#procedure)
	fmt.println("\n=== GARCH specs (GJR-t, EGARCH) vs numpy / scipy ===")
	context.allocator = allocator
	passed, total := 0, 0
	expect :: proc(passed, total: ^int, ok: bool, name: string) {
		total^ += 1
		if ok {passed^ += 1}
		fmt.printf("%s %s\n", "OK  " if ok else "FAIL", name)
	}
	near :: proc(got, want, rtol: f64) -> bool {return math.abs(got - want) <= rtol * max(1, math.abs(want))}

	{
		th := []f64{1.1325916086692028e-06, 0.06437956615546243, 0.840042660394772, 0.1391540191155818, 8.466676749007423}
		p := ts.GARCH_Params{variance = .GJR, dist = .StudentT, p = 1, q = 1, omega = th[0], alpha = []f64{th[1]}, beta = []f64{th[2]}}
		p.gamma = th[3]
		p.nu = th[4]
		nll := ts._garch_neg_log_likelihood(&p, GA_E0[:], context.allocator)
		expect(&passed, &total, near(nll, -5913.571416490671, 1e-10), "GJR + Student-t: log-likelihood = numpy reference")
		r := ts.garch_fit_spec(GA_E0[:], {variance = .GJR, dist = .StudentT, p = 1, q = 1})
		got := []f64{r.params.omega, r.params.alpha[0], r.params.beta[0], r.params.gamma, r.params.nu}
		want := []f64{1.0296287351538208e-06, 0.07153285128384715, 0.840042660394772, 0.11596168259631817, 8.912291314744657}
		ok := r.log_likelihood >= 5914.2576126998065 - 1e-4
		for v, i in got {if !(math.abs(v - want[i]) <= 2e-3 * max(math.abs(want[i]), 0.01)) do ok = false}
		expect(&passed, &total, ok, fmt.tprintf("GJR + Student-t: MLE = scipy optimum (llf %.4f vs 5914.2576)", r.log_likelihood))
		fc := ts.garch_forecast(&r, GA_E0[:], 1)
		expect(&passed, &total, near(fc.variance_forecast, 1.4698517673262317e-05, 2e-3), "GJR: one-step variance forecast at the MLE")
		ts.garch_result_free(&r)
	}
	{
		th := []f64{-0.3281735042994512, 0.09952983868119233, 0.9627313151072843, -0.09067854475889099}
		p := ts.GARCH_Params{variance = .EGARCH, dist = .Normal, p = 1, q = 1, omega = th[0], alpha = []f64{th[1]}, beta = []f64{th[2]}}
		p.egarch_gamma = []f64{th[3]}
		
		nll := ts._garch_neg_log_likelihood(&p, GA_E1[:], context.allocator)
		expect(&passed, &total, near(nll, -3815.4312687201514, 1e-10), "EGARCH + normal: log-likelihood = numpy reference")
		r := ts.garch_fit_spec(GA_E1[:], {variance = .EGARCH, dist = .Normal, p = 1, q = 1})
		got := []f64{r.params.omega, r.params.alpha[0], r.params.beta[0], r.params.egarch_gamma[0]}
		want := []f64{-0.29833954936313745, 0.11058870964576926, 0.9627313151072843, -0.07556545396574249}
		ok := r.log_likelihood >= 3875.6629821569395 - 1e-4
		for v, i in got {if !(math.abs(v - want[i]) <= 2e-3 * max(math.abs(want[i]), 0.01)) do ok = false}
		expect(&passed, &total, ok, fmt.tprintf("EGARCH + normal: MLE = scipy optimum (llf %.4f vs 3875.6630)", r.log_likelihood))
		fc := ts.garch_forecast(&r, GA_E1[:], 1)
		expect(&passed, &total, near(fc.variance_forecast, 0.00031963241055817473, 2e-3), "EGARCH: one-step variance forecast at the MLE")
		ts.garch_result_free(&r)
	}
	{
		th := []f64{-0.28378340747342057, 0.06894074178703635, 0.9677084352816485, -0.09156753858314004, 5.729783089901274}
		p := ts.GARCH_Params{variance = .EGARCH, dist = .StudentT, p = 1, q = 1, omega = th[0], alpha = []f64{th[1]}, beta = []f64{th[2]}}
		p.egarch_gamma = []f64{th[3]}
		p.nu = th[4]
		nll := ts._garch_neg_log_likelihood(&p, GA_E2[:], context.allocator)
		expect(&passed, &total, near(nll, -3919.0108604922625, 1e-10), "EGARCH + Student-t: log-likelihood = numpy reference")
		r := ts.garch_fit_spec(GA_E2[:], {variance = .EGARCH, dist = .StudentT, p = 1, q = 1})
		got := []f64{r.params.omega, r.params.alpha[0], r.params.beta[0], r.params.egarch_gamma[0], r.params.nu}
		want := []f64{-0.2579849158849278, 0.07660082420781816, 0.9677084352816485, -0.0763062821526167, 6.03135062094871}
		ok := r.log_likelihood >= 3966.843866485698 - 1e-4
		for v, i in got {if !(math.abs(v - want[i]) <= 2e-3 * max(math.abs(want[i]), 0.01)) do ok = false}
		expect(&passed, &total, ok, fmt.tprintf("EGARCH + Student-t: MLE = scipy optimum (llf %.4f vs 3966.8439)", r.log_likelihood))
		fc := ts.garch_forecast(&r, GA_E2[:], 1)
		expect(&passed, &total, near(fc.variance_forecast, 0.0001786666455503761, 2e-3), "EGARCH: one-step variance forecast at the MLE")
		ts.garch_result_free(&r)
	}

	fmt.printf("GARCH spec summary: %d/%d passed\n", passed, total)
	record_failures(total - passed)
}
