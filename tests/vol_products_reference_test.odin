@(private = "file")
VP_RV :: 0.06365229202628045

// Black-Scholes price on the test smile (vol by strike from the table)
@(private = "file")
_VP_Smile :: struct {
	S, T, r: f64,
}

@(private = "file")
_vp_smile_price :: proc(K: f64, opt: fin.OptionType, data: rawptr) -> f64 {
	c := (^_VP_Smile)(data)
	vol := 0.0
	for k, i in VP_KS {
		if k == K {vol = VP_VOLS[i]}
	}
	return fin.fx_gk_price(c.S, K, c.T, c.r, 0.0, vol, .Call if opt == .Call else .Put)
}

@(private = "file")
_VP_Model :: struct {
	S, T, r: f64,
	heston:  fin.Heston_Params,
	sigma:   f64, // Black-Scholes when heston.kappa == 0
}

@(private = "file")
_vp_model_price :: proc(K: f64, opt: fin.OptionType, data: rawptr) -> f64 {
	c := (^_VP_Model)(data)
	if c.heston.kappa ==
	   0 {return fin.fx_gk_price(c.S, K, c.T, c.r, 0.0, c.sigma, .Call if opt == .Call else .Put)}
	return fin.heston_price(c.S, K, c.T, c.r, c.heston, opt)
}

vol_products_reference_test :: proc(allocator: mem.Allocator) {
	seed_test(#procedure)
	fmt.println(
		"\n=== Variance / volatility swaps and quanto options (QuantLib / scipy reference) ===",
	)
	context.allocator = allocator
	passed, total := 0, 0
	expect :: proc(passed, total: ^int, ok: bool, name: string) {
		total^ += 1
		if ok {passed^ += 1}
		fmt.printf("%s %s\n", "OK  " if ok else "FAIL", name)
	}

	// 1. Strip replication vs QuantLib
	{
		sm := _VP_Smile{100, 90.0 / 365.0, 0.05}
		v := fin.variance_swap_replication(
			sm.S,
			sm.T,
			sm.r,
			0,
			VP_CALLS[:],
			VP_PUTS[:],
			_vp_smile_price,
			&sm,
		)
		npv := 50000.0 * math.exp(-sm.r * sm.T) * (v - 0.04)
		ok := abs(v - VP_REPL[0]) < 1e-14 && abs(npv - VP_REPL[1]) < 1e-9
		expect(
			&passed,
			&total,
			ok,
			fmt.tprintf(
				"variance swap replicated by 8 calls + 11 puts on a skew (3M, r = 5%%) vs QuantLib ReplicatingVarianceSwapEngine: fair variance %.10f (%.10f), NPV of a 4%% strike on 50k %.6f (%.6f)",
				v,
				VP_REPL[0],
				npv,
				VP_REPL[1],
			),
		)
	}

	// 2. Continuous strip: flat Black-Scholes gives σ², Heston gives its expected variance
	{
		bs := _VP_Model{100, 1.0, 0.03, {}, 0.25}
		v_bs := fin.variance_swap_fair_variance(bs.S, bs.T, bs.r, 0, _vp_model_price, &bs)
		worst := 0.0
		for k in 0 ..< 3 {
			h := VP_HP[4 * k:]
			hm := _VP_Model {
				100,
				0,
				0.03,
				{v0 = h[0], kappa = h[1], theta = h[2], sigma = h[3], rho = -0.6},
				0,
			}
			for T in ([]f64{0.25, 1.0}) {
				hm.T = T
				v := fin.variance_swap_fair_variance(hm.S, T, hm.r, 0, _vp_model_price, &hm)
				worst = max(worst, abs(v - fin.heston_fair_variance(T, hm.heston)))
			}
		}
		expect(
			&passed,
			&total,
			abs(v_bs - 0.0625) < 1e-9 && worst < 1e-9,
			fmt.tprintf(
				"continuous replication: flat 25%% Black-Scholes %.12f (0.0625), Heston strips (COS prices, ρ = −0.6) vs θ + (v0 − θ)(1 − e^(−κT))/(κT): max diff %.1e",
				v_bs,
				worst,
			),
		)
	}

	// 3. Heston integrated variance: Laplace transform and fair volatility
	{
		worst_l, worst_v, worst_e := 0.0, 0.0, 0.0
		k := 0
		for i in 0 ..< 3 {
			h := VP_HP[4 * i:]
			p := fin.Heston_Params {
				v0    = h[0],
				kappa = h[1],
				theta = h[2],
				sigma = h[3],
			}
			for T, j in VP_TS {
				for s in VP_SS {
					worst_l = max(
						worst_l,
						abs(fin.heston_integrated_variance_laplace(s, T, p) - VP_LAP[k]) /
						VP_LAP[k],
					)
					k += 1
				}
				worst_v = max(worst_v, abs(fin.heston_fair_volatility(T, p) - VP_FV[3 * i + j]))
				worst_e = max(worst_e, abs(fin.heston_fair_variance(T, p) - VP_FVAR[3 * i + j]))
			}
		}
		p0 := fin.Heston_Params {
			v0    = VP_HP[0],
			kappa = VP_HP[1],
			theta = VP_HP[2],
			sigma = VP_HP[3],
		}
		kv, kvol := fin.heston_fair_variance(1, p0), fin.heston_fair_volatility(1, p0)
		flat := fin.heston_fair_volatility(1, {v0 = 0.04, kappa = 2, theta = 0.04, sigma = 1e-9})
		ok := worst_l < 1e-10 && worst_v < 1e-10 && worst_e < 1e-15 && abs(flat - 0.2) < 1e-9
		expect(
			&passed,
			&total,
			ok,
			fmt.tprintf(
				"Heston integrated variance (3 parameter sets incl. σ = 1, 3M-5Y): Laplace transform vs Riccati ODEs %.1e rel, fair volatility vs scipy.quad %.1e, fair variance exact; 1Y fair vol %.6f vs √fair var %.6f (convexity %.2f vol pts); σ → 0 gives %.10f",
				worst_l,
				worst_v,
				kvol,
				math.sqrt(kv),
				100 * (math.sqrt(kv) - kvol),
				flat,
			),
		)
	}

	// 4. Realized variance and a seasoned swap
	{
		rv := fin.realized_variance(VP_PATH[:])
		// 60 of 252 days elapsed, remaining fair variance 0.045, strike 0.05, DF 0.97
		val := fin.variance_swap_value(10000, 0.05, rv, 60.0 / 252.0, 1.0, 0.045, 0.97)
		want := 10000 * 0.97 * (60.0 / 252.0 * VP_RV + 192.0 / 252.0 * 0.045 - 0.05)
		ok :=
			abs(rv - VP_RV) < 1e-15 &&
			abs(val - want) < 1e-9 &&
			fin.variance_notional_from_vega(100000, 0.2) == 250000
		expect(
			&passed,
			&total,
			ok,
			fmt.tprintf(
				"realized variance of 60 daily returns %.10f (numpy %.10f); seasoned swap value %.4f; vega notional 100k at 20%% = variance notional 250k",
				rv,
				VP_RV,
				val,
			),
		)
	}

	// 5. Quanto options vs QuantLib
	{
		worst := 0.0
		for c := 0; c < len(VP_QC); c += 13 {
			q := VP_QC[c:c + 13]
			r := fin.quanto_option(
				100,
				q[0],
				1,
				0.03,
				0.045,
				0.01,
				0.25,
				0.12,
				q[2],
				.Put if q[1] != 0 else .Call,
			)
			got := [10]f64 {
				r.price,
				r.delta,
				r.gamma,
				r.vega,
				r.theta,
				r.rho,
				r.dividend_rho,
				r.qvega,
				r.qrho,
				r.qlambda,
			}
			for j in 0 ..< 10 {worst = max(worst, abs(got[j] - q[3 + j]) / max(abs(q[3 + j]), 1.0))}
		}
		fwd := fin.quanto_forward(100, 1, 0.045, 0.01, 0.25, 0.12, -0.4)
		expect(
			&passed,
			&total,
			worst < 1e-12,
			fmt.tprintf(
				"12 quanto calls / puts (K 80-120, correlation −0.4 / +0.6) vs QuantLib QuantoEuropeanEngine: price, delta, gamma, vega, theta, rho, dividend rho, qvega, qrho, qlambda max rel diff %.1e; quanto forward %.6f (unadjusted %.6f)",
				worst,
				fwd,
				100 * math.exp_f64(0.035),
			),
		)
	}

	fmt.printf("Vol products summary: %d/%d passed\n", passed, total)
	record_failures(total - passed)
}
