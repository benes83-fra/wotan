arimax_reference_test :: proc(allocator: mem.Allocator) {
	seed_test(#procedure)
	fmt.println("\n=== ARIMAX vs statsmodels SARIMAX(exog) ===")
	context.allocator = allocator
	passed, total := 0, 0
	expect :: proc(passed, total: ^int, ok: bool, name: string) {
		total^ += 1
		if ok {passed^ += 1}
		fmt.printf("%s %s\n", "OK  " if ok else "FAIL", name)
	}
	close :: proc(got, want: []f64, tol: f64) -> bool {
		if len(got) != len(want) do return false
		for g, i in got {if !(math.abs(g - want[i]) <= tol * max(1, math.abs(want[i]))) do return false}
		return true
	}

	Xall := l.Matrix(f64){data = AX_X[:], rows = 165, cols = 3}
	X := l.Matrix(f64){data = AX_X[:160 * 3], rows = 160, cols = 3}
	Xf := l.Matrix(f64){data = AX_X[160 * 3:], rows = 5, cols = 3}
	_ = Xall
	ll := ts.arimax_loglik(AX_Y0[:], &X, {0.5}, {0.2}, {1.9, 0.75, -1.4}, 0, 1.1)
	expect(&passed, &total, math.abs(ll - -239.84946351798163) <= 1e-9 * math.abs(-239.84946351798163), "ARIMAX(1,0,1) log-likelihood at fixed parameters = statsmodels loglike")

	r0 := ts.arimax_fit(AX_Y0[:], &X, 1, 0, 1)
	got0 := []f64{r0.beta[0], r0.beta[1], r0.beta[2], r0.phi[0], r0.theta[0], r0.sigma2}
	expect(&passed, &total, close(got0, {1.8724180899689409, 0.7494474343129982, -1.2803317894265662, 0.5214476550487347, 0.3570056671665953, 1.1219919463059016}, 1e-4) && math.abs(r0.loglik - -236.63616987698416) <= 1e-6 && math.abs(r0.aic - 485.2723397539683) <= 1e-5 && math.abs(r0.bic - 503.72338264537126) <= 1e-5, fmt.tprintf("ARIMAX(1,0,1) MLE = statsmodels (llf %.6f vs -236.636170)", r0.loglik))
	fc0 := ts.arimax_forecast(AX_Y0[:], &X, r0, 0, &Xf, 0.1)
	expect(&passed, &total, close(fc0.mean, {3.1034727715876436, 3.759907161920635, 3.995504743388287, 3.867859271366552, 2.9558602974341595}, 1e-4) && close(fc0.lower, {1.3611760213537163, 1.4408321457482152, 1.5429437149006846, 1.3802406763023471, 0.45879439012586687}, 1e-4) && close(fc0.upper, {4.845769521821571, 6.078982178093055, 6.448065771875889, 6.355477866430757, 5.452926204742452}, 1e-4), "ARIMAX(1,0,1) forecast + 90 % interval with future X = statsmodels")

	X1 := l.Matrix(f64){data = AX_X1[:160 * 2], rows = 160, cols = 2}
	X1f := l.Matrix(f64){data = AX_X1[160 * 2:], rows = 5, cols = 2}
	r1 := ts.arimax_fit(AX_Y1[:], &X1, 1, 1, 1)
	got1 := []f64{r1.beta[0], r1.beta[1], r1.phi[0], r1.theta[0], r1.sigma2}
	expect(&passed, &total, close(got1, {0.46610379840324867, -0.8122922907674331, 0.5559564827276703, 0.3428530345325631, 0.5607076524099328}, 1e-4) && math.abs(r1.loglik - -180.03791784353012) <= 1e-6, fmt.tprintf("ARIMAX(1,1,1) MLE = statsmodels on the differenced data (llf %.6f vs -180.037918)", r1.loglik))
	// levels forecast at statsmodels' parameters (isolates the forecast from the fit)
	ref1 := ts.ArimaxFitResult{beta = {0.46610379840324867, -0.8122922907674331}, phi = {0.5559564827276703}, theta = {0.3428530345325631}, sigma2 = 0.5607076524099328}
	fc1 := ts.arimax_forecast(AX_Y1[:], &X1, ref1, 1, &X1f, 0.05)
	expect(&passed, &total, close(fc1.mean, {-42.84140378800995, -42.98760691481082, -42.9124099476775, -43.024177517410905, -43.57162026950012}, 1e-5) && close(fc1.lower, {-44.30903295001949, -46.137194348488215, -47.63587826522519, -49.167394455476725, -50.98776195836395}, 1e-5) && close(fc1.upper, {-41.373774626000404, -39.83801948113342, -38.18894163012982, -36.880960579345086, -36.1554785806363}, 1e-5), "ARIMAX(1,1,1) levels forecast + 95 % interval = statsmodels SARIMAX(1,1,1) filter")
	ts.arimax_free(&r0)
	ts.arimax_free(&r1)

	fmt.printf("ARIMAX summary: %d/%d passed\n", passed, total)
	record_failures(total - passed)
}
