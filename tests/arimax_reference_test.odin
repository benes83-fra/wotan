@(private = "file")
AX_Y1 := [?]f64{0.33530185551131125, 0.21347648753984977, -0.7173743216883923, 0.3886082651023959, 0.675821846502356, -0.1713324016730411, -1.8980038475964538, -1.2837222596643154, -1.266350882416605, 0.08731927827617736, 0.7271052940040406, 0.7058118786564871, 0.1663960236384714, -1.5660950457625606, -3.4721472505063327, -4.487626206844048, -4.586342746258121, -3.870077106870527, -2.1732295338625507, -1.2794599290358335, -1.0707745626788971, -0.8897117601785747, -0.5304153527525648, 0.27498112189921664, 0.24725519295935233, 0.7260187785869074, -0.6708539001253959, -1.275246227048503, -2.110514878447926, -0.8554572559885191, -1.17292006655332, -1.5163715496931307, -1.2085564292101412, -0.8198466439072855, 0.3902159501093255, 1.1883819443421897, 1.7591830468949194, 0.32940185055203963, -2.148379579644466, -3.9393965348085267, -5.271980553798386, -6.609230107947824, -6.400722512959917, -4.690970322396714, -5.048641478332016, -4.6528379599307135, -6.62560533332017, -8.737437345863, -10.398016223446266, -13.429582995210573, -15.957646985595511, -19.38038374898865, -22.495680296112717, -23.039714148690734, -23.562367614700307, -24.229167023887793, -23.874451837653957, -25.573171701578506, -27.806552667412355, -29.275662966151767, -30.252180237440186, -30.677814092884685, -31.34862407630071, -30.86127759851384, -31.582412399915484, -30.008652980224532, -29.967962911716885, -30.88362516543286, -31.993102090437596, -33.50309956378564, -32.8293947398489, -32.64181319436781, -32.33512117777388, -32.18066183007167, -32.69432917083366, -34.62880438922604, -35.58821172219093, -37.11272174994444, -38.82692354455353, -39.53168638758038, -40.411374298029344, -41.16098874630518, -41.94608294124028, -41.147423638112436, -41.55141815943933, -44.098784680654376, -46.41969647599629, -47.83684700908432, -47.7978124041777, -48.051759079307836, -49.29310362263148, -49.91687966262954, -48.591500843786015, -48.28280884778322, -48.01614777397793, -47.865676634216584, -47.76861675858879, -48.6