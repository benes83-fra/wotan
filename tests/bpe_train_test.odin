// Training a byte-level BPE vocabulary (nn/tokenizers/bpe_train.odin) on a
// small corpus (the Zen of Python; finance sentences in documents separated by
// <|endoftext|>; the tokenizer reference test's texts), as Hugging Face's
// BpeTrainer: to 600 tokens, until min_frequency 4 (with a second special
// token, <pad>) and to fewer tokens than the alphabet (no merges): the saved
// vocab.json and merges.txt are HF's byte for byte, the texts encode to HF's
// ids and decode back, and the saved files load (bpe_tokenizer_new) into a
// tokenizer that encodes the same. (On 1 MB of Python's standard library, to
// 8000 tokens, vocab.json and merges.txt were HF's too.)
bpe_train_test :: proc(allocator: mem.Allocator) {
	fmt.println("\n=== BPE training ===")
	context.allocator = allocator
	passed, total := 0, 0
	expect :: proc(passed, total: ^int, ok: bool, name: string) {
		total^ += 1
		if ok {passed^ += 1}
		fmt.printf("%s %s\n", "OK  " if ok else "FAIL", name)
	}
	// texts whose ids are want's, texts that decode back
	check_ids :: proc(tk: ^tok.BPETokenizer, want: []string) -> (same, round_trip: int) {
		for text, i in BT_TEXTS {
			ids := tok.bpe_encode(tk, text)
			defer delete(ids)
			s := want[i]
			ok, n := true, 0
			for f in strings.fields_iterator(&s) {
				v, _ := strconv.parse_int(f)
				ok &&= n < len(ids) && ids[n] == v
				n += 1
			}
			if ok && n == len(ids) {same += 1}
			dec := tok.bpe_decode(tk, ids)
			defer delete(dec)
			if dec == text {round_trip += 1}
		}
		return
	}

	dir, _ := os.temp_directory(allocator)
	defer delete(dir)
	vocab_path := fmt.tprintf("%s/wotan_bpe_train_vocab.json", dir)
	merges_path := fmt.tprintf("%s/wotan_bpe_train_merges.txt", dir)
	defer os.remove(vocab_path)
	defer os.remove(merges_path)
	for c in BT_CONFIGS {
		tk := tok.bpe_train(BT_TRAIN[:], c.vocab_size, c.specials, c.min_frequency)
		defer tok.bpe_tokenizer_free(&tk)
		saved := tok.bpe_save(&tk, vocab_path, merges_path)
		vocab_data, _ := os.read_entire_file(vocab_path, allocator)
		defer delete(vocab_data)
		merges_data, _ := os.read_entire_file(merges_path, allocator)
		defer delete(merges_data)
		HEADER :: "#version: 0.2\n"
		vocab_ok := string(vocab_data) == c.vocab_json
		merges_ok := strings.has_prefix(string(merges_data), HEADER) && string(merges_data[len(HEADER):]) == c.merges
		same, round_trip := check_ids(&tk, c.ids)
		n := len(BT_TEXTS)
		ok := saved && vocab_ok && merges_ok && same == n && round_trip == n
		reloaded := ""
		if c.name == "a" {
			tk2, loaded := tok.bpe_tokenizer_new(vocab_path, merges_path, 1024)
			same2 := 0
			if loaded {
				same2, _ = check_ids(&tk2, c.ids)
				tok.bpe_tokenizer_free(&tk2)
			}
			ok &&= same2 == n
			reloaded = fmt.tprintf("; reloaded from the saved files: %d/%d", same2, n)
		}
		expect(
			&passed,
			&total,
			ok,
			fmt.tprintf(
				"vocab_size %d, min_frequency %d, specials %v: %d tokens, %d merges; vocab.json %v, merges.txt %v vs HF; ids of %d/%d texts as HF, %d/%d decode back%s",
				c.vocab_size,
				c.min_frequency,
				c.specials,
				len(tk.vocab),
				len(tk.merges),
				vocab_ok,
				merges_ok,
				same,
				n,
				round_trip,
				n,
				reloaded,
			),
		)
	}

	fmt.printf("BPE training: %d/%d passed\n", passed, total)
	record_failures(total - passed)
}
