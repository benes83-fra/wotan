step5_reference_test :: proc(allocator: mem.Allocator) {
	seed_test(#procedure)
	fmt.println("\n=== HP / decomposition / STL / Holt-Winters / Phillips-Perron / bootstrap ===")
	context.allocator = allocator
	passed, total := 0, 0
	expect :: proc(passed, total: ^int, ok: bool, name: string) {
		total^ += 1
		if ok {passed^ += 1}
		fmt.printf("%s %s\n", "OK  " if ok else "FAIL", name)
	}
	close :: proc(got, want: []f64, tol: f64) -> bool {
		if len(got) != len(want) do return false
		for g, i in got {
			if math.is_nan(want[i]) {if !math.is_nan(g) do return false; continue}
			if !(math.abs(g - want[i]) <= tol * max(1, math.abs(want[i]))) do return false
		}
		return true
	}
	near :: proc(got, want, tol: f64) -> bool {return(
			math.abs(got - want) <=
			tol * max(1, math.abs(want)) \
		)}
	NaN :: math.QNAN_F64

	// --- HP filter ---
	{
		_, t1 := ts.hp_filter(Y[:], 1600)
		c2, _ := ts.hp_filter(X7[:], 129600)
