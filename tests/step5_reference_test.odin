					71.54203224156805,
					71.37751976288352,
					71.21300728419898,
					71.04849480551445,
					70.88398232682991,
				},
				1e-10,
			)
		ok =
			ok &&
			near(r.aic, 325.3803619945441, 1e-9) &&
			near(r.bic, 335.6377547604154, 1e-9) &&
			near(r.aicc, 326.3241822192632, 1e-9)
		expect(
			&passed,
			&total,
			ok,
			"Holt-Winters Holt (additive trend): fitted, SSE, AIC/BIC/AICc, 15-step forecast = statsmodels",
		)
		ts.holt_winters_free(&r)
	}
	{
		r := ts.holt_winters_filter(
			Y[:],
			ts.HoltWintersSpec{},
			ts.HoltWintersParams{alpha = 0.35, level0 = 50.0},
		)
		fc := ts.holt_winters_forecast(&r, 15)
		ok :=
			close(
				r.fitted,
				{
					50.0,
					51.178220491002676,
					52.80188693719314,
					53.01747693191302,
					52.84930661610265,
					52.51998758757533,
					54.24809399746672,
					54.450006181155786,
					53.21051297384835,
					50.17179277488866,
					48.55057676905275,
					48.25940185521793,
					49.43465366811061,
					51.6506965688732,
					53.82568979313683,
					54.831073303713325,
					55.77914382576495,
					56.406608781851745,
					57.831705531488204,
					57.841887593771496,
					56.38139947738332,
					54.71131413955788,
					51.73635144137279,
					50.27181924777362,
					52.258945487066754,
					53.94743359810347,
					56.904630622575766,
					59.02706632711521,
					59.7894035037708,
					60.60163503940385,
					60.43449286568149,
					61.27395479761134,
					60.266124216251846,
					57.074028569469775,
					55.91753321245962,
					54.43013473476281,
					55.14796013769433,
					57.22536876029821,
					60.17012442053739,
					62.071616627623854,
					63.2230621111962,
					69.16152973166172,
					67.90833993901128,
					67.54287236591156,
					64.92163470989759,
					61.340243105346715,
					59.6818487439093,
					58.87277337736871,
					60.42472989036993,
					63.19464079867882,
					64.99632303691659,
					66.01151046429231,
					67.14878718539947,
					67.57636062592118,
					68.74104526985722,
					68.85471316011994,
					66.87857100826126,
					65.01477296111223,
					61.91768740107673,
					61.61514927113069,
					63.255013982759735,
					66.63072997787313,
					68.20217124327822,
					69.34988638775728,
					70.18976521601866,
					71.23194544668807,
					72.65670454080957,
					72.87018470586423,
					71.38867186447197,
					69.23886070363244,
					67.70069281728452,
					65.80014633644456,
					67.19707816069811,
					70.18691174984629,
					72.40650753175619,
					74.38106807129061,
					74.59725372866771,
					74.72951633993861,
					76.19120375414832,
					74.80851011871012,
					73.64575820863588,
					72.66828128239712,
					70.10316071782204,
					69.52122734207099,
					70.37920458145867,
					73.10430987635337,
					75.44314702759638,
					77.83732554376098,
					77.74896837356896,
					77.12055687647782,
					78.76185380988449,
					80.00896327643453,
					78.17427671329055,
					74.6722735838546,
					72.08874635956865,
					72.11165584696114,
				},
				1e-10,
			) &&
			near(r.sse, 2591.5526326014146, 1e-10) &&
			close(
				fc,
				{
					73.52739052011538,
					73.52739052011538,
					73.52739052011538,
					73.52739052011538,
					73.52739052011538,
					73.52739052011538,
					73.52739052011538,
					73.52739052011538,
					73.52739052011538,
					73.52739052011538,
					73.52739052011538,
					73.52739052011538,
					73.52739052011538,
					73.52739052011538,
					73.52739052011538,
				},
				1e-10,
			)
		ok =
			ok &&
			near(r.aic, 320.38376854345944, 1e-9) &&
			near(r.bic, 325.5124649263951, 1e-9) &&
			near(r.aicc, 320.8233289830199, 1e-9)
		expect(
			&passed,
			&total,
			ok,
			"Holt-Winters simple exponential smoothing: fitted, SSE, AIC/BIC/AICc, 15-step forecast = statsmodels",
		)
		ts.holt_winters_free(&r)
	}
	{
		r := ts.holt_winters_fit(
			Y[:],
			ts.HoltWintersSpec{trend = .Additive, seasonal = .Additive, period = 12},
		)
		expect(
			&passed,
			&total,
			r.sse <= 426.3725493440601 * (1 + 1e-6),
			fmt.tprintf(
				"Holt-Winters fit (additive trend + additive season): SSE %.4f <= statsmodels 426.3725",
				r.sse,
			),
		)
		ts.holt_winters_free(&r)
	}
	{
		r := ts.holt_winters_fit(
			Y[:],
			ts.HoltWintersSpec {
				trend = .Additive,
				damped = true,
				seasonal = .Additive,
				period = 12,
			},
		)
		expect(
			&passed,
			&total,
			r.sse <= 427.97948140300406 * (1 + 1e-6),
			fmt.tprintf(
				"Holt-Winters fit (damped trend + additive season): SSE %.4f <= statsmodels 427.9795",
				r.sse,
			),
		)
		ts.holt_winters_free(&r)
	}
	{
		r := ts.holt_winters_fit(
			Y[:],
			ts.HoltWintersSpec{trend = .Additive, seasonal = .Multiplicative, period = 12},
		)
		expect(
			&passed,
			&total,
			r.sse <= 450.3611116469778 * (1 + 1e-6),
			fmt.tprintf(
				"Holt-Winters fit (additive trend + multiplicative season): SSE %.4f <= statsmodels 450.3611",
				r.sse,
			),
		)
		ts.holt_winters_free(&r)
	}

	// --- Phillips-Perron ---
	{
		p0 := ts.phillips_perron_test(RW[:], 0, .Constant)
		p0ct := ts.phillips_perron_test(RW[:], 0, .ConstantTrend)
		expect(
			&passed,
			&total,
			near(p0.statistic, -1.631582438721779, 1e-10) &&
			near(p0ct.statistic, -1.1963365485612278, 1e-10),
			"Phillips-Perron Z_τ with 0 lags = Dickey-Fuller t (statsmodels adfuller)",
		)
		a := ts.phillips_perron_test(RW[:])
		b := ts.phillips_perron_test(AR[:])
		c := ts.phillips_perron_test(RW[:], 5, .ConstantTrend)
		rr := ts.phillips_perron_test(RW[:], test_type = .Rho)
		ok :=
			a.lags == 16 &&
			near(a.statistic, -1.5797224832864303, 1e-10) &&
			near(b.statistic, -10.114466279871515, 1e-10) &&
			near(c.statistic, -1.0160068479327093, 1e-10) &&
			near(rr.statistic, -2.7349866533907887, 1e-10)
		expect(
			&passed,
			&total,
			ok,
			"Phillips-Perron Z_τ / Z_ρ (Newey-West lags) = arch's formulas",
		)
		expect(
			&passed,
			&total,
			a.p_value > 0.1 && b.p_value < 0.01,
			fmt.tprintf(
				"Phillips-Perron: random walk not rejected (p = %.3f), AR(0.5) rejected (p = %.2e)",
				a.p_value,
				b.p_value,
			),
		)
	}

	// --- bootstrap ---
	{
		th := 2.1762253089130477
		lo, hi := ts.bootstrap_interval(th, BOOT[:], JACK[:], 0.95, .BCa)
		expect(
			&passed,
			&total,
			near(lo, 1.6935653154189219, 1e-12) && near(hi, 2.913448101004998, 1e-12),
			"bootstrap BCa interval = scipy (same bootstrap distribution)",
		)
		lo, hi = ts.bootstrap_interval(th, BOOT[:], nil, 0.95, .Percentile)
		lo2, hi2 := ts.bootstrap_interval(th, BOOT[:], nil, 0.95, .Basic)
		expect(
			&passed,
			&total,
			near(lo, 1.6273541250629573, 1e-12) &&
			near(hi, 2.8198142569080917, 1e-12) &&
			near(lo2, 1.5326363609180036, 1e-12) &&
			near(hi2, 2.725096492763138, 1e-12),
			"bootstrap percentile and basic intervals = scipy",
		)
		mean :: proc(x: []f64, _: rawptr) -> f64 {
			s := 0.0
			for v in x {s += v}
			return s / f64(len(x))
		}
		r1 := ts.bootstrap_ci(DATA[:], mean, n_resamples = 4000, seed = 7)
		r2 := ts.bootstrap_ci(DATA[:], mean, n_resamples = 4000, seed = 7)
		ok :=
			r1.low == r2.low &&
			r1.high == r2.high &&
			r1.low < th &&
			th < r1.high &&
			near(r1.standard_error, 0.312094917250459, 0.08)
		expect(
			&passed,
			&total,
			ok,
			fmt.tprintf(
				"bootstrap_ci (BCa, seeded): reproducible, contains the mean, SE %.4f ≈ s/√n",
				r1.standard_error,
			),
		)
		// dependent data: block bootstrap SE of the mean is larger than the iid one for an AR(0.5) series
		iid := ts.bootstrap_ci(AR[:], mean, n_resamples = 2000, method = .Percentile, seed = 3)
		blk := ts.bootstrap_ci(
			AR[:],
			mean,
			n_resamples = 2000,
			method = .Percentile,
			resample = .MovingBlock,
			block_size = 10,
			seed = 3,
		)
		sta := ts.bootstrap_ci(
			AR[:],
			mean,
			n_resamples = 2000,
			method = .Percentile,
			resample = .Stationary,
			block_size = 10,
			seed = 3,
		)
		expect(
			&passed,
			&total,
			blk.standard_error > 1.3 * iid.standard_error &&
			sta.standard_error > 1.3 * iid.standard_error,
			fmt.tprintf(
				"block bootstraps capture autocorrelation (SE iid %.3f, moving block %.3f, stationary %.3f)",
				iid.standard_error,
				blk.standard_error,
				sta.standard_error,
			),
		)
	}

	fmt.printf("Step-5 summary: %d/%d passed\n", passed, total)
	record_failures(total - passed)
}
