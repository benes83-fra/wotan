					69.14425568378505,
				},
				1e-10,
			) &&
			near(r.sse, 2618.5961404937398, 1e-10) &&
			close(
				fc,
				{
					73.18715702841341,
					73.02264454972888,
					72.85813207104434,
					72.69361959235981,
					72.52910711367527,
					72.36459463499074,
					72.2000821563062,
					72.03556967762167,
