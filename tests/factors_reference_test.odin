// Rows of a flat row-major table as [][]f64 (views, no copy)
@(private = "file")
_fa_rows :: proc(flat: []f64, rows, cols: int) -> [][]f64 {
	out := make([][]f64, rows)
	for r in 0 ..< rows {out[r] = flat[r * cols:(r + 1) * cols]}
	return out
}

// Varimax criterion Σ_f [Σ_v λ⁴ - (Σ_v λ²)² / p], optionally on row-normalised loadings
@(private = "file")
_fa_crit :: proc(L: [][]f64, normalize: bool) -> f64 {
	k, p := len(L), len(L[0])
	c := 0.0
	for f in 0 ..< k {
		s2, s4 := 0.0, 0.0
		for v in 0 ..< p {
			x := L[f][v]
			if normalize {
				h := 0.0
				for g in 0 ..< k {h += L[g][v] * L[g][v]}
				x /= math.sqrt(h)
			}
			s2 += x * x
			s4 += x * x * x * x
		}
		c += s4 - s2 * s2 / f64(p)
	}
	return c
}

// Max |difference| after matching each factor to a reference factor up to sign
// and order (varimax solutions are unique only up to both)
@(private = "file")
_fa_match :: proc(L: [][]f64, ref: [][]f64) -> f64 {
	worst := 0.0
	for f in 0 ..< len(L) {
		best := math.F64_MAX
		for g in 0 ..< len(ref) {
			for sgn in ([]f64{1, -1}) {
				d := 0.0
				for v in 0 ..< len(L[f]) {d = max(d, abs(L[f][v] - sgn * ref[g][v]))}
				best = min(best, d)
			}
		}
		worst = max(worst, best)
	}
	return worst
}

factors_reference_test :: proc(allocator: mem.Allocator) {
	seed_test(#procedure)
	fmt.println(
		"\n=== Factors: principal axis, varimax, factor scores, market factor, factor model (numpy reference) ===",
	)
	context.allocator = allocator
	passed, total := 0, 0
	expect :: proc(passed, total: ^int, ok: bool, name: string) {
		total^ += 1
		if ok {passed^ += 1}
		fmt.printf("%s %s\n", "OK  " if ok else "FAIL", name)
	}
	sc := FA_SCAL
	data := _fa_rows(FA_X[:], FA_N, FA_P)
	lam := _fa_rows(FA_LAM[:], FA_K, FA_P)
	rot_raw := _fa_rows(FA_ROT_RAW[:], FA_K, FA_P)
	rot_nrm := _fa_rows(FA_ROT_NRM[:], FA_K, FA_P)

	// 1. Principal axis factoring
	fa := fin.factor_analysis(data, FA_K)
	{
		worst := 0.0
		for v in 0 ..< FA_P {worst = max(worst, abs(fa.communalities[v] - FA_H[v]))}
		wl := 0.0
		for f in 0 ..< FA_K {
			for v in 0 ..< FA_P {wl = max(wl, abs(fa.loadings[f][v] - lam[f][v]))}
		}
		expect(
			&passed,
			&total,
			fa.converged && worst < 1e-8 && wl < 1e-8,
			fmt.tprintf(
				"factor_analysis (principal axis, %d vars, %d factors) vs numpy fixed point: communalities %.1e, loadings %.1e, converged in %d iterations from the SMCs",
				FA_P,
				FA_K,
				worst,
				wl,
				fa.n_iterations,
			),
		)
	}

	// 2. Varimax, raw and Kaiser-normalised, vs R's SVD algorithm
	{
		raw := fin.varimax_rotation(lam, 1000, 1e-14, normalize = false)
		nrm := fin.varimax_rotation(lam, 1000, 1e-14)
		c_raw, c_nrm := _fa_crit(raw, false), _fa_crit(nrm, true)
		d_raw, d_nrm := _fa_match(raw, rot_raw), _fa_match(nrm, rot_nrm)
		expect(
			&passed,
			&total,
			abs(c_raw - sc[2]) < 1e-10 &&
			abs(c_nrm - sc[4]) < 1e-10 &&
			d_raw < 1e-7 &&
			d_nrm < 1e-7,
			fmt.tprintf(
				"varimax_rotation vs R's varimax: criterion raw %.6f (R %.6f, unrotated %.6f), normalised %.6f (R %.6f); loadings match up to sign/order to %.1e / %.1e (the old rotation turned the wrong way and stayed near the unrotated criterion)",
				c_raw,
				sc[2],
				sc[1],
				c_nrm,
				sc[4],
				d_raw,
				d_nrm,
			),
		)
	}

	// 3. Regression factor scores with the rotated loadings
	{
		rot := fin.FactorAnalysisResult {
			loadings  = rot_nrm,
			n_factors = FA_K,
		}
		s := fin.compute_factor_scores(data, &rot)
		worst := 0.0
		for o in 0 ..< FA_N {
			for f in 0 ..< FA_K {worst = max(worst, abs(s[o][f] - FA_SCORES[o * FA_K + f]))}
		}
		expect(
			&passed,
			&total,
			worst < 1e-10,
			fmt.tprintf(
				"compute_factor_scores (regression, Z R⁻¹ Λ, varimax loadings) vs numpy: max err %.1e (the old per-factor projection ignored the other factors)",
				worst,
			),
		)
	}

	// 4. Market factor
	{
		mkt, ve := fin.extract_market_factor(data)
		worst := 0.0
		for o in 0 ..< FA_N {worst = max(worst, abs(mkt[o] - FA_MKT[o]))}
		expect(
			&passed,
			&total,
			worst < 1e-10 && abs(ve - sc[0]) < 1e-13,
			fmt.tprintf(
				"extract_market_factor vs numpy PC1 (signed to load positively on the average asset): max err %.1e, variance explained %.6f vs %.6f",
				worst,
				ve,
				sc[0],
			),
		)
	}

	// 5. Time-series factor model covariance vs OLS
	{
		ass := _fa_rows(FA_ASS[:], FM_T, 4)
		fac := _fa_rows(FA_FAC[:], FM_T, 2)
		fm := fin.factor_model_covariance(ass, fac)
		wb, wi, wr := 0.0, 0.0, 0.0
		for a in 0 ..< 4 {
			for f in 0 ..< 2 {wb = max(wb, abs(fm.betas[a][f] - FA_B_OLS[a * 2 + f]) / abs(FA_B_OLS[a * 2 + f]))}
			wi = max(wi, abs(fm.idiosyncratic_var[a] - FA_IDIO[a]) / FA_IDIO[a])
			for b in 0 ..< 4 {wr = max(wr, abs(fm.reconstructed_cov[a][b] - FA_RECON[a * 4 + b]) / abs(FA_RECON[a * 4 + b]))}
		}
		expect(
			&passed,
			&total,
			wb < 1e-10 && wi < 1e-10 && wr < 1e-10,
			fmt.tprintf(
				"factor_model_covariance vs numpy OLS with intercept: betas %.1e, residual variance %.1e, B Σ_f Bᵀ + D %.1e (max rel err)",
				wb,
				wi,
				wr,
			),
		)
	}

	fmt.printf("Factors summary: %d/%d passed\n", passed, total)
	record_failures(total - passed)
}
