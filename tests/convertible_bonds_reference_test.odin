@(private = "file")
_cb_date :: proc(serial: f64) -> w.Date {
	return w.civil_from_days(i64(serial) - 25569)
}

convertible_bonds_reference_test :: proc(allocator: mem.Allocator) {
	seed_test(#procedure)
	fmt.println(
		"\n=== Convertible bonds: Tsiveriotis-Fernandes CRR lattice (QuantLib reference) ===",
	)
	context.allocator = allocator
	passed, total := 0, 0
	expect :: proc(passed, total: ^int, ok: bool, name: string) {
		total^ += 1
		if ok {passed^ += 1}
		fmt.printf("%s %s\n", "OK  " if ok else "FAIL", name)
	}

	eval := _cb_date(CB_EVAL)
	sch := fin.make_schedule(
		{2023, 3, 15},
		{2030, 3, 15},
		{6, .Months},
		{.TARGET},
		.Following,
		.Following,
	)
	defer fin.free_schedule(&sch)
	bond := fin.DatedBond{100, 0.025, sch, .ACT_ACT_ICMA, .Following, 0}
	names := [5]string {
		"plain 2.5% 2030, ratio 3.5, S = 25",
		"soft call 102 (trigger 130%) + put 100 + 3 cash dividends",
		"hard calls 101 clean / 100.5 dirty, S = 35",
		"distressed S = 10, 5% spread, put 98",
		"conversion only from 2027, soft call 103",
	}
	off := 0
	for k in 0 ..< 5 {
		n_in := int(CB_IN[off])
		row := CB_IN[off + 1:off + 1 + n_in]
		off += 1 + n_in
		n_calls, n_divs := int(row[6]), int(row[7])
		calls := make([]fin.ConvertibleCallability, n_calls)
		for c in 0 ..< n_calls {
			x := row[8 + 5 * c:]
			calls[c] = {_cb_date(x[0]), .Put if x[1] != 0 else .Call, x[2], x[3] != 0, x[4]}
		}
		divs := make([]fin.CashDividend, n_divs)
		for d in 0 ..< n_divs {
			x := row[8 + 5 * n_calls + 2 * d:]
			divs[d] = {_cb_date(x[0]), x[1]}
		}
		cb := fin.ConvertibleBond{bond, 3.5, _cb_date(row[5]), {2030, 3, 15}, calls}
		mkt := fin.ConvertibleMarket{row[0], row[1], row[2], row[3], row[4], divs}
		worst := 0.0
		got: [2]f64
		for n, i in ([]int{801, 2000}) {
			got[i] = fin.price_convertible_bond(cb, eval, mkt, n)
			worst = max(worst, abs(got[i] - CB_OUT[2 * k + i]))
		}
		bond_floor := 0.0
		{
			straight := cb
			straight.conversion_ratio = 1e-12
			bond_floor = fin.price_convertible_bond(straight, eval, mkt, 801)
		}
		expect(
			&passed,
			&total,
			worst < 1e-9,
			fmt.tprintf(
				"%s: %.6f / %.6f with 801 / 2000 steps (QuantLib %.6f / %.6f), max diff %.1e; parity %.2f, bond floor %.4f",
				names[k],
				got[0],
				got[1],
				CB_OUT[2 * k],
				CB_OUT[2 * k + 1],
				worst,
				3.5 * row[0],
				bond_floor,
			),
		)
	}

	fmt.printf("Convertible bonds summary: %d/%d passed\n", passed, total)
	record_failures(total - passed)
}
