// tensor_overlap_add against torch: the inverse STFT built from a matmul with an
// inverse real-DFT basis and a windowed overlap-add matches torch.istft (centred
// Hann; not centred Hamming with zero padding past the end) and Vocos' ISTFT
// with "same" padding (start = (n_fft - hop) / 2), output and the gradient of
// the spectrum; without a window it matches torch.nn.functional.fold;
// the STFT of W2 (a strided conv1d) followed by this iSTFT returns the signal.
overlap_add_reference_test :: proc(allocator: mem.Allocator) {
	seed_test(#procedure)
	fmt.println("\n=== overlap-add / iSTFT vs torch ===")
	context.allocator = allocator
	passed, total := 0, 0
	expect :: proc(passed, total: ^int, ok: bool, name: string) {
		total^ += 1
		if ok {passed^ += 1}
		fmt.printf("%s %s\n", "OK  " if ok else "FAIL", name)
	}
	diff :: proc(a, b: []f64) -> f64 {
		if len(a) != len(b) {return math.INF_F64}
		d := 0.0
		for v, i in a {d = max(d, abs(v - b[i]) / max(1, abs(b[i])))}
		return d
	}
	matrix_leaf :: proc(v: []f64, rows, cols: int, grad: bool) -> ^t.Tensor {
		m := l.matrix_new(f64, rows, cols)
		copy(m.data, v)
		return t.tensor_new(m, grad)
	}
	// inverse real DFT as a [2·bins, N] matrix: frame = [re | im] @ basis, with
	// x[n] = (1/N) Σ_k c_k (re_k cos(2πkn/N) - im_k sin(2πkn/N)), c_k = 1 for the
	// DC and Nyquist bins and 2 otherwise (the imaginary parts of those two drop out)
	irdft_basis :: proc(N: int) -> ^t.Tensor {
		bins := N / 2 + 1
		basis := make([]f64, 2 * bins * N, context.temp_allocator)
		for k in 0 ..< bins {
			c := 1.0 if k == 0 || 2 * k == N else 2.0
			for n in 0 ..< N {
				arg := 2 * math.PI * f64(k * n) / f64(N)
				basis[k * N + n] = c * math.cos(arg) / f64(N)
				basis[(bins + k) * N + n] = -c * math.sin(arg) / f64(N)
			}
		}
		return matrix_leaf(basis, 2 * bins, N, false)
	}
	window :: proc(N: int, a0: f64) -> []f64 {
		w := make([]f64, N, context.temp_allocator)
		for &v, n in w {v = a0 - (1 - a0) * math.cos(2 * math.PI * f64(n) / f64(N))}
		return w
	}
	Istft_Case :: struct {
		B, F, N, hop, length: int,
		a0:                   f64, // window a0 - (1 - a0)·cos: 0.5 Hann, 0.54 Hamming
		center:               bool,
		same:                 bool, // Vocos' "same" padding: start = (N - hop) / 2
		spec, up, y, dspec:   []f64,
		name:                 string,
	}
	cases := [?]Istft_Case {
		{
			B = 2,
			F = 9,
			N = 16,
			hop = 4,
			length = -1,
			a0 = 0.5,
			center = true,
			spec = OA1_SPEC[:],
			up = OA1_UP[:],
			y = OA1_Y[:],
			dspec = OA1_DSPEC[:],
			name = "centred, Hann, n_fft 16, hop 4, 9 frames",
		},
		{
			B = 2,
			F = 6,
			N = 8,
			hop = 3,
			length = 28,
			a0 = 0.54,
			center = false,
			spec = OA2_SPEC[:],
			up = OA2_UP[:],
			y = OA2_Y[:],
			dspec = OA2_DSPEC[:],
			name = "not centred, Hamming, n_fft 8, hop 3, 6 frames, 5 samples past the end",
		},
		{
			B = 2,
			F = 8,
			N = 16,
			hop = 4,
			length = -1,
			a0 = 0.5,
			same = true,
			spec = OA4_SPEC[:],
			up = OA4_UP[:],
			y = OA4_Y[:],
			dspec = OA4_DSPEC[:],
			name = "Vocos \"same\" padding, Hann, n_fft 16, hop 4, 8 frames",
		},
	}

	// 1-3. iSTFT = matmul with the inverse DFT basis + windowed overlap-add
	for c in cases {
		bins := c.N / 2 + 1
		spec := matrix_leaf(c.spec, c.B * c.F, 2 * bins, true)
		frames := t.tensor_reshape(t.tensor_matmul(spec, irdft_basis(c.N)), {c.B, c.F, c.N, 1})
		start := (c.N - c.hop) / 2 if c.same else -1
		y := t.tensor_overlap_add(frames, c.hop, window(c.N, c.a0), c.center, c.length, start)
		t.tensor_backward_with_grad(y, c.up)
		d := max(diff(y.data.data, c.y), diff(spec.grad.data, c.dspec))
		L := len(c.y) / c.B
		expect(
			&passed,
			&total,
			y.shape == [4]int{c.B, L, 1, 1} && d < 1e-12,
			fmt.tprintf(
				"iSTFT (%s): output %v, output and spectrum gradient vs torch %.1e",
				c.name,
				y.shape,
				d,
			),
		)
	}

	// 4. no window: plain overlap-add sum, as torch.nn.functional.fold
	{
		B, F, N, hop :: 2, 5, 6, 4
		fr := matrix_leaf(OA3_FR[:], 1, B * F * N, true)
		fr.shape = {B, F, N, 1}
		y := t.tensor_overlap_add(fr, hop)
		t.tensor_backward_with_grad(y, OA3_UP[:])
		d := max(diff(y.data.data, OA3_Y[:]), diff(fr.grad.data, OA3_DFR[:]))
		expect(
			&passed,
			&total,
			y.shape == [4]int{B, (F - 1) * hop + N, 1, 1} && d < 1e-13,
			fmt.tprintf(
				"overlap-add without a window (6-sample frames, hop 4): output %v, output and frame gradient vs torch fold %.1e",
				y.shape,
				d,
			),
		)
	}

	// 5. round trip: the STFT of conv1d_reference_test (reflect-padded strided
	//    conv1d with a Hann-windowed DFT basis) then this iSTFT gives the signal back
	{
		N_FFT, HOP, L :: 64, 16, 400
		BINS :: N_FFT / 2 + 1
		signal := make([]f64, L, context.temp_allocator)
		for &v, i in signal {
			n := f64(i)
			v = math.sin(0.05 * n + 0.001 * n * n) + 0.3 * math.cos(1.3 * n)
		}
		padded := make([]f64, L + N_FFT, context.temp_allocator)
		for &v, i in padded {
			j := abs(i - N_FFT / 2)
			if j >= L {j = 2 * (L - 1) - j}
			v = signal[j]
		}
		hann := window(N_FFT, 0.5)
		basis := make([]f64, 2 * BINS * N_FFT, context.temp_allocator)
		for f in 0 ..< BINS {
			for n in 0 ..< N_FFT {
				arg := 2 * math.PI * f64(f * n) / N_FFT
				basis[f * N_FFT + n] = hann[n] * math.cos(arg)
				basis[(BINS + f) * N_FFT + n] = -hann[n] * math.sin(arg)
			}
		}
		x := matrix_leaf(padded, 1, L + N_FFT, false)
		x.shape = {1, L + N_FFT, 1, 1}
		w := matrix_leaf(basis, 1, len(basis), false)
		w.shape = {2 * BINS, 1, N_FFT, 1}
		spec := t.tensor_conv1d(x, w, nil, stride = HOP) // [1, F, 2·bins]
		F := spec.shape[1]
		spec_m := t.tensor_as_matrix(spec, F, 2 * BINS)
		frames := t.tensor_reshape(t.tensor_matmul(spec_m, irdft_basis(N_FFT)), {1, F, N_FFT, 1})
		y := t.tensor_overlap_add(frames, HOP, hann, center = true)
		d := diff(y.data.data, signal)
		expect(
			&passed,
			&total,
			d < 1e-12,
			fmt.tprintf(
				"STFT (strided conv1d) then iSTFT (n_fft 64, hop 16, Hann, %d frames): %d samples, reconstruction error %.1e",
				F,
				len(y.data.data),
				d,
			),
		)
	}

	fmt.printf("overlap-add / iSTFT: %d/%d passed\n", passed, total)
	record_failures(total - passed)
}
