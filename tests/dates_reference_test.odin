3715846994536, 0.15555555555555556, 1.0497237569060773, 0.39075566826676333, 2.1666666666666665, 1.3054526994744386, 0.005376344086021505, 0.7698630136986302, 0.35329089598846986, 1.6348595848595848, 1.1740331491712708, 0.904438103333131, 0.6665315558758181, 0.2513812154696133, 0.03763440860215053, 1.6666666666666667, 0.8145161290322581, 0.058333333333333334, 1.1942660378770866, 1.443304139531402, 1.0815217391304348, 0.810958904109589, 1.76080850024426, 1.0833333333333333, 1.9123287671232876, 0.6693838947937308, 0.9003399915002125, 0.3333333333333333, 1.2146953405017922, 2.3333333333333335, 1.75, 2.0833333333333335, 0.1712707182320442, 2.0, 0.9241036005689048, 2.4166666666666665, 0.41666666666666674, 0.013888888888888888, 0.8333333333333334, 0.4166666666666667, 0.8657534246575342, 1.7084811737405494, 1.4166666666666667, 1.3205479452054794, 0.07880434782608696, 1.9166666666666667, 0.5722222222222222, 0.6666666666666666, 1.4166666666666667, 1.25, 1.4900162142685565, 1.1370087581405794, 0.3259376493072145, 0.04619565217391304, 1.828804347826087, 0.16666666666666666, 1.576086956521739, 0.0028089887640449437, 0.0, 0.3999641662685141, 1.7052324275769144, 1.1666666666666667, 1.4767123287671233, 1.25, 1.4836065573770492, 0.01098901098901099, 1.0833333333333333, 1.476744535190968, 0.11413043478260869, 1.231953129743185, 1.8856280193236716, 0.7835616438356164, 0.7873655913978495, 1.4166666666666667, 1.4488526570048308, 0.18904109589041096, 1.0386406168126356, 0.08333333333333333, 0.07967032967032966, 0.3333333333333333, 0.3333333333333333, 0.3087374581939799, 1.5994623655913975, 0.20218579234972678, 1.896291208791209, 0.029569892473118278, 0.8777677969907927, 1.1666666666666667, 2.1666666666666665, 0.9617486338797814, 1.173913043478261, 1.4806629834254144, 2.0451605659106225, 0.11944444444444444, 0.41666666666666674, 1.8704737885065754, 1.023924731182796, 1.5972602739726027, 0.013440860215053762, 0.6666666666666666, 0.536986301369863, 0.7452054794520548, 2.041417770791227, 1.75, 0.34972677595628415, 1.833333333333333, 0.762087912087912}
@(private = "file")
DT_S0 :: 34700
@(private = "file")
DT_S1 :: 64284

@(private = "file")
_dt_date :: proc(serial: i32) -> w.Date {
	return w.civil_from_days(i64(serial) - 25569)
}

@(private = "file")
_dt_serial :: proc(d: w.Date) -> i32 {
	return i32(w.days_from_civil(i64(d.year), i64(d.month), i64(d.day)) + 25569)
}

// Test calendars by index: null, weekends only, TARGET, US settlement, US
// government bond, UK settlement, TARGET + UK
@(private = "file")
_DT_CALS := [7]fin.Calendar{{}, {.Weekends}, {.TARGET}, {.US_Settlement}, {.US_Government_Bond}, {.UK_Settlement}, {.TARGET, .UK_Settlement}}

dates_reference_test :: proc(allocator: mem.Allocator) {
	seed_test(#procedure)
	fmt.println("\n=== Calendars, business-day rules, day counters, schedules (QuantLib reference) ===")
	context.allocator = allocator
	passed, total := 0, 0
	expect :: proc(passed, total: ^int, ok: bool, name: string) {
		total^ += 1
		if ok {passed^ += 1}
		fmt.printf("%s %s\n", "OK  " if ok else "FAIL", name)
	}
	show :: proc(bad: ^int, msg: string) {
		if bad^ < 5 {fmt.println("     ", msg)}
		bad^ += 1
	}

	// 1. Holiday lists and weekdays
	{
		bad, count := 0, 0
		for c in 0 ..< 7 {
			want := DT_HOL[DT_HOFF[c]:DT_HOFF[c + 1]]
			k := 0
			for s := i32(DT_S0); s <= DT_S1; s += 1 {
				d := _dt_date(s)
				wd := w.date_weekday(d)
				if wd == .Saturday || wd == .Sunday || fin.is_business_day(_DT_CALS[c], d) {continue}
				if k >= len(want) || want[k] != s {
					show(&bad, fmt.tprintf("calendar %d: holiday %v not in QuantLib's list", c, d))
					for k < len(want) && want[k] < s {k += 1}
					if k < len(want) && want[k] == s {k += 1}
					continue
				}
				k += 1
				count += 1
			}
			if k != len(want) {show(&bad, fmt.tprintf("calendar %d: %d QuantLib holidays missing", c, len(want) - k))}
		}
		for i := 0; i < len(DT_WD); i += 2 {
			if int(w.date_weekday(_dt_date(DT_WD[i]))) != int((DT_WD[i + 1] + 5) % 7) {show(&bad, fmt.tprintf("weekday of %v", _dt_date(DT_WD[i])))}
		}
		expect(&passed, &total, bad == 0, fmt.tprintf("holidays 1995-2075 on weekdays for TARGET, US settlement, US government bond (SIFMA), UK settlement and TARGET+UK: %d / %d match QuantLib; %d weekdays", count, len(DT_HOL), len(DT_WD) / 2))
	}

	// 2. Adjustment, advance, business-day counts
	{
		bad := 0
		for i := 0; i < len(DT_ADJ); i += 4 {
			got := fin.calendar_adjust(_DT_CALS[DT_ADJ[i]], _dt_date(DT_ADJ[i + 1]), fin.BusinessDayConvention(DT_ADJ[i + 2]))
			if _dt_serial(got) != DT_ADJ[i + 3] {show(&bad, fmt.tprintf("adjust cal %d %v %v: %v, QuantLib %v", DT_ADJ[i], _dt_date(DT_ADJ[i + 1]), fin.BusinessDayConvention(DT_ADJ[i + 2]), got, _dt_date(DT_ADJ[i + 3])))}
		}
		for i := 0; i < len(DT_ADV); i += 7 {
			a := DT_ADV[i:i + 7]
			got := fin.calendar_advance(_DT_CALS[a[0]], _dt_date(a[1]), int(a[2]), fin.TimeUnit(a[3]), fin.BusinessDayConvention(a[4]), a[5] != 0)
			if _dt_serial(got) != a[6] {show(&bad, fmt.tprintf("advance cal %d %v %d %v %v eom %d: %v, QuantLib %v", a[0], _dt_date(a[1]), a[2], fin.TimeUnit(a[3]), fin.BusinessDayConvention(a[4]), a[5], got, _dt_date(a[6])))}
		}
		for i := 0; i < len(DT_BDB); i += 6 {
			a := DT_BDB[i:i + 6]
			got := fin.business_days_between(_DT_CALS[a[0]], _dt_date(a[1]), _dt_date(a[2]), a[3] != 0, a[4] != 0)
			if i32(got) != a[5] {show(&bad, fmt.tprintf("business days cal %d %v → %v (%d, %d): %d, QuantLib %d", a[0], _dt_date(a[1]), _dt_date(a[2]), a[3], a[4], got, a[5]))}
		}
		expect(&passed, &total, bad == 0, fmt.tprintf("%d adjustments (7 conventions incl. half-month modified following, nearest), %d advances (days / weeks / months / years, end-of-month rule), %d business-day counts vs QuantLib: %d mismatches", len(DT_ADJ) / 4, len(DT_ADV) / 7, len(DT_BDB) / 6, bad))
	}

	// 3. Day counters
	{
		bad := 0
		worst := 0.0
		for k in 0 ..< len(DT_DCF) {
			a := DT_DCI[6 * k:6 * k + 6]
			rs := _dt_date(a[3]) if a[3] != 0 else w.Date{}
			re := _dt_date(a[4]) if a[4] != 0 else w.Date{}
			tm := _dt_date(a[5]) if a[5] != 0 else w.Date{}
			got := fin.year_fraction(fin.DayCountConvention(a[0]), _dt_date(a[1]), _dt_date(a[2]), rs, re, tm)
			err := abs(got - DT_DCF[k])
			if !(err < 1e-14) {show(&bad, fmt.tprintf("%v %v → %v (ref %v – %v, term %v): %.15f, QuantLib %.15f", fin.DayCountConvention(a[0]), _dt_date(a[1]), _dt_date(a[2]), rs, re, tm, got, DT_DCF[k]))}
			if !math.is_nan(err) {worst = max(worst, err)}
		}
		expect(&passed, &total, bad == 0, fmt.tprintf("%d year fractions (ACT/360, ACT/365F, ACT/ACT ISDA, 30/360 bond basis, ACT/ACT ICMA with long first / last stubs, 30/360 US, 30E/360, 30E/360 ISDA with termination) vs QuantLib: max diff %.1e, %d mismatches", len(DT_DCF), worst, bad))
	}

	// 4. Schedules
	{
		bad, n_dates := 0, 0
		for i := 0; i < len(DT_SCH); i += 14 {
			a := DT_SCH[i:i + 14]
			first := _dt_date(a[9]) if a[9] != 0 else w.Date{}
			ntl := _dt_date(a[10]) if a[10] != 0 else w.Date{}
			s := fin.make_schedule(_dt_date(a[0]), _dt_date(a[1]), fin.Period{int(a[2]), fin.TimeUnit(a[3])}, _DT_CALS[a[4]], fin.BusinessDayConvention(a[5]), fin.BusinessDayConvention(a[6]), fin.DateGenerationRule(a[7]), a[8] != 0, first, ntl)
			defer fin.free_schedule(&s)
			want := DT_SD[a[11]:a[11] + a[13]]
			want_r := DT_SR[a[12]:a[12] + a[13] - 1]
			ok := len(s.dates) == len(want) && len(s.is_regular) == len(want_r)
			if ok {
				for d, j in s.dates {ok &&= _dt_serial(d) == want[j]}
				for r, j in s.is_regular {ok &&= r == (want_r[j] != 0)}
			}
			if !ok {
				got := make([]i32, len(s.dates))
				for d, j in s.dates {got[j] = _dt_serial(d)}
				show(&bad, fmt.tprintf("schedule %d (%v → %v, %d %v, cal %d, %v / %v, %v, eom %d, first %v, ntl %v): %v %v, QuantLib %v %v", i / 14, _dt_date(a[0]), _dt_date(a[1]), a[2], fin.TimeUnit(a[3]), a[4], fin.BusinessDayConvention(a[5]), fin.BusinessDayConvention(a[6]), fin.DateGenerationRule(a[7]), a[8], first, ntl, got, s.is_regular, want, want_r))
			}
			n_dates += len(want)
		}
		expect(&passed, &total, bad == 0, fmt.tprintf("%d schedules (backward / forward / zero, 1M-1Y and 4-week tenors, end-of-month, explicit first and next-to-last stub dates, 7 calendars): %d dates and regularity flags vs QuantLib, %d mismatches", len(DT_SCH) / 14, n_dates, bad))
	}

	fmt.printf("Dates summary: %d/%d passed\n", passed, total)
	record_failures(total - passed)
}
