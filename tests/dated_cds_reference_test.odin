@(private = "file")
CD_EVAL :: 45769
@(private = "file")
CD_R :: 0.4

@(private = "file")
_cd_date :: proc(serial: i32) -> w.Date {
	return w.civil_from_days(i64(serial) - 25569)
}

dated_cds_reference_test :: proc(allocator: mem.Allocator) {
	seed_test(#procedure)
	fmt.println(
		"\n=== Flat-forward curve, CDS2015 contracts, ISDA engine and hazard bootstrap (QuantLib reference) ===",
	)
	context.allocator = allocator
	passed, total := 0, 0
	expect :: proc(passed, total: ^int, ok: bool, name: string) {
		total^ += 1
		if ok {passed^ += 1}
		fmt.printf("%s %s\n", "OK  " if ok else "FAIL", name)
	}
	rel :: proc(x, y: f64) -> f64 {return abs(x - y) / max(abs(y), 1e-300)}

	eval := _cd_date(CD_EVAL)
	conv := fin.SwapConventions {
		calendar         = {.TARGET},
		settlement_days  = 2,
		fixed_tenor      = {1, .Years},
		fixed_convention = .ModifiedFollowing,
		fixed_day_count  = .THIRTY_360,
		float_tenor      = {6, .Months},
		float_convention = .ModifiedFollowing,
		float_day_count  = .ACT_360,
	}
	quotes := [10]fin.CurveQuote {
		{.Deposit, {1, .Months}, CD_DEP[0]},
		{.Deposit, {3, .Months}, CD_DEP[1]},
		{.Deposit, {6, .Months}, CD_DEP[2]},
		{.Swap, {1, .Years}, CD_SWP[0]},
		{.Swap, {2, .Years}, CD_SWP[1]},
		{.Swap, {3, .Years}, CD_SWP[2]},
		{.Swap, {5, .Years}, CD_SWP[3]},
		{.Swap, {7, .Years}, CD_SWP[4]},
		{.Swap, {10, .Years}, CD_SWP[5]},
		{.Swap, {15, .Years}, CD_SWP[6]},
	}
	disc := fin.bootstrap_yield_curve_dated(eval, quotes[:], conv, interpolation = .FlatForward)
	defer fin.free_yield_curve(&disc, allocator)

	// 1. Flat-forward bootstrap
	{
		pillars_ok := true
		for t, i in disc.tenors {pillars_ok &&= abs(t - fin.date_to_time(eval, _cd_date(CD_YP[i]))) < 1e-15}
		worst_z, worst_df := 0.0, 0.0
		for z, i in disc.zero_rates {worst_z = max(worst_z, abs(z - CD_YZ[i]))}
		for d, i in CD_YDFD {worst_df = max(worst_df, rel(fin.yield_curve_discount_factor_date(&disc, _cd_date(d)), CD_YDF[i]))}
		expect(
			&passed,
			&total,
			pillars_ok && worst_z < 1e-11 && worst_df < 1e-10,
			fmt.tprintf(
				"flat-forward discount curve (deposits + swaps) vs QuantLib PiecewiseFlatForward: pillar dates %v, max zero-rate diff %.1e, max DF rel diff %.1e over %d dates incl. extrapolation past 15Y",
				pillars_ok,
				worst_z,
				worst_df,
				len(CD_YDFD),
			),
		)
	}

	// 2. Hazard bootstrap from par spreads
	tenors := [7]fin.Period {
		{6, .Months},
		{1, .Years},
		{2, .Years},
		{3, .Years},
		{5, .Years},
		{7, .Years},
		{10, .Years},
	}
	hz := fin.bootstrap_cds_curve_dated(tenors[:], CD_SPR[:], CD_R, &disc)
	defer {delete(hz.tenors); delete(hz.hazards)}
	{
		pillars_ok := true
		for t, i in hz.tenors {pillars_ok &&= abs(t - fin.date_to_time(eval, _cd_date(CD_HP[i]))) < 1e-15}
		worst_h, worst_s, worst_q := 0.0, 0.0, 0.0
		for h, i in hz.hazards {worst_h = max(worst_h, rel(h, CD_HR[i]))}
		for d, i in CD_SURVD {worst_s = max(worst_s, abs(fin.get_survival_prob(fin.date_to_time(eval, _cd_date(d)), hz) - CD_SURV[i]))}
		for t, i in tenors {
			cds := fin.make_standard_cds(eval, t, CD_SPR[i])
			worst_q = max(
				worst_q,
				abs(fin.price_dated_cds(cds, &hz, &disc).fair_spread - CD_SPR[i]),
			)
			fin.free_dated_cds(&cds)
		}
		expect(
			&passed,
			&total,
			pillars_ok && worst_h < 1e-9 && worst_s < 1e-11 && worst_q < 1e-14,
			fmt.tprintf(
				"hazard curve from 7 par spreads 6M-10Y (CDS2015, recovery 40%%) vs QuantLib SpreadCdsHelper (ISDA) / PiecewiseFlatHazardRate: pillar dates (payment date of maturity + 1) %v, max hazard rel diff %.1e, survival diff %.1e on %d dates, quotes reprice to %.1e",
				pillars_ok,
				worst_h,
				worst_s,
				len(CD_SURVD),
				worst_q,
			),
		)
	}

	// 3. Contracts vs IsdaCdsEngine
	{
		names := [6]string {
			"5Y buyer 100bp",
			"5Y buyer 100bp + 1.37% upfront",
			"3Y seller 500bp − 9.12% upfront",
			"10Y buyer 100bp",
			"1Y seller 100bp",
			"seasoned 5Y buyer (traded 10 Jun 2023)",
		}
		worst := 0.0
		bad := 0
		for k in 0 ..< 6 {
			a := CD_CI[4 * k:4 * k + 4]
			f := CD_CF[11 * k:11 * k + 11]
			cds := fin.make_standard_cds(
				_cd_date(a[0]),
				{int(a[1]), fin.TimeUnit(a[2])},
				f[0],
				f[2],
				fin.CDSSide(a[3]),
				f[1],
			)
			defer fin.free_dated_cds(&cds)
			r := fin.price_dated_cds(cds, &hz, &disc)
			sgn := 1.0 if cds.side == .Buyer else -1.0
			// QuantLib's legs are signed for the side
			got := [8]f64 {
				r.npv,
				sgn * r.protection_leg,
				-sgn * r.premium_leg,
				-sgn * r.upfront_pv,
				sgn * r.accrual_rebate,
				r.fair_spread,
				r.fair_upfront,
				-sgn * r.risky_annuity * f[2] * 1e-4,
			}
			want := [8]f64{f[3], f[4], f[5], f[6], f[7], f[8], f[9], f[10]}
			e := 0.0
			for j in 0 ..< 8 {
				if j == 6 && want[j] == 1e300 { 	// no fair upfront once the upfront date has passed
					if got[j] == got[j] {e = 1} 	// must be NaN
					continue
				}
				e = max(
					e,
					abs(got[j] - want[j]) / (f[2] if j < 5 else max(abs(want[j]), 1e-300)) if j != 6 else abs(got[j] - want[j]),
				)
			}
			if !(e < 1e-11) {
				bad += 1
				fmt.printf("      %s: got %v\n      QuantLib %v\n", names[k], got, want)
			}
			worst = max(worst, e)
		}
		f := CD_CF[0:11]
		expect(
			&passed,
			&total,
			bad == 0,
			fmt.tprintf(
				"6 standard CDS (new buyer / seller, with upfront, 1Y-10Y, seasoned) vs QuantLib IsdaCdsEngine: NPV, protection, premium, upfront, accrual rebate (per notional), fair spread, fair upfront, BPS max diff %.1e; 5Y 100bp: NPV %.2f (%.2f), fair spread %.4f bp, fair upfront %.6f%%",
				worst,
				CD_CF[3],
				f[3],
				1e4 * f[8],
				100 * f[9],
			),
		)
	}

	fmt.printf("Dated CDS summary: %d/%d passed\n", passed, total)
	record_failures(total - passed)
}
