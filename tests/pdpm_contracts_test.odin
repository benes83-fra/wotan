package tests

import fin "../wotan/finance"
import "core:fmt"
import "core:math"
import "core:math/rand"
import "core:mem"

// PDPM calibration contracts, on option prices generated by the model itself:
// - the fine grid window is centred on the coarse best and clipped to the range
// - exponential, power-utility and 2-factor calibrations recover the generating
//   parameters, report an interior optimum as converged, and keep E[M] = 1/(1+rf)
// - an optimum on the edge of the search range is reported as not converged

pdpm_contracts_test :: proc(allocator: mem.Allocator) {
	seed_test(#procedure)
	fmt.println("\n=== PDPM Calibration Contracts ===")
	context.allocator = allocator
	passed, total := 0, 0
	expect :: proc(passed, total: ^int, ok: bool, name: string) {
		total^ += 1
		if ok {passed^ += 1}
		fmt.printf("%s %s\n", "OK  " if ok else "FAIL", name)
	}

	// 1. fine window: centred ±1 coarse step, clipped at the range edge
	lo_c := fin._fine_grid_point(2.0, 0.5, -5, 5, 0, 11)
	hi_c := fin._fine_grid_point(2.0, 0.5, -5, 5, 10, 11)
	lo_e := fin._fine_grid_point(4.8, 0.5, -5, 5, 0, 11)
	hi_e := fin._fine_grid_point(4.8, 0.5, -5, 5, 10, 11)
	expect(&passed, &total, lo_c == 1.5 && hi_c == 2.5 && lo_e == 4.3 && hi_e == 5.0,
		fmt.tprintf("fine window [%.2f, %.2f] around 2.0, clipped [%.2f, %.2f] near the edge", lo_c, hi_c, lo_e, hi_e))

	// Synthetic states: gross returns R ~ 1 + N(0.01, 0.05), squared-shock second factor
	n := 400
	rets := make([]f64, n)
	vol := make([]f64, n)
	defer {delete(rets); delete(vol)}
	for i in 0 ..< n {
		z := rand.norm_float64()
		rets[i] = 0.01 + 0.05 * z
		vol[i] = z * z - 1.0 // squared shock: a volatility factor that option prices can identify
	}
	spot, rf := 100.0, 0.03
	rf_d := 1.0 / (1.0 + rf)

	n_opt := 10
	strikes := make([]f64, n_opt)
	expiries := make([]f64, n_opt)
	ivs := make([]f64, n_opt)
	prices := make([]f64, n_opt)
	types := make([]string, n_opt)
	defer {delete(strikes); delete(expiries); delete(ivs); delete(prices); delete(types)}
	for k in 0 ..< n_opt {
		strikes[k] = 90.0 + 4.0 * f64(k / 2)
		expiries[k] = 1.0
		types[k] = "call" if k % 2 == 0 else "put"
	}
	chain := fin.OptionChain{strikes, expiries, ivs, prices, types, n_opt}

	// Prices E[M * payoff] for a model SDF m (already normalised)
	fill_prices :: proc(chain: ^fin.OptionChain, m, rets: []f64, spot: f64) {
		for k in 0 ..< chain.n_options {
			p := 0.0
			for i in 0 ..< len(rets) {
				ST := spot * (1.0 + rets[i])
				pay := max(ST - chain.strikes[k], 0) if chain.option_types[k] == "call" else max(chain.strikes[k] - ST, 0)
				p += m[i] * pay
			}
			chain.market_prices[k] = p / f64(len(rets))
		}
	}
	normalise :: proc(m: []f64, rf_d: f64) {
		mean := 0.0
		for v in m {mean += v}
		mean /= f64(len(m))
		for &v in m {v *= rf_d / mean}
	}
	free_cal :: proc(r: ^fin.CalibrationResult) {
		delete(r.sdf.values)
		delete(r.sdf.parameters)
	}
	m := make([]f64, n)
	defer delete(m)

	// 2. exponential SDF, gamma = 2 (search range [-5, 5])
	for i in 0 ..< n {m[i] = math.exp(-2.0 * (1.0 + rets[i]))}
	normalise(m, rf_d)
	fill_prices(&chain, m, rets, spot)
	ex := fin.calibrate_sdf_exponential(rets, rf, &chain, spot, allocator)
	defer free_cal(&ex)
	expect(&passed, &total, abs(ex.sdf.risk_aversion - 2.0) < 5e-3 && ex.converged && ex.rmse < 1e-2,
		fmt.tprintf("exponential recovers gamma = %.4f (truth 2), converged = %v, RMSE %.1e", ex.sdf.risk_aversion, ex.converged, ex.rmse))

	// 3. power utility, gamma = 3 (range [0.5, 10]): E[M] pinned to 1/(1+rf)
	for i in 0 ..< n {m[i] = math.pow(1.0 + rets[i], -3.0)}
	normalise(m, rf_d)
	fill_prices(&chain, m, rets, spot)
	pw := fin.calibrate_sdf_power_utility(rets, rf, &chain, spot, allocator)
	defer free_cal(&pw)
	expect(&passed, &total, abs(pw.sdf.risk_aversion - 3.0) < 5e-3 && pw.converged && abs(pw.sdf.mean / rf_d - 1.0) < 1e-12,
		fmt.tprintf("power utility recovers gamma = %.4f (truth 3), E[M] = %.6f (1/(1+rf) = %.6f)", pw.sdf.risk_aversion, pw.sdf.mean, rf_d))

	// 4. 2-factor exponential, weights (1.3, -0.7) (range ±5)
	for i in 0 ..< n {m[i] = math.exp(1.3 * rets[i] - 0.7 * vol[i])}
	normalise(m, rf_d)
	fill_prices(&chain, m, rets, spot)
	mf := fin.calibrate_sdf_multifactor_2d(rets, vol, rf, &chain, spot, allocator)
	defer free_cal(&mf)
	w := mf.sdf.parameters
	expect(&passed, &total, abs(w[0] - 1.3) < 0.06 && abs(w[1] + 0.7) < 0.06 && mf.converged,
		fmt.tprintf("2-factor recovers weights (%.3f, %.3f) (truth 1.3, -0.7), converged = %v", w[0], w[1], mf.converged))

	// 5. truth outside the range: exponential gamma = 8 > 5 is pinned to the edge
	for i in 0 ..< n {m[i] = math.exp(-8.0 * (1.0 + rets[i]))}
	normalise(m, rf_d)
	fill_prices(&chain, m, rets, spot)
	edge := fin.calibrate_sdf_exponential(rets, rf, &chain, spot, allocator)
	defer free_cal(&edge)
	expect(&passed, &total, edge.sdf.risk_aversion == 5.0 && !edge.converged,
		fmt.tprintf("edge optimum gamma = %.4f reported as not converged (%v)", edge.sdf.risk_aversion, edge.converged))

	fmt.printf("PDPM contracts summary: %d/%d passed\n", passed, total)
	record_failures(total - passed)
}
