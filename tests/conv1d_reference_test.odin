// STFT: n_fft 64, hop 16, 400 samples, 26 frames, 33 bins


Cv_Case :: struct {
	C_in, C_out, K, stride, groups, dilation, pad_left, pad_right, T, T_out: int,
	x, w, b, up, y, dx, dw, db:                                              []f64,
}

// tensor_conv1d with stride and groups against torch.nn.functional.conv1d:
// 6 configurations (strides 1 to 4, groups 1, 2, depthwise and depthwise with
// 2 outputs per channel, dilation 1 to 3, asymmetric padding, with and without
// bias), output and the gradients of x, weight and bias under a random upstream
// gradient; Conv1dLayer with stride and groups gives the same output; a strided
// convolution with a windowed DFT basis reproduces torch.stft magnitudes
// (centred with reflect padding, periodic Hann window).
conv1d_reference_test :: proc(allocator: mem.Allocator) {
	seed_test(#procedure)
	fmt.println("\n=== conv1d stride and groups vs torch ===")
	context.allocator = allocator
	passed, total := 0, 0
	expect :: proc(passed, total: ^int, ok: bool, name: string) {
		total^ += 1
		if ok {passed^ += 1}
		fmt.printf("%s %s\n", "OK  " if ok else "FAIL", name)
	}
	leaf :: proc(v: []f64, shape: [4]int, grad := true) -> ^t.Tensor {
		m := l.matrix_new(f64, 1, len(v))
		copy(m.data, v)
		x := t.tensor_new(m, grad)
		x.shape = shape
		return x
	}
	diff :: proc(a, b: []f64) -> f64 {
		if len(a) != len(b) {return math.INF_F64}
		d := 0.0
		for v, i in a {d = max(d, abs(v - b[i]) / max(1, abs(b[i])))}
		return d
	}
	cases := [?]Cv_Case {
		{
			4,
			6,
			3,
			2,
			1,
			1,
			1,
			1,
			13,
			7,
			CV1_X[:],
			CV1_W[:],
			CV1_B[:],
			CV1_UP[:],
			CV1_Y[:],
			CV1_DX[:],
			CV1_DW[:],
			CV1_DB[:],
		},
		{
			4,
			6,
			3,
			3,
			2,
			2,
			2,
			0,
			13,
			4,
			CV2_X[:],
			CV2_W[:],
			CV2_B[:],
			CV2_UP[:],
			CV2_Y[:],
			CV2_DX[:],
			CV2_DW[:],
			CV2_DB[:],
		},
		{
			5,
			5,
			7,
			1,
			5,
			1,
			3,
			3,
			13,
			13,
			CV3_X[:],
			CV3_W[:],
			CV3_B[:],
			CV3_UP[:],
			CV3_Y[:],
			CV3_DX[:],
			CV3_DW[:],
			CV3_DB[:],
		},
		{
			3,
			6,
			5,
			4,
			3,
			1,
			0,
			2,
			13,
			3,
			CV4_X[:],
			CV4_W[:],
			nil,
			CV4_UP[:],
			CV4_Y[:],
			CV4_DX[:],
			CV4_DW[:],
			nil,
		},
		{
			3,
			4,
			4,
			4,
			1,
			1,
			0,
			0,
			14,
			3,
			CV5_X[:],
			CV5_W[:],
			CV5_B[:],
			CV5_UP[:],
			CV5_Y[:],
			CV5_DX[:],
			CV5_DW[:],
			CV5_DB[:],
		},
		{
			6,
			4,
			3,
			2,
			2,
			3,
			4,
			1,
			11,
			5,
			CV6_X[:],
			CV6_W[:],
			CV6_B[:],
			CV6_UP[:],
			CV6_Y[:],
			CV6_DX[:],
			CV6_DW[:],
			CV6_DB[:],
		},
	}

	// 1. the six configurations
	worst := 0.0
	shapes_ok := true
	for c in cases {
		x := leaf(c.x, {2, c.T, c.C_in, 1})
		w := leaf(c.w, {c.C_out, c.C_in / c.groups, c.K, 1})
		b := leaf(c.b, {1, c.C_out, 1, 1}) if c.b != nil else nil
		y := t.tensor_conv1d(x, w, b, c.dilation, c.pad_left, c.pad_right, c.stride, c.groups)
		shapes_ok &&= y.shape == [4]int{2, c.T_out, c.C_out, 1}
		t.tensor_backward_with_grad(y, c.up)
		d := max(diff(y.data.data, c.y), diff(x.grad.data, c.dx), diff(w.grad.data, c.dw))
		if b != nil {d = max(d, diff(b.grad.data, c.db))}
		worst = max(worst, d)
	}
	expect(
		&passed,
		&total,
		shapes_ok && worst < 1e-13,
		fmt.tprintf(
			"conv1d, 6 configurations (stride 1-4; groups 1, 2, depthwise, depthwise x2; dilation 1-3; asymmetric padding): output shape %v, output and x / weight / bias gradients vs torch %.1e",
			shapes_ok,
			worst,
		),
	)

	// 2. Conv1dLayer passes stride and groups on (depthwise, padding 3)
	{
		c := cases[2]
		layer := nn.conv1d_layer_new(
			c.C_in,
			c.C_out,
			c.K,
			padding = 3,
			stride = c.stride,
			groups = c.groups,
		)
		defer nn.conv1d_layer_free(&layer)
		copy(layer.weight.data.data, c.w)
		copy(layer.bias.data.data, c.b)
		y := nn.conv1d_layer_forward(&layer, leaf(c.x, {2, c.T, c.C_in, 1}, false))
		d := diff(y.data.data, c.y)
		expect(
			&passed,
			&total,
			d < 1e-13 && layer.weight.shape == [4]int{c.C_out, 1, c.K, 1},
			fmt.tprintf(
				"Conv1dLayer depthwise (groups %d): weight shape %v, output vs torch %.1e",
				c.groups,
				layer.weight.shape,
				d,
			),
		)
	}

	// 3. STFT as a strided convolution: reflect-pad n_fft / 2 on both sides,
	//    convolve with the rows win·cos and -win·sin of the DFT, stride = hop
	{
		N_FFT, HOP, L :: 64, 16, 400
		BINS :: N_FFT / 2 + 1
		padded := make([]f64, L + N_FFT, context.temp_allocator)
		for &v, i in padded {
			j := i - N_FFT / 2
			if j < 0 {j = -j}
			if j >= L {j = 2 * (L - 1) - j}
			n := f64(j)
			v = math.sin(0.05 * n + 0.001 * n * n) + 0.3 * math.cos(1.3 * n)
		}
		basis := make([]f64, 2 * BINS * N_FFT, context.temp_allocator)
		for f in 0 ..< BINS {
			for n in 0 ..< N_FFT {
				win := 0.5 - 0.5 * math.cos(2 * math.PI * f64(n) / N_FFT)
				arg := 2 * math.PI * f64(f * n) / N_FFT
				basis[f * N_FFT + n] = win * math.cos(arg)
				basis[(BINS + f) * N_FFT + n] = -win * math.sin(arg)
			}
		}
		x := leaf(padded, {1, L + N_FFT, 1, 1}, false)
		w := leaf(basis, {2 * BINS, 1, N_FFT, 1}, false)
		y := t.tensor_conv1d(x, w, nil, stride = HOP)
		frames := y.shape[1]
		mag := make([]f64, frames * BINS, context.temp_allocator)
		for fr in 0 ..< frames {
			row := y.data.data[fr * 2 * BINS:][:2 * BINS]
			for f in 0 ..< BINS {mag[fr * BINS + f] = math.hypot(row[f], row[BINS + f])}
		}
		d := diff(mag, CV_STFT_MAG[:])
		expect(
			&passed,
			&total,
			frames == 26 && d < 1e-10,
			fmt.tprintf(
				"STFT as a strided conv1d (n_fft 64, hop 16, Hann, centred): %d frames, magnitudes vs torch.stft %.1e",
				frames,
				d,
			),
		)
	}

	fmt.printf("conv1d stride and groups: %d/%d passed\n", passed, total)
	record_failures(total - passed)
}
