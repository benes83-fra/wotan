// tensor_ctc_loss (on tensor_log_softmax of logits) against
// torch.nn.functional.ctc_loss: a random batch with different input lengths,
// an empty target and repeated labels, with mean, sum and per-sample losses
// (random upstream gradients); the blank as the last class; 60 steps with 20
// classes and up to 15 labels; impossible alignments with zero_infinity (loss
// and gradient 0) and without it (+inf, NaN gradient for those samples, the
// others unchanged). Losses and logit gradients; the gradient with respect to
// log_probs is torch's minus exp(log_probs) on the used steps. tensor_log_softmax
// alone (value and gradient) against torch.log_softmax.
ctc_reference_test :: proc(allocator: mem.Allocator) {
	seed_test(#procedure)
	fmt.println("\n=== CTC loss and log_softmax vs torch ===")
	context.allocator = allocator
	passed, total := 0, 0
	expect :: proc(passed, total: ^int, ok: bool, name: string) {
		total^ += 1
		if ok {passed^ += 1}
		fmt.printf("%s %s\n", "OK  " if ok else "FAIL", name)
	}
	leaf :: proc(v: []f64, shape: [4]int) -> ^t.Tensor {
		m := l.matrix_new(f64, 1, len(v))
		copy(m.data, v)
		x := t.tensor_new(m, true)
		x.shape = shape
		return x
	}
	// relative difference; infinities and NaNs must sit at the same places
	diff :: proc(a, b: []f64) -> f64 {
		if len(a) != len(b) {return math.INF_F64}
		d := 0.0
		for v, i in a {
			w := b[i]
			if math.is_nan(w) || math.is_inf(w) {
				same := (math.is_nan(v) && math.is_nan(w)) || v == w
				if !same {return math.INF_F64}
				continue
			}
			d = max(d, abs(v - w) / max(1, abs(w)))
		}
		return d
	}
	Ctc_Case :: struct {
		name:              string,
		N, T, C, blank:    int,
		reduction:         t.Loss_Reduction,
		zero_infinity:     bool,
		logits:            []f64,
		targets, il, tl:   []int,
		up, loss, dlogits: []f64,
	}
	cases := [?]Ctc_Case {
		{
			"random batch, mean",
			4,
			12,
			6,
			0,
			.Mean,
			false,
			CT1_LOGITS[:],
			CT1_TARGETS[:],
			CT1_IL[:],
			CT1_TL[:],
			nil,
			CT1_MEAN_LOSS[:],
			CT1_MEAN_DLOGITS[:],
		},
		{
			"random batch, sum",
			4,
			12,
			6,
			0,
			.Sum,
			false,
			CT1_LOGITS[:],
			CT1_TARGETS[:],
			CT1_IL[:],
			CT1_TL[:],
			nil,
			CT1_SUM_LOSS[:],
			CT1_SUM_DLOGITS[:],
		},
		{
			"random batch, per sample",
			4,
			12,
			6,
			0,
			.None,
			false,
			CT1_LOGITS[:],
			CT1_TARGETS[:],
			CT1_IL[:],
			CT1_TL[:],
			CT1_NONE_UP[:],
			CT1_NONE_LOSS[:],
			CT1_NONE_DLOGITS[:],
		},
		{
			"blank = last class",
			3,
			9,
			5,
			4,
			.Mean,
			false,
			CT2_LOGITS[:],
			CT2_TARGETS[:],
			CT2_IL[:],
			CT2_TL[:],
			nil,
			CT2_MEAN_LOSS[:],
			CT2_MEAN_DLOGITS[:],
		},
		{
			"60 steps, 20 classes, up to 15 labels",
			3,
			60,
			20,
			0,
			.Mean,
			false,
			CT3_LOGITS[:],
			CT3_TARGETS[:],
			CT3_IL[:],
			CT3_TL[:],
			nil,
			CT3_MEAN_LOSS[:],
			CT3_MEAN_DLOGITS[:],
		},
		{
			"2 impossible of 3, zero_infinity, mean",
			3,
			6,
			4,
			0,
			.Mean,
			true,
			CT4_LOGITS[:],
			CT4_TARGETS[:],
			CT4_IL[:],
			CT4_TL[:],
			nil,
			CT4_MEAN_LOSS[:],
			CT4_MEAN_DLOGITS[:],
		},
		{
			"2 impossible of 3, zero_infinity, per sample",
			3,
			6,
			4,
			0,
			.None,
			true,
			CT4_LOGITS[:],
			CT4_TARGETS[:],
			CT4_IL[:],
			CT4_TL[:],
			CT4_NONE_UP[:],
			CT4_NONE_LOSS[:],
			CT4_NONE_DLOGITS[:],
		},
		{
			"2 impossible of 3, mean (+inf)",
			3,
			6,
			4,
			0,
			.Mean,
			false,
			CT5_LOGITS[:],
			CT5_TARGETS[:],
			CT5_IL[:],
			CT5_TL[:],
			nil,
			CT5_MEAN_LOSS[:],
			CT5_MEAN_DLOGITS[:],
		},
		{
			"2 impossible of 3, per sample (+inf)",
			3,
			6,
			4,
			0,
			.None,
			false,
			CT5_LOGITS[:],
			CT5_TARGETS[:],
			CT5_IL[:],
			CT5_TL[:],
			CT5_NONE_UP[:],
			CT5_NONE_LOSS[:],
			CT5_NONE_DLOGITS[:],
		},
	}
	for c in cases {
		x := leaf(c.logits, {c.N, c.T, c.C, 1})
		loss := t.tensor_ctc_loss(
			t.tensor_log_softmax(x),
			c.targets,
			c.il,
			c.tl,
			c.blank,
			c.reduction,
			c.zero_infinity,
		)
		if c.up != nil {t.tensor_backward_with_grad(loss, c.up)} else {t.tensor_backward(loss)}
		d := max(diff(loss.data.data, c.loss), diff(x.grad.data, c.dlogits))
		expect(
			&passed,
			&total,
			d < 1e-9,
			fmt.tprintf(
				"%s: loss %v, loss and logit gradient vs torch %.1e",
				c.name,
				c.loss if len(c.loss) <= 3 else c.loss[:1],
				d,
			),
		)
	}

	// the gradient with respect to log_probs: torch's ctc_loss returns
	// exp(log_probs) - posterior on the steps a sample uses, this the derivative
	// -posterior; outside the used steps both are 0. Both are scaled by the mean
	// reduction's 1 / (N · max(target length, 1)).
	{
		lsm := t.tensor_log_softmax(leaf(CT1_LOGITS[:], {4, 12, 6, 1}))
		lp := leaf(lsm.data.data, {4, 12, 6, 1})
		t.tensor_backward(t.tensor_ctc_loss(lp, CT1_TARGETS[:], CT1_IL[:], CT1_TL[:]))
		want := make([]f64, len(CT1_DLP_TORCH), context.temp_allocator)
		for b in 0 ..< 4 {
			scale := 1 / (4 * f64(max(CT1_TL[b], 1)))
			for s in 0 ..< 12 {
				for k in 0 ..< 6 {
					i := (b * 12 + s) * 6 + k
					want[i] = CT1_DLP_TORCH[i]
					if s < CT1_IL[b] {want[i] -= scale * math.exp(lp.data.data[i])}
				}
			}
		}
		d := diff(lp.grad.data, want)
		expect(
			&passed,
			&total,
			d < 1e-9,
			fmt.tprintf(
				"gradient with respect to log_probs = torch's minus exp(log_probs) (scaled as the loss) on the used steps: %.1e",
				d,
			),
		)
	}

	// log_softmax alone
	{
		x := leaf(LS_X[:], {3, 4, 7, 1})
		y := t.tensor_log_softmax(x)
		t.tensor_backward_with_grad(y, LS_UP[:])
		d := max(diff(y.data.data, LS_Y[:]), diff(x.grad.data, LS_DX[:]))
		expect(
			&passed,
			&total,
			y.shape == x.shape && d < 1e-13,
			fmt.tprintf(
				"tensor_log_softmax (rows of 7, logits with standard deviation 20): output and gradient vs torch %.1e",
				d,
			),
		)
	}

	fmt.printf("CTC loss: %d/%d passed\n", passed, total)
	record_failures(total - passed)
}
