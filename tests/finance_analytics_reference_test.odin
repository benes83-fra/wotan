@(private = "file")
FA_COV := [?]f64 {
	0.04349059023691864,
	0.010735632738789759,
	0.0049253293212199985,
	-0.005158075817439268,
	-0.011756703606635202,
	0.010735632738789759,
	0.059975015152817834,
	0.022324086469938872,
	-0.004103632146893331,
	-0.011588580498522204,
	0.0049253293212199985,
	0.022324086469938872,
	0.05399784306268385,
	-0.009143369427293263,
	-0.00499736339895405,
	-0.005158075817439268,
	-0.004103632146893331,
	-0.009143369427293263,
	0.02601969224017489,
	0.0016478738028457502,
	-0.011756703606635202,
	-0.011588580498522204,
	-0.00499736339895405,
	0.0016478738028457502,
	0.06233457478801801,
}
@(private = "file")
FA_WTS := [?]f64{0.3, 0.25, -0.1, 0.35, 0.2}
@(private = "file")
FA_MCTR := [?]f64 {
	0.10672631981538135,
	0.1177646684051353,
	-0.024469837550306246,
	0.07490251773191153,
	0.06856337583304463,
}
@(private = "file")
FA_CTR := [?]f64 {
	0.032017895944614405,
	0.029441167101283826,
	0.0024469837550306246,
	0.026215881206169037,
	0.013712675166608927,
}
@(private = "file")
FA_VOL :: 0.10383460317370682

// Column from a slice; NaN becomes null
@(private = "file")
_fa_col :: proc(name: string, x: []f64) -> w.Column {
	c := w.column_new(name, .Float, len(x))
	for v in x {
		if math.is_nan(v) {w.append_null(&c)} else {w.append_float(&c, v)}
	}
	return c
}

// Max relative error against a reference (NaN = null) and whether the nulls match
@(private = "file")
_fa_err :: proc(c: ^w.Column, ref: []f64) -> (worst: f64, nulls_ok: bool) {
	nulls_ok = c.len == len(ref)
	for i in 0 ..< min(c.len, len(ref)) {
		v, is_null := w.column_at_float(c, i)
		if is_null != math.is_nan(ref[i]) {
			nulls_ok = false
			continue
		}
		if !is_null {worst = max(worst, abs(v - ref[i]) / max(abs(ref[i]), 1e-300))}
	}
	return
}

finance_analytics_reference_test :: proc(allocator: mem.Allocator) {
	seed_test(#procedure)
	fmt.println(
		"\n=== Finance analytics: risk decomposition, rolling vol / Sharpe / beta (numpy / pandas reference) ===",
	)
	context.allocator = allocator
	passed, total := 0, 0
	expect :: proc(passed, total: ^int, ok: bool, name: string) {
		total^ += 1
		if ok {passed^ += 1}
		fmt.printf("%s %s\n", "OK  " if ok else "FAIL", name)
	}

	df := w.dataframe_new()
	defer w.destroy_dataframe(&df)
	w.add_column(&df, _fa_col("r", FA_R[:]))
	w.add_column(&df, _fa_col("b", FA_B[:]))
	w.add_column(&df, _fa_col("r_full", FA_R_FULL[:]))
	w.add_column(&df, _fa_col("tb", FA_TB[:]))
	df.rows = len(FA_R)

	// 1. Risk decomposition (5 assets, one short) and the zero-variance case
	{
		n := len(FA_WTS)
		cov := l.matrix_new(f64, n, n)
		defer l.matrix_free(&cov)
		copy(cov.data, FA_COV[:])
		d := fin.risk_decomposition(FA_WTS[:], &cov)
		defer {delete(d.mctr); delete(d.ctr)}
		worst, sum := abs(d.total_risk - FA_VOL) / FA_VOL, 0.0
		for i in 0 ..< n {
			worst = max(
				worst,
				abs(d.mctr[i] - FA_MCTR[i]) / abs(FA_MCTR[i]),
				abs(d.ctr[i] - FA_CTR[i]) / abs(FA_CTR[i]),
			)
			sum += d.ctr[i]
		}
		zero := []f64{0, 0, 0, 0, 0}
		z := fin.risk_decomposition(zero, &cov)
		defer {delete(z.mctr); delete(z.ctr)}
		expect(
			&passed,
			&total,
			worst < 1e-13 &&
			abs(sum - d.total_risk) < 1e-15 &&
			z.total_risk == 0 &&
			z.mctr[0] == 0,
			fmt.tprintf(
				"risk_decomposition vs numpy: max rel err %.1e, Σ CTR - σ = %.1e; zero weights give σ = MCTR = 0",
				worst,
				sum - d.total_risk,
			),
		)
	}

	// 2. Rolling and EWM volatility wrappers
	{
		vol := fin.rolling_volatility(&df, "r", FA_WIN, FA_MINP)
		ewm := fin.ewma_rolling_volatility(&df, "r_full", 0.06, FA_MINP)
		defer {w.destroy_column(&vol); w.destroy_column(&ewm)}
		e1, n1 := _fa_err(&vol, FA_ROLL_VOL[:])
		e2, n2 := _fa_err(&ewm, FA_EWM_VOL[:])
		expect(
			&passed,
			&total,
			e1 < 1e-12 && e2 < 1e-12 && n1 && n2,
			fmt.tprintf(
				"rolling_volatility (with nulls) / ewma_rolling_volatility vs pandas: max rel err %.1e / %.1e, nulls match %v / %v",
				e1,
				e2,
				n1,
				n2,
			),
		)
	}

	// 3. Rolling Sharpe with nulls
	{
		sh := fin.rolling_sharpe(&df, "r", FA_WIN, FA_RF)
		defer w.destroy_column(&sh)
		e, nm := _fa_err(&sh, FA_SHARPE[:])
		const := w.dataframe_new()
		defer w.destroy_dataframe(&const)
		cc := w.column_new("c", .Float, 10)
		for _ in 0 ..< 10 {w.append_float(&cc, 0.0004)}
		w.add_column(&const, cc)
		const.rows = 10
		cs := fin.rolling_sharpe(&const, "c", 5)
		defer w.destroy_column(&cs)
		_, c_null := w.column_at_float(&cs, 9)
		expect(
			&passed,
			&total,
			e < 1e-12 && nm && c_null,
			fmt.tprintf(
				"rolling_sharpe vs pandas rolling mean / std of the excess returns: max rel err %.1e, nulls match %v; a constant series gives null: %v",
				e,
				nm,
				c_null,
			),
		)
	}

	// 4. Rolling beta on pairwise-complete rows
	{
		b1 := fin.rolling_beta(&df, "r", "b", FA_WIN)
		b2 := fin.rolling_beta_df(&df, "r", "b", FA_WIN, FA_MINP)
		defer {w.destroy_column(&b1); w.destroy_column(&b2)}
		e1, n1 := _fa_err(&b1, FA_BETA_FULL[:])
		e2, n2 := _fa_err(&b2, FA_BETA_MINP[:])
		dp, _ := _fa_err(&b2, FA_BETA_PANDAS[:])
		expect(
			&passed,
			&total,
			e1 < 1e-12 && e2 < 1e-12 && n1 && n2,
			fmt.tprintf(
				"rolling_beta / rolling_beta_df vs numpy OLS slope on pairwise-complete rows: max rel err %.1e / %.1e, nulls match %v / %v (the old pandas-style cov / var(b) differed by up to %.1f%% with nulls)",
				e1,
				e2,
				n1,
				n2,
				100 * dp,
			),
		)
	}

	// 5. Beta against a low-volatility benchmark (daily std 4e-6, variance 1.6e-11)
	{
		bt := fin.rolling_beta(&df, "r_full", "tb", FA_WIN)
		defer w.destroy_column(&bt)
		e, nm := _fa_err(&bt, FA_BETA_TB[:])
		expect(
			&passed,
			&total,
			e < 1e-9 && nm,
			fmt.tprintf(
				"rolling_beta against a T-bill-like benchmark: max rel err %.1e, nulls match %v (the old absolute var > 1e-10 cut-off returned null everywhere)",
				e,
				nm,
			),
		)
	}

	fmt.printf("Finance analytics summary: %d/%d passed\n", passed, total)
	record_failures(total - passed)
}
