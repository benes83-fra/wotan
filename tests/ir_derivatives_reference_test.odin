package tests

// Generated by gen_ir_test.py: QuantLib HullWhite / G2 bond options (caplets, floorlets,
// Jamshidian swaptions, finite-difference Greeks) and FdHullWhite / FdG2 Bermudan
// swaption engines, flat 4% continuously compounded curve; the same models on a
// ZeroCurve with linear zeros (ir_curve_ql.py: caps, Jamshidian / G2SwaptionEngine
// swaptions with annual and 0.4-year payments, payer and receiver Bermudans).

import fin "../wotan/finance"
import "core:fmt"
import "core:math"
import "core:mem"

@(private = "file")
IR_TS := [?]f64{0.5, 1.0, 1.5, 2.0, 2.5, 3.0, 3.5, 4.0, 4.5}
@(private = "file")
IR_TE := [?]f64{1.0, 1.5, 2.0, 2.5, 3.0, 3.5, 4.0, 4.5, 5.0}
@(private = "file")
IR_KS := [?]f64{0.03, 0.04, 0.05, 0.03, 0.04, 0.05, 0.03, 0.04, 0.05}
@(private = "file")
IR_CAP1 := [?]f64 {
	0.005197494192690759,
	0.0022630779926237797,
	0.0009302880081471598,
	0.00578132719463364,
	0.003137431964481312,
	0.0015547505469959656,
	0.006005617795150524,
	0.003521182197418964,
	0.001897499585906556,
}
@(private = "file")
IR_FLR1 := [?]f64 {
	0.0002001016255432898,
	0.0020734630962342517,
	0.005360009470200061,
	0.0010749601144966522,
	0.002958859380022465,
	0.005726505113614377,
	0.001573328197049149,
	0.0033530088707050478,
	0.005826310079565974,
}
@(private = "file")
IR_CAP2 := [?]f64 {
	0.0050225169503561,
	0.0014841429004145146,
	0.00028906811614612046,
	0.0050490992200675445,
	0.002020047950456666,
	0.0005945050703626831,
	0.005022649482352573,
	0.0022569320488901455,
	0.0007918025989571412,
}
@(private = "file")
IR_MC_CAP1 := [?]f64{0.021845930728228963, 1.6996049103514377, 2.417286362319593}
@(private = "file")
IR_MC_FLR1 := [?]f64{0.039723616022112836, -2.812182306074166, 2.4172863623198384}
@(private = "file")
IR_MC_CAP2 := [?]f64{0.01136902800630573, 1.4957414336830548, 1.1583487098613303}
@(private = "file")
IR_SWPT := [?]f64{0.019829864479332545, 1.8981410084634252, 1.8408213628636332}
@(private = "file")
IR_SCAL := [?]f64 {
	0.00016330870767073373,
	0.004632390640155242,
	0.04321658747000373,
	0.027606824651303662,
	0.8133832813224879,
	0.042204309884294446,
	0.027586510040113862,
}

// QuantLib 1.44: ZeroCurve linear zeros [0.025, 0.028, 0.031, 0.034, 0.036, 0.037, 0.038] at [1, 2, 3, 5, 7, 10, 15] y (continuous, Act/365F)
@(private = "file")
IR_CURVE_QL := [?]struct {
	k: string,
	v: f64,
} {
	{"CAP_HW", 0.01839368355601616},
	{"FLR_HW", 0.05117648833318499},
	{"CAP_G2", 0.00889003868003077},
	{"CAP_HW_DR", 1.3918221179715085},
	{"F_A", 0.03987279339242298},
	{"ANN_A", 4.220782731852219},
	{"SW_HW_A_PAY", 0.03178400985755762},
	{"SW_G2_A_PAY", 0.023942243900482305},
	{"SW_HW_A_REC", 0.015437790382739507},
	{"SW_G2_A_REC", 0.007596024449363776},
	{"F_Q", 0.03872828694805275},
	{"ANN_Q", 3.4846594196440366},
	{"SW_HW_Q_PAY", 0.024122821241021615},
	{"SW_G2_Q_PAY", 0.017285233968354418},
	{"SW_HW_Q_REC", 0.014615670427993745},
	{"SW_G2_Q_REC", 0.0077780831663454885},
	{"BER_HW_PAY", 0.058592505652139394},
	{"BER_G2_PAY", 0.043152474301210005},
	{"BER_HW_REC", 0.03135017565358991},
	{"BER_G2_REC", 0.01658275077346808},
	{"P5", 0.8436648165963837},
	{"F0_4", 0.03850000000070705},
}

@(private = "file")
_ir_tensors :: proc(
	Ts, Te, K: []f64,
	r0: f64,
	allocator: mem.Allocator,
) -> (
	ts, te, f, k, p: [dynamic]f64,
) {
	for i in 0 ..< len(Ts) {
		d := Te[i] - Ts[i]
		append(&ts, Ts[i])
		append(&te, Te[i])
		append(&f, (math.exp(r0 * d) - 1.0) / d) // simple forward on the flat curve
		append(&k, K[i])
		append(&p, math.exp(-r0 * Te[i]))
	}
	return
}

ir_derivatives_reference_test :: proc(allocator: mem.Allocator) {
	seed_test(#procedure)
	fmt.println(
		"\n=== IR derivatives: Hull-White / G2++ caplets, floors, swaptions, Bermudans (QuantLib reference) ===",
	)
	context.allocator = allocator
	passed, total := 0, 0
	expect :: proc(passed, total: ^int, ok: bool, name: string) {
		total^ += 1
		if ok {passed^ += 1}
		fmt.printf("%s %s\n", "OK  " if ok else "FAIL", name)
	}
	r0 := 0.04
	hw := fin.HW_Params {
		a     = 0.08,
		sigma = 0.012,
	}
	g2 := fin.HW2_Params {
		a     = 0.15,
		b     = 0.02,
		sigma = 0.008,
		eta   = 0.006,
		rho   = -0.4,
	}
	n := len(IR_TS)
	ts, te, f, k, p := _ir_tensors(IR_TS[:], IR_TE[:], IR_KS[:], r0, allocator)
	Ts, Te :=
		fin._make_const_tensor(ts[:], n, allocator), fin._make_const_tensor(te[:], n, allocator)
	F, K, P :=
		fin._make_const_tensor(f[:], n, allocator),
		fin._make_const_tensor(k[:], n, allocator),
		fin._make_const_tensor(p[:], n, allocator)
	rel :: proc(x, y: f64) -> f64 {return abs(x - y) / abs(y)}

	// 1. HW 1F caplets / floorlets (semi-annual, strikes 3–5%), parity, strip pricer
	{
		cap := fin.hull_white_caplet_price_tensor(hw.a, hw.sigma, Ts, Te, F, K, P, allocator)
		flr := fin.hull_white_floorlet_price_tensor(hw.a, hw.sigma, Ts, Te, F, K, P, allocator)
		wc, wf, wp := 0.0, 0.0, 0.0
		for i in 0 ..< n {
			c, fl := cap.data.data[i], flr.data.data[i]
			wc = max(wc, rel(c, IR_CAP1[i]))
			wf = max(wf, rel(fl, IR_FLR1[i]))
			d := te[i] - ts[i]
			wp = max(wp, abs(c - fl - (math.exp(-r0 * ts[i]) - (1.0 + d * k[i]) * p[i])))
		}
		strip := fin.hw_price_cap_floor_strip(
			r0,
			0.045,
			[]f64{1, 2, 3, 4, 5},
			[]f64{2, 3, 4, 5, 6},
			[]f64{1, 1, 1, 1, 1},
			hw,
			true,
			allocator,
		)
		ws := rel(strip.total_price, IR_MC_CAP1[0])
		expect(
			&passed,
			&total,
			wc < 1e-12 && wf < 1e-12 && wp < 1e-15 && ws < 1e-12,
			fmt.tprintf(
				"HW1F caplets / floorlets vs QuantLib (1+δK)·ZBP / ZBC: max rel err %.1e / %.1e, cap − floor parity %.1e, 5Y cap strip %.6f (%.6f); old formula applied Black to the rate with the bond-price vol: ATM 1Y caplet %.6f vs %.6f",
				wc,
				wf,
				wp,
				strip.total_price,
				IR_MC_CAP1[0],
				IR_SCAL[0],
				IR_SCAL[1],
			),
		)
		delete(strip.leg_prices)
	}

	// 2. G2++ caplets
	{
		cap := fin.hull_white_2f_caplet_price_tensor(g2, Ts, Te, F, K, P, allocator)
		w := 0.0
		for i in 0 ..< n {w = max(w, rel(cap.data.data[i], IR_CAP2[i]))}
		expect(
			&passed,
			&total,
			w < 1e-12,
			fmt.tprintf("G2++ caplets vs QuantLib G2.discountBondOption: max rel err %.1e", w),
		)
	}

	NP :: 100000
	ms, me, md := []f64{1, 2, 3, 4, 5}, []f64{2, 3, 4, 5, 6}, []f64{1, 1, 1, 1, 1}

	// 3. HW 1F Monte Carlo cap and floor with Greeks
	{
		c, cd, cv := fin.hw_mc_cap_option(r0, 0.045, ms, me, md, 5, hw, NP)
		fl, fd, fv := fin.hw_mc_floor_option(r0, 0.045, ms, me, md, 5, hw, NP)
		rc, rf := IR_MC_CAP1, IR_MC_FLR1
		ok :=
			abs(c - rc[0]) < 3e-4 &&
			abs(fl - rf[0]) < 3e-4 &&
			abs(cd - rc[1]) < 0.01 &&
			abs(fd - rf[1]) < 0.01 &&
			abs(cv - rc[2]) < 0.03 &&
			abs(fv - rf[2]) < 0.03
		expect(
			&passed,
			&total,
			ok,
			fmt.tprintf(
				"HW1F MC 5Y cap / floor (K = 4.5%%, %d paths) vs QuantLib: cap %.6f (%.6f; old Vasicek-to-r0 Euler with flat discounting 0.022672), ∂/∂r0 %.4f (%.4f), vega %.4f (%.4f); floor %.6f (%.6f), ∂/∂r0 %.4f (%.4f), vega %.4f (%.4f)",
				NP,
				c,
				rc[0],
				cd,
				rc[1],
				cv,
				rc[2],
				fl,
				rf[0],
				fd,
				rf[1],
				fv,
				rf[2],
			),
		)
	}

	// 4. G2++ Monte Carlo cap, HW 1F Monte Carlo swaption, G2++ bond
	{
		c, cd, cv := fin.hw2_mc_cap_option(r0, 0.045, ms, me, md, 5, g2, NP)
		s, sd, sv := fin.hw_mc_swaption_option(r0, 0.042, 2, 7, 1, true, hw, NP)
		zcb := fin.hw2f_zero_coupon_bond(3, 8, IR_SCAL[5], -0.002, g2, r0)
		rc, rs := IR_MC_CAP2, IR_SWPT
		ok :=
			abs(c - rc[0]) < 2e-4 &&
			abs(cd - rc[1]) < 0.01 &&
			abs(cv - rc[2]) < 0.03 &&
			abs(s - rs[0]) < 3.5e-4 &&
			abs(sd - rs[1]) < 0.01 &&
			abs(sv - rs[2]) < 0.03 &&
			rel(zcb, IR_SCAL[4]) < 1e-12
		expect(
			&passed,
			&total,
			ok,
			fmt.tprintf(
				"G2++ MC cap %.6f (QuantLib %.6f; old 0.020719), ∂/∂r0 %.4f (%.4f), vega %.4f (%.4f); HW1F MC 2Y×5Y payer swaption %.6f (Jamshidian %.6f; old 0.022964), ∂/∂r0 %.4f (%.4f), vega %.4f (%.4f); G2++ P(3,8) %.10f (%.10f)",
				c,
				rc[0],
				cd,
				rc[1],
				cv,
				rc[2],
				s,
				rs[0],
				sd,
				rs[1],
				sv,
				rs[2],
				zcb,
				IR_SCAL[4],
			),
		)
	}

	// 5. Bermudan payer swaptions (exercise 1Y–5Y into the swap to 10Y)
	{
		ex := []f64{1, 2, 3, 4, 5}
		b1 := fin.hw2f_mc_bermudan_option(
			r0,
			0.0408,
			ex,
			10,
			1,
			fin.HW2_Params{a = hw.a, b = hw.a, sigma = hw.sigma},
			NP,
		)
		b2 := fin.hw2f_mc_bermudan_option(r0, 0.0408, ex, 10, 1, g2, NP)
		ok := abs(b1 - IR_SCAL[2]) < 3e-4 && abs(b2 - IR_SCAL[3]) < 3e-4
		expect(
			&passed,
			&total,
			ok,
			fmt.tprintf(
				"Bermudan 1Y–5Y into 10Y (K = 4.08%%, LSM, %d paths): HW1F (η = 0) %.6f vs FdHullWhiteSwaptionEngine %.6f (old 0.042566); G2++ %.6f vs FdG2SwaptionEngine %.6f (coarser grid %.6f; old 0.024755)",
				NP,
				b1,
				IR_SCAL[2],
				b2,
				IR_SCAL[3],
				IR_SCAL[6],
			),
		)
	}

	// 6. On a non-flat curve (ZeroCurve, linear zeros 2.5% … 3.8%): cap strip,
	// Monte Carlo caps / floors / swaptions with the parallel-shift delta,
	// swaptions paying every 0.4 years, payer and receiver Bermudans
	{
		curve := fin.YieldCurve {
			tenors        = []f64{1, 2, 3, 5, 7, 10, 15},
			zero_rates    = []f64{0.025, 0.028, 0.031, 0.034, 0.036, 0.037, 0.038},
			interpolation = .LinearZero,
		}
		Q :: proc(k: string) -> f64 {
			for e in IR_CURVE_QL {if e.k == k {return e.v}}
			panic(k)
		}
		strip := fin.hw_price_cap_floor_strip(&curve, 0.045, ms, me, md, hw, true, allocator)
		fstrip := fin.hw_price_cap_floor_strip(&curve, 0.045, ms, me, md, hw, false, allocator)
		c, cd, _ := fin.hw_mc_cap_option(&curve, 0.045, ms, me, md, 5, hw, NP)
		fl, _, _ := fin.hw_mc_floor_option(&curve, 0.045, ms, me, md, 5, hw, NP)
		c2, _, _ := fin.hw2_mc_cap_option(&curve, 0.045, ms, me, md, 5, g2, NP)
		ok :=
			rel(fin.rate_curve_discount(&curve, 5), Q("P5")) < 1e-14 &&
			abs(fin.rate_curve_forward(&curve, 4) - Q("F0_4")) < 1e-9 &&
			rel(strip.total_price, Q("CAP_HW")) < 1e-12 &&
			rel(fstrip.total_price, Q("FLR_HW")) < 1e-12 &&
			abs(c - Q("CAP_HW")) < 3e-4 &&
			abs(fl - Q("FLR_HW")) < 3e-4 &&
			abs(cd - Q("CAP_HW_DR")) < 0.01 &&
			abs(c2 - Q("CAP_G2")) < 2e-4
		expect(
			&passed,
			&total,
			ok,
			fmt.tprintf(
				"curve: P(5) and f(0,4) = QuantLib ZeroCurve; HW1F cap strip %.10f (%.10f), floor %.10f (%.10f); MC cap %.6f, ∂/∂shift %.4f (QuantLib ±1bp %.4f), floor %.6f; G2++ MC cap %.6f (%.6f)",
				strip.total_price,
				Q("CAP_HW"),
				fstrip.total_price,
				Q("FLR_HW"),
				c,
				cd,
				Q("CAP_HW_DR"),
				fl,
				c2,
				Q("CAP_G2"),
			),
		)
		delete(strip.leg_prices)
		delete(fstrip.leg_prices)

		msg := ""
		ok = true
		for k in 0 ..< 2 {
			d := 1.0 if k == 0 else 0.4
			n := 5 if k == 0 else 10
			tag := "A" if k == 0 else "Q"
			p, _, _ := fin.hw_mc_swaption_option(&curve, 0.036, 2, 2 + f64(n) * d, d, true, hw, NP)
			r, _, _ := fin.hw_mc_swaption_option(
				&curve,
				0.036,
				2,
				2 + f64(n) * d,
				d,
				false,
				hw,
				NP,
			)
			spec := []fin.SwaptionSpec {
				{
					T_exp = 2,
					swap_length = n,
					F = Q(fmt.tprintf("F_%s", tag)),
					K = 0.036,
					annuity = Q(fmt.tprintf("ANN_%s", tag)),
					delta = d,
				},
			}
			g := fin.hw2f_swaption_price_strip(g2, spec, 1, &curve, allocator)
			qp, qr := Q(fmt.tprintf("SW_HW_%s_PAY", tag)), Q(fmt.tprintf("SW_HW_%s_REC", tag))
			qg := Q(fmt.tprintf("SW_G2_%s_PAY", tag))
			ok = ok && abs(p - qp) < 3.5e-4 && abs(r - qr) < 3.5e-4 && rel(g[0], qg) < 3e-3
			msg = fmt.tprintf(
				"%s; every %.1fy: HW payer %.6f (Jamshidian %.6f), receiver %.6f (%.6f), G2++ frozen-weights payer %.6f (G2SwaptionEngine %.6f)",
				msg,
				d,
				p,
				qp,
				r,
				qr,
				g[0],
				qg,
			)
			delete(g, allocator)
		}
		expect(&passed, &total, ok, fmt.tprintf("curve: 2Y swaptions, K = 3.6%%%s", msg))

		ex := []f64{1, 2, 3, 4, 5}
		h1 := fin.HW2_Params {
			a     = hw.a,
			b     = hw.a,
			sigma = hw.sigma,
		}
		bp := fin.hw2f_mc_bermudan_option(&curve, 0.036, ex, 10, 1, h1, NP)
		br := fin.hw2f_mc_bermudan_option(&curve, 0.036, ex, 10, 1, h1, NP, is_payer = false)
		gp := fin.hw2f_mc_bermudan_option(&curve, 0.036, ex, 10, 1, g2, NP)
		gr := fin.hw2f_mc_bermudan_option(&curve, 0.036, ex, 10, 1, g2, NP, is_payer = false)
		ok =
			abs(bp - Q("BER_HW_PAY")) < 3e-4 &&
			abs(br - Q("BER_HW_REC")) < 3e-4 &&
			abs(gp - Q("BER_G2_PAY")) < 3e-4 &&
			abs(gr - Q("BER_G2_REC")) < 3e-4
		expect(
			&passed,
			&total,
			ok,
			fmt.tprintf(
				"curve: Bermudan 1Y–5Y into 10Y (K = 3.6%%): HW1F payer %.6f / receiver %.6f vs FdHullWhiteSwaptionEngine %.6f / %.6f; G2++ %.6f / %.6f vs FdG2SwaptionEngine %.6f / %.6f",
				bp,
				br,
				Q("BER_HW_PAY"),
				Q("BER_HW_REC"),
				gp,
				gr,
				Q("BER_G2_PAY"),
				Q("BER_G2_REC"),
			),
		)
	}

	fmt.printf("IR derivatives summary: %d/%d passed\n", passed, total)
	record_failures(total - passed)
}
