package tests

// Generated by gen_credit_test.py: scipy quad CDS legs (continuous default, accrual on
// default), brentq bootstrap, scipy.stats.t CDF, semi-analytic Gaussian / Student-t
// copula expected tranche losses.

import fin "../wotan/finance"
import "core:fmt"
import "core:math"
import "core:mem"

@(private = "file")
CR_CDS := [?]f64{1986.6454778404845, 1924.7755368987512, 0.012045074929081225}
@(private = "file")
CR_TEN := [?]f64{1.0, 3.0, 5.0, 7.0, 10.0}
@(private = "file")
CR_SPR := [?]f64{0.004, 0.006, 0.008, 0.0095, 0.011}
@(private = "file")
CR_SPR_D := [?]f64{0.03, 0.05, 0.08, 0.1, 0.12}
@(private = "file")
CR_HZ := [?]f64 {
	0.006641704835055823,
	0.011725334957418603,
	0.018848400565528976,
	0.023153575562620207,
	0.025804665996258393,
}
@(private = "file")
CR_HZ_D := [?]f64 {
	0.04981312353589013,
	0.10270265248078785,
	0.25168062535520025,
	0.3890661930894263,
	1.2446672317117942,
}
@(private = "file")
CR_FULL := [?]f64{-0.009009104428023842, 450.4552214011923, 0.01440527946799297, 916.8338815910604}
@(private = "file")
CR_TX := [?]f64{-6.0, -2.5, -0.3, 0.7, 3.2}
@(private = "file")
CR_TCDF := [?]f64 {
	0.002482285650369513,
	0.035911011455913376,
	0.39013374356573116,
	0.7372869730284121,
	0.9816299196452201,
	6.143423053782546e-08,
	0.00758539011744426,
	0.38260703760672976,
	0.7566836675072439,
	0.9989013647280843,
}
@(private = "file")
CR_CDO := [?]f64 {
	0.5548043673598259,
	0.7169001544302586,
	0.3127614560876059,
	0.39829390686294164,
	0.42648830689083805,
	0.6124079051823017,
	0.2719462438907797,
	0.3541118944629203,
}

credit_derivatives_reference_test :: proc(allocator: mem.Allocator) {
	seed_test(#procedure)
	fmt.println(
		"\n=== Credit derivatives: CDS legs, bootstrap, upfront, Student-t CDF, copula CDO tranches (scipy reference) ===",
	)
	context.allocator = allocator
	passed, total := 0, 0
	expect :: proc(passed, total: ^int, ok: bool, name: string) {
		total^ += 1
		if ok {passed^ += 1}
		fmt.printf("%s %s\n", "OK  " if ok else "FAIL", name)
	}
	rel :: proc(x, y: f64) -> f64 {return abs(x - y) / max(abs(y), 1e-300)}
	R, r, freq := 0.4, 0.03, 0.25

	// 1. Flat-hazard CDS
	{
		p := fin.CDS_Params {
			lambda   = 0.02,
			recovery = R,
			r        = r,
		}
		v5 := fin.price_cds(1e7, 0.012, 5, p, freq)
		v49 := fin.price_cds(1e7, 0.012, 4.9, p, freq)
		par := fin.price_cds(1e7, CR_CDS[2], 5, p, freq)
		ok := rel(v5, CR_CDS[0]) < 1e-9 && rel(v49, CR_CDS[1]) < 1e-9 && abs(par) < 1e-6
		expect(
			&passed,
			&total,
			ok,
			fmt.tprintf(
				"5Y CDS at 120bp (λ = 2%%, R = 40%%) vs scipy quad legs with accrual on default: PV $%.4f ($%.4f; old $3311.08: continuous protection against coupons without accrual), 4.9Y stub $%.4f ($%.4f), PV at the par spread %.2fbp = %.1e",
				v5,
				CR_CDS[0],
				v49,
				CR_CDS[1],
				1e4 * CR_CDS[2],
				par,
			),
		)
	}

	// 2. Bootstrap: investment grade and distressed
	{
		cv := fin.bootstrap_cds_curve(CR_TEN[:], CR_SPR[:], R, r, freq)
		cd := fin.bootstrap_cds_curve(CR_TEN[:], CR_SPR_D[:], R, r, freq)
		defer {delete(cv.tenors); delete(cv.hazards); delete(cd.tenors); delete(cd.hazards)}
		wh, wd, wp := 0.0, 0.0, 0.0
		for i in 0 ..< len(CR_TEN) {
			wh = max(wh, rel(cv.hazards[i], CR_HZ[i]))
			wd = max(wd, rel(cd.hazards[i], CR_HZ_D[i]))
			res := fin.price_cds_full(1.0, CR_SPR_D[i], CR_TEN[i], cd, freq)
			wp = max(wp, abs(res.upfront_pct))
		}
		expect(
			&passed,
			&total,
			wh < 1e-9 && wd < 1e-9 && wp < 1e-13,
			fmt.tprintf(
				"bootstrap vs scipy brentq: 40–110bp hazards max rel err %.1e; distressed 300–1200bp max rel err %.1e, 10Y hazard %.4f (old bracket capped it at 0.5); every distressed quote reprices to %.1e upfront",
				wh,
				wd,
				cd.hazards[4],
				wp,
			),
		)
	}

	// 3. Upfront and RPV01 on the bootstrapped curve, inside and beyond the last tenor
	{
		cv := fin.bootstrap_cds_curve(CR_TEN[:], CR_SPR[:], R, r, freq)
		defer {delete(cv.tenors); delete(cv.hazards)}
		a := fin.price_cds_full(1e7, 0.01, 5, cv, freq)
		b := fin.price_cds_full(1e7, 0.01, 12, cv, freq)
		z := fin.price_cds_full(1e7, 0.0, 5, cv, freq)
		ok :=
			rel(a.upfront_pct, CR_FULL[0]) < 1e-9 &&
			rel(a.rpv01, CR_FULL[1]) < 1e-9 &&
			rel(b.upfront_pct, CR_FULL[2]) < 1e-9 &&
			rel(b.rpv01, CR_FULL[3]) < 1e-9 &&
			rel(z.rpv01, CR_FULL[1]) < 1e-9
		expect(
			&passed,
			&total,
			ok,
			fmt.tprintf(
				"100bp-coupon CDS: 5Y upfront %.6f%% (%.6f%%), RPV01 $%.4f ($%.4f); 12Y upfront %.6f%% (%.6f%%; old −0.383085%%, survival stopped decaying after 10Y), RPV01 $%.4f; zero coupon RPV01 $%.4f (old: 0/0)",
				100 * a.upfront_pct,
				100 * CR_FULL[0],
				a.rpv01,
				CR_FULL[1],
				100 * b.upfront_pct,
				100 * CR_FULL[2],
				b.rpv01,
				z.rpv01,
			),
		)
	}

	// 4. Student-t CDF
	{
		worst := 0.0
		for x, i in CR_TX {
			worst = max(
				worst,
				rel(fin.student_t_cdf(x, 3.7), CR_TCDF[i]),
				rel(fin.student_t_cdf(x, 60.0), CR_TCDF[5 + i]),
			)
		}
		expect(
			&passed,
			&total,
			worst < 1e-12,
			fmt.tprintf(
				"student_t_cdf vs scipy at ν = 3.7 and 60, x ∈ [−6, 3.2]: max rel err %.1e; F(−2.5; 60) = %.8f (%.8f; old 0.00620967 from the normal approximation above ν = 50)",
				worst,
				fin.student_t_cdf(-2.5, 60),
				CR_TCDF[6],
			),
		)
	}

	// 5. CDO tranches, Gaussian and Student-t (ν = 4.5) copulas
	{
		c := fin.CDO_Params {
			N        = 100,
			lambda   = 0.02,
			recovery = R,
			r        = r,
			rho      = 0.3,
			maturity = 5,
		}
		tr := [2]fin.CDO_Tranche{{"equity", 0.0, 0.03}, {"mezz", 0.03, 0.07}}
		sp := [2]f64{0.05, 0.015}
		NP :: 50000
		got: [8]f64
		for k in 0 ..< 2 {
			got[2 * k], got[2 * k + 1] = fin.price_cdo_tranche_mc(tr[k], c, sp[k], NP)
			got[4 + 2 * k], got[4 + 2 * k + 1] = fin.price_cdo_tranche_t_copula_mc(
				tr[k],
				c,
				4.5,
				sp[k],
				NP,
			)
		}
		worst := 0.0
		for k in 0 ..< 8 {worst = max(worst, abs(got[k] - CR_CDO[k]))}
		expect(
			&passed,
			&total,
			worst < 0.01,
			fmt.tprintf(
				"CDO tranches (N = 100, λ = 2%%, ρ = 0.3, 5Y, %d paths) vs semi-analytic conditional binomial: Gaussian equity PV %.4f (%.4f; old 0.6063), EL %.4f (%.4f); mezz PV %.4f (%.4f); t(4.5) equity PV %.4f (%.4f), mezz PV %.4f (%.4f); max abs err %.4f",
				NP,
				got[0],
				CR_CDO[0],
				got[1],
				CR_CDO[1],
				got[2],
				CR_CDO[2],
				got[4],
				CR_CDO[4],
				got[6],
				CR_CDO[6],
				worst,
			),
		)
	}

	fmt.printf("Credit derivatives summary: %d/%d passed\n", passed, total)
	record_failures(total - passed)
}
