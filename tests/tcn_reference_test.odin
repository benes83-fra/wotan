// Conv1d and TCN against torch (see gen_tcn_test.py): outputs, input and
// parameter gradients of Σ out ⊙ R
tcn_reference_test :: proc(allocator: mem.Allocator) {
	seed_test(#procedure)
	fmt.println("\n=== Conv1d / TCN (torch reference) ===")
	context.allocator = allocator
	passed, total := 0, 0
	expect :: proc(passed, total: ^int, ok: bool, name: string) {
		total^ += 1
		if ok {passed^ += 1}
		fmt.printf("%s %s\n", "OK  " if ok else "FAIL", name)
	}
	TOL :: 1e-12

	// 1-2. Conv1d: dilated causal; symmetric padding without bias
	{
		causal := nn.conv1d_layer_new(3, 4, 3, dilation = 2, causal = true)
		pad := nn.conv1d_layer_new(3, 4, 2, padding = 1, use_bias = false)
		cases := [2]_LtCase {
			{
				TC_CAUSAL_X[:],
				TC_CAUSAL_R[:],
				TC_CAUSAL_OUT[:],
				TC_CAUSAL_DX[:],
				TC_CAUSAL_P[:],
				TC_CAUSAL_DP[:],
			},
			{TC_PAD_X[:], TC_PAD_R[:], TC_PAD_OUT[:], TC_PAD_DX[:], TC_PAD_P[:], TC_PAD_DP[:]},
		}
		layers := [2]^nn.Conv1dLayer{&causal, &pad}
		worst: [2]f64
		t_out: [2]int
		for c, i in cases {
			ps := _lt_params(layers[i]^)
			_lt_load(ps, c.p)
			x := _lt_tensor(c.x, {2, 7, 3, 1}, true)
			out := nn.conv1d_layer_forward(layers[i], x)
			t_out[i] = out.shape[1]
			do_, dx, dp := _lt_check(c, out, x, ps)
			worst[i] = max(do_, dx, dp)
		}
		expect(
			&passed,
			&total,
			max(worst[0], worst[1]) < TOL && t_out == {7, 8},
			fmt.tprintf(
				"Conv1d(3 → 4, k3, dilation 2, causal) %.1e; Conv1d(k2, padding 1, no bias, T 7 → %d) %.1e (output, input and parameter grads)",
				worst[0],
				t_out[1],
				worst[1],
			),
		)
	}

	// 3. TCN: block 3 → 5 (dilation 1, 1×1 downsample), block 5 → 5 (dilation 2)
	{
		c := _LtCase {
			TC_TCN_X[:],
			TC_TCN_R[:],
			TC_TCN_OUT[:],
			TC_TCN_DX[:],
			TC_TCN_P[:],
			TC_TCN_DP[:],
		}
		seq := nn.sequential_new()
		nn.sequential_add_tcn(seq, 3, 5, levels = 2, kernel_size = 3)
		ps := nn.sequential_parameters(seq)
		_lt_load(ps[:], c.p)
		x := _lt_tensor(c.x, {2, 7, 3, 1}, true)
		do_, dx, dp := _lt_check(c, nn.sequential_forward(seq, x), x, ps[:])
		expect(
			&passed,
			&total,
			max(do_, dx, dp) < TOL,
			fmt.tprintf(
				"TCN, 2 residual blocks (3 → 5 with 1×1 downsample, dilations 1, 2): output %.1e, input grad %.1e, all %d parameter grads %.1e",
				do_,
				dx,
				len(ps),
				dp,
			),
		)
	}

	fmt.printf("TCN summary: %d/%d passed\n", passed, total)
	record_failures(total - passed)
}
