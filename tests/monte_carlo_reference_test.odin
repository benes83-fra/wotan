@(private = "file")
MC_CVR := [?]f64{1.119702054086974, 23.895067228213097, 0.9065187624534611}
@(private = "file")
MC_BSG := [?]f64{0.5198747929060461, 0.01593788438397284, 39.844710959932094}
@(private = "file")
MC_MAXJ :: 2

@(private = "file")
_mc_maxdiff :: proc(a, b: []f64) -> f64 {
	if len(a) != len(b) {return math.INF_F64}
	d := 0.0
	for i in 0 ..< len(a) {d = max(d, abs(a[i] - b[i]) / max(abs(b[i]), 1.0))}
	return d
}

// Black-Scholes call, for the CRN finite differences
@(private = "file")
_mc_bs_call :: proc(S: f64) -> f64 {
	K, T, r, s := 105.0, 1.0, 0.03, 0.25
	d1 := (math.ln(S / K) + (r + 0.5 * s * s) * T) / (s * math.sqrt(T))
	N :: proc(x: f64) -> f64 {return 0.5 * math.erfc(-x / math.sqrt_f64(2.0))}
	return S * N(d1) - K * math.exp(-r * T) * N(d1 - s * math.sqrt(T))
}

monte_carlo_reference_test :: proc(allocator: mem.Allocator) {
	seed_test(#procedure)
	fmt.println(
		"\n=== Monte Carlo primitives: path generators, payoff helpers, LSM step, control variate, CRN Greeks (numpy reference) ===",
	)
	context.allocator = allocator
	passed, total := 0, 0
	expect :: proc(passed, total: ^int, ok: bool, name: string) {
		total^ += 1
		if ok {passed^ += 1}
		fmt.printf("%s %s\n", "OK  " if ok else "FAIL", name)
	}
	NP, NS := 5, 4
	S0, R, SIG, T := 100.0, 0.03, 0.25, 1.0
	hp := fin.Heston_Params {
		v0    = 0.04,
		kappa = 1.5,
		theta = 0.05,
		sigma = 0.9,
		rho   = -0.7,
	}
	mp := fin.MJD_Params {
		sigma   = 0.2,
		lambda  = 3.6,
		mu_j    = -0.08,
		sigma_j = 0.15,
	}
	hw := fin.HW_Params {
		a     = 0.1,
		sigma = 0.012,
	}

	// 1. Generators on fixed inputs vs the numpy replicas
	{
		ga := fin.mc_generate_gbm_paths_antithetic(S0, R, SIG, T, NP, NS, MC_ZA[:], allocator)
		hs, hv := fin.mc_generate_heston_paths(S0, R, T, hp, NP, NS, MC_ZH[:], allocator)
		ms := fin.mc_generate_mjd_paths(S0, R, T, mp, NP, NS, MC_ZM[:], MC_UM[:], allocator)
		rw := fin.mc_generate_hw1f_paths(R, T, hw, NP, NS, MC_ZW[:], allocator)
		e := [5]f64 {
			_mc_maxdiff(ga, MC_GA[:]),
			_mc_maxdiff(hs, MC_HS[:]),
			_mc_maxdiff(hv, MC_HV[:]),
			_mc_maxdiff(ms, MC_MS[:]),
			_mc_maxdiff(rw, MC_HW[:]),
		}
		worst := max(e[0], e[1], e[2], e[3], e[4])
		expect(
			&passed,
			&total,
			worst < 1e-13,
			fmt.tprintf(
				"generators on fixed normals vs numpy: antithetic GBM, 5 paths (odd; the last path used to stay 0) %.1e; Heston full truncation %.1e / variance %.1e; Merton with Poisson jump counts (up to %d jumps per step; old: at most one) %.1e; exact Hull-White OU %.1e",
				e[0],
				e[1],
				e[2],
				MC_MAXJ,
				e[3],
				e[4],
			),
		)
	}

	// 2. Martingale and moment checks with many paths
	{
		N, M := 200000, 50
		z := fin.mc_generate_normals(N * M * 2, allocator)
		u := fin.mc_generate_uniforms(N * M, allocator)
		hs, _ := fin.mc_generate_heston_paths(S0, R, T, hp, N, M, z, allocator)
		ms := fin.mc_generate_mjd_paths(S0, R, T, mp, N, M, z, u, allocator)
		rw := fin.mc_generate_hw1f_paths(R, 5.0, hw, N, M, z[:N * M], allocator)
		stat :: proc(paths: []f64, n, m: int, disc: f64) -> (mean, se: f64) {
			s, s2 := 0.0, 0.0
			for p in 0 ..< n {
				x := paths[p * (m + 1) + m] * disc
				s += x
				s2 += x * x
			}
			mean = s / f64(n)
			se = math.sqrt((s2 / f64(n) - mean * mean) / f64(n))
			return
		}
		disc := math.exp(-R * T)
		mh, sh := stat(hs, N, M, disc)
		mm, sm := stat(ms, N, M, disc)
		mr, sr := stat(rw, N, M, 1.0)
		vr := 0.0
		for p in 0 ..< N {vr += (rw[p * (M + 1) + M] - mr) * (rw[p * (M + 1) + M] - mr)}
		vr /= f64(N - 1)
		ok :=
			abs(mh - S0) < 4 * sh &&
			abs(mm - S0) < 4 * sm &&
			abs(mr - MC_HWM[0]) < 4 * sr &&
			abs(vr / MC_HWM[1] - 1) < 0.02
		expect(
			&passed,
			&total,
			ok,
			fmt.tprintf(
				"%d paths × %d steps: Heston E[e^(-rT) S_T] = %.4f ± %.4f, Merton %.4f ± %.4f (S_0 = 100); Hull-White r(5) mean %.6f vs %.6f, variance ratio %.4f",
				N,
				M,
				mh,
				sh,
				mm,
				sm,
				mr,
				MC_HWM[0],
				vr / MC_HWM[1],
			),
		)
	}

	// 3. Payoff helpers
	{
		ga := fin.mc_generate_gbm_paths_antithetic(S0, R, SIG, T, NP, NS, MC_ZA[:], allocator)
		p, k := 3, 2
		want := 0.0
		for s in 0 ..= k {want += MC_GA[p * (NS + 1) + s]}
		want /= f64(k + 1)
		got := fin.mc_compute_asian_average_to_step(ga, p, k, NS)
		mx, mn := MC_GA[p * (NS + 1)], MC_GA[p * (NS + 1)]
		for s in 0 ..= NS {mx = max(mx, MC_GA[p * (NS + 1) + s]); mn = min(mn, MC_GA[p * (NS + 1) + s])}
		ok :=
			abs(got - want) < 1e-12 &&
			fin.mc_compute_lookback_max(ga, p, NS) == mx &&
			fin.mc_compute_lookback_min(ga, p, NS) == mn
		expect(
			&passed,
			&total,
			ok,
			fmt.tprintf(
				"running Asian average of path %d to step %d: %.10f (%.10f; old indexed with stride step + 1, i.e. another path), lookback max / min exact",
				p,
				k,
				got,
				want,
			),
		)
	}

	// 4. LSM step (degree 4) and control variate
	{
		cf := make([]f64, 9)
		copy(cf, MC_CF[:])
		fin.mc_lsm_regression_step(
			MC_LS[:],
			cf,
			9,
			2,
			3,
			2.0 / 3.0,
			0.05,
			100.0,
			.Put,
			4,
			allocator,
		)
		e_lsm := _mc_maxdiff(cf, MC_CF2[:])
		adj, vr := fin.mc_apply_control_variate(MC_PY[:], MC_CV[:], MC_CVR[2], len(MC_PY))
		ok := e_lsm < 1e-10 && abs(adj - MC_CVR[0]) < 1e-12 && abs(vr / MC_CVR[1] - 1) < 1e-10
		expect(
			&passed,
			&total,
			ok,
			fmt.tprintf(
				"LSM put step with a degree-4 basis vs numpy lstsq: max cashflow diff %.1e (old: degrees above 3 left zero columns); control variate %.10f (%.10f), variance ratio %.4f",
				e_lsm,
				adj,
				MC_CVR[0],
				vr,
			),
		)
	}

	// 5. CRN Greeks
	{
		d, g := fin.mc_compute_crn_delta_gamma(100.0, _mc_bs_call)
		vfn :: proc(S, sig: f64) -> f64 {
			K, T, r := 105.0, 1.0, 0.03
			d1 := (math.ln(S / K) + (r + 0.5 * sig * sig) * T) / (sig * math.sqrt(T))
			N :: proc(x: f64) -> f64 {return 0.5 * math.erfc(-x / math.sqrt_f64(2.0))}
			return S * N(d1) - K * math.exp(-r * T) * N(d1 - sig * math.sqrt(T))
		}
		v := fin.mc_compute_crn_vega(100.0, 0.25, vfn)
		ok :=
			abs(d / MC_BSG[0] - 1) < 1e-4 &&
			abs(g / MC_BSG[1] - 1) < 1e-3 &&
			abs(v / MC_BSG[2] - 1) < 1e-4
		expect(
			&passed,
			&total,
			ok,
			fmt.tprintf(
				"CRN finite differences on Black-Scholes (h = 1%%): delta %.6f (%.6f), gamma %.6f (%.6f; old staggered differences gave 3/16 of it), vega %.4f (%.4f)",
				d,
				MC_BSG[0],
				g,
				MC_BSG[1],
				v,
				MC_BSG[2],
			),
		)
	}

	fmt.printf("Monte Carlo primitives summary: %d/%d passed\n", passed, total)
	record_failures(total - passed)
}
