_NB_I_LOSS :: 0.32335617779804043
_NB_I_LAST :: 0.12600593667114598

@(private = "file")
_nb_u :: proc(x: ^u64) -> f64 {
	x^ = 6364136223846793005 * x^ + 1442695040888963407
	return f64(x^ >> 11) * 1.1102230246251565e-16
}

@(private = "file")
_nb_err :: proc(got, want: []f64) -> f64 {
	e := 0.0
	for v, i in want {e = max(e, abs(got[i] - v) / max(abs(v), 1e-3))}
	return e
}

// returns the errors of (forecast, loss and gradients) and (after 10 steps)
@(private = "file")
_nb_case :: proc(
	config: ml_fin.NBeatsConfig,
	seed: u64,
	forecast_ref, after_ref: []f64,
	grads_ref: [][]f64,
	loss_ref, last_ref: f64,
) -> (
	e1, e2: f64,
) {
	x := seed
	I, H := config.input_size, config.horizon
	series := make([]f64, 40)
	defer delete(series)
	for i in 1 ..< 40 {series[i] = series[i - 1] * 0.7 + (_nb_u(&x) - 0.5) + 0.3 * math.sin(f64(i) * 0.9)}
	B :: 5
	Xm := l.matrix_new(f64, B, I)
	Ym := l.matrix_new(f64, B, H)
	for s in 0 ..< B {
		copy(Xm.data[s * I:][:I], series[3 * s:][:I])
		copy(Ym.data[s * H:][:H], series[3 * s + I:][:H])
	}
	X := t.tensor_new(Xm)
	defer t.tensor_free(X)
	Y := t.tensor_new(Ym)
	defer t.tensor_free(Y)
	m := ml_fin.nbeats_new(config)
	defer ml_fin.nbeats_free(m)
	params := ml_fin.nbeats_parameters(m)
	defer delete(params)
	for q, k in params {
		scale := 0.8 if k % 2 == 0 else 0.1
		for &v in q.data.data {v = scale * (_nb_u(&x) - 0.5)}
	}
	f := ml_fin.nbeats_predict(m, X)
	defer delete(f)
	e1 = _nb_err(f, forecast_ref)
	opt := nn.adam_new(0.01)
	defer nn.adam_free(&opt)
	for q in params {nn.adam_add_param(&opt, q)}
	// the first step's gradients are those of the initial weights: compare before stepping
	{
		t.graph_begin(&m.scope)
		alloc := t.graph_allocator(&m.scope)
		loss := t.tensor_mse_loss(ml_fin.nbeats_forward(m, X, alloc), Y, alloc)
		nn.adam_zero_grad(&opt)
		t.tensor_backward(loss)
		e1 = max(e1, abs(loss.data.data[0] - loss_ref) / loss_ref)
		t.graph_end(&m.scope)
		for q, k in params {e1 = max(e1, _nb_err(q.grad.data, grads_ref[k]))}
	}
	last := 0.0
	for _ in 0 ..< 10 {last = ml_fin.nbeats_train_step(m, X, Y, &opt)}
	g := ml_fin.nbeats_predict(m, X)
	defer delete(g)
	e2 = max(abs(last - last_ref) / last_ref, _nb_err(g, after_ref))
	return
}

nbeats_reference_test :: proc(allocator: mem.Allocator) {
	seed_test(#procedure)
	fmt.println("\n=== N-BEATS Reference Checks ===")
	context.allocator = allocator
	passed, total := 0, 0
	expect :: proc(passed, total: ^int, ok: bool, name: string) {
		total^ += 1
		if ok {passed^ += 1}
		fmt.printf("%s %s\n", "OK  " if ok else "FAIL", name)
	}
	{
		e1, e2 := _nb_case(
			{input_size = 8, horizon = 3, blocks = 2, layers = 2, layer_size = 6},
			515,
			_NB_G_FORECAST,
			_NB_G_AFTER,
			_NB_G_GRADS[:],
			_NB_G_LOSS,
			_NB_G_LAST,
		)
		expect(
			&passed,
			&total,
			e1 < 1e-10 && e2 < 1e-9,
			fmt.tprintf(
				"generic (2 blocks): forecasts, MSE and all 12 parameter gradients = torch (error %.1e); after 10 Adam steps loss and forecasts (error %.1e)",
				e1,
				e2,
			),
		)
	}
	{
		e1, e2 := _nb_case(
			{
				input_size = 8,
				horizon = 4,
				interpretable = true,
				blocks = 2,
				layers = 2,
				layer_size = 5,
				seasonality_layer_size = 7,
				degree = 2,
				harmonics = 1,
			},
			616,
			_NB_I_FORECAST,
			_NB_I_AFTER,
			_NB_I_GRADS[:],
			_NB_I_LOSS,
			_NB_I_LAST,
		)
		expect(
			&passed,
			&total,
			e1 < 1e-10 && e2 < 1e-9,
			fmt.tprintf(
				"interpretable (trend degree 2 + seasonality, 2 shared blocks each): forecasts, MSE and the gradients of the shared weights = torch (error %.1e); after 10 Adam steps (error %.1e)",
				e1,
				e2,
			),
		)
	}
	fmt.printf("N-BEATS reference checks: %d/%d passed\n", passed, total)
	record_failures(total - passed)
}
