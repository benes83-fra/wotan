package plot

import "core:math"
import "core:sync"

// Anti-aliased text from an embedded glyph atlas (DejaVu Sans, regular + bold,
// a few pixel sizes; generated by fonts/gen_font.py, license in fonts/LICENSE_DEJAVU).

@(private = "file")
FONT_BLOB := #load("fonts/dejavu_sans.bin")

Font :: struct {
	size:    int,
	bold:    bool,
	ascent:  int, // pixels above the baseline (line box top -> baseline)
	descent: int,
	cap_top: int, // top / bottom of capital letters, from the line box top
	cap_bot: int,
	n:       int,
	recs:    []u8,
	data:    []u8,
}

Glyph :: struct {
	advance: f64,
	x_off:   int,
	y_off:   int, // from the line box top
	w, h:    int,
	pixels:  []u8,
}

@(private = "file")
GLYPH_REC_SIZE :: 16

@(private = "file")
_fonts: [16]Font
@(private = "file")
_n_fonts: int
@(private = "file")
_fonts_once: sync.Once

@(private = "file")
_u16 :: proc(b: []u8, o: int) -> int {return int(b[o]) | int(b[o + 1]) << 8}
@(private = "file")
_i16 :: proc(b: []u8, o: int) -> int {return int(i16(u16(b[o]) | u16(b[o + 1]) << 8))}
@(private = "file")
_u32 :: proc(b: []u8, o: int) -> int {
	return int(b[o]) | int(b[o + 1]) << 8 | int(b[o + 2]) << 16 | int(b[o + 3]) << 24
}

@(private = "file")
_load_fonts :: proc() {
	b := FONT_BLOB[:]
	assert(len(b) > 6 && string(b[:4]) == "WFNT", "plot: corrupt font atlas")
	n := _u16(b, 4)
	o := 6
	for i in 0 ..< min(n, len(_fonts)) {
		f := &_fonts[i]
		f.size = int(b[o])
		f.bold = b[o + 1] != 0
		f.ascent = _i16(b, o + 2)
		f.descent = _i16(b, o + 4)
		f.n = _u16(b, o + 6)
		data_size := _u32(b, o + 8)
		o += 12
		f.recs = b[o:o + f.n * GLYPH_REC_SIZE]
		o += f.n * GLYPH_REC_SIZE
		f.data = b[o:o + data_size]
		o += data_size
		f.cap_top, f.cap_bot = 0, f.ascent
		if g, ok := font_glyph(f, 'H'); ok {
			f.cap_top, f.cap_bot = g.y_off, g.y_off + g.h
		}
		_n_fonts = i + 1
	}
}

@(private = "file")
_glyph_at :: proc(f: ^Font, i: int) -> Glyph {
	r := f.recs[i * GLYPH_REC_SIZE:]
	w, h := int(r[10]), int(r[11])
	off := _u32(r, 12)
	return Glyph {
		advance = f64(_u16(r, 4)) / 64.0,
		x_off = _i16(r, 6),
		y_off = _i16(r, 8),
		w = w,
		h = h,
		pixels = f.data[off:off + w * h],
	}
}

// Glyph for a code point; ASCII 32..126 are the first 95 records, then extras
font_glyph :: proc(f: ^Font, cp: rune) -> (Glyph, bool) {
	if cp >= 32 && cp < 127 && int(cp - 32) < f.n {
		return _glyph_at(f, int(cp - 32)), true
	}
	for i in 95 ..< f.n {
		if rune(_u32(f.recs, i * GLYPH_REC_SIZE)) == cp {return _glyph_at(f, i), true}
	}
	return {}, false
}

// Closest available font to `size_px` (bold falls back to regular if needed)
font_get :: proc(size_px: int, bold := false) -> ^Font {
	sync.once_do(&_fonts_once, _load_fonts)
	best: ^Font = nil
	best_d := max(int)
	for pass in 0 ..< 2 {
		want_bold := bold && pass == 0
		for i in 0 ..< _n_fonts {
			f := &_fonts[i]
			if f.bold != want_bold {continue}
			d := abs(f.size - size_px)
			if d < best_d {best, best_d = f, d}
		}
		if best != nil {break}
	}
	return best
}

// Body text size for the legacy integer font_scale (1 small .. 5 large)
font_size_for_scale :: proc(scale: int) -> int {
	switch {
	case scale <= 1:
		return 11
	case scale == 2:
		return 13
	case scale == 3:
		return 16
	case scale == 4:
		return 20
	}
	return 24
}

line_height :: proc(f: ^Font) -> int {return f.ascent + f.descent}

text_width :: proc(f: ^Font, s: string) -> f64 {
	w := 0.0
	for cp in s {
		g, ok := font_glyph(f, cp)
		if !ok {g, _ = font_glyph(f, '?')}
		w += g.advance
	}
	return w
}

// Alpha-blend colour c at coverage a (0..1) onto the pixel
blend_pixel :: proc(img: ^Image, x, y: int, c: Color, a: f32) {
	if x < 0 || x >= img.width || y < 0 || y >= img.height || a <= 0 {return}
	alpha := min(a, 1) * f32(c.a) / 255
	idx := (y * img.width + x) * 4
	p := img.pixels[idx:idx + 4]
	p[0] = u8(f32(p[0]) + (f32(c.r) - f32(p[0])) * alpha + 0.5)
	p[1] = u8(f32(p[1]) + (f32(c.g) - f32(p[1])) * alpha + 0.5)
	p[2] = u8(f32(p[2]) + (f32(c.b) - f32(p[2])) * alpha + 0.5)
	p[3] = u8(min(255, f32(p[3]) + (255 - f32(p[3])) * alpha + 0.5))
}

H_Align :: enum {
	Left,
	Center,
	Right,
}

V_Align :: enum {
	Top, // y is the top of the line box
	Middle, // y is the vertical centre of capital letters / digits
	Bottom, // y is the bottom of the line box
}

// Draw text with its anchor at (x, y); returns the drawn width
draw_string :: proc(
	img: ^Image,
	f: ^Font,
	x, y: f64,
	s: string,
	c: Color,
	h_align := H_Align.Left,
	v_align := V_Align.Top,
) -> f64 {
	w := text_width(f, s)
	pen := x
	switch h_align {
	case .Left:
	case .Center:
		pen -= w / 2
	case .Right:
		pen -= w
	}
	top := y
	switch v_align {
	case .Top:
	case .Middle:
		top -= f64(f.cap_top + f.cap_bot) / 2
	case .Bottom:
		top -= f64(line_height(f))
	}
	ty := int(math.round(top))
	for cp in s {
		g, ok := font_glyph(f, cp)
		if !ok {g, _ = font_glyph(f, '?')}
		gx := int(math.round(pen)) + g.x_off
		gy := ty + g.y_off
		for row in 0 ..< g.h {
			for col in 0 ..< g.w {
				a := g.pixels[row * g.w + col]
				if a != 0 {blend_pixel(img, gx + col, gy + row, c, f32(a) / 255)}
			}
		}
		pen += g.advance
	}
	return w
}

// Text rotated 90° counter-clockwise (reads bottom to top), centred on (cx, cy)
draw_string_vertical :: proc(img: ^Image, f: ^Font, cx, cy: f64, s: string, c: Color) {
	w := text_width(f, s)
	// rotated frame: text x runs up the image, text y (line box) runs right
	left := int(math.round(cx - f64(f.cap_top + f.cap_bot) / 2))
	pen := cy + w / 2
	for cp in s {
		g, ok := font_glyph(f, cp)
		if !ok {g, _ = font_glyph(f, '?')}
		base := int(math.round(pen)) - g.x_off
		for row in 0 ..< g.h {
			for col in 0 ..< g.w {
				a := g.pixels[row * g.w + col]
				if a != 0 {blend_pixel(img, left + g.y_off + row, base - col, c, f32(a) / 255)}
			}
		}
		pen -= g.advance
	}
}
